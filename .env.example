# VitalMatch Environment Configuration

# Application Settings
NODE_ENV=development
PORT=3000
SESSION_SECRET=your-super-secure-session-secret-change-this-in-production
BASE_URL=http://localhost:3000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=vitalmatch_db
DB_PORT=3306

# Email Configuration (for email verification)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=VitalMatch <noreply@vitalmatch.com>

# Security Settings
BCRYPT_ROUNDS=12
JWT_SECRET=your-jwt-secret-key-change-this-in-production
CSRF_SECRET=your-csrf-secret-key-change-this-in-production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# File Upload Settings
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,audio/wav,audio/mp3,audio/ogg

# Performance Settings
CACHE_TTL=3600
API_CACHE_TTL=300
SESSION_CACHE_TTL=900

# Logging
LOG_LEVEL=info
LOG_FILE=logs/vitalmatch.log

# External Services
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Monitoring
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_MEMORY_MONITORING=true
ENABLE_REQUEST_LOGGING=true