{{> head-public}}

<div class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-3xl mx-auto bg-white rounded-xl shadow-lg p-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-2">{{heading}}</h1>
    <p class="text-sm text-gray-500 mb-6">VitalMatch - Digital Blood Request Platform</p>
    <div class="prose text-gray-700 leading-relaxed whitespace-pre-line">{{body}}</div>
    <div class="mt-8">
      <a href="/" class="bg-red-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-red-700 transition-colors">
        Back to Home
      </a>
    </div>
  </div>
</div>
