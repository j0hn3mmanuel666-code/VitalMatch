{{> public-nav}}
<main id="main-content" tabindex="-1" class="journey-status"><section class="journey-status__panel"><div class="journey-status__signal journey-status__signal--warning" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 8v4m0 4h.01M5.5 19h13a1 1 0 0 0 .87-1.5l-6.5-11a1 1 0 0 0-1.74 0l-6.5 11A1 1 0 0 0 5.5 19Z"/></svg></div><p class="journey-eyebrow">{{statusCode}}</p><h1>Something needs attention.</h1><p>{{message}}</p><div class="journey-status__actions"><a class="journey-button" href="/">Go home</a><button class="journey-button journey-button--secondary" type="button" onclick="history.back()">Go back</button></div></section></main>
{{> public-footer}}
