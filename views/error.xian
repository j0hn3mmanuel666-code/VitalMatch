{{> head-public}}

<div class="min-h-screen bg-gray-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <div class="text-center">
      <div class="mx-auto w-32 h-32 mb-8">
        <svg class="w-full h-full text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>

      <h1 class="text-6xl font-bold text-gray-900 mb-4">{{statusCode}}</h1>
      <h2 class="text-2xl font-semibold text-gray-700 mb-4">Something went wrong</h2>
      <p class="text-gray-600 mb-8 max-w-md mx-auto">{{message}}</p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="bg-red-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-red-700 transition-colors transform hover:scale-105">
          Go Home
        </a>
        <button onclick="history.back()" class="bg-gray-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-gray-700 transition-colors">
          Go Back
        </button>
      </div>
    </div>
  </div>
</div>
