{{> head-public}}
{{> public-nav hideRegister=true}}

<main id="main-content" tabindex="-1" class="journey-status">
  <section class="journey-status__panel" aria-labelledby="verification-heading">
    <div class="journey-status__signal journey-status__signal--success" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg></div>
    <p class="journey-eyebrow">One more step</p>
    <h1 id="verification-heading">Check your email, {{firstName}}.</h1>
    <p>Your VitalMatch account has been created. Verify your email address before signing in.</p>
    <div class="journey-status__details">
      <strong>Verification email sent to</strong><br>{{email}}<br><br>
      Check your inbox and spam folder, then open the verification link. The link expires after 24 hours.
    </div>
    {{#if previewUrl}}
    <div class="journey-alert journey-alert--success"><strong>Development preview available.</strong> This local environment can open the verification email without waiting for delivery.<br><br><a class="journey-text-link" href="{{previewUrl}}" target="_blank" rel="noopener">View verification email</a></div>
    {{/if}}
    <div class="journey-status__actions"><a class="journey-button" href="/login">Go to login</a><button id="resendBtn" class="journey-button journey-button--secondary" type="button" data-email="{{email}}">Resend verification email</button></div>
  <p id="resend-status" class="journey-alert" role="status" hidden style="margin-top: 1.5rem"></p>
  </section>
</main>

<script src="/js/public-verification.js?v=1" defer></script>

{{> public-footer}}
