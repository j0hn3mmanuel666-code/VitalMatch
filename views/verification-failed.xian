{{> head-public}}
{{> public-nav}}

<main id="main-content" tabindex="-1" class="journey-status">
  <section class="journey-status__panel" aria-labelledby="failed-heading">
    <div class="journey-status__signal journey-status__signal--warning" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 8v4m0 4h.01M5.5 19h13a1 1 0 0 0 .87-1.5l-6.5-11a1 1 0 0 0-1.74 0l-6.5 11A1 1 0 0 0 5.5 19Z"/></svg></div>
    <p class="journey-eyebrow">Verification needed</p>
    <h1 id="failed-heading">We could not verify that link.</h1>
    <p>{{message}}</p>
    <div class="journey-status__details">Verification links may expire or have already been used. Enter your email address below to request another link.</div>
    <div class="journey-form">
      <form id="resendForm">
        <p class="journey-alert" role="alert" data-form-status hidden></p><label for="email">Email address<input type="email" id="email" name="email" autocomplete="email" placeholder="name@example.com" required></label><button id="resendBtn" type="submit" class="journey-button journey-button--block">Send a new verification email</button></form>
    </div>
    <div class="journey-status__actions" style="margin-top: 1.25rem"><a class="journey-button journey-button--secondary" href="/login">Back to login</a></div>
  <p id="resend-status" class="journey-alert" role="status" hidden style="margin-top: 1.5rem"></p>
  </section>
</main>

<script src="/js/public-verification.js?v=1" defer></script>

{{> public-footer}}
