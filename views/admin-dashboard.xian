<!-- Admin Dashboard Content -->
<main id="main-content" tabindex="-1" class="vm-page">
  <div class="vm-page-container">
{{#if error}}<div class="vm-alert vm-alert--danger mb-4" role="alert">{{error}} <a class="vm-text-link" href="/admin/dashboard">Retry</a></div>{{/if}}
    <div class="vm-page-heading vm-heading-actions"><div><p class="vm-eyebrow">Chapter coordination</p><h1>Coordination dashboard</h1><p>Follow requests, review the latest activity, and keep donor coordination moving.</p></div><a href="/admin/new-blood-request" class="vm-button vm-button--primary">New blood request</a></div>
    {{#unless error}}<dl class="vm-dashboard-summary">
      <div><dt>Ready for coordination</dt><dd>{{stats.activeDonors}}</dd><p><a href="/admin/donors" class="vm-text-link">Review donor readiness</a></p></div>
      <div><dt>Fulfilled requests</dt><dd>{{stats.successfulMatches}}</dd><p>Completed coordination</p></div>
      <div><dt>Total requests</dt><dd>{{stats.totalRequests}}</dd><p><a href="/admin/requests" class="vm-text-link">Open request register</a></p></div>
    </dl>
    <div class="vm-dashboard-grid mb-8">
      <section aria-labelledby="recent-requests-heading">
        <div class="vm-section-heading"><h2 id="recent-requests-heading">Recent blood requests</h2><a href="/admin/requests" class="vm-text-link text-sm">View all requests</a></div>
        {{#if recentRequests.length}}<div class="vm-table-scroll" tabindex="0" role="region" aria-label="Recent blood requests"><table class="vm-table"><caption>Recent blood requests</caption><thead><tr><th scope="col" class="text-left">Patient / facility</th><th scope="col" class="text-left">Blood type</th><th scope="col" class="text-left">Status</th><th scope="col" class="text-right">Action</th></tr></thead><tbody>{{#each recentRequests}}<tr><td><strong class="font-semibold">{{patientName}}</strong><p class="vm-muted text-xs">{{hospitalName}}</p></td><td>{{bloodType}}</td><td>{{> status-badge value=status}}</td><td class="text-right"><a class="vm-button vm-button--small" href="/view-blood-request/{{id}}">View request</a></td></tr>{{/each}}</tbody></table></div>{{else}}<div class="vm-empty-state vm-panel"><h3>No blood requests yet</h3><p>New requests will appear here as they are submitted.</p></div>{{/if}}
      </section>
      <aside aria-label="Coordination tasks"><h2 class="mb-4">Coordination tasks</h2><div class="vm-action-list"><a href="/admin/requests?filter=active"><span><strong>Review active requests</strong><small>See donor matches and schedule the next step.</small></span><span aria-hidden="true">→</span></a><a href="/admin/appointments"><span><strong>Upcoming appointments</strong><small>Review confirmations and follow through.</small></span><span aria-hidden="true">→</span></a><a href="/admin/calls"><span><strong>Calls for donation</strong><small>Review community submissions.</small></span><span aria-hidden="true">→</span></a><a href="/admin/hospitals"><span><strong>Hospital accounts</strong><small>Review facility verification and access.</small></span><span aria-hidden="true">→</span></a></div></aside>
    </div>
    <section aria-labelledby="analytics-heading" class="vm-analytics"><div class="vm-section-heading"><h2 id="analytics-heading">Coordination overview</h2><a href="/admin/reports" class="vm-text-link text-sm">Open reports</a></div>
<!-- Charts Row 1 -->
    <div class="vm-chart-grid">

      <!-- Blood Requests Over Time Area Chart -->
      <div class="vm-panel vm-chart-card">
        <div class="vm-chart-card__heading">
          <div>
            <h2 class="text-xl font-bold text-gray-800 dark:text-white tracking-wide">Blood Requests Trend</h2>
            <p class="text-gray-500 dark:text-gray-400 text-sm mt-1">Monthly request volume analysis</p>
          </div>
          <div class="vm-chart-card__total">
            <p class="text-gray-500 dark:text-gray-400 text-sm font-medium mb-1">Total</p>
            <p class="text-3xl font-black text-blue-600 dark:text-blue-500 leading-none tracking-tight">{{stats.totalRequests}}</p>
          </div>
        </div>
        <div class="vm-chart" id="requestsChart" role="img" aria-label="Monthly request counts"></div>
      </div>

      <!-- Blood Type Distribution Chart -->
      <div class="vm-panel vm-chart-card">
        <h2>Blood Type Distribution</h2>
        <div class="vm-chart" id="bloodTypeChart" role="img" aria-label="Blood type distribution"></div>
      </div>

    </div>

    <!-- Charts Row 2 -->
    <div class="vm-chart-grid">

      <!-- Donor Registration Trend -->
      <div class="vm-panel vm-chart-card">
        <h2>Donor Registration Trend</h2>
        <div class="vm-chart" id="donorTrendChart" role="img" aria-label="Donor registrations by month"></div>
      </div>

      <!-- Request Status Breakdown -->
      <div class="vm-panel vm-chart-card">
        <h2>Request Status Breakdown</h2>
        <div class="vm-chart" id="statusChart" role="img" aria-label="Request status breakdown"></div>
      </div>

    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
<section class="vm-panel p-5" aria-labelledby="hospital-summary-title"><h2 id="hospital-summary-title" class="mb-4">Facilities by request volume</h2>{{#each topHospitals}}<div class="vm-activity-row"><div><h3>{{hospitalName}}</h3><p>{{city}}</p></div><span class="text-sm font-semibold">{{count}} requests</span></div>{{else}}<p class="vm-muted text-sm">No facility activity recorded yet.</p>{{/each}}<a href="/admin/hospitals" class="vm-text-link inline-block text-sm mt-4">View hospitals</a></section>
<section class="vm-panel p-5" aria-labelledby="regional-summary-title"><h2 id="regional-summary-title" class="mb-4">Request distribution by province</h2>{{#each regionalDistribution}}<div class="vm-activity-row"><span class="text-sm">{{province}}</span><span class="text-sm font-semibold">{{count}} requests</span></div>{{else}}<p class="vm-muted text-sm">Distribution will appear as requests are submitted.</p>{{/each}}</section>
</div>
</section>{{/unless}}
</div>
</main>
<script>
  // Render compact, dependency-free SVG charts from the same server-side aggregates.
  const monthlyRequestsData = {{{ monthlyRequests }}};
  const bloodTypeData = {{{ bloodTypeDistribution }}};
  const monthlyDonorsData = {{{ monthlyDonors }}};
  const statusData = {{{ statusBreakdown }}};
  const svgNS = 'http://www.w3.org/2000/svg';
  const chartColors = ['#a32129', '#305c78', '#226449', '#815619', '#65756f', '#7b568c', '#af5e36', '#547c91'];
  function chartText(svg, x, y, value) {
    const text = document.createElementNS(svgNS, 'text'); text.setAttribute('x', x); text.setAttribute('y', y); text.textContent = value; svg.appendChild(text);
  }
  function renderTrend(id, rows, valueKey, color, isLine) {
    const target = document.getElementById(id), values = rows.map(row => Number(row[valueKey]) || 0);
    const labels = rows.map(row => new Date(row.month + '-01T00:00:00').toLocaleDateString('en-US', { month: 'short' }));
    if (!values.length) { target.textContent = 'No activity recorded for this period.'; target.classList.add('vm-chart__empty'); return; }
    const svg = document.createElementNS(svgNS, 'svg'); svg.setAttribute('viewBox', '0 0 560 170'); svg.setAttribute('preserveAspectRatio', 'none'); svg.setAttribute('aria-hidden', 'true');
    const max = Math.max(1, ...values), left = 30, right = 548, top = 14, base = 132, width = right - left, step = width / Math.max(values.length - 1, 1);
    [0, .5, 1].forEach(ratio => { const y = base - ratio * (base - top), line = document.createElementNS(svgNS, 'line'); line.setAttribute('x1', left); line.setAttribute('x2', right); line.setAttribute('y1', y); line.setAttribute('y2', y); line.setAttribute('class', 'vm-chart__grid'); svg.appendChild(line); });
    if (isLine) {
      const points = values.map((value, i) => `${values.length === 1 ? left + width / 2 : left + i * step},${base - value / max * (base - top)}`).join(' ');
      const line = document.createElementNS(svgNS, 'polyline'); line.setAttribute('points', points); line.setAttribute('class', 'vm-chart__line'); line.setAttribute('stroke', color); svg.appendChild(line);
      values.forEach((value, i) => { const dot = document.createElementNS(svgNS, 'circle'); dot.setAttribute('cx', values.length === 1 ? left + width / 2 : left + i * step); dot.setAttribute('cy', base - value / max * (base - top)); dot.setAttribute('r', 3.5); dot.setAttribute('fill', color); svg.appendChild(dot); });
    } else values.forEach((value, i) => { const slot = width / values.length, height = value / max * (base - top), bar = document.createElementNS(svgNS, 'rect'); bar.setAttribute('x', left + i * slot + slot * .22); bar.setAttribute('y', base - height); bar.setAttribute('width', Math.max(8, slot * .56)); bar.setAttribute('height', Math.max(2, height)); bar.setAttribute('rx', 3); bar.setAttribute('fill', color); svg.appendChild(bar); });
    labels.forEach((label, i) => chartText(svg, values.length === 1 ? left + width / 2 : left + i * step, 158, label));
    target.appendChild(svg); target.setAttribute('aria-label', rows.map((row, i) => `${labels[i]}: ${values[i]}`).join(', '));
  }
  function renderBreakdown(id, rows, labelKey, valueKey) {
    const target = document.getElementById(id);
    if (!rows.length) { target.textContent = 'No records to display yet.'; target.classList.add('vm-chart__empty'); return; }
    const total = rows.reduce((sum, row) => sum + (Number(row[valueKey]) || 0), 0), legend = document.createElement('ul'); legend.className = 'vm-chart-legend';
    if (total > 0) {
      const svg = document.createElementNS(svgNS, 'svg'); svg.setAttribute('viewBox', '0 0 140 140'); svg.setAttribute('aria-hidden', 'true'); const radius = 48, circumference = 2 * Math.PI * radius; let offset = 0;
      rows.forEach((row, i) => { const value = Number(row[valueKey]) || 0, circle = document.createElementNS(svgNS, 'circle'); circle.setAttribute('cx', 70); circle.setAttribute('cy', 70); circle.setAttribute('r', radius); circle.setAttribute('fill', 'none'); circle.setAttribute('stroke', chartColors[i % chartColors.length]); circle.setAttribute('stroke-width', 18); circle.setAttribute('stroke-dasharray', `${circumference * value / total} ${circumference}`); circle.setAttribute('stroke-dashoffset', -offset); circle.setAttribute('transform', 'rotate(-90 70 70)'); svg.appendChild(circle); offset += circumference * value / total; }); target.appendChild(svg);
    }
    rows.forEach((row, i) => { const item = document.createElement('li'), swatch = document.createElement('span'), label = document.createElement('span'), value = document.createElement('strong'); swatch.className = 'vm-chart-legend__swatch'; swatch.style.backgroundColor = chartColors[i % chartColors.length]; label.textContent = row[labelKey]; value.textContent = `${row[valueKey]} (${total ? Math.round(Number(row[valueKey]) / total * 100) : 0}%)`; item.append(swatch, label, value); legend.appendChild(item); });
    target.appendChild(legend); target.setAttribute('aria-label', rows.map(row => `${row[labelKey]}: ${row[valueKey]}`).join(', '));
  }
  renderTrend('requestsChart', monthlyRequestsData, 'count', '#305c78', true);
  renderBreakdown('bloodTypeChart', bloodTypeData, 'bloodType', 'count');
  renderTrend('donorTrendChart', monthlyDonorsData, 'count', '#226449', false);
  renderBreakdown('statusChart', statusData, 'status', 'count');
</script>
