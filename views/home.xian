{{> head-public}}
{{> public-nav}}
<main id="main-content" tabindex="-1">
  <section class="landing-hero" aria-labelledby="landing-title">
    <div class="journey-container landing-hero__grid">
      <div class="landing-hero__copy">
        <p class="journey-eyebrow">Care starts with community</p>
        <h1 id="landing-title">{{#if hero.title}}{{hero.title}}{{else}}When blood is needed, every connection matters.{{/if}}</h1>
        <p class="landing-hero__statement">{{#if hero.subtitle}}{{hero.subtitle}}{{else}}A clear way to connect people who need blood with people ready to help.{{/if}}</p>
        <div class="landing-hero__description">{{#if hero.description}}{{{hero.description}}}{{else}}VitalMatch supports donors, hospitals, and Philippine Red Cross coordinators in Oriental Mindoro, from a request for support to the next coordinated step.{{/if}}</div>
        <div class="landing-actions">
          <a class="journey-button" href="{{#if hero.primaryButtonLink}}{{hero.primaryButtonLink}}{{else}}/login{{/if}}">{{#if hero.primaryButtonText}}{{hero.primaryButtonText}}{{else}}Request blood{{/if}} <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></a>
          <a class="journey-button journey-button--secondary" href="{{#if hero.secondaryButtonLink}}{{hero.secondaryButtonLink}}{{else}}/register{{/if}}">{{#if hero.secondaryButtonText}}{{hero.secondaryButtonText}}{{else}}Become a donor{{/if}}</a>
        </div>
        <p class="landing-hero__note">Blood requests continue through your secure account. For a medical emergency, seek immediate care from your hospital or local emergency service.</p>
      </div>
      <figure class="landing-hero__image">
        {{#if hero.imageUrl}}<img src="{{hero.imageUrl}}" alt="Community blood donation and humanitarian support" width="1280" height="960" fetchpriority="high">{{else}}<img class="landing-hero__photo" src="/images/philippine-red-cross-blood-donation.jpg" alt="A Philippine Red Cross blood services staff member caring for a donor during blood donation" width="1000" height="667" fetchpriority="high"><figcaption><span>Blood donation care &middot; Philippine Red Cross</span><a href="https://mb.com.ph/2023/02/24/gordon-clarifies-ph-red-cross-blood-processing-fee-lowest-in-ph" target="_blank" rel="noopener">Photo: Philippine Red Cross</a></figcaption>{{/if}}
      </figure>
    </div>
  </section>
  <div class="landing-context"><div class="journey-container landing-context__inner"><span><strong>Local focus.</strong> Oriental Mindoro communities</span><span><strong>Shared purpose.</strong> Donors, hospitals &amp; coordinators</span><span><strong>Human care.</strong> Professional donation screening</span></div></div>
  <section class="landing-section" aria-labelledby="intro-heading">
    <div class="journey-container landing-intro__grid" data-reveal>
      <div><p class="journey-eyebrow">People at the heart of the response</p><h2 id="intro-heading">A small act of care can begin a meaningful connection.</h2></div>
      <div class="landing-copy"><p>Behind every blood request are people waiting for support, volunteers willing to give, and teams working to bring them together.</p><p>VitalMatch helps make that coordination easier to follow. It brings requests, donor availability, notifications, and scheduling into one place, while medical professionals guide donation screening and care.</p><a href="/about" class="journey-text-link">Get to know VitalMatch <span aria-hidden="true">&rarr;</span></a></div>
    </div>
  </section>
  <section class="landing-section" aria-labelledby="paths-heading">
    <div class="journey-container">
      <div class="landing-section-heading" data-reveal><div><p class="journey-eyebrow">How you can take part</p><h2 id="paths-heading">Find the right place to begin.</h2></div><p>Whether you are seeking support or ready to give, your next step should be clear.</p></div>
      <div class="path-choices">
        <article class="path-choice" data-reveal><div class="path-choice__mark" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M6 28V5h20v23M2 28h28M12 28v-7h8v7M12 11h8M16 7v8"/></svg></div><h3>I need to request blood</h3><p>Hospitals and authorized requesters can sign in to submit a request and follow the coordination process.</p><a href="/login">Start a blood request <span aria-hidden="true">&rarr;</span></a></article>
        <article class="path-choice path-choice--donor" data-reveal style="--reveal-delay: 80ms"><div class="path-choice__mark" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M16 3S6 14 6 20a10 10 0 0 0 20 0C26 14 16 3 16 3Z"/><path d="M11 21a5 5 0 0 0 5 5"/></svg></div><h3>I want to become a donor</h3><p>Create an account, verify your email, and share your donor profile and availability when you are ready.</p><a href="/register">Join the donor community <span aria-hidden="true">&rarr;</span></a></article>
      </div>
    </div>
  </section>
  <section id="how-it-works" class="landing-section landing-section--soft" aria-labelledby="process-heading">
    <div class="journey-container">
      <div class="landing-section-heading" data-reveal><div><p class="journey-eyebrow">A clearer process</p><h2 id="process-heading">From a request to a coordinated next step.</h2></div><p>Simple handoffs help everyone understand what happens next.</p></div>
      <ol class="process-list">
        <li data-reveal><span class="process-list__number" aria-hidden="true">01</span><div><h3>Share the need</h3><p>An authorized requester submits the blood type, hospital, and other details through their account.</p></div></li>
        <li data-reveal style="--reveal-delay: 70ms"><span class="process-list__number" aria-hidden="true">02</span><div><h3>Connect with donors</h3><p>Relevant request details help coordinators identify potential donors and send notifications.</p></div></li>
        <li data-reveal style="--reveal-delay: 140ms"><span class="process-list__number" aria-hidden="true">03</span><div><h3>Arrange the next step</h3><p>Donors, hospitals, and coordinators can communicate and follow through with scheduling.</p></div></li>
      </ol>
      <p class="landing-process__note">Every donation remains subject to professional screening. Request fulfillment and timing depend on availability and clinical requirements.</p>
    </div>
  </section>
  {{#if about.title}}
  <section class="landing-section" aria-labelledby="about-heading"><div class="journey-container landing-story__grid{{#if about.imageUrl}} landing-story__grid--image{{/if}}" data-reveal><div><p class="journey-eyebrow">Our community</p><h2 id="about-heading">{{about.title}}</h2>{{#if about.subtitle}}<p class="landing-story__lead">{{about.subtitle}}</p>{{/if}}{{#if about.description}}<div class="landing-story__body">{{{about.description}}}</div>{{/if}}</div>{{#if about.imageUrl}}<img src="{{about.imageUrl}}" alt="{{about.title}}" class="landing-story__image" width="900" height="675" loading="lazy" decoding="async">{{/if}}</div></section>
  {{/if}}
  {{#if otherSections}}
  <section class="landing-section" aria-label="More from VitalMatch"><div class="journey-container">{{#each otherSections}}<article class="landing-cms-section{{#if imageUrl}} landing-cms-section--image{{/if}}" data-reveal>{{#if imageUrl}}<img src="{{imageUrl}}" alt="{{title}}" class="landing-cms-section__image" width="900" height="675" loading="lazy" decoding="async">{{/if}}<div>{{#if title}}<h2>{{title}}</h2>{{/if}}{{#if subtitle}}<p class="landing-cms-section__lead">{{subtitle}}</p>{{/if}}{{#if description}}<div class="landing-cms-section__body">{{{description}}}</div>{{/if}}<div class="landing-cms-section__actions">{{#if primaryButtonText}}<a class="journey-button" href="{{primaryButtonLink}}">{{primaryButtonText}}</a>{{/if}}{{#if secondaryButtonText}}<a class="journey-button journey-button--secondary" href="{{secondaryButtonLink}}">{{secondaryButtonText}}</a>{{/if}}</div></div></article>{{/each}}</div></section>
  {{/if}}
  <section class="landing-section landing-guidance" aria-labelledby="guidance-heading">
    <div class="journey-container landing-guidance__grid">
      <div data-reveal><p class="journey-eyebrow">Before you begin</p><h2 id="guidance-heading">A little clarity goes a long way.</h2><p class="landing-guidance__intro">Understand the next step, whether you are giving blood, requesting support, or organizing a donation drive.</p></div>
      <div class="public-accordion" data-reveal>
        <details><summary>Does registering mean I can donate immediately?</summary><p>Registration creates your account. Complete your donor profile after verifying your email. Medical professionals determine eligibility and carry out screening before donation. Visit the <a href="https://redcross.org.ph/give-blood/" target="_blank" rel="noopener">Philippine Red Cross blood donation guide</a> for official information.</p></details>
        <details><summary>How do hospitals use VitalMatch?</summary><p>Hospital accounts are issued by an administrator. If you represent a hospital or clinic, <a href="/contact">contact the team</a> for account support. Existing account holders can <a href="/login">sign in to request blood</a>.</p></details>
        <details><summary>Can I send a call for donation without an account?</summary><p>Yes. Use the call-for-donation form below to share the required details with the coordination team. For an immediate blood request, use your secure account. Do not wait for an online response during a medical emergency.</p></details>
      </div>
    </div>
  </section>
  <section id="call-for-donation-section" class="landing-section landing-call" aria-labelledby="call-heading">
    <div class="journey-container landing-call__inner" data-reveal>
      <div class="landing-call__copy"><p class="journey-eyebrow">Bring people together</p><h2 id="call-heading">{{#if callForDonation.title}}{{callForDonation.title}}{{else}}Planning a drive or seeking donor support?{{/if}}</h2><div>{{#if callForDonation.description}}{{{callForDonation.description}}}{{else}}Share a call for donation with the VitalMatch team. A coordinator reviews the details before arranging the next step.{{/if}}</div><div class="landing-cms-section__actions">{{#if callForDonation.primaryButtonText}}<a class="journey-button journey-button--secondary" href="{{callForDonation.primaryButtonLink}}">{{callForDonation.primaryButtonText}}</a>{{/if}}{{#if callForDonation.secondaryButtonText}}<a class="journey-text-link" href="{{callForDonation.secondaryButtonLink}}">{{callForDonation.secondaryButtonText}}</a>{{/if}}</div></div>
      <div class="landing-call__action">{{#if error_msg}}<div class="landing-form-alert" role="alert">{{error_msg}}</div>{{/if}}<p id="call-submission-status" class="journey-alert journey-alert--success" role="status" hidden></p><button id="openCallDonationBtn" type="button" class="journey-button" aria-haspopup="dialog" aria-controls="callDonationModal" aria-expanded="false">Submit a call for donation</button><p>Have your contact details, blood type, and donation location ready. Required details are marked in the form.</p></div>
    </div>
  </section>
</main>
<div id="callDonationModal" class="landing-modal" hidden role="dialog" aria-modal="true" aria-labelledby="callDonationModalTitle" aria-describedby="call-form-intro">
  <div class="landing-modal__backdrop" data-close-call-modal></div>
  <div class="landing-modal__dialog">
    <div class="landing-modal__header"><div><p class="journey-eyebrow">Community coordination</p><h2 id="callDonationModalTitle">Submit a call for donation</h2></div><button type="button" class="landing-modal__close" data-close-call-modal aria-label="Close donation form"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div>
    <form action="/submit-call-for-donation" method="POST" class="journey-form landing-form">
      <p class="journey-alert" role="alert" data-form-status hidden></p>
      <input type="hidden" name="_csrf" value="{{csrfToken}}"><p id="call-form-intro" class="landing-form__intro">Tell us enough to review the request and coordinate a follow-up. Fields marked <span aria-hidden="true">*</span> are required.</p>
      <div class="journey-form__grid">
        <label>Patient or organizer name <span aria-hidden="true">*</span><input type="text" name="fullName" autocomplete="name" required></label><label>Contact number <span aria-hidden="true">*</span><input type="tel" name="contactNumber" autocomplete="tel" required></label><label>Age <span aria-hidden="true">*</span><input type="number" name="age" min="1" inputmode="numeric" required></label><label>Weight (kg) <span aria-hidden="true">*</span><input type="text" name="weight" inputmode="decimal" required></label><label>Gender <span aria-hidden="true">*</span><select name="gender" required><option value="">Select one</option><option value="Male">Male</option><option value="Female">Female</option><option value="Other">Other</option></select></label><label>Blood type required <span aria-hidden="true">*</span><select name="bloodType" required><option value="">Select one</option><option value="A+">A+</option><option value="A-">A-</option><option value="B+">B+</option><option value="B-">B-</option><option value="AB+">AB+</option><option value="AB-">AB-</option><option value="O+">O+</option><option value="O-">O-</option><option value="Any">Any type (blood drive)</option></select></label><label>Recent tattoo or piercing (last 12 months)? <span aria-hidden="true">*</span><select name="hasTattoo" required><option value="">Select one</option><option value="No">No</option><option value="Yes">Yes</option><option value="Not Applicable">Not applicable (organizing a drive)</option></select></label><label>Hospital or donation location <span aria-hidden="true">*</span><input type="text" name="location" autocomplete="organization" placeholder="e.g. Oriental Mindoro Provincial Hospital" required></label>
      </div>
      <label class="landing-form__full">Additional details <textarea name="message" rows="3" placeholder="Briefly describe the situation or planned drive."></textarea></label><div class="landing-form__actions"><button type="button" class="journey-button journey-button--secondary" data-close-call-modal>Cancel</button><button type="submit" class="journey-button journey-button--primary">Submit for review</button></div>
    </form>
  </div>
</div>
<script src="/js/public-landing.js?v=1" defer></script>
{{> public-footer}}
