<a class="vm-skip-link" href="#main-content">Skip to main content</a>
<div id="confirmModal" class="vm-dialog-backdrop hidden" role="dialog" aria-modal="true" aria-labelledby="confirmModalTitle" aria-describedby="confirmModalMessage" tabindex="-1">
  <div class="vm-dialog">
    <div id="confirmModalIcon" class="vm-dialog-signal" aria-hidden="true"><svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M12 8v4m0 4h.01M5.5 19h13a1 1 0 0 0 .87-1.5l-6.5-11a1 1 0 0 0-1.74 0l-6.5 11a1 1 0 0 0 .87 1.5Z"/></svg></div>
    <h2 id="confirmModalTitle">Confirm action</h2>
    <p id="confirmModalMessage">Review this action before continuing.</p>
    <div class="vm-dialog__actions">
      <button type="button" onclick="closeConfirmModal()" class="vm-button">Go back</button>
      <button type="button" id="confirmModalAction" class="vm-button vm-button--primary">Confirm</button>
    </div>
  </div>
</div>
<script src="/js/confirm-dialog.js?v=3"></script>
