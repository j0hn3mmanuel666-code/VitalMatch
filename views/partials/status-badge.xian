<span class="vm-status{{#if (eq value 'active')}} vm-status--success{{else if (eq value 'fulfilled')}} vm-status--success{{else if (eq value 'available')}} vm-status--success{{else if (eq value 'approved')}} vm-status--success{{else if (eq value 'completed')}} vm-status--success{{else if (eq value 'Resolved')}} vm-status--success{{else if (eq value 'scheduled')}} vm-status--info{{else if (eq value 'Reviewed')}} vm-status--info{{else if (eq value 'Contacted')}} vm-status--info{{else if (eq value 'moderate')}} vm-status--info{{else if (eq value 'critical')}} vm-status--danger{{else if (eq value 'cancelled')}} vm-status--danger{{else if (eq value 'rejected')}} vm-status--danger{{else if (eq value 'expired')}} vm-status--danger{{else if (eq value 'failed')}} vm-status--danger{{else if (eq value 'overdue')}} vm-status--danger{{else if (eq value 'Pending')}} vm-status--warning{{else if (eq value 'pending')}} vm-status--warning{{else if (eq value 'urgent')}} vm-status--warning{{else if (eq value 'high')}} vm-status--warning{{/if}} capitalize">{{#if label}}{{label}}{{else}}{{value}}{{/if}}</span>
