      <div class="absolute top-[8px] right-[20%] md:right-[35%] w-2 h-2 bg-red-500 rounded-full animate-pulse"></div>
      <svg class="w-6 h-6 mb-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
      </svg>
      <span class="text-[10px] font-semibold text-center leading-tight">Emergency<br>Alerts</span>
    </button>
  </div>
</nav>

<!-- Spacer Div to prevent content from hiding behind the fixed bottom nav -->
<div class="h-20 w-full lg:hidden transparent pointer-events-none"></div>

<script>
  // Handle bottom nav active states
  document.addEventListener('DOMContentLoaded', () => {
    const bottomNavLinks = document.querySelectorAll('.bottom-nav-link');
    const currentPath = window.location.pathname;
    bottomNavLinks.forEach(link => {
      if (link.tagName === 'A') {
        try {
          const linkPath = new URL(link.href, window.location.origin).pathname;
          if (linkPath === currentPath) {
            if (linkPath.includes('new-blood-request') || linkPath.includes('request-blood')) {
              link.classList.remove('text-gray-500');
              link.classList.add('text-red-600');
            } else if (linkPath.includes('view-donor-profile')) {
              link.classList.remove('text-gray-500');
              link.classList.add('text-blue-600');
            } else if (linkPath.includes('my-requests')) {
              link.classList.remove('text-gray-500');
              link.classList.add('text-green-600');
            }
          }
        } catch (e) { }
      }
    });

    // Auto-open emergency alerts if in URL query parameters
    if (window.location.search.includes('alerts=true') && typeof showEmergencyAlerts === 'function') {
      showEmergencyAlerts();
    }
  });
</script>
<!-- Global Notification System -->
<script>
  async function fetchNotifications() {
    try {
      const response = await fetch(`/api/notifications?_=${Date.now()}`);
      const data = await response.json();

      if (data.success) {
        const badge = document.getElementById('notificationBadge');
        const sidebarBadge = document.getElementById('sidebarNotificationBadge');
        const dropdown = document.getElementById('notificationList');

        // Update badges
        if (badge) {
          badge.textContent = data.unreadCount > 0 ? data.unreadCount : '';
          badge.style.display = data.unreadCount > 0 ? 'flex' : 'none';
        }
        if (sidebarBadge) {
          sidebarBadge.textContent = data.unreadCount > 0 ? data.unreadCount : '';
          sidebarBadge.style.display = data.unreadCount > 0 ? 'flex' : 'none';
        }

        // Render dropdown if it exists
        if (dropdown) {
          if (data.notifications.length === 0) {
            dropdown.innerHTML = '<div class="p-4 text-center text-gray-500">No notifications</div>';
          } else {
            dropdown.innerHTML = data.notifications.map(notif => `
                <div class="p-4 border-b hover:bg-gray-50 cursor-pointer ${notif.isRead ? 'opacity-75' : 'bg-blue-50/30'}" onclick="markNotificationRead(${notif.id}, '${notif.link || '#'}', '${notif.title}', '${notif.message}')">
                  <div class="flex items-start space-x-3">
                    <div class="p-2 rounded-full ${notif.type === 'alert' ? 'bg-red-100 text-red-600' : 'bg-blue-100 text-blue-600'}">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                      </svg>
                    </div>
                    <div class="flex-1">
                      <p class="text-sm font-semibold text-gray-800">${notif.title}</p>
                      <p class="text-xs text-gray-600">${notif.message}</p>
                      <p class="text-xs text-gray-400 mt-1">${new Date(notif.createdAt).toLocaleString()}</p>
                    </div>
                    ${!notif.isRead ? '<div class="w-2 h-2 bg-blue-500 rounded-full mt-1"></div>' : ''}
                  </div>
                </div>
              `).join('');
          }
        }
      }
    } catch (error) {
      console.error("Failed to fetch notifications", error);
    }
  }

  async function markNotificationRead(id, link, title, message) {
    try {
      await fetch(`/api/notifications/${id}/read`, { method: 'POST' });
      if (link && link !== '#') {
        if (link.startsWith('/view-blood-request/') || title === 'Nearby Blood Request') {
          showRequestNotificationModal(id, title, message);
        } else {
          window.location.href = link;
        }
      } else {
        fetchNotifications(); // Refresh list
      }
    } catch (error) {
      console.error("Failed to mark read", error);
    }
  }

  async function markAllNotificationsRead() {
    try {
      await fetch('/api/notifications/read-all', { method: 'POST' });
      fetchNotifications();
    } catch (error) {
      console.error("Failed to mark all read", error);
    }
  }

  // Fetch on load and every 60 seconds
  document.addEventListener('DOMContentLoaded', () => {
    fetchNotifications();
    setInterval(fetchNotifications, 60000);
  });
</script>
{{/if}}
</body>

</html>