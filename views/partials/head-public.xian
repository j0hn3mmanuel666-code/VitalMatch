<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="VitalMatch connects blood requests, donors, and coordinators in Oriental Mindoro. Find a clear way to request support or become a donor.">
  <meta name="csrf-token" content="{{csrfToken}}">
  <meta name="theme-color" content="#b82025">
  <title>{{#if title}}{{title}}{{else}}VitalMatch | Blood donation coordination{{/if}}</title>
  {{> typography}}
  <link rel="stylesheet" href="/css/public-journey.css?v=5">
  {{#if isLanding}}<link rel="stylesheet" href="/css/landing.css?v=5">{{/if}}
  <link rel="manifest" href="/manifest.json">
  <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <script src="/js/pwa-register.js?v=3" defer></script>
  <script src="/js/public-experience.js?v=1" defer></script>
  {{#if isDevelopment}}<script src="/js/dev-reload.js?v=1" defer></script>{{/if}}
</head>
<body class="vitalmatch-public{{#if isLanding}} vitalmatch-landing{{/if}}">
  <a class="public-skip-link" href="#main-content">Skip to main content</a>
