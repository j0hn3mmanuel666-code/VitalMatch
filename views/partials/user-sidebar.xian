<!-- Shared user sidebar: hamburger navigation used by every user page -->
<style>
  .sidebar { transform: translateX(-100%); transition: transform 0.3s ease-in-out; }
  .sidebar-toggle:checked ~ .sidebar-container .sidebar { transform: translateX(0); }
  .sidebar-toggle:checked ~ .sidebar-overlay { opacity: 1; pointer-events: auto; }
  .sidebar-overlay { opacity: 0; pointer-events: none; transition: opacity 0.3s ease-in-out; }
</style>

<!-- Sidebar Toggle Checkbox (Hidden) -->
<input type="checkbox" id="sidebar-toggle" class="hidden sidebar-toggle" />

<!-- Sidebar Overlay (Dark Background). z-index sits above Leaflet map panes (max 1000). -->
<label for="sidebar-toggle" class="sidebar-overlay fixed inset-0 bg-black bg-opacity-50 z-[1100]"></label>

<!-- Sidebar Container -->
<div class="sidebar-container">
  <aside class="sidebar user-sidebar-nav fixed top-0 left-0 h-full w-72 bg-white dark:bg-[#18181b] shadow-2xl z-[1101] overflow-y-auto">
    <div class="p-6">

      <!-- Close Button -->
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-gray-800 dark:text-gray-200">Menu</h2>
        <label for="sidebar-toggle" class="cursor-pointer hover:bg-gray-100 dark:hover:bg-gray-800 p-2 rounded-lg transition">
          <svg class="w-6 h-6 text-gray-700 dark:text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </label>
      </div>

{{#if navUser}}
      <!-- User Profile Section -->
      <div class="mb-6 pb-6 border-b border-gray-200 dark:border-gray-800">
        <div class="flex items-center space-x-3">
          <div class="w-14 h-14 bg-gradient-to-br from-red-500 to-blue-500 rounded-full flex items-center justify-center text-white font-bold text-xl shadow-lg">
            {{navInitial}}
          </div>
          <div>
            <p class="font-semibold text-gray-800 dark:text-gray-200 text-lg">{{navUser.firstName}} {{navUser.lastName}}</p>
            <p class="text-sm text-green-600 font-medium">
              {{#if (eq navUser.role "hospital")}}Hospital Account{{else}}{{#if (eq navUser.role "admin")}}Administrator{{else}}{{#if navDonor}}{{#if navDonor.isAvailable}}Active Donor{{else}}Paused Donor{{/if}}{{else}}Registered User{{/if}}{{/if}}{{/if}}
            </p>
          </div>
        </div>
      </div>

      <!-- Navigation Links -->
      <nav class="space-y-1">

        <!-- Dashboard -->
        <a href="{{#if (eq navUser.role "hospital")}}/hospital/dashboard{{else}}/dashboard{{/if}}" class="flex items-center space-x-3 px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <span>Dashboard</span>
        </a>

        <!-- Patient Records (hospital accounts) -->
        {{#if (eq navUser.role "hospital")}}
        <a href="/hospital/patients" class="flex items-center space-x-3 px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
          </svg>
          <span>Patient Records</span>
        </a>
        {{/if}}

        <!-- My Profile -->
        {{#unless (eq navUser.role "hospital")}}
        <a href="/view-donor-profile" class="flex items-center space-x-3 px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          <span>My Profile</span>
        </a>
        {{/unless}}

        <!-- My Requests -->
        <a href="/my-requests" class="flex items-center space-x-3 px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
          <span>My Requests</span>
        </a>

        <!-- Notifications -->
        <a href="/notifications" class="flex items-center justify-between px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition">
          <div class="flex items-center space-x-3">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
            <span>Notifications</span>
          </div>
          <span id="sidebarNotificationBadge" class="bg-red-500 text-white text-xs rounded-full w-6 h-6 flex items-center justify-center font-semibold"{{#unless navUnread}} style="display: none;"{{/unless}}>{{navUnread}}</span>
        </a>

        <!-- Messages -->
        <a href="/messages" class="flex items-center justify-between px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition">
          <div class="flex items-center space-x-3">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
            <span>Messages</span>
          </div>
          {{#if navUnreadMsgs}}<span class="bg-blue-500 text-white text-xs rounded-full w-6 h-6 flex items-center justify-center font-semibold">{{navUnreadMsgs}}</span>{{/if}}
        </a>

        <!-- My Appointments -->
        {{#unless (eq navUser.role "hospital")}}
        <a href="/my-appointments" class="flex items-center space-x-3 px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>Appointments</span>
        </a>
        {{/unless}}

        <!-- Blood Map -->
        <a href="/map" class="flex items-center space-x-3 px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
          </svg>
          <span>Blood Map</span>
        </a>

        <!-- Divider -->
        <div class="border-t border-gray-200 dark:border-gray-800 my-4"></div>

        <!-- Request Blood -->
        <a href="/new-blood-request" class="flex items-center space-x-3 px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Request Blood</span>
        </a>

        <!-- Donation History -->
        {{#unless (eq navUser.role "hospital")}}
        <a href="/history" class="flex items-center space-x-3 px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>History</span>
        </a>
        {{/unless}}

        <!-- Settings -->
        <a href="/settings" class="flex items-center space-x-3 px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>Settings</span>
        </a>

        <!-- Help and Support -->
        <a href="/help" class="flex items-center space-x-3 px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Help and Support</span>
        </a>

      </nav>
{{else}}
      <div class="text-center py-8">
        <p class="text-gray-600 dark:text-gray-400 font-semibold mb-4">You are browsing as a guest</p>
        <a href="/login" class="inline-block bg-red-600 text-white px-6 py-2 rounded-lg font-semibold hover:bg-red-700 transition">Login</a>
      </div>
{{/if}}
    </div>
  </aside>
</div>

<script>
  function updateSidebarActiveState() {
    var currentPath = window.location.pathname;
    var sidebarLinks = document.querySelectorAll(".user-sidebar-nav a");
    sidebarLinks.forEach(function (link) {
      try {
        if (link.getAttribute("href") === "#") return;
        var linkPath = new URL(link.href).pathname;
        link.classList.remove("bg-red-50", "text-red-600", "font-semibold");
        if (!link.classList.contains("text-gray-700")) link.classList.add("text-gray-700");
        var isMatch = linkPath === currentPath || (linkPath === "/dashboard" && currentPath === "/hospital/dashboard") || (linkPath === "/hospital/dashboard" && currentPath === "/dashboard");
        if (isMatch) { link.classList.remove("text-gray-700"); link.classList.add("bg-red-50", "text-red-600", "font-semibold"); }
      } catch (e) {}
    });
  }
  document.addEventListener("DOMContentLoaded", updateSidebarActiveState);
</script>

<!-- Logout Confirmation Modal -->
<div id="logoutModal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black bg-opacity-50">
  <div class="bg-white dark:bg-[#27272a] rounded-2xl shadow-2xl p-8 max-w-sm w-full mx-4 text-center">
    <div class="w-16 h-16 bg-red-100 dark:bg-red-900/30 rounded-full flex items-center justify-center mx-auto mb-5">
      <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
      </svg>
    </div>
    <h3 class="text-xl font-bold text-gray-800 dark:text-gray-200 mb-2">Logout?</h3>
    <p class="text-gray-500 dark:text-gray-400 mb-6">You'll need to log in again to access your account.</p>
    <div class="flex gap-3">
      <button onclick="closeLogoutModal()" class="flex-1 px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 font-semibold hover:bg-gray-50 dark:hover:bg-gray-800 transition">Cancel</button>
      <a id="logoutConfirmBtn" href="/logout" class="flex-1 px-4 py-2.5 rounded-lg bg-red-600 text-white font-semibold hover:bg-red-700 transition text-center">Logout</a>
    </div>
  </div>
</div>
<script>
  (function () {
    document.addEventListener("DOMContentLoaded", function () {
      document.querySelectorAll('a[href="/logout"]').forEach(function (link) {
        link.addEventListener("click", function (e) {
          e.preventDefault();
          document.getElementById("logoutModal").classList.remove("hidden");
          document.getElementById("logoutModal").classList.add("flex");
        });
      });
    });
  })();
  function closeLogoutModal() {
    document.getElementById("logoutModal").classList.add("hidden");
    document.getElementById("logoutModal").classList.remove("flex");
  }
</script>
