<div id="mobileOverlay" class="mobile-overlay vm-sidebar-overlay fixed inset-0 hidden"></div>
<!-- Shadcn-like Sidebar -->
<aside
  id="workspace-navigation" aria-label="Administration navigation" class="vm-sidebar shadcn-sidebar w-64 fixed top-0 left-0 h-full bg-white dark:bg-[#09090b] border-r border-gray-200 dark:border-gray-800 z-50 flex flex-col justify-between shadow-sm overflow-hidden transition-all duration-300">

  <!-- Sidebar Header (Workspace / Logo) -->
  <div
    class="sidebar-header-container h-14 flex items-center justify-between px-3 border-b border-gray-200 dark:border-gray-800 flex-shrink-0">
    <div class="sidebar-logo-container flex items-center overflow-hidden flex-1">
      <div
        class="sidebar-icon-container flex-shrink-0 w-8 h-8 bg-black dark:bg-white rounded-md flex items-center justify-center text-white dark:text-black shadow-sm mr-3 transition-all duration-200">
        {{> brand-mark}}
      </div>
      <div class="sidebar-text flex flex-col min-w-0 transition-opacity duration-200">
        <span class="text-sm font-semibold text-gray-900 dark:text-gray-100 truncate">{{#if appName}}{{appName}}{{else}}VitalMatch{{/if}}</span>
        <span class="text-xs text-gray-500 dark:text-gray-400 truncate text-left">Coordination workspace</span>
      </div>
    </div>
    <!-- Close Button for Mobile -->
    <button type="button" data-sidebar-close aria-label="Close navigation"
      class="vm-icon-button vm-sidebar-close flex items-center justify-center w-8 h-8 rounded-md text-gray-500 hover:text-gray-900 hover:bg-gray-100 dark:hover:text-gray-100 dark:hover:bg-gray-800 transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Sidebar Content (Scrollable) -->
  <div class="flex-1 overflow-y-auto py-4 px-3 custom-scrollbar">

    <div class="sidebar-text px-2 mb-2">
      <span class="text-xs font-medium text-gray-500 dark:text-gray-400 tracking-wider">Coordination</span>
    </div>

    <nav class="space-y-1">
      <!-- Dashboard -->
      <a href="/admin/dashboard"
        class="flex items-center px-2 py-2 rounded-md {{#if isDashboard}}bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-gray-100 font-medium{{else}}text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-gray-100{{/if}} transition-colors group"
        title="Dashboard">
        <div class="sidebar-icon-container flex items-center justify-center w-5 h-5 mr-3 transition-all duration-200">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
        </div>
        <span class="sidebar-text text-sm flex-1">Dashboard</span>
      </a>

      <!-- Requests -->
      <a href="/admin/requests"
        class="flex items-center px-2 py-2 rounded-md {{#if isRequests}}bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-gray-100 font-medium{{else}}text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-gray-100{{/if}} transition-colors group"
        title="Requests">
        <div class="sidebar-icon-container flex items-center justify-center w-5 h-5 mr-3 transition-all duration-200">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
        </div>
        <span class="sidebar-text text-sm flex-1">Requests</span>
        <svg class="sidebar-text w-4 h-4 text-gray-400 opacity-0 group-hover:opacity-100 transition-opacity" fill="none"
          stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>

      <!-- Appointments -->
      <a href="/admin/appointments"
        class="flex items-center px-2 py-2 rounded-md {{#if isAppointments}}bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-gray-100 font-medium{{else}}text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-gray-100{{/if}} transition-colors group"
        title="Appointments">
        <div class="sidebar-icon-container flex items-center justify-center w-5 h-5 mr-3 transition-all duration-200">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <span class="sidebar-text text-sm flex-1">Appointments</span>
      </a>

      <!-- Donors -->
      <a href="/admin/donors"
        class="flex items-center px-2 py-2 rounded-md {{#if isDonors}}bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-gray-100 font-medium{{else}}text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-gray-100{{/if}} transition-colors group"
        title="Donors">
        <div class="sidebar-icon-container flex items-center justify-center w-5 h-5 mr-3 transition-all duration-200">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
        <span class="sidebar-text text-sm flex-1">Donors</span>
        <svg class="sidebar-text w-4 h-4 text-gray-400 opacity-0 group-hover:opacity-100 transition-opacity" fill="none"
          stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>

      <!-- Donation Calls -->
      <a href="/admin/calls"
        class="flex items-center px-2 py-2 rounded-md {{#if isCalls}}bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-gray-100 font-medium{{else}}text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-gray-100{{/if}} transition-colors group"
        title="Donation Calls">
        <div class="sidebar-icon-container flex items-center justify-center w-5 h-5 mr-3 transition-all duration-200">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <span class="sidebar-text text-sm flex-1">Donation Calls</span>
      </a>

      <!-- Hospitals -->
      <a href="/admin/hospitals"
        class="flex items-center px-2 py-2 rounded-md {{#if isHospitals}}bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-gray-100 font-medium{{else}}text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-gray-100{{/if}} transition-colors group"
        title="Hospitals">
        <div class="sidebar-icon-container flex items-center justify-center w-5 h-5 mr-3 transition-all duration-200">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </div>
        <span class="sidebar-text text-sm flex-1">Hospitals</span>
      </a>

      <!-- Blood Map -->
      <a href="/map"
        class="flex items-center px-2 py-2 rounded-md text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-gray-100 transition-colors group"
        title="Blood Map">
        <div class="sidebar-icon-container flex items-center justify-center w-5 h-5 mr-3 transition-all duration-200">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
          </svg>
        </div>
        <span class="sidebar-text text-sm flex-1">Blood Map</span>
      </a>

      <!-- Reports -->
      <a href="/admin/reports"
        class="flex items-center px-2 py-2 rounded-md {{#if isReports}}bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-gray-100 font-medium{{else}}text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-gray-100{{/if}} transition-colors group"
        title="Reports">
        <div class="sidebar-icon-container flex items-center justify-center w-5 h-5 mr-3 transition-all duration-200">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
        </div>
        <span class="sidebar-text text-sm flex-1">Reports</span>
      </a>

      <!-- Public CMS (Admin) -->
      <a href="/admin/cms"
        class="flex items-center px-2 py-2 rounded-md {{#if isCMS}}bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-gray-100 font-medium{{else}}text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-gray-100{{/if}} transition-colors group"
        title="Public CMS">
        <div class="sidebar-icon-container flex items-center justify-center w-5 h-5 mr-3 transition-all duration-200">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7h18M3 12h18M3 17h18" />
          </svg>
        </div>
        <span class="sidebar-text text-sm flex-1">Public CMS</span>
      </a>

      <div class="pt-4 pb-2">
        <div class="h-px bg-gray-200 dark:bg-gray-800"></div>
      </div>

      <!-- Messages -->
      <a href="/messages"
        class="flex items-center px-2 py-2 rounded-md {{#if isMessages}}bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-gray-100 font-medium{{else}}text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-gray-100{{/if}} transition-colors group"
        title="Messages">
        <div
          class="sidebar-icon-container flex items-center justify-center w-5 h-5 mr-3 transition-all duration-200 relative">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
        </div>
        <span class="sidebar-text text-sm flex-1">Messages</span>
        <span id="adminMsgBadge"
          class="sidebar-text inline-flex items-center justify-center px-2 py-0.5 ml-3 text-xs font-medium text-white bg-gray-900 dark:bg-gray-100 dark:text-gray-900 rounded-md"{{#unless navUnreadMsgs}} style="display:none;"{{/unless}}>{{navUnreadMsgs}}</span>
      </a>

      <p class="vm-sidebar__group">Administration</p>
      <a href="/admin/feedback"
        class="flex items-center px-2 py-2 rounded-md {{#if isFeedback}}bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-gray-100 font-medium{{else}}text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-gray-100{{/if}} transition-colors group"
        title="System feedback">
        <div class="sidebar-icon-container flex items-center justify-center w-5 h-5 mr-3 transition-all duration-200">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h8m-8 4h5m-9 6 1.5-4.5A8 8 0 1118 18H6z" /></svg>
        </div>
        <span class="sidebar-text text-sm flex-1">System feedback</span>
      </a>
      <!-- Users -->
      <a href="/admin/users"
        class="flex items-center px-2 py-2 rounded-md {{#if isUsers}}bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-gray-100 font-medium{{else}}text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-gray-100{{/if}} transition-colors group"
        title="Users">
        <div class="sidebar-icon-container flex items-center justify-center w-5 h-5 mr-3 transition-all duration-200">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </div>
        <span class="sidebar-text text-sm flex-1">Users</span>
      </a>

      <!-- Settings -->
      <a href="/admin/settings"
        class="flex items-center px-2 py-2 rounded-md {{#if isSettings}}bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-gray-100 font-medium{{else}}text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-gray-100{{/if}} transition-colors group"
        title="Settings">
        <div class="sidebar-icon-container flex items-center justify-center w-5 h-5 mr-3 transition-all duration-200">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <span class="sidebar-text text-sm flex-1">Settings</span>
        <svg class="sidebar-text w-4 h-4 text-gray-400 opacity-0 group-hover:opacity-100 transition-opacity" fill="none"
          stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>

    </nav>
  </div>

  <!-- Sidebar Footer (User Profile) -->
  <div class="p-3 border-t border-gray-200 dark:border-gray-800 flex-shrink-0">
    <div class="flex items-center px-2 py-2">
      <div
        class="sidebar-icon-container flex-shrink-0 w-8 h-8 rounded-md bg-gray-100 dark:bg-gray-800 flex items-center justify-center text-gray-700 dark:text-gray-200 font-semibold text-xs mr-3 transition-all duration-200">
        A
      </div>
      <div class="sidebar-text flex flex-col min-w-0 flex-1 transition-opacity duration-200">
        <span class="text-sm font-semibold text-gray-900 dark:text-gray-100 truncate">Admin</span>
        <span class="text-xs text-gray-500 dark:text-gray-400 truncate">admin@vitalmatch.com</span>
      </div>
    </div>
  </div>
</aside>
