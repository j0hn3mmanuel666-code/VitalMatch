        class="flex items-center px-2 py-2 rounded-md {{#if isUsers}}bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-gray-100 font-medium{{else}}text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-gray-100{{/if}} transition-colors group"
        title="Users">
