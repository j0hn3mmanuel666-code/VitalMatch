<!-- Shared public top bar for login / register / public pages -->
<nav class="bg-white/95 backdrop-blur shadow-md sticky top-0 z-50">
  <div class="container mx-auto px-4 py-3 flex items-center justify-between">
    <div class="flex items-center space-x-3">
      <button onclick="if (history.length > 1) { history.back(); } else { window.location.href = '/'; }"
        class="text-gray-600 hover:text-gray-800 hover:bg-gray-100 p-2 rounded-lg transition-colors" aria-label="Go back">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
      </button>
      <a href="/" class="flex items-center space-x-2">
        <svg class="w-8 h-8 text-red-600" fill="currentColor" viewBox="0 0 24 24">
          <path
            d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.94-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" />
        </svg>
        <span class="text-2xl font-bold text-gray-800">VitalMatch</span>
      </a>
    </div>
    <div class="hidden sm:flex items-center space-x-6 text-sm font-semibold">
      <a href="/" class="text-gray-600 hover:text-red-600 transition-colors">Home</a>
      <a href="/about" class="text-gray-600 hover:text-red-600 transition-colors">About</a>
      <a href="/contact" class="text-gray-600 hover:text-red-600 transition-colors">Contact</a>
    </div>
    <div class="flex items-center space-x-2">
      {{#unless hideLogin}}
      <a href="/login" class="text-red-600 hover:text-red-700 font-semibold px-4 py-2 rounded-lg hover:bg-red-50 transition-colors">Login</a>
      {{/unless}}
      {{#unless hideRegister}}
      <a href="/register" class="bg-red-600 text-white px-4 py-2 rounded-lg font-semibold hover:bg-red-700 transition-colors">Register</a>
      {{/unless}}
    </div>
  </div>
</nav>
