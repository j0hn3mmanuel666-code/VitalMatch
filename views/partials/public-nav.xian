<header class="journey-header" data-public-header>
  <div class="journey-context"><div class="journey-container"><span>Philippine Red Cross  <span aria-hidden="true">&middot;</span> Mindoro Chapter</span><span class="journey-context__location">Serving Oriental Mindoro</span></div></div>
  <nav class="journey-nav" aria-label="Main navigation">
    <div class="journey-container journey-nav__inner">
      <a href="/" class="journey-nav__brand" aria-label="VitalMatch home">
        <svg aria-hidden="true" viewBox="0 0 32 40" fill="currentColor"><path d="M16 1C12 7 2 18 2 25a14 14 0 0 0 28 0C30 18 20 7 16 1Z"/><path d="M9 26a7 7 0 0 0 7 7" fill="none" stroke="white" stroke-width="2" stroke-linecap="round"/></svg>
        <span>VitalMatch<small>Blood donation coordination</small></span>
      </a>
      <button type="button" class="journey-nav__toggle" data-nav-toggle aria-controls="public-nav-panel" aria-expanded="false"><span data-menu-label>Menu</span><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
      <div class="journey-nav__panel" id="public-nav-panel">
        <div class="journey-nav__links"><a href="/" data-public-link>Home</a><a href="/about" data-public-link>About</a><a href="/#how-it-works">How it works</a><a href="/contact" data-public-link>Contact</a></div>
        <div class="journey-nav__actions">
          {{#if user}}<a href="{{#if isAdmin}}/admin/dashboard{{else}}/dashboard{{/if}}" class="journey-button journey-button--secondary">My account</a>{{else}}
          {{#unless hideLogin}}<a href="/login" class="journey-nav__quiet" data-public-link>Sign in</a>{{/unless}}
          {{#unless hideRegister}}<a href="/register" class="journey-button" data-public-link>Become a donor</a>{{/unless}}
          {{/if}}
        </div>
      </div>
    </div>
  </nav>
</header>
