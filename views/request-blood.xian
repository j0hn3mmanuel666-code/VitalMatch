{{> head}}

<!-- Navigation Bar -->
<nav class="bg-white shadow-md">
  <div class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <!-- Back Button & Logo/Brand -->
      <div class="flex items-center space-x-1 sm:space-x-3">
        <a href="javascript:history.length > 1 ? history.back() : window.location.href='/dashboard'"
          class="p-1 sm:p-2 -ml-2 text-gray-600 hover:text-red-600 hover:bg-gray-100 rounded-lg transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </a>
        <div class="flex items-center space-x-1 sm:space-x-2">
          <svg class="w-6 h-6 sm:w-8 sm:h-8 text-red-600" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.94-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" />
          </svg>
          <a href="/dashboard" class="text-xl sm:text-2xl font-bold text-gray-800">VitalMatch</a>
        </div>
      </div>

      <!-- User Menu -->
      <div class="flex items-center space-x-4">
        <a href="/dashboard" class="text-gray-700 hover:text-red-600 transition">Dashboard</a>
        <a href="/logout" class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition">Logout</a>
      </div>
    </div>
  </div>
</nav>

<!-- Request Blood Form -->
<div class="min-h-screen bg-gray-50 py-12">
  <div class="container mx-auto px-4">
    <div class="max-w-3xl mx-auto">

      <!-- Header -->
      <div class="bg-gradient-to-r from-red-600 to-blue-600 rounded-xl shadow-lg p-8 mb-8 text-white">
        <h1 class="text-3xl font-bold mb-2">Request Blood</h1>
        <p class="text-white/90">Submit an urgent blood request for your hospital or patient</p>
      </div>

      <!-- Flash Messages -->
      {{#if success_msg}}
      <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">
        {{success_msg}}
      </div>
      {{/if}}

      {{#if error_msg}}
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
        {{error_msg}}
      </div>
      {{/if}}

      <!-- Form Card with Enhanced Interactions -->
      <div class="bg-white rounded-xl shadow-md p-8 relative">
        <!-- Loading Overlay -->
        <div id="loadingOverlay"
          class="hidden absolute inset-0 bg-white bg-opacity-90 flex items-center justify-center z-50 rounded-xl">
          <div class="text-center">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-red-600 mx-auto mb-4"></div>
            <p class="text-gray-600 font-semibold">Submitting your request...</p>
            <p class="text-gray-500 text-sm">Please wait while we process your blood request</p>
          </div>
        </div>

        <form id="bloodRequestForm" action="/new-blood-request" method="POST" novalidate>

          <!-- Progress Indicator -->
          <div class="mb-8">
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm font-semibold text-gray-600">Form Progress</span>
              <span id="progressText" class="text-sm text-gray-500">0% Complete</span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2">
              <div id="progressBar"
                class="bg-gradient-to-r from-red-500 to-blue-500 h-2 rounded-full transition-all duration-300"
                style="width: 0%"></div>
            </div>
          </div>

          <!-- Patient Information Section -->
          <div class="mb-8">
            <h2 class="text-2xl font-bold text-gray-800 mb-4 flex items-center">
              <svg class="w-6 h-6 text-red-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              Patient Information
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="form-group">
                <label class="block text-gray-700 font-semibold mb-2">
                  Patient Name *
                  <span class="tooltip-trigger ml-1 cursor-help"
                    data-tooltip="Enter the full name of the patient who needs blood">
                    <svg class="w-4 h-4 inline text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </span>
                </label>
                <input type="text" name="patientName" id="patientName" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200"
                  placeholder="Enter patient name" data-validate="required,minLength:2">
                <div class="error-message hidden text-red-600 text-sm mt-1"></div>
                <div class="success-message hidden text-green-600 text-sm mt-1">
                  <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd" />
                  </svg>
                  Valid name entered
                </div>
              </div>

              <div class="form-group">
                <label class="block text-gray-700 font-semibold mb-2">
                  Patient Age *
                  <span class="tooltip-trigger ml-1 cursor-help" data-tooltip="Age must be between 0 and 120 years">
                    <svg class="w-4 h-4 inline text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </span>
                </label>
                <input type="number" name="patientAge" id="patientAge" required min="0" max="120"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200"
                  placeholder="Enter age" data-validate="required,min:0,max:120">
                <div class="error-message hidden text-red-600 text-sm mt-1"></div>
                <div class="success-message hidden text-green-600 text-sm mt-1">
                  <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd" />
                  </svg>
                  Valid age entered
                </div>
              </div>

              <div class="form-group">
                <label class="block text-gray-700 font-semibold mb-2">
                  Blood Type Required *
                  <span class="tooltip-trigger ml-1 cursor-help"
                    data-tooltip="Select the specific blood type needed for the patient">
                    <svg class="w-4 h-4 inline text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </span>
                </label>
                <select name="bloodType" id="bloodType" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200"
                  data-validate="required">
                  <option value="">Select blood type</option>
                  <option value="A+">A+ (A Positive)</option>
                  <option value="A-">A- (A Negative)</option>
                  <option value="B+">B+ (B Positive)</option>
                  <option value="B-">B- (B Negative)</option>
                  <option value="AB+">AB+ (AB Positive)</option>
                  <option value="AB-">AB- (AB Negative)</option>
                  <option value="O+">O+ (O Positive)</option>
                  <option value="O-">O- (O Negative - Universal Donor)</option>
                </select>
                <div class="error-message hidden text-red-600 text-sm mt-1"></div>
                <div class="success-message hidden text-green-600 text-sm mt-1">
                  <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd" />
                  </svg>
                  Blood type selected
                </div>
              </div>

              <div class="form-group">
                <label class="block text-gray-700 font-semibold mb-2">
                  Units Required *
                  <span class="tooltip-trigger ml-1 cursor-help"
                    data-tooltip="Number of blood units needed (typically 1-4 units per patient)">
                    <svg class="w-4 h-4 inline text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </span>
                </label>
                <input type="number" name="unitsRequired" id="unitsRequired" required min="1" max="20"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200"
                  placeholder="Number of units" data-validate="required,min:1,max:20">
                <div class="error-message hidden text-red-600 text-sm mt-1"></div>
                <div class="success-message hidden text-green-600 text-sm mt-1">
                  <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd" />
                  </svg>
                  Valid units entered
                </div>
              </div>
            </div>
          </div>

          <!-- Blood Component and Transfusion Information Section -->
          <div class="mb-8">
            <h2 class="text-2xl font-bold text-gray-800 mb-4 flex items-center">
              <svg class="w-6 h-6 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              Blood Component & Transfusion Details
            </h2>

            <div class="grid grid-cols-1 gap-6">
              <!-- Indication of Transfusion -->
              <div class="form-group">
                <label class="block text-gray-700 font-semibold mb-2">
                  Indication of Transfusion *
                  <span class="tooltip-trigger ml-1 cursor-help"
                    data-tooltip="Medical reason or indication for the blood transfusion">
                    <svg class="w-4 h-4 inline text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </span>
                </label>
                <textarea name="indicationOfTransfusion" id="indicationOfTransfusion" required rows="3"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200"
                  placeholder="Enter the medical indication for transfusion (e.g., Acute blood loss, Anemia, Surgery preparation, etc.)"
                  data-validate="required,minLength:10"></textarea>
                <div class="error-message hidden text-red-600 text-sm mt-1"></div>
                <div class="success-message hidden text-green-600 text-sm mt-1">
                  <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd" />
                  </svg>
                  Valid indication entered
                </div>
              </div>

              <!-- Blood Components Section -->
              <div class="form-group">
                <label class="block text-gray-700 font-semibold mb-3">
                  Blood Component Required *
                  <span class="tooltip-trigger ml-1 cursor-help"
                    data-tooltip="Select the specific blood components needed and specify the units/volume for each">
                    <svg class="w-4 h-4 inline text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </span>
                </label>

                <div class="bg-gray-50 rounded-lg p-4">
                  <p class="text-sm text-gray-600 mb-3">Select the blood components needed and specify the units/volume
                    for each:</p>

                  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                    <!-- Whole Blood -->
                    <div class="flex flex-col space-y-2 p-3 bg-white rounded-lg border">
                      <div class="flex items-center">
                        <input type="checkbox" id="wholeBlood" name="bloodComponents[]" value="wholeBlood"
                          class="w-4 h-4 text-red-600 bg-gray-100 border-gray-300 rounded focus:ring-red-500 focus:ring-2">
                        <label for="wholeBlood" class="ml-2 text-sm font-medium text-gray-700">Whole blood</label>
                      </div>
                      <input type="text" name="wholeBloodVolume" id="wholeBloodVolume" placeholder="Units/Volume"
                        class="w-full px-3 py-2 text-sm border border-gray-300 rounded focus:ring-2 focus:ring-red-500 focus:border-transparent"
                        disabled>
                    </div>

                    <!-- Packed RBC -->
                    <div class="flex flex-col space-y-2 p-3 bg-white rounded-lg border">
                      <div class="flex items-center">
                        <input type="checkbox" id="packedRBC" name="bloodComponents[]" value="packedRBC"
                          class="w-4 h-4 text-red-600 bg-gray-100 border-gray-300 rounded focus:ring-red-500 focus:ring-2">
                        <label for="packedRBC" class="ml-2 text-sm font-medium text-gray-700">Packed RBC</label>
                      </div>
                      <input type="text" name="packedRBCVolume" id="packedRBCVolume" placeholder="Units/Volume"
                        class="w-full px-3 py-2 text-sm border border-gray-300 rounded focus:ring-2 focus:ring-red-500 focus:border-transparent"
                        disabled>
                    </div>

                    <!-- Platelet Concentrate -->
                    <div class="flex flex-col space-y-2 p-3 bg-white rounded-lg border">
                      <div class="flex items-center">
                        <input type="checkbox" id="plateletConcentrate" name="bloodComponents[]"
                          value="plateletConcentrate"
                          class="w-4 h-4 text-red-600 bg-gray-100 border-gray-300 rounded focus:ring-red-500 focus:ring-2">
                        <label for="plateletConcentrate" class="ml-2 text-sm font-medium text-gray-700">Platelet
                          concentrate</label>
                      </div>
                      <input type="text" name="plateletConcentrateVolume" id="plateletConcentrateVolume"
                        placeholder="Units/Volume"
                        class="w-full px-3 py-2 text-sm border border-gray-300 rounded focus:ring-2 focus:ring-red-500 focus:border-transparent"
                        disabled>
                    </div>

                    <!-- Fresh Frozen Plasma -->
                    <div class="flex flex-col space-y-2 p-3 bg-white rounded-lg border">
                      <div class="flex items-center">
                        <input type="checkbox" id="freshFrozenPlasma" name="bloodComponents[]" value="freshFrozenPlasma"
                          class="w-4 h-4 text-red-600 bg-gray-100 border-gray-300 rounded focus:ring-red-500 focus:ring-2">
                        <label for="freshFrozenPlasma" class="ml-2 text-sm font-medium text-gray-700">Fresh Frozen
                          Plasma</label>
                      </div>
                      <input type="text" name="freshFrozenPlasmaVolume" id="freshFrozenPlasmaVolume"
                        placeholder="Units/Volume"
                        class="w-full px-3 py-2 text-sm border border-gray-300 rounded focus:ring-2 focus:ring-red-500 focus:border-transparent"
                        disabled>
                    </div>

                    <!-- Cryoprecipitate -->
                    <div class="flex flex-col space-y-2 p-3 bg-white rounded-lg border">
                      <div class="flex items-center">
                        <input type="checkbox" id="cryoprecipitate" name="bloodComponents[]" value="cryoprecipitate"
                          class="w-4 h-4 text-red-600 bg-gray-100 border-gray-300 rounded focus:ring-red-500 focus:ring-2">
                        <label for="cryoprecipitate"
                          class="ml-2 text-sm font-medium text-gray-700">Cryoprecipitate</label>
                      </div>
                      <input type="text" name="cryoprecipitateVolume" id="cryoprecipitateVolume"
                        placeholder="Units/Volume"
                        class="w-full px-3 py-2 text-sm border border-gray-300 rounded focus:ring-2 focus:ring-red-500 focus:border-transparent"
                        disabled>
                    </div>

                    <!-- Platelet Apheresis -->
                    <div class="flex flex-col space-y-2 p-3 bg-white rounded-lg border">
                      <div class="flex items-center">
                        <input type="checkbox" id="plateletApheresis" name="bloodComponents[]" value="plateletApheresis"
                          class="w-4 h-4 text-red-600 bg-gray-100 border-gray-300 rounded focus:ring-red-500 focus:ring-2">
                        <label for="plateletApheresis" class="ml-2 text-sm font-medium text-gray-700">Platelet
                          Apheresis</label>
                      </div>
                      <input type="text" name="plateletApheresisVolume" id="plateletApheresisVolume"
                        placeholder="Units/Volume"
                        class="w-full px-3 py-2 text-sm border border-gray-300 rounded focus:ring-2 focus:ring-red-500 focus:border-transparent"
                        disabled>
                    </div>
                  </div>
                </div>

                <div class="error-message hidden text-red-600 text-sm mt-1"></div>
                <div class="success-message hidden text-green-600 text-sm mt-1">
                  <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd" />
                  </svg>
                  Blood components selected
                </div>
              </div>
            </div>
          </div>

          <!-- Hospital Information Section -->
          <div class="mb-8">
            <h2 class="text-2xl font-bold text-gray-800 mb-4 flex items-center">
              <svg class="w-6 h-6 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
              Hospital Information
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-gray-700 font-semibold mb-2">Hospital Name *</label>
                <input type="text" name="hospitalName" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent"
                  placeholder="Enter hospital name">
              </div>

              <div>
                <label class="block text-gray-700 font-semibold mb-2">Hospital Address *</label>
                <input type="text" name="hospitalAddress" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent"
                  placeholder="Enter complete address">
              </div>

              <div>
                <label class="block text-gray-700 font-semibold mb-2">City *</label>
                <input type="text" name="city" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent"
                  placeholder="Enter city">
              </div>

              <div>
                <label class="block text-gray-700 font-semibold mb-2">Province *</label>
                <input type="text" name="province" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent"
                  placeholder="Enter province">
              </div>
            </div>
            <input type="hidden" name="latitude" id="requestLatitude">
            <input type="hidden" name="longitude" id="requestLongitude">
          </div>

          <!-- Contact Information Section -->
          <div class="mb-8">
            <h2 class="text-2xl font-bold text-gray-800 mb-4 flex items-center">
              <svg class="w-6 h-6 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              Contact Information
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              <div>
                <label class="block text-gray-700 font-semibold mb-2">Contact Person *</label>
                <input type="text" name="contactPerson" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent"
                  placeholder="Enter contact person name">
              </div>

              <div>
                <label class="block text-gray-700 font-semibold mb-2">Contact Number *</label>
                <input type="tel" name="contactNumber" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent"
                  placeholder="09XX-XXX-XXXX">
              </div>

              <div>
                <label class="block text-gray-700 font-semibold mb-2">Email Address *</label>
                <input type="email" name="email" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent"
                  placeholder="email@example.com">
              </div>
            </div>
          </div>

          <!-- Urgency and Additional Information -->
          <div class="mb-8">
            <h2 class="text-2xl font-bold text-gray-800 mb-4 flex items-center">
              <svg class="w-6 h-6 text-orange-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Additional Details
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-gray-700 font-semibold mb-2">Urgency Level *</label>
                <select name="urgency" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent">
                  <option value="">Select urgency level</option>
                  <option value="critical">Critical - Immediate</option>
                  <option value="urgent">Urgent - Within 24 hours</option>
                  <option value="moderate">Moderate - Within 2-3 days</option>
                </select>
              </div>

              <div>
                <label class="block text-gray-700 font-semibold mb-2">Required By Date *</label>
                <input type="date" name="requiredByDate" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent">
              </div>

              <div class="md:col-span-2">
                <label class="block text-gray-700 font-semibold mb-2">Additional Notes</label>
                <textarea name="notes" rows="2"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent"
                  placeholder="Any additional information about the patient's condition or special requirements..."></textarea>
              </div>
            </div>
          </div>

          <!-- Enhanced Submit Button with Loading State -->
          <div class="flex justify-end space-x-4">
            <a href="/dashboard"
              class="px-6 py-3 border border-gray-300 rounded-lg text-gray-700 font-semibold hover:bg-gray-50 transition-all duration-200 transform hover:scale-105">
              Cancel
            </a>
            <button type="submit" id="submitBtn"
              class="px-8 py-3 bg-red-600 text-white rounded-lg font-semibold hover:bg-red-700 transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-1">
              <span id="submitText">Submit Blood Request</span>
              <span id="submitLoader" class="hidden">
                <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white inline" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor"
                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z">
                  </path>
                </svg>
                Submitting...
              </span>
            </button>
          </div>

        </form>
      </div>

      <!-- Help Text -->
      <div class="mt-6 bg-blue-50 border border-blue-200 rounded-lg p-4">
        <div class="flex items-start">
          <svg class="w-6 h-6 text-blue-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor"
            viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div>
            <p class="text-blue-800 font-semibold mb-1">Important Information</p>
            <p class="text-blue-700 text-sm">Once submitted, your blood request will be processed by our matching
              algorithm. Qualified donors in your area will be notified immediately. You will receive updates via email
              and SMS.</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

{{> footer}}

<script>
  if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(position => {
      document.getElementById('requestLatitude').value = position.coords.latitude;
      document.getElementById('requestLongitude').value = position.coords.longitude;
    }, () => {});
  }
</script>

<!-- Tooltip Container -->
<div id="tooltip"
  class="absolute z-50 px-3 py-2 text-sm text-white bg-gray-900 rounded-lg shadow-lg opacity-0 pointer-events-none transition-opacity duration-200">
  <div id="tooltipText"></div>
  <div class="tooltip-arrow absolute w-2 h-2 bg-gray-900 transform rotate-45"></div>
</div>

<!-- Success Modal -->
<div id="successModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center p-4">
  <div class="bg-white rounded-xl shadow-2xl max-w-md w-full p-6 transform scale-95 transition-transform duration-300">
    <div class="text-center">
      <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-green-100 mb-4">
        <svg class="h-8 w-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-gray-900 mb-2">Request Submitted Successfully!</h3>
      <p class="text-gray-600 mb-6">Your blood request has been submitted and is being processed. You will receive
        notifications when donors respond.</p>
      <button onclick="closeSuccessModal()"
        class="w-full bg-green-600 text-white px-4 py-2 rounded-lg font-semibold hover:bg-green-700 transition">
        Continue to Dashboard
      </button>
    </div>
  </div>
</div>

<script>
  // Enhanced Form Validation and Interactions
  class BloodRequestForm {
    constructor() {
      this.form = document.getElementById('bloodRequestForm');
      this.submitBtn = document.getElementById('submitBtn');
      this.progressBar = document.getElementById('progressBar');
      this.progressText = document.getElementById('progressText');
      this.loadingOverlay = document.getElementById('loadingOverlay');

      this.totalFields = this.form.querySelectorAll('[data-validate]').length;
      this.validFields = 0;

      this.init();
    }

    init() {
      this.setupEventListeners();
      this.setupTooltips();
      this.setupBloodComponentHandlers();
      this.updateProgress();
    }

    setupEventListeners() {
      // Real-time validation
      this.form.querySelectorAll('[data-validate]').forEach(field => {
        field.addEventListener('input', (e) => this.validateField(e.target));
        field.addEventListener('blur', (e) => this.validateField(e.target));
        field.addEventListener('focus', (e) => this.clearFieldErrors(e.target));
      });

      // Form submission
      this.form.addEventListener('submit', (e) => this.handleSubmit(e));

      // Auto-save draft functionality has been completely disabled per user request
      // this.form.addEventListener('input', () => this.saveDraft());
    }

    setupTooltips() {
      const tooltip = document.getElementById('tooltip');
      const tooltipText = document.getElementById('tooltipText');

      document.querySelectorAll('.tooltip-trigger').forEach(trigger => {
        trigger.addEventListener('mouseenter', (e) => {
          const text = e.target.closest('.tooltip-trigger').dataset.tooltip;
          tooltipText.textContent = text;

          const rect = e.target.getBoundingClientRect();
          tooltip.style.left = rect.left + (rect.width / 2) - (tooltip.offsetWidth / 2) + 'px';
          tooltip.style.top = rect.top - tooltip.offsetHeight - 10 + 'px';

          tooltip.classList.remove('opacity-0');
          tooltip.classList.add('opacity-100');
        });

        trigger.addEventListener('mouseleave', () => {
          tooltip.classList.remove('opacity-100');
          tooltip.classList.add('opacity-0');
        });
      });
    }

    setupBloodComponentHandlers() {
      // Handle blood component checkboxes
      const bloodComponents = [
        'wholeBlood',
        'packedRBC',
        'plateletConcentrate',
        'freshFrozenPlasma',
        'cryoprecipitate',
        'plateletApheresis'
      ];

      bloodComponents.forEach(component => {
        const checkbox = document.getElementById(component);
        const volumeInput = document.getElementById(component + 'Volume');

        if (checkbox && volumeInput) {
          checkbox.addEventListener('change', (e) => {
            if (e.target.checked) {
              volumeInput.disabled = false;
              volumeInput.focus();
              volumeInput.classList.remove('bg-gray-100');
              volumeInput.classList.add('bg-white');
            } else {
              volumeInput.disabled = true;
              volumeInput.value = '';
              volumeInput.classList.remove('bg-white');
              volumeInput.classList.add('bg-gray-100');
            }
            this.validateBloodComponents();
          });

          // Validate volume input when typing
          volumeInput.addEventListener('input', () => {
            this.validateBloodComponents();
          });
        }
      });
    }

    validateBloodComponents() {
      const checkboxes = document.querySelectorAll('input[name="bloodComponents[]"]');
      const checkedBoxes = Array.from(checkboxes).filter(cb => cb.checked);
      const bloodComponentGroup = document.querySelector('.form-group:has(input[name="bloodComponents[]"])');
      const errorDiv = bloodComponentGroup?.querySelector('.error-message');
      const successDiv = bloodComponentGroup?.querySelector('.success-message');

      let isValid = true;
      let errorMessage = '';

      // Check if at least one component is selected
      if (checkedBoxes.length === 0) {
        isValid = false;
        errorMessage = 'Please select at least one blood component';
      } else {
        // Check if all selected components have volume specified
        for (const checkbox of checkedBoxes) {
          const componentName = checkbox.value;
          const volumeInput = document.getElementById(componentName + 'Volume');
          if (!volumeInput.value.trim()) {
            isValid = false;
            errorMessage = 'Please specify units/volume for all selected components';
            break;
          }
        }
      }

      // Update UI
      if (errorDiv && successDiv) {
        if (isValid && checkedBoxes.length > 0) {
          errorDiv.classList.add('hidden');
          successDiv.classList.remove('hidden');
        } else if (!isValid) {
          errorDiv.textContent = errorMessage;
          errorDiv.classList.remove('hidden');
          successDiv.classList.add('hidden');
        } else {
          errorDiv.classList.add('hidden');
          successDiv.classList.add('hidden');
        }
      }

      return isValid;
    }

    validateField(field) {
      const rules = field.dataset.validate.split(',');
      const value = field.value.trim();
      let isValid = true;
      let errorMessage = '';

      // Clear previous states
      this.clearFieldErrors(field);

      for (const rule of rules) {
        const [ruleName, ruleValue] = rule.split(':');

        switch (ruleName) {
          case 'required':
            if (!value) {
              isValid = false;
              errorMessage = 'This field is required';
            }
            break;

          case 'minLength':
            if (value && value.length < parseInt(ruleValue)) {
              isValid = false;
              errorMessage = `Minimum ${ruleValue} characters required`;
            }
            break;

          case 'min':
            if (value && parseInt(value) < parseInt(ruleValue)) {
              isValid = false;
              errorMessage = `Minimum value is ${ruleValue}`;
            }
            break;

          case 'max':
            if (value && parseInt(value) > parseInt(ruleValue)) {
              isValid = false;
              errorMessage = `Maximum value is ${ruleValue}`;
            }
            break;

          case 'email':
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (value && !emailRegex.test(value)) {
              isValid = false;
              errorMessage = 'Please enter a valid email address';
            }
            break;

          case 'phone':
            const phoneRegex = /^09\d{9}$/;
            if (value && !phoneRegex.test(value.replace(/[-\s]/g, ''))) {
              isValid = false;
              errorMessage = 'Please enter a valid Philippine mobile number';
            }
            break;
        }

        if (!isValid) break;
      }

      // Update field appearance
      if (isValid && value) {
        this.showFieldSuccess(field);
      } else if (!isValid) {
        this.showFieldError(field, errorMessage);
      }

      this.updateProgress();
      return isValid;
    }

    showFieldError(field, message) {
      field.classList.add('border-red-500', 'bg-red-50');
      field.classList.remove('border-green-500', 'bg-green-50');

      const errorDiv = field.parentNode.querySelector('.error-message');
      const successDiv = field.parentNode.querySelector('.success-message');

      if (errorDiv) {
        errorDiv.textContent = message;
        errorDiv.classList.remove('hidden');
      }

      if (successDiv) {
        successDiv.classList.add('hidden');
      }
    }

    showFieldSuccess(field) {
      field.classList.add('border-green-500', 'bg-green-50');
      field.classList.remove('border-red-500', 'bg-red-50');

      const errorDiv = field.parentNode.querySelector('.error-message');
      const successDiv = field.parentNode.querySelector('.success-message');

      if (errorDiv) {
        errorDiv.classList.add('hidden');
      }

      if (successDiv) {
        successDiv.classList.remove('hidden');
      }
    }

    clearFieldErrors(field) {
      field.classList.remove('border-red-500', 'bg-red-50', 'border-green-500', 'bg-green-50');

      const errorDiv = field.parentNode.querySelector('.error-message');
      const successDiv = field.parentNode.querySelector('.success-message');

      if (errorDiv) errorDiv.classList.add('hidden');
      if (successDiv) successDiv.classList.add('hidden');
    }

    updateProgress() {
      // Simplified - just enable the button
      this.submitBtn.disabled = false;
      this.submitBtn.classList.add('pulse-animation');
    }

    async handleSubmit(e) {
      // Don't prevent default - let the form submit normally
      // e.preventDefault();

      // Show loading state
      this.showLoading(true);
    }

    showLoading(show) {
      const submitText = document.getElementById('submitText');
      const submitLoader = document.getElementById('submitLoader');

      if (show) {
        this.loadingOverlay.classList.remove('hidden');
        submitText.classList.add('hidden');
        submitLoader.classList.remove('hidden');
        this.submitBtn.disabled = true;
      } else {
        this.loadingOverlay.classList.add('hidden');
        submitText.classList.remove('hidden');
        submitLoader.classList.add('hidden');
        this.submitBtn.disabled = false;
      }
    }

    async simulateSubmission() {
      // Simulate network delay
      return new Promise(resolve => setTimeout(resolve, 2000));
    }

    showSuccessModal() {
      const modal = document.getElementById('successModal');
      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.querySelector('.transform').classList.remove('scale-95');
        modal.querySelector('.transform').classList.add('scale-100');
      }, 10);
    }

    showNotification(message, type = 'info') {
      // Create notification element
      const notification = document.createElement('div');
      notification.className = `fixed top-4 right-4 z-50 p-4 rounded-lg shadow-lg transform translate-x-full transition-transform duration-300 ${type === 'error' ? 'bg-red-600 text-white' :
          type === 'success' ? 'bg-green-600 text-white' :
            'bg-blue-600 text-white'
        }`;
      notification.textContent = message;

      document.body.appendChild(notification);

      // Animate in
      setTimeout(() => {
        notification.classList.remove('translate-x-full');
      }, 10);

      // Remove after 5 seconds
      setTimeout(() => {
        notification.classList.add('translate-x-full');
        setTimeout(() => notification.remove(), 300);
      }, 5000);
    }

    saveDraft() {
      // Auto-save form data to localStorage
      const formData = new FormData(this.form);
      const data = Object.fromEntries(formData);
      localStorage.setItem('bloodRequestDraft', JSON.stringify(data));
    }

    loadDraft() {
      // Load saved draft
      const draft = localStorage.getItem('bloodRequestDraft');
      if (draft) {
        const data = JSON.parse(draft);
        Object.keys(data).forEach(key => {
          const field = this.form.querySelector(`[name="${key}"]`);
          if (field) {
            field.value = data[key];
            this.validateField(field);
          }
        });
      }
    }
  }

  // Success Modal Functions
  function closeSuccessModal() {
    const modal = document.getElementById('successModal');
    modal.classList.add('hidden');
    window.location.href = '/dashboard';
  }

  // Initialize form when DOM is loaded
  document.addEventListener('DOMContentLoaded', () => {
    const form = new BloodRequestForm();
    // Draft loading disabled to prevent automatic details from appearing
    // form.loadDraft(); 
  });

  // Add pulse animation CSS
  const style = document.createElement('style');
  style.textContent = `
  .pulse-animation {
    animation: pulse 2s infinite;
  }
  
  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }
  
  .tooltip-arrow {
    bottom: -4px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
  }
`;
  document.head.appendChild(style);
</script>