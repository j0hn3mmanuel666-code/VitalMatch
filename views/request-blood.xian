{{> head}}

{{> user-sidebar}}

<!-- Navigation Bar -->
{{> internal-header}}

<!-- Request Blood Form -->
<main id="main-content" tabindex="-1" class="vm-page min-h-screen bg-gray-50 py-12">
  <div class="vm-page-container container mx-auto px-4">
    <div class="max-w-3xl mx-auto">

      <!-- Header -->
      <div class="vm-page-heading mb-8">
        <h1 class="text-3xl font-bold mb-2">Request Blood</h1>
        <p class="text-white/90">Submit an urgent blood request for your hospital or patient</p>
      </div>

      <!-- Flash Messages -->
      {{#if success_msg}}
      <div class="vm-alert vm-alert--success bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">
        {{success_msg}}
      </div>
      {{/if}}

      {{#if error_msg}}
      <div class="vm-alert vm-alert--danger bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
        {{error_msg}}
      </div>
      {{/if}}

      <!-- Form Card with Enhanced Interactions -->
      <div class="vm-form-shell vm-panel bg-white rounded-md p-8 relative">
        <!-- Loading Overlay -->
        <div id="loadingOverlay"
          class="hidden absolute inset-0 bg-white bg-opacity-90 flex items-center justify-center z-50 rounded-md">
          <div class="text-center">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-red-600 mx-auto mb-4"></div>
            <p class="text-gray-600 font-semibold">Submitting your request...</p>
            <p class="text-gray-500 text-sm">Please wait while we process your blood request</p>
          </div>
        </div>

        <form id="bloodRequestForm" data-workspace-form action="{{#if formAction}}{{formAction}}{{else}}/new-blood-request{{/if}}" method="POST" novalidate>
          <input type="hidden" name="_csrf" value="{{csrfToken}}">
          <input type="hidden" name="submissionKey" value="{{formValues.submissionKey}}">
          {{#if editRequestId}}<input type="hidden" name="version" value="{{formValues.version}}"><p class="vm-alert vm-alert--info mb-4">Correcting request #{{editRequestId}}. Saving returns it for a new facility or coordinator review.</p>{{/if}}
          {{#if formValuesJson}}<script id="request-form-data" type="application/json">{{{formValuesJson}}}</script>{{/if}}

          <!-- Step Indicator -->
          <div class="mb-6">
            <div class="flex items-center justify-between mb-4">
              <span class="text-sm font-semibold text-gray-600">Step <span id="stepNumber">1</span> of 5</span>
              <span id="progressText" class="text-sm text-gray-500">Step 1 of 5</span>
            </div>
            <div class="flex items-center mb-4">
              <div class="step-pill flex-1 text-center text-xs font-semibold py-2 rounded-l-lg" data-step-pill="1">1. Patient</div>
              <div class="step-pill flex-1 text-center text-xs font-semibold py-2" data-step-pill="2">2. Components</div>
              <div class="step-pill flex-1 text-center text-xs font-semibold py-2" data-step-pill="3">3. Hospital</div>
              <div class="step-pill flex-1 text-center text-xs font-semibold py-2" data-step-pill="4">4. Contact</div>
              <div class="step-pill flex-1 text-center text-xs font-semibold py-2 rounded-r-lg" data-step-pill="5">5. Additional details</div>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2">
              <div id="progressBar"
                class="vm-surface-muted h-2 rounded-full transition-all duration-300"
                style="width: 0%"></div>
            </div>
          </div>

          <!-- Patient Information Section -->
          <div class="mb-8 form-step" data-step="1">
            <h2 class="text-2xl font-bold text-gray-800 mb-4 flex items-center">
              <svg class="w-6 h-6 text-red-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              Patient Information
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="form-group">
                <label class="block text-gray-700 font-semibold mb-2" for="patientName">
                  Patient Name *
                  <span class="tooltip-trigger ml-1 cursor-help"
                    data-tooltip="Enter the full name of the patient who needs blood">
                    <svg class="w-4 h-4 inline text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </span>
                </label>
                <input type="text" name="patientName" id="patientName" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200"
                  placeholder="Enter patient name" data-validate="required,minLength:2">
                <div class="error-message hidden text-red-600 text-sm mt-1"></div>
                <div class="success-message hidden text-green-600 text-sm mt-1">
                  <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd" />
                  </svg>
                  Valid name entered
                </div>
              </div>

              <div class="form-group">
                <label class="block text-gray-700 font-semibold mb-2" for="patientAge">
                  Patient Age *
                  <span class="tooltip-trigger ml-1 cursor-help" data-tooltip="Age must be between 0 and 120 years">
                    <svg class="w-4 h-4 inline text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </span>
                </label>
                <input type="number" name="patientAge" id="patientAge" required min="0" max="120"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200"
                  placeholder="Enter age" data-validate="required,min:0,max:120">
                <div class="error-message hidden text-red-600 text-sm mt-1"></div>
                <div class="success-message hidden text-green-600 text-sm mt-1">
                  <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd" />
                  </svg>
                  Valid age entered
                </div>
              </div>

              <div class="form-group">
                <label class="block text-gray-700 font-semibold mb-2" for="bloodType">
                  Blood Type Required *
                  <span class="tooltip-trigger ml-1 cursor-help"
                    data-tooltip="Select the specific blood type needed for the patient">
                    <svg class="w-4 h-4 inline text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </span>
                </label>
                <select name="bloodType" id="bloodType" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200"
                  data-validate="required">
                  <option value="">Select blood type</option>
                  <option value="A+">A+ (A Positive)</option>
                  <option value="A-">A- (A Negative)</option>
                  <option value="B+">B+ (B Positive)</option>
                  <option value="B-">B- (B Negative)</option>
                  <option value="AB+">AB+ (AB Positive)</option>
                  <option value="AB-">AB- (AB Negative)</option>
                  <option value="O+">O+ (O Positive)</option>
                  <option value="O-">O- (O Negative - Universal Donor)</option>
                </select>
                <div class="error-message hidden text-red-600 text-sm mt-1"></div>
                <div class="success-message hidden text-green-600 text-sm mt-1">
                  <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd" />
                  </svg>
                  Blood type selected
                </div>
              </div>

              <div class="form-group">
                <label class="block text-gray-700 font-semibold mb-2" for="unitsRequired">
                  Units Required *
                  <span class="tooltip-trigger ml-1 cursor-help"
                    data-tooltip="Number of blood units needed (typically 1-4 units per patient)">
                    <svg class="w-4 h-4 inline text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </span>
                </label>
                <input type="number" name="unitsRequired" id="unitsRequired" required min="1" max="10"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200"
                  placeholder="Number of units (1-10)" data-validate="required,min:1,max:10">
                <div class="error-message hidden text-red-600 text-sm mt-1"></div>
                <div class="success-message hidden text-green-600 text-sm mt-1">
                  <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd" />
                  </svg>
                  Valid units entered
                </div>
              </div>
            </div>
          </div>

          <!-- Blood Component and Transfusion Information Section -->
          <div class="mb-8 form-step" data-step="2">
            <h2 class="text-2xl font-bold text-gray-800 mb-4 flex items-center">
              <svg class="w-6 h-6 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              Blood Component & Transfusion Details
            </h2>

            <div class="grid grid-cols-1 gap-6">
              <!-- Indication of Transfusion -->
              <div class="form-group">
                <label class="block text-gray-700 font-semibold mb-2" for="indicationOfTransfusion">
                  Indication of Transfusion *
                  <span class="tooltip-trigger ml-1 cursor-help"
                    data-tooltip="Medical reason or indication for the blood transfusion">
                    <svg class="w-4 h-4 inline text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </span>
                </label>
                <textarea name="indicationOfTransfusion" id="indicationOfTransfusion" required rows="3"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200"
                  placeholder="Enter the medical indication for transfusion (e.g., Acute blood loss, Anemia, Surgery preparation, etc.)"
                  data-validate="required,minLength:10"></textarea>
                <div class="error-message hidden text-red-600 text-sm mt-1"></div>
                <div class="success-message hidden text-green-600 text-sm mt-1">
                  <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd" />
                  </svg>
                  Valid indication entered
                </div>
              </div>

              <!-- Blood Components Section -->
              <div class="form-group">
                <label class="block text-gray-700 font-semibold mb-3">
                  Blood Component Required *
                  <span class="tooltip-trigger ml-1 cursor-help"
                    data-tooltip="Select the specific blood components needed and specify the units/volume for each">
                    <svg class="w-4 h-4 inline text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </span>
                </label>

                <div class="bg-gray-50 rounded-lg p-4">
                  <p class="text-sm text-gray-600 mb-3">Select the blood components needed and enter a positive quantity for each, for example 2 units or 450 ml. Maximum quantity per component: 100000.</p>

                  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                    <!-- Whole Blood -->
                    <div class="vm-panel flex flex-col space-y-2 p-3 bg-white rounded-lg border">
                      <div class="flex items-center">
                        <input type="checkbox" id="wholeBlood" name="bloodComponents[]" value="wholeBlood"
                          class="w-4 h-4 text-red-600 bg-gray-100 border-gray-300 rounded focus:ring-red-500 focus:ring-2">
                        <label for="wholeBlood" class="ml-2 text-sm font-medium text-gray-700">Whole blood</label>
                      </div>
                      <input type="text" name="wholeBloodVolume" id="wholeBloodVolume" placeholder="Units/Volume"
                        class="w-full px-3 py-2 text-sm border border-gray-300 rounded focus:ring-2 focus:ring-red-500 focus:border-transparent"
                        disabled aria-label="Units/Volume">
                    </div>

                    <!-- Packed RBC -->
                    <div class="vm-panel flex flex-col space-y-2 p-3 bg-white rounded-lg border">
                      <div class="flex items-center">
                        <input type="checkbox" id="packedRBC" name="bloodComponents[]" value="packedRBC"
                          class="w-4 h-4 text-red-600 bg-gray-100 border-gray-300 rounded focus:ring-red-500 focus:ring-2">
                        <label for="packedRBC" class="ml-2 text-sm font-medium text-gray-700">Packed RBC</label>
                      </div>
                      <input type="text" name="packedRBCVolume" id="packedRBCVolume" placeholder="Units/Volume"
                        class="w-full px-3 py-2 text-sm border border-gray-300 rounded focus:ring-2 focus:ring-red-500 focus:border-transparent"
                        disabled aria-label="Units/Volume">
                    </div>

                    <!-- Platelet Concentrate -->
                    <div class="vm-panel flex flex-col space-y-2 p-3 bg-white rounded-lg border">
                      <div class="flex items-center">
                        <input type="checkbox" id="plateletConcentrate" name="bloodComponents[]"
                          value="plateletConcentrate"
                          class="w-4 h-4 text-red-600 bg-gray-100 border-gray-300 rounded focus:ring-red-500 focus:ring-2">
                        <label for="plateletConcentrate" class="ml-2 text-sm font-medium text-gray-700">Platelet
                          concentrate</label>
                      </div>
                      <input type="text" name="plateletConcentrateVolume" id="plateletConcentrateVolume"
                        placeholder="Units/Volume"
                        class="w-full px-3 py-2 text-sm border border-gray-300 rounded focus:ring-2 focus:ring-red-500 focus:border-transparent"
                        disabled aria-label="Units/Volume">
                    </div>

                    <!-- Fresh Frozen Plasma -->
                    <div class="vm-panel flex flex-col space-y-2 p-3 bg-white rounded-lg border">
                      <div class="flex items-center">
                        <input type="checkbox" id="freshFrozenPlasma" name="bloodComponents[]" value="freshFrozenPlasma"
                          class="w-4 h-4 text-red-600 bg-gray-100 border-gray-300 rounded focus:ring-red-500 focus:ring-2">
                        <label for="freshFrozenPlasma" class="ml-2 text-sm font-medium text-gray-700">Fresh Frozen
                          Plasma</label>
                      </div>
                      <input type="text" name="freshFrozenPlasmaVolume" id="freshFrozenPlasmaVolume"
                        placeholder="Units/Volume"
                        class="w-full px-3 py-2 text-sm border border-gray-300 rounded focus:ring-2 focus:ring-red-500 focus:border-transparent"
                        disabled aria-label="Units/Volume">
                    </div>

                    <!-- Cryoprecipitate -->
                    <div class="vm-panel flex flex-col space-y-2 p-3 bg-white rounded-lg border">
                      <div class="flex items-center">
                        <input type="checkbox" id="cryoprecipitate" name="bloodComponents[]" value="cryoprecipitate"
                          class="w-4 h-4 text-red-600 bg-gray-100 border-gray-300 rounded focus:ring-red-500 focus:ring-2">
                        <label for="cryoprecipitate"
                          class="ml-2 text-sm font-medium text-gray-700">Cryoprecipitate</label>
                      </div>
                      <input type="text" name="cryoprecipitateVolume" id="cryoprecipitateVolume"
                        placeholder="Units/Volume"
                        class="w-full px-3 py-2 text-sm border border-gray-300 rounded focus:ring-2 focus:ring-red-500 focus:border-transparent"
                        disabled aria-label="Units/Volume">
                    </div>

                    <!-- Platelet Apheresis -->
                    <div class="vm-panel flex flex-col space-y-2 p-3 bg-white rounded-lg border">
                      <div class="flex items-center">
                        <input type="checkbox" id="plateletApheresis" name="bloodComponents[]" value="plateletApheresis"
                          class="w-4 h-4 text-red-600 bg-gray-100 border-gray-300 rounded focus:ring-red-500 focus:ring-2">
                        <label for="plateletApheresis" class="ml-2 text-sm font-medium text-gray-700">Platelet
                          Apheresis</label>
                      </div>
                      <input type="text" name="plateletApheresisVolume" id="plateletApheresisVolume"
                        placeholder="Units/Volume"
                        class="w-full px-3 py-2 text-sm border border-gray-300 rounded focus:ring-2 focus:ring-red-500 focus:border-transparent"
                        disabled aria-label="Units/Volume">
                    </div>
                  </div>
                </div>

                <div class="error-message hidden text-red-600 text-sm mt-1"></div>
                <div class="success-message hidden text-green-600 text-sm mt-1">
                  <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd" />
                  </svg>
                  Blood components selected
                </div>
              </div>
            </div>
          </div>

          <!-- Hospital Information Section -->
          <div class="mb-8 form-step" data-step="3">
            <h2 class="text-2xl font-bold text-gray-800 mb-4 flex items-center">
              <svg class="w-6 h-6 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
              Hospital Information
            </h2>
            {{> facility-selector}}

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-gray-700 font-semibold mb-2" for="vm-request-blood-49">Hospital Name *</label>
                <input type="text" name="hospitalName" required value="{{profile.hospitalName}}"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent"
                  placeholder="Enter hospital name" id="vm-request-blood-49">
              </div>

              <div>
                <label class="block text-gray-700 font-semibold mb-2" for="vm-request-blood-50">Hospital Address *</label>
                <input type="text" name="hospitalAddress" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent"
                  placeholder="Enter complete address" id="vm-request-blood-50">
              </div>

              <div>
                <label class="block text-gray-700 font-semibold mb-2">City *</label>
                <div data-city-wrap>
                  <select name="city" data-city-select required
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent bg-white" aria-label="Municipality">
                    <option value="">Select municipality</option>
                    <option>Baco</option>
                    <option>Bansud</option>
                    <option>Bongabong</option>
                    <option>Bulalacao</option>
                    <option>Calapan City</option>
                    <option>Gloria</option>
                    <option>Mansalay</option>
                    <option>Naujan</option>
                    <option>Pinamalayan</option>
                    <option>Pola</option>
                    <option>Puerto Galera</option>
                    <option>Roxas</option>
                    <option>San Teodoro</option>
                    <option>Socorro</option>
                    <option>Victoria</option>
                    <option value="__other">Others (specify)</option>
                  </select>
                  <input type="text" data-city-other placeholder="Specify municipality"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent mt-2 hidden" aria-label="Specify municipality">
                </div>
              </div>

              <div>
                <label class="block text-gray-700 font-semibold mb-2" for="vm-request-blood-51">Province *</label>
                <input type="text" name="province" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent"
                  placeholder="Enter province" id="vm-request-blood-51">
              </div>
            </div>
            <input type="hidden" name="latitude" id="requestLatitude">
            <input type="hidden" name="longitude" id="requestLongitude">
          </div>

          <!-- Contact Information Section -->
          <div class="mb-8 form-step" data-step="4">
            <h2 class="text-2xl font-bold text-gray-800 mb-4 flex items-center">
              <svg class="w-6 h-6 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              Contact Information
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              <div>
                <label class="block text-gray-700 font-semibold mb-2" for="vm-request-blood-52">Contact Person *</label>
                <input type="text" name="contactPerson" required value="{{profile.firstName}} {{profile.lastName}}"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent"
                  placeholder="Enter contact person name" id="vm-request-blood-52">
              </div>

              <div>
                <label class="block text-gray-700 font-semibold mb-2" for="vm-request-blood-53">Contact Number *</label>
                <input type="tel" name="contactNumber" required value="{{profile.phone}}"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent"
                  placeholder="09XX-XXX-XXXX" id="vm-request-blood-53">
              </div>

              <div>
                <label class="block text-gray-700 font-semibold mb-2" for="vm-request-blood-54">Email Address *</label>
                <input type="email" name="email" required value="{{profile.email}}"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent"
                  placeholder="email@example.com" id="vm-request-blood-54">
              </div>
            </div>
          </div>

          <!-- Urgency and Additional Information -->
          <div class="mb-8 form-step" data-step="5">
            <h2 class="text-2xl font-bold text-gray-800 mb-4 flex items-center">
              <svg class="w-6 h-6 text-orange-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Additional Details
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-gray-700 font-semibold mb-2" for="vm-request-blood-55">Urgency Level *</label>
                <select name="urgency" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent" id="vm-request-blood-55">
                  <option value="">Select urgency level</option>
                  <option value="critical">Critical - Immediate</option>
                  <option value="urgent">Urgent - Within 24 hours</option>
                  <option value="moderate">Moderate - Within 2-3 days</option>
                </select>
              </div>

              <div>
                <label class="block text-gray-700 font-semibold mb-2" for="vm-request-blood-56">Required By Date *</label>
                <input type="date" name="requiredByDate" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent" id="vm-request-blood-56">
              </div>

              <div class="md:col-span-2">
                <label class="block text-gray-700 font-semibold mb-2" for="vm-request-blood-57">Additional Notes</label>
                <textarea name="notes" rows="2"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent"
                  placeholder="Any additional information about the patient's condition or special requirements..." id="vm-request-blood-57"></textarea>
              </div>
            </div>
          </div>

          <!-- Wizard Navigation -->
          <div class="vm-form-actions flex justify-between items-center">
            <button type="button" id="wizardBack"
              class="vm-button px-6 py-3 border border-gray-300 rounded-lg text-gray-700 font-semibold hover:bg-gray-50 transition-all duration-200 invisible">
              &larr; Back
            </button>
            <button type="button" id="wizardNext"
              class="vm-button vm-button--primary px-8 py-3 bg-red-600 text-white rounded-lg font-semibold hover:bg-red-700 transition-all duration-200">
              Next &rarr;
            </button>
            <button type="submit" id="submitBtn"
              class="vm-button vm-button--primary px-8 py-3 bg-red-600 text-white rounded-lg font-semibold hover:bg-red-700 transition-all duration-200 transform">
              <span id="submitText">Submit Blood Request</span>
              <span id="submitLoader" class="hidden">
                <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white inline" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor"
                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z">
                  </path>
                </svg>
                Submitting...
              </span>
            </button>
          </div>

        </form>
      </div>

      <!-- Help Text -->
      <div class="mt-6 bg-blue-50 border border-blue-200 rounded-lg p-4">
        <div class="flex items-start">
          <svg class="w-6 h-6 text-blue-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor"
            viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div>
            <p class="text-blue-800 font-semibold mb-1">Important Information</p>
            <p class="text-blue-700 text-sm">Once submitted, your blood request will be processed by our matching
              algorithm. The named facility or a coordinator first reviews your request. Once approved, matching alerts appear in VitalMatch; email delivery depends on the configured service and your preferences.</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</main>



<script src="/js/workspace-form.js?v=1" defer></script>

{{> footer}}
