<!-- Admin Requests Content -->
<main id="main-content" tabindex="-1" class="vm-page min-h-screen bg-gray-100 dark:bg-[#09090b] py-8">
  <div class="vm-page-container container mx-auto px-4">
    {{#if error}}<div class="vm-alert vm-alert--danger mb-4" role="alert">{{error}} <a class="vm-text-link" href="/admin/requests">Retry</a></div>{{/if}}

    <!-- Header -->
    <div class="vm-page-heading vm-heading-actions mb-8 flex justify-between items-center">
      <div>
        <h1 class="text-3xl font-bold text-gray-800 dark:text-gray-200 mb-2">Manage Blood Requests</h1>
        <p class="text-gray-600 dark:text-gray-400">View and manage all blood requests in the system</p>
      </div>
      <a href="/admin/new-blood-request"
        class="vm-button inline-flex items-center space-x-2 bg-red-600 text-white px-6 py-3 rounded-md font-bold hover:bg-red-700 transition-all duration-200 vm-button--primary">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>New Request</span>
      </a>
    </div>
      {{> record-search label="Search blood requests" placeholder="Patient, facility, blood type, location or ID"}}

    <!-- Live critical banner: polls for critical-urgency requests needing immediate action -->
    <div id="critical-banner" class="hidden mb-4 p-4 border-2 border-red-600 rounded-md bg-red-50 dark:bg-red-900/20 flex items-center justify-between" role="alert">
      <div class="flex items-center gap-3">
        <span class="inline-block w-3 h-3 bg-red-600 rounded-full animate-pulse"></span>
        <p class="text-sm font-bold text-red-700 dark:text-red-300" id="critical-banner-text"></p>
      </div>
      <a href="/admin/requests?filter=pending" id="critical-review-link" class="vm-button vm-button--small vm-button--danger">Review now</a>
    </div>

    <!-- Filter Tabs -->
    <div class="vm-panel bg-white dark:bg-[#18181b] rounded-md dark:shadow-none mb-6">
      <div class="vm-tabs flex border-b overflow-x-auto">
        <a href="/admin/requests" class="px-6 py-4 font-semibold {{#unless filter}}text-blue-600 border-b-2 border-blue-600{{else}}text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:text-gray-300{{/unless}}">
          All Requests
        </a>
        <a href="/admin/requests?filter=pending" class="px-6 py-4 font-semibold {{#if (eq filter 'pending')}}text-blue-600 border-b-2 border-blue-600{{else}}text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:text-gray-300{{/if}}" {{#if (eq filter 'pending')}}aria-current="page"{{/if}}>Awaiting review</a>
        <a href="/admin/requests?filter=scheduled" class="px-6 py-4 font-semibold {{#if (eq filter 'scheduled')}}text-blue-600 border-b-2 border-blue-600{{else}}text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:text-gray-300{{/if}}" {{#if (eq filter 'scheduled')}}aria-current="page"{{/if}}>Scheduled</a>
        <a href="/admin/requests?filter=active" class="px-6 py-4 font-semibold {{#if (eq filter 'active')}}text-blue-600 border-b-2 border-blue-600{{else}}text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:text-gray-300{{/if}}">
          Active
        </a>
        <a href="/admin/requests?filter=fulfilled" class="px-6 py-4 font-semibold {{#if (eq filter 'fulfilled')}}text-blue-600 border-b-2 border-blue-600{{else}}text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:text-gray-300{{/if}}">
          Fulfilled
        </a>
        <a href="/admin/requests?filter=cancelled" class="px-6 py-4 font-semibold {{#if (eq filter 'cancelled')}}text-blue-600 border-b-2 border-blue-600{{else}}text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:text-gray-300{{/if}}">
          Cancelled
        </a>
      </div>
    </div>

    <!-- Bulk Actions Bar -->
    <div id="bulkActions" class="hidden bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
      <div class="flex items-center justify-between">
        <span class="text-blue-800 font-semibold">Bulk Actions</span>
        <div class="space-x-2">

          <button onclick="bulkDelete()"
            class="vm-button vm-button--small bg-red-600 text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-red-700 transition vm-button--danger">
            Archive selected
          </button>
        </div>
      </div>
    </div>

    <!-- Requests Table -->
    <div class="vm-panel bg-white dark:bg-[#18181b] rounded-md dark:shadow-none overflow-hidden">
      {{#if requests.length}}
      <div class="vm-table-scroll overflow-x-auto" tabindex="0" role="region" aria-label="Scrollable data table">
        <table data-search-mode="server" class="vm-table min-w-full divide-y divide-gray-100 dark:divide-gray-800">
          <thead class="bg-gray-50 dark:bg-[#27272a]/80 backdrop-blur">
            <tr>
              <th scope="col"
                class="px-4 py-3 text-left text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-widest w-12">
                <input type="checkbox" id="selectAll" onchange="selectAllRequests()"
                  class="rounded border-gray-300 text-red-600 focus:ring-red-500 shadow-sm dark:shadow-none transition" aria-label="Select all rows">
              </th>
              <th scope="col"
                class="px-4 py-3 text-left text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-widest">
                ID</th>
              <th scope="col"
                class="px-4 py-3 text-left text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-widest">
                Patient</th>
              <th scope="col"
                class="px-4 py-3 text-left text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-widest text-center">
                Blood Type</th>
              <th scope="col"
                class="px-4 py-3 text-left text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-widest text-center">
                Units</th>
              <th scope="col"
                class="px-4 py-3 text-left text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-widest">
                Hospital</th>
              <th scope="col"
                class="px-4 py-3 text-left text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-widest">
                Location</th>
              <th scope="col"
                class="px-4 py-3 text-left text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-widest">
                Urgency</th>
              <th scope="col"
                class="px-4 py-3 text-left text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-widest">
                Status</th>
              <th scope="col"
                class="px-4 py-3 text-left text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-widest text-center">
                Matches</th>
              <th scope="col"
                class="px-4 py-3 text-right text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-widest pr-6">
                Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white dark:bg-[#18181b] divide-y divide-gray-100 dark:divide-gray-800">
            {{#each requests}}
            <tr id="request-row-{{id}}" class="hover:bg-blue-50/30 transition-colors duration-200 group">
              <td class="px-4 py-3 whitespace-nowrap">
                <input type="checkbox" name="selectedRequests" value="{{id}}" {{#unless (eq status "fulfilled")}}{{#unless (eq status "cancelled")}}disabled{{/unless}}{{/unless}} onchange="updateBulkActionsVisibility()"
                  class="rounded border-gray-300 text-red-600 focus:ring-red-500 shadow-sm dark:shadow-none transition" aria-label="Select this row">
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm font-semibold text-gray-600 dark:text-gray-400">#{{id}}
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-gray-100">
                {{patientName}}</td>
              <td class="px-4 py-3 whitespace-nowrap">
                <div class="flex justify-center">
                  <div
                    class="flex items-center justify-center w-10 h-10 rounded-full bg-red-50/80 text-red-600 font-extrabold text-sm shadow-sm dark:shadow-none border border-red-100">
                    {{bloodType}}
                  </div>
                </div>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm font-medium text-gray-600 dark:text-gray-400 text-center">
                <span>{{unitsRemaining}} outstanding</span><br><span class="vm-muted text-xs">{{unitsFulfilled}} collected / {{unitsRequired}} requested</span></td>
              <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-300 font-medium">{{hospitalName}}</td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">{{city}}</td>
              <td class="px-4 py-3 whitespace-nowrap">
                {{#if (eq urgency 'critical')}}
                <span
                  class="vm-status vm-status--danger inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-red-50 text-red-700 border border-red-200 shadow-sm dark:shadow-none"><span
                    class="w-1.5 h-1.5 rounded-full bg-red-500 mr-1.5 animate-pulse"></span>Critical</span>
                {{else if (eq urgency 'urgent')}}
                <span
                  class="vm-status vm-status--warning inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-orange-50 text-orange-700 border border-orange-200 shadow-sm dark:shadow-none"><span
                    class="w-1.5 h-1.5 rounded-full bg-orange-500 mr-1.5"></span>Urgent</span>
                {{else if (eq urgency 'high')}}
                <span
                  class="vm-status vm-status--warning inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200 shadow-sm dark:shadow-none"><span
                    class="w-1.5 h-1.5 rounded-full bg-amber-500 mr-1.5"></span>High</span>
                {{else}}
                <span
                  class="vm-status vm-status--info inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 shadow-sm dark:shadow-none"><span
                    class="w-1.5 h-1.5 rounded-full bg-blue-500 mr-1.5"></span>Moderate</span>
                {{/if}}
              </td>
              <td class="px-4 py-3 whitespace-nowrap">
                {{#if emergencyActive}}
                <span
                  class="vm-status vm-status--danger inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-red-600 text-white border border-red-600 shadow-sm dark:shadow-none animate-pulse">EMERGENCY</span>
                {{/if}}
                {{#if (eq status 'active')}}
                <span
                  class="vm-status vm-status--success inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 shadow-sm dark:shadow-none"><span
                    class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span>Active</span>
                {{else if (eq status 'scheduled')}}
                <span class="vm-status vm-status--info">Scheduled</span>
                {{else if (eq status 'fulfilled')}}
                <span
                  class="vm-status vm-status--success inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 shadow-sm dark:shadow-none"><svg
                    class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>Fulfilled</span>
                {{else if (eq status 'cancelled')}}
                <span
                  class="vm-status vm-status--danger inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-gray-50 dark:bg-[#27272a] text-gray-700 dark:text-gray-300 border border-gray-200 dark:border-gray-800 shadow-sm dark:shadow-none">Cancelled</span>
                {{else}}
                <span
                  class="vm-status vm-status--warning inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-yellow-50 text-yellow-700 border border-yellow-200 shadow-sm dark:shadow-none">Pending</span>
                {{/if}}
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-center">
                {{#if pledgeCount}}
                <a href="/view-blood-request/{{id}}" title="View pledged donors"
                  class="vm-button vm-button--small inline-flex items-center justify-center px-3 py-1 bg-gradient-to-r from-green-500 to-green-600 text-white rounded-lg text-xs font-semibold hover:from-green-600 hover:to-green-700 transition shadow-sm dark:shadow-none dark:shadow-none transform mb-1">
                  <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                  </svg>
                  {{pledgeCount}} Pledged
                </a><br>
                {{/if}}
                {{#if matchingDonorsCount}}
                <button type="button" data-request-id="{{id}}"
                  class="vm-button vm-button--small show-donor-btn inline-flex items-center justify-center px-3 py-1 bg-gradient-to-r from-blue-500 to-blue-600 text-white rounded-lg text-xs font-semibold hover:from-blue-600 hover:to-blue-700 transition shadow-sm dark:shadow-none dark:shadow-none transform">
                  <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                  {{matchingDonorsCount}} Donors
                </button>
                {{else}}
                <span
                  class="vm-status text-xs text-gray-400 font-medium px-2 py-1 bg-gray-50 dark:bg-[#27272a] rounded-md border border-gray-100 dark:border-gray-800">No
                  matches</span>
                {{/if}}
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-right pr-6">
                <div class="flex items-center justify-end space-x-2">
                  <a href="/view-blood-request/{{id}}"
                    class="vm-button vm-button--small p-1.5 text-blue-600 bg-blue-50 rounded-md hover:bg-blue-100 hover:text-blue-800 transition tooltip-trigger"
                    title="View details">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                  <span>View</span></a>
                  {{#if (eq status 'active')}}
                  <button type="button" class="vm-button vm-button--small fulfill-btn" data-request-id="{{id}}" title="Coordinate donation">Coordinate</button>
                  {{else if (eq status 'scheduled')}}<a class="vm-button vm-button--small" href="/admin/appointments">Manage appointment</a>
                  {{else if (eq status 'pending')}}{{#unless facilityId}}<button type="button" class="vm-button vm-button--small review-toggle" data-request-id="{{id}}">Review request</button>
                  <div class="review-panel hidden mt-2 p-3 border rounded-md bg-gray-50 dark:bg-[#27272a] text-left whitespace-normal w-64" id="review-panel-{{id}}">
                    <input type="text" class="review-reason w-full px-2 py-1 text-xs border rounded-md mb-2" placeholder="Reason (required to return)" maxlength="200" />
                    <div class="flex gap-2">
                      <button type="button" class="vm-button vm-button--small review-approve" data-request-id="{{id}}">Approve</button>
                      <button type="button" class="vm-button vm-button--small vm-button--danger review-return" data-request-id="{{id}}">Return</button>
                    </div>
                    <p class="review-error text-xs text-red-600 mt-1"></p>
                  </div>{{/unless}}{{/if}}
                  {{#if (eq status 'fulfilled')}}
                  <button type="button" onclick="deleteRequest('{{id}}')"
                    class="vm-button vm-button--small p-1.5 text-red-600 bg-red-50 rounded-md hover:bg-red-100 hover:text-red-800 transition delete-btn tooltip-trigger vm-button--danger"
                    data-request-id="{{id}}" title="Archive request" aria-label="Archive request">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  <span>Archive</span></button>
                  {{else if (eq status "cancelled")}}<button type="button" class="vm-button vm-button--small vm-button--danger" onclick="deleteRequest('{{id}}')">Archive</button>{{/if}}
                </div>
              </td>
            </tr>


            {{/each}}
          </tbody>
        </table>
      </div>
      {{else}}
      <div class="vm-empty-state text-center py-12">
        <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <p class="text-gray-500 dark:text-gray-400 text-lg mb-4">No blood requests found</p>
        <p class="text-gray-400">Blood requests will appear here as they are submitted</p>
      </div>
      {{/if}}
    </div>
  </div>
  {{> pagination}}
</main>

<!-- Donor Modals -->
{{#each requests}}
{{#if matchingDonorsCount}}
<div id="donor-modal-{{id}}" class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6"
  style="z-index: 9999;">
  <!-- Backdrop -->
  <div class="close-donor-modal-backdrop absolute inset-0 bg-gray-900 bg-opacity-60 backdrop-blur-sm transition-opacity"
    data-request-id="{{id}}"></div>
  <!-- Modal Panel -->
  <div
    class="relative bg-white dark:bg-[#18181b] rounded-md w-full max-w-3xl max-h-[90vh] flex flex-col overflow-hidden transform transition-all">
    <div
      class="p-6 border-b border-gray-100 dark:border-gray-800 flex justify-between items-center bg-gray-50 dark:bg-[#27272a]/80">
      <div>
        <h3 class="text-xl font-extrabold text-gray-900 dark:text-gray-100 tracking-tight">Matching Donors</h3>
        <p class="vm-muted text-sm">Shows up to ten prioritized matches plus all donor offers. Recheck eligibility before scheduling.</p><p class="text-sm text-gray-500 dark:text-gray-400 mt-1 font-medium">For Request #{{id}} • <span
            class="vm-status font-bold text-red-600 bg-red-50 px-2 py-0.5 rounded">{{bloodType}}</span></p>
      </div>
      <button type="button" data-request-id="{{id}}"
        data-dialog-close="true" aria-label="Close donor list" class="vm-button close-donor-modal-btn text-gray-400 hover:text-gray-600 dark:text-gray-400 hover:bg-gray-200 p-2 rounded-full transition">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div class="p-6 overflow-y-auto flex-1 bg-gray-50 dark:bg-[#27272a]/50">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {{#each matchingDonors}}
        <div
          class="vm-panel border border-gray-200 dark:border-gray-800 rounded-md p-5 dark:shadow-none hover:border-blue-300 transition bg-white dark:bg-[#18181b] relative overflow-hidden group">
          <div class="vm-surface-muted absolute top-0 left-0 w-1 h-full"></div>
          <div class="flex items-start justify-between mb-4">
            <div>
              <h4 class="font-bold text-gray-900 dark:text-gray-100 text-lg">{{fullName}}</h4>
              <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mt-0.5">{{city}},
                {{province}}</p>
            </div>
            <div class="bg-blue-50 text-blue-700 px-2.5 py-1 rounded text-sm font-bold border border-blue-100">
              {{../bloodType}}</div>
          </div>
          <div class="space-y-2 mb-5">
            <p class="text-sm text-gray-600 dark:text-gray-400 flex items-center font-medium"><span
                class="w-5 text-center mr-2 opacity-70">📱</span> {{mobileNumber}}</p>
            <p class="text-sm text-gray-600 dark:text-gray-400 flex items-center truncate font-medium"
              title="{{email}}"><span class="w-5 text-center mr-2 opacity-70">✉️</span> {{email}}</p>
          </div>
          <button type="button" data-request-id="{{../id}}" data-user-id="{{userId}}"
            class="vm-button vm-button--small notify-donor-btn w-full bg-gradient-to-r from-green-500 to-green-600 text-white px-4 py-2.5 rounded-md text-sm font-bold hover:from-green-600 hover:to-green-700 dark:shadow-none transition-all flex items-center justify-center space-x-2 transform">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
            <span>Open conversation</span>
          </button>
        </div>
        {{/each}}
      </div>
    </div>
    <div
      class="vm-panel p-4 border-t border-gray-100 dark:border-gray-800 bg-white dark:bg-[#18181b] flex justify-end rounded-b-2xl">
      <button type="button" data-request-id="{{id}}"
        data-dialog-close="true" aria-label="Close donor list" class="vm-button close-donor-modal-btn px-6 py-2.5 text-gray-600 dark:text-gray-400 font-semibold hover:bg-gray-100 dark:bg-[#09090b] hover:text-gray-900 dark:text-gray-100 rounded-lg transition-colors">Close</button>
    </div>
  </div>
</div>
{{/if}}
{{/each}}

<!-- Schedule Donation Modals -->
{{#each requests}}
{{#if (eq status 'active')}}
<div id="schedule-modal-{{id}}" class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6"
  style="z-index: 9999;">
  <!-- Backdrop -->
  <div
    class="close-schedule-modal-backdrop absolute inset-0 bg-gray-900 bg-opacity-60 backdrop-blur-sm transition-opacity"
    data-request-id="{{id}}"></div>
  <!-- Modal Panel -->
  <div
    class="vm-panel relative bg-white dark:bg-[#18181b] rounded-md w-full max-w-lg max-h-[90vh] flex flex-col overflow-hidden transform transition-all">
    <div
      class="p-6 border-b border-gray-100 dark:border-gray-800 flex justify-between items-center bg-gray-50 dark:bg-[#27272a]/80">
      <div>
        <h3 class="text-xl font-extrabold text-gray-900 dark:text-gray-100 tracking-tight">Coordinate donation</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1 font-medium">For Request #{{id}} • <span
            class="vm-status font-bold text-red-600 bg-red-50 px-2 py-0.5 rounded">{{bloodType}}</span></p>
      </div>
      <button type="button" data-request-id="{{id}}"
        data-dialog-close="true" aria-label="Close scheduling dialog" class="vm-button close-schedule-modal-btn text-gray-400 hover:text-gray-600 dark:text-gray-400 hover:bg-gray-200 p-2 rounded-full transition">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <form class="schedule-form" data-request-id="{{id}}">
      <p class="vm-muted p-4">Scheduling reserves coordination only. It does not record a completed donation. Completed walk-in collection requires actual units and a reason.</p>
      <div class="p-6 overflow-y-auto flex-1">
        <div class="space-y-4">
          <div><label for="coordination-mode-{{id}}" class="block mb-1">Action</label><select name="coordinationMode" id="coordination-mode-{{id}}"><option value="schedule">Schedule a future donation</option><option value="complete">Record a collected walk-in donation</option></select></div>
          <p class="schedule-error vm-field-error" role="alert"></p>
          <!-- Donor Selection -->
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" for="vm-admin-requests-27-{{id}}">Assign donor (required for scheduled donation)</label>
            <select name="donorId"
              class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 dark:bg-[#09090b] dark:text-white" id="vm-admin-requests-27-{{id}}">
              <option value="">-- No donor assigned (Walk-in) --</option>
              {{#each matchingDonors}}
              <option value="{{id}}" {{#unless isAssignable}}disabled{{/unless}}>{{fullName}} ({{bloodType}}){{#if pledged}} - pledged{{/if}}{{#unless isAssignable}} - currently unavailable{{/unless}}</option>
              {{/each}}
            </select>
          </div>
          <!-- Units for this donation -->
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" for="vm-admin-requests-28-{{id}}">Units for a completed donation</label>
            <input type="number" name="unitsProvided" value="1" min="1" max="10" step="1" required
              class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 dark:bg-[#09090b] dark:text-white" id="vm-admin-requests-28-{{id}}">
          </div>
          <!-- Schedule Date -->
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" for="vm-admin-requests-29-{{id}}">Schedule date &amp; time (your device time zone)</label>
            <input type="datetime-local" name="scheduledDate"
              class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 dark:bg-[#09090b] dark:text-white" id="vm-admin-requests-29-{{id}}">
            <p class="text-xs text-gray-500 mt-1">Leave blank only after a walk-in donation has actually been collected.</p>
          </div>
          <!-- Notes -->
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" for="vm-admin-requests-30-{{id}}">Notes / Instructions</label>
            <textarea name="notes" rows="3"
              class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 dark:bg-[#09090b] dark:text-white"
              placeholder="Add any instructions for the donor or hospital..." id="vm-admin-requests-30-{{id}}"></textarea>
          </div>
        </div>
      </div>
      <div
        class="vm-form-actions p-4 border-t border-gray-100 dark:border-gray-800 bg-gray-50 dark:bg-[#27272a]/80 flex justify-end space-x-3 rounded-b-2xl">
        <button type="button" data-request-id="{{id}}"
          data-dialog-close="true" aria-label="Close scheduling dialog" class="vm-button close-schedule-modal-btn px-4 py-2 text-gray-700 dark:text-gray-300 bg-white dark:bg-[#18181b] border border-gray-300 dark:border-gray-700 rounded-md hover:bg-gray-50 dark:hover:bg-[#27272a] transition-colors shadow-sm vm-button--danger">Cancel</button>
        <button type="submit"
          class="vm-button vm-button--primary px-4 py-2 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-semibold rounded-md hover:from-blue-600 hover:to-blue-700 transition-all">Save coordination</button>
      </div>
    </form>
  </div>
</div>
{{/if}}
{{/each}}



<script>

  document.addEventListener('DOMContentLoaded', () => {

    // Bind all donor buttons to open modal
    document.querySelectorAll('.schedule-form').forEach(form => {
      const mode = form.elements.coordinationMode, date = form.elements.scheduledDate, units = form.elements.unitsProvided, donor = form.elements.donorId, notes = form.elements.notes;
      const update = () => { const scheduling = mode.value === 'schedule'; date.required = scheduling; date.disabled = !scheduling; units.disabled = scheduling; donor.required = scheduling; notes.required = !scheduling; form.querySelector('button[type="submit"]').textContent = scheduling ? 'Schedule donation' : 'Record actual collection'; };
      mode.addEventListener('change', update); donor.addEventListener('change', () => donor.setCustomValidity('')); update();
    });
    const donorButtons = document.querySelectorAll('.show-donor-btn');
    donorButtons.forEach(btn => {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        const requestId = e.currentTarget.getAttribute('data-request-id');
        showDonors(requestId);
      });
    });

    // Bind close modal buttons and backdrop
    const closeElements = document.querySelectorAll('.close-donor-modal-btn, .close-donor-modal-backdrop');
    closeElements.forEach(el => {
      el.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        const requestId = e.currentTarget.getAttribute('data-request-id');
        closeDonorModal(requestId);
      });
    });

    // Bind notify donor buttons
    const notifyButtons = document.querySelectorAll('.notify-donor-btn');
    notifyButtons.forEach(btn => {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        const requestId = e.currentTarget.getAttribute('data-request-id');
        const userId = e.currentTarget.getAttribute('data-user-id');
        contactDonor(requestId, userId);
      });
    });

    // Bind close schedule modal buttons
    const closeScheduleElements = document.querySelectorAll('.close-schedule-modal-btn, .close-schedule-modal-backdrop');
    closeScheduleElements.forEach(el => {
      el.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        const requestId = e.currentTarget.getAttribute('data-request-id');
        closeScheduleModal(requestId);
      });
    });

    // Bind fulfill buttons
    const fulfillButtons = document.querySelectorAll('.fulfill-btn');
    fulfillButtons.forEach(btn => {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        const requestId = e.currentTarget.getAttribute('data-request-id');
        markFulfilled(requestId);
      });
    });

    // Bind schedule forms
    const scheduleForms = document.querySelectorAll('.schedule-form');
    scheduleForms.forEach(form => {
      form.addEventListener('submit', function (e) {
        const requestId = e.currentTarget.getAttribute('data-request-id');
        submitSchedule(e, requestId);
      });
    });
  });

  // Enhanced donor contact functionality without confirm to avoid browser suppression issues
  function contactDonor(requestId, donorUserId) {
    window.location.href = `/contact-donor/${requestId}/${donorUserId}`;
  }


  function showDonors(requestId) {
    const modal = document.getElementById('donor-modal-' + requestId);
    if (modal) {
      modal.classList.remove('hidden');
      modal.style.display = 'flex';
      modal.style.zIndex = '9999';
      document.body.style.overflow = 'hidden';
    } else {
      console.error('Error: Modal element with ID donor-modal-' + requestId + ' was not found in the HTML.');
    }
  }

  function closeDonorModal(requestId) {
    const modal = document.getElementById('donor-modal-' + requestId);
    if (modal) {
      modal.style.display = 'none';
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  function markFulfilled(requestId) {
    // Open the schedule modal instead of browser confirm
    const modal = document.getElementById('schedule-modal-' + requestId);
    if (modal) {
      modal.classList.remove('hidden');
      modal.style.display = 'flex';
      modal.style.zIndex = '9999';
      document.body.style.overflow = 'hidden';
    } else {
      console.error('Error: Modal element with ID schedule-modal-' + requestId + ' was not found in the HTML.');
    }
  }

  // Deep link from pledged-donor panels: ?schedule=<requestId>&donor=<donorId>
  // opens the schedule modal with that donor pre-selected
  document.addEventListener('DOMContentLoaded', () => {
    try {
      const params = new URLSearchParams(window.location.search);
      const requestId = params.get('schedule');
      if (!requestId) return;
      const modal = document.getElementById('schedule-modal-' + requestId);
      if (!modal) return;
      markFulfilled(requestId);
      const donorId = params.get('donor');
      if (donorId) {
        const select = modal.querySelector('select[name="donorId"]');
        if (select) {
          if (Array.from(select.options).some(option => option.value === donorId && !option.disabled)) {
            select.value = donorId;
          } else {
            select.setCustomValidity('The selected donor is unavailable. Choose an eligible donor before continuing.');
            select.reportValidity();
          }
        }
      }
      modal.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch (e) {
      console.error('Schedule deep-link failed:', e);
    }
  });

  function closeScheduleModal(requestId) {
    const modal = document.getElementById('schedule-modal-' + requestId);
    if (modal) {
      modal.style.display = 'none';
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  async function submitSchedule(event, requestId) {
    event.preventDefault();
    const form = event.target, feedback = form.querySelector('.schedule-error'), button = form.querySelector('button[type="submit"]');
    if (button.disabled || !form.checkValidity()) { form.reportValidity(); return; }
    const fields = new FormData(form), scheduling = fields.get('coordinationMode') === 'schedule';
    if (scheduling && (!fields.get('donorId') || new Date(fields.get('scheduledDate')).getTime() <= Date.now())) { feedback.textContent = 'Select an eligible donor and a future date.'; return; }
    const payload = { donorId: fields.get('donorId') || null, unitsProvided: scheduling ? undefined : fields.get('unitsProvided'), scheduledDate: scheduling ? new Date(fields.get('scheduledDate')).toISOString() : null, notes: fields.get('notes') || '', idempotencyKey: form.dataset.idempotencyKey || (form.dataset.idempotencyKey = crypto.randomUUID()) };
    button.disabled = true; feedback.textContent = 'Saving...';
    try {
      const response = await fetch(`/admin/fulfill-request/${requestId}`, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': window.getCsrfToken() }, body: JSON.stringify(payload) });
      const data = await response.json();
      if (!response.ok || !data.success) throw new Error(data.message || 'This action could not be saved.');
      location.reload();
    } catch (error) { feedback.textContent = error.message + ' Your entered details are retained; retry the same action.'; button.disabled = false; }
  }

  // Review workflow: approve activates the request, return sends it back with a reason
  async function reviewDecision(requestId, approved) {
    const panel = document.getElementById('review-panel-' + requestId);
    const reasonInput = panel ? panel.querySelector('.review-reason') : null;
    const errorEl = panel ? panel.querySelector('.review-error') : null;
    const reason = reasonInput ? reasonInput.value.trim() : '';
    if (!approved && !reason) {
      if (errorEl) errorEl.textContent = 'A reason is required to return a request.';
      if (reasonInput) reasonInput.focus();
      return;
    }
    if (errorEl) errorEl.textContent = 'Saving...';
    try {
      const response = await fetch(`/admin/requests/${requestId}/review`, {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': window.getCsrfToken() },
        body: JSON.stringify({ action: approved ? 'approve' : 'decline', reason })
      });
      const data = await response.json();
      if (!response.ok || !data.success) throw new Error(data.message || 'Could not save the review decision.');
      location.reload();
    } catch (error) {
      if (errorEl) errorEl.textContent = error.message;
    }
  }
  // Critical alert polling: every 20s so critical requests get immediate attention
  async function pollCriticalAlerts() {
    try {
      const response = await fetch('/api/admin/critical-alerts', { credentials: 'same-origin', headers: { 'X-CSRF-Token': window.getCsrfToken() } });
      const data = await response.json();
      const banner = document.getElementById('critical-banner');
      const text = document.getElementById('critical-banner-text');
      if (banner && text && data.success && data.count > 0) {
        const latest = data.criticals[0];
        text.textContent = `${data.count} CRITICAL request${data.count > 1 ? 's need' : ' needs'} immediate action (latest: #${latest.id}, ${latest.bloodType} at ${latest.hospitalName || latest.city || 'unknown facility'})`;
        banner.classList.remove('hidden');
      } else if (banner) {
        banner.classList.add('hidden');
      }
    } catch (e) { /* next poll will retry */ }
  }
  document.addEventListener('DOMContentLoaded', () => {
    pollCriticalAlerts();
    setInterval(pollCriticalAlerts, 20000);
    // Review now: filter to pending, then scroll to and flash the critical row
    var reviewLink = document.getElementById('critical-review-link');
    if (reviewLink) {
      reviewLink.addEventListener('click', function (e) {
        var text = document.getElementById('critical-banner-text');
        var match = text ? text.textContent.match(/#(\d+)/) : null;
        if (match) reviewLink.href = '/admin/requests?filter=pending&highlight=' + match[1];
      });
    }
    try {
      var highlight = new URLSearchParams(window.location.search).get('highlight');
      if (highlight) {
        var row = document.getElementById('request-row-' + highlight);
        if (row) {
          row.scrollIntoView({ behavior: 'smooth', block: 'center' });
          row.classList.add('bg-red-50');
          setTimeout(function () { row.classList.remove('bg-red-50'); }, 4000);
        }
      }
    } catch (e) { /* highlight is decorative */ }
    document.querySelectorAll('.review-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const panel = document.getElementById('review-panel-' + btn.getAttribute('data-request-id'));
        if (panel) panel.classList.toggle('hidden');
      });
    });
    document.querySelectorAll('.review-approve').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-request-id');
        openConfirmModal({
          title: 'Approve request?',
          message: 'This request will become active for donor coordination.',
          button: 'Approve',
          buttonClass: 'bg-green-600 hover:bg-green-700',
          icon: 'success',
          onSubmit: function () { reviewDecision(id, true); }
        });
      });
    });
    document.querySelectorAll('.review-return').forEach(btn => {
      btn.addEventListener('click', () => reviewDecision(btn.getAttribute('data-request-id'), false));
    });
  });

  function deleteRequest(requestId) {


    if (!requestId) {
      alert('Error: No request ID provided');
      return;
    }

    openConfirmModal({
      title: 'Archive request?',
      message: 'This blood request will be archived from the active register. Its coordination and donation history is preserved.',
      button: 'Archive',
      buttonClass: 'bg-red-600 hover:bg-red-700',
      icon: 'danger',
      onSubmit: function () {
        fetch(`/admin/delete-request/${requestId}`, {
          method: 'DELETE',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': window.getCsrfToken() }
      })
        .then(response => {

          if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
          }
          return response.json();
        })
        .then(data => {
          if (data.success) {
            alert('Request archived. Coordination history is preserved.');
            window.location.reload();
          } else {
            alert('Error: ' + (data.message || 'Unknown error'));
          }
        })
        .catch(error => {
          console.error('Delete error:', error);
          alert('Error archiving request: ' + error.message);
        });
      }
    });
  }


  // Bulk actions functionality
  function selectAllRequests() {
    const checkboxes = document.querySelectorAll('input[name="selectedRequests"]:not(:disabled)');
    const selectAllCheckbox = document.getElementById('selectAll');

    checkboxes.forEach(checkbox => {
      checkbox.checked = selectAllCheckbox.checked;
    });

    updateBulkActionsVisibility();
  }

  function updateBulkActionsVisibility() {
    const selectedCheckboxes = document.querySelectorAll('input[name="selectedRequests"]:checked:not(:disabled)');
    const bulkActions = document.getElementById('bulkActions');

    if (selectedCheckboxes.length > 0) {
      bulkActions.classList.remove('hidden');
    } else {
      bulkActions.classList.add('hidden');
    }
  }

  function bulkDelete() {
    const selectedCheckboxes = document.querySelectorAll('input[name="selectedRequests"]:checked:not(:disabled)');
    const requestIds = Array.from(selectedCheckboxes).map(cb => cb.value);

    if (requestIds.length === 0) {
      alert('Please select closed requests to archive');
      return;
    }

    openConfirmModal({
      title: 'Archive requests?',
      message: `${requestIds.length} request(s) will be archived from the active register. Its coordination and donation history is preserved.`,
      button: 'Archive selected',
      buttonClass: 'bg-red-600 hover:bg-red-700',
      icon: 'danger',
      onSubmit: function () {
        Promise.all(requestIds.map(id =>
          fetch(`/admin/delete-request/${id}`, {
            method: 'DELETE',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': window.getCsrfToken() }
          }).then(r => r.json())
        ))
          .then(results => {
            const successful = results.filter(r => r.success).length;
            alert(`${successful} of ${requestIds.length} requests archived`);
            location.reload();
          })
          .catch(error => {
            alert('Error processing bulk archive');
            console.error(error);
          });
      }
    });
  }
</script>
