{{#if isAdmin}}
{{> admin-head}}
{{else}}
{{> head}}
{{/if}}



{{#if isAdmin}}
{{> admin-sidebar}}
{{> internal-header}}


{{else}}

{{> user-sidebar}}

<!-- Single Top Navigation Bar -->
{{> internal-header}}

{{/if}}

<!-- Messages Content -->
<main id="main-content" tabindex="-1" class="vm-messages vm-page flex chat-container" data-has-conversation="{{#if selectedUser}}true{{else}}false{{/if}}">
  
  <!-- Conversations List (Left Panel) -->
  <div class="vm-conversation-pane bg-white dark:bg-[#18181b] border-r">
    <div class="p-4 border-b">
      <div class="vm-messages__list-heading"><div><h1 class="text-xl font-bold text-gray-800 dark:text-gray-200">Messages</h1><p>{{conversations.length}} conversations</p></div><span aria-hidden="true"><svg fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8z"/></svg></span></div>
      <input 
        type="text" 
        id="conversationSearch"
        placeholder="Search conversations..." 
        class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500"
      aria-label="Search conversations...">
    </div>
    
    <div class="conversation-list">
      {{#if conversations.length}}
        {{#each conversations}}
          <a href="/messages?userId={{otherUserId}}" data-conversation-search="{{otherUserName}} {{lastMessage}}" {{#if isActive}}aria-current="page"{{/if}} class="vm-conversation-link hover:bg-gray-50 dark:bg-[#27272a] transition {{#if isActive}}bg-red-50{{/if}}">
            <div class="flex items-center space-x-3">
              <div class="vm-surface-muted w-12 h-12 rounded-full flex items-center justify-center text-white font-bold flex-shrink-0">
                {{otherUserInitial}}
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between mb-1">
                  <p class="font-semibold text-gray-800 dark:text-gray-200 truncate">{{otherUserName}}</p>
                  <span class="text-xs text-gray-500 dark:text-gray-400">{{timeAgo}}</span>
                </div>
                <p class="text-sm text-gray-600 dark:text-gray-400 truncate">{{lastMessage}}</p>
                {{#if unreadCount}}
                  <span class="vm-status vm-status--info inline-block mt-1 bg-red-500 text-white text-xs rounded-full px-2 py-0.5">{{unreadCount}} new</span>
                {{/if}}
              </div>
            </div>
          </a>
        {{/each}}
      {{else}}
        <div class="p-8 text-center">
          <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
          </svg>
          <p class="text-gray-500 dark:text-gray-400">No conversations yet</p>
          <p class="text-sm text-gray-400 mt-2">Start messaging donors or beneficiaries</p>
        </div>
      {{/if}}
    </div>
  </div>
  
  <!-- Chat Area (Right Panel) -->
  <div class="vm-chat-pane flex-1 flex flex-col">
    {{#if selectedUser}}
      <!-- Chat Header -->
      <a href="/messages" class="vm-button vm-button--small vm-chat-back m-3 self-start">Back to conversations</a>
      <div class="vm-panel p-4 bg-white dark:bg-[#18181b] border-b flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="vm-surface-muted w-10 h-10 rounded-full flex items-center justify-center text-white font-bold">
            {{selectedUser.selectedUserInitial}}
          </div>
          <div>
            <p class="font-semibold text-gray-800 dark:text-gray-200">{{selectedUser.selectedUserName}}</p>
          </div>
        </div>
        <div class="flex items-center space-x-2">
          <!-- Audio Call Button -->
          <button onclick="initiateAudioCall()" class="vm-button p-2 text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:bg-[#09090b] rounded-lg transition" title="Audio Call" aria-label="Start audio call">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </button>
          
          <!-- Video Call Button -->
          <button onclick="initiateVideoCall()" class="vm-button p-2 text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:bg-[#09090b] rounded-lg transition" title="Video Call" aria-label="Start video call">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
          </button>
          
          <div class="relative">
            <button onclick="toggleThreadMenu(event)" title="Conversation options"
              class="vm-button p-2 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg transition" aria-label="Conversation options">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"/>
              </svg>
            </button>
            <div id="threadMenu"
              class="hidden absolute right-0 mt-2 w-56 bg-white dark:bg-[#18181b] border border-gray-200 dark:border-gray-800 rounded-md z-50 overflow-hidden">
              <button onclick="toggleThreadSearch();toggleThreadMenu();"
                class="vm-button vm-button--small w-full flex items-center px-4 py-3 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition">
                <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                Search in conversation
              </button>
              <button onclick="window.location.reload();"
                class="vm-button vm-button--small w-full flex items-center px-4 py-3 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition">
                <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                Refresh conversation
              </button>
              <a href="/messages"
                class="vm-button vm-button--small flex items-center px-4 py-3 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition">
                <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
                Close conversation
              </a>
            </div>
          </div>
        </div>
      </div>
      
      <!-- In-Conversation Search (hidden until toggled from the menu) -->
      <div id="threadSearchBar" class="hidden px-4 py-2 bg-white dark:bg-[#18181b] border-b">
        <div class="relative">
          <input type="text" id="threadSearchInput" placeholder="Search messages..."
            class="w-full pl-10 pr-4 py-2 border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent bg-white dark:bg-[#27272a] text-gray-800 dark:text-gray-200 text-sm" aria-label="Search messages...">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
        </div>
        <p id="threadSearchCount" class="text-xs text-gray-500 dark:text-gray-400 mt-1 hidden"></p>
      </div>

      <!-- Messages Area -->
      <div class="messages-list p-4 space-y-4">
        {{#each messages}}
          {{#if isSender}}
            <!-- Sent Message -->
            <div class="flex justify-end">
              <div class="max-w-xs lg:max-w-md">
                {{#if (eq messageType 'voice')}}
                  <!-- Voice Message (Sent) -->
                  <div class="vm-message-sent bg-red-600 text-white rounded-lg rounded-tr-none px-4 py-3">
                    <div class="flex items-center space-x-3">
                      <button onclick="playVoiceMessage('{{audioFilePath}}', this)" class="vm-button flex-shrink-0">
                        <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M8 5v14l11-7z"/>
                        </svg>
                      </button>
                      <div class="flex-1">
                        <div class="h-8 flex items-center">
                          <div class="voice-waveform" data-waveform="{{waveformData}}"></div>
                        </div>
                        <p class="text-xs mt-1">{{audioDuration}}s</p>
                      </div>
                    </div>
                  </div>
                {{else}}
                  <!-- Text Message (Sent) -->
                  <div class="vm-message-sent bg-red-600 text-white rounded-lg rounded-tr-none px-4 py-2">
                    <p class="whitespace-pre-wrap">{{message}}</p>
                  </div>
                {{/if}}
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 text-right">{{timestamp}}</p>
              </div>
            </div>
          {{else}}
            <!-- Received Message -->
            <div class="flex justify-start">
              <div class="max-w-xs lg:max-w-md">
                {{#if (eq messageType 'voice')}}
                  <!-- Voice Message (Received) -->
                  <div class="vm-message-received bg-gray-200 dark:bg-gray-700 text-gray-800 dark:text-gray-200 rounded-lg rounded-tl-none px-4 py-3">
                    <div class="flex items-center space-x-3">
                      <button onclick="playVoiceMessage('{{audioFilePath}}', this)" class="vm-button flex-shrink-0">
                        <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M8 5v14l11-7z"/>
                        </svg>
                      </button>
                      <div class="flex-1">
                        <div class="h-8 flex items-center">
                          <div class="voice-waveform" data-waveform="{{waveformData}}"></div>
                        </div>
                        <p class="text-xs mt-1">{{audioDuration}}s</p>
                      </div>
                    </div>
                  </div>
                {{else}}
                  <!-- Text Message (Received) -->
                  <div class="vm-message-received bg-gray-200 dark:bg-gray-700 text-gray-800 dark:text-gray-200 rounded-lg rounded-tl-none px-4 py-2">
                    <p class="whitespace-pre-wrap">{{message}}</p>
                  </div>
                {{/if}}
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">{{timestamp}}</p>
              </div>
            </div>
          {{/if}}
        {{/each}}
      </div>
      
      <p id="callAvailability" class="vm-muted text-xs px-4" aria-live="polite">Connecting calling service...</p>
      <!-- Message Input -->
      <div class="vm-panel p-4 bg-white dark:bg-[#18181b] border-t">
        <!-- Normal Message Input -->
        <form id="text-message-form" action="/messages/send" method="POST" class="flex items-center space-x-2">
          <input type="hidden" name="_csrf" value="{{csrfToken}}">
          <input type="hidden" name="recipientId" value="{{selectedUser.selectedUserId}}" />
          
          <!-- Microphone Button -->
          <button type="button" aria-label="Record a voice message" id="mic-btn" onclick="startVoiceRecording()" class="vm-button p-3 text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:bg-[#09090b] rounded-lg transition">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
            </svg>
          </button>
          
          <input 
            type="text" 
            name="message"
            id="message-input"
            placeholder="Type a message..." 
            class="flex-1 px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500"
            required
          aria-label="Type a message...">
          <button type="submit" aria-label="Send message" class="vm-button vm-button--primary bg-red-600 text-white p-3 rounded-lg hover:bg-red-700 transition">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
            </svg>
          </button>
        </form>
        
        <!-- Voice Recording Interface (Hidden by default) -->
        <div id="voice-recording-ui" class="hidden">
          <div class="flex items-center space-x-4 bg-red-50 p-4 rounded-lg">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-red-600 rounded-full flex items-center justify-center animate-pulse">
                <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3z"/>
                </svg>
              </div>
            </div>
            <div class="flex-1">
              <p class="text-sm text-gray-600 dark:text-gray-400 mb-1">Recording...</p>
              <div class="flex items-center space-x-2">
                <canvas id="recording-waveform" width="200" height="40" class="bg-white dark:bg-[#18181b] rounded"></canvas>
                <span id="recording-time" class="text-lg tabular-nums text-red-600">0:00</span>
              </div>
            </div>
            <button onclick="cancelVoiceRecording()" class="vm-button p-2 text-gray-600 dark:text-gray-400 hover:bg-white dark:bg-[#18181b] rounded-lg transition" aria-label="Record voice message">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
            <button onclick="stopVoiceRecording()" class="vm-button vm-button--primary bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition">
              Send
            </button>
          </div>
        </div>
      </div>
    {{else}}
      <!-- No Chat Selected -->
      <div class="flex-1 flex items-center justify-center">
        <div class="text-center">
          <svg class="w-24 h-24 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
          </svg>
          <p class="text-xl text-gray-500 dark:text-gray-400 mb-2">Select a conversation</p>
          <p class="text-gray-400">Choose a conversation from the list to start messaging</p>
        </div>
      </div>
    {{/if}}
  </div>
  
</main>



<script>
  {{#if selectedUser}}const otherUserId = {{selectedUser.selectedUserId}};{{else}}const otherUserId = null;{{/if}}
  // Call initiation functions
  function initiateAudioCall() {
    if (window.callManager && otherUserId) {
      window.callManager.initiateCall(otherUserId, 'audio');
    }
  }
  
  function initiateVideoCall() {
    if (window.callManager && otherUserId) {
      window.callManager.initiateCall(otherUserId, 'video');
    }
  }
  
  // Voice Recording System
  let mediaRecorder = null;
  let audioChunks = [];
  let recordingStartTime = null;
  let recordingInterval = null;
  let audioContext = null;
  let analyser = null;
  let dataArray = null;
  
  let recordingCancelled = false;
  async function startVoiceRecording() {
    recordingCancelled = false;
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      
      if (!window.MediaRecorder || !MediaRecorder.isTypeSupported('audio/webm')) { stream.getTracks().forEach(track => track.stop()); alert('Voice recording is not supported by this browser. Use text messaging.'); return; }
      mediaRecorder = new MediaRecorder(stream, { mimeType: 'audio/webm' });
      audioChunks = [];
      
      // Set up audio visualization
      audioContext = new (window.AudioContext || window.webkitAudioContext)();
      const source = audioContext.createMediaStreamSource(stream);
      analyser = audioContext.createAnalyser();
      analyser.fftSize = 256;
      source.connect(analyser);
      dataArray = new Uint8Array(analyser.frequencyBinCount);
      
      mediaRecorder.ondataavailable = (event) => {
        audioChunks.push(event.data);
      };
      
      mediaRecorder.onstop = async () => {
        const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
        try { if (!recordingCancelled && audioBlob.size > 0) await sendVoiceMessage(audioBlob); } finally { stream.getTracks().forEach(track => track.stop()); if (audioContext) audioContext.close(); }
      };
      
      mediaRecorder.start();
      recordingStartTime = Date.now();
      
      // Show recording UI
      document.getElementById('text-message-form').classList.add('hidden');
      document.getElementById('voice-recording-ui').classList.remove('hidden');
      
      // Start timer and waveform
      updateRecordingTime();
      drawWaveform();
      
    } catch (error) {
      console.error('Error starting recording:', error);
      alert('Microphone access is required to record voice messages. Please enable it in your browser settings.');
    }
  }
  
  function stopVoiceRecording() {
    if (mediaRecorder && mediaRecorder.state !== 'inactive') {
      mediaRecorder.stop();
      clearInterval(recordingInterval);
      
      // Hide recording UI
      document.getElementById('voice-recording-ui').classList.add('hidden');
      document.getElementById('text-message-form').classList.remove('hidden');
    }
  }
  
  function cancelVoiceRecording() {
    recordingCancelled = true;
    if (mediaRecorder && mediaRecorder.state !== 'inactive') {
      mediaRecorder.stop();
      mediaRecorder.stream.getTracks().forEach(track => track.stop());
      clearInterval(recordingInterval);
      audioChunks = [];
      
      // Hide recording UI
      document.getElementById('voice-recording-ui').classList.add('hidden');
      document.getElementById('text-message-form').classList.remove('hidden');
    }
  }
  
  function updateRecordingTime() {
    recordingInterval = setInterval(() => {
      const elapsed = Math.floor((Date.now() - recordingStartTime) / 1000);
      const minutes = Math.floor(elapsed / 60);
      const seconds = elapsed % 60;
      document.getElementById('recording-time').textContent = 
        `${minutes}:${seconds.toString().padStart(2, '0')}`;
      
      // Auto-stop at 120 seconds
      if (elapsed >= 120) {
        stopVoiceRecording();
      }
    }, 1000);
  }
  
  function drawWaveform() {
    const canvas = document.getElementById('recording-waveform');
    const ctx = canvas.getContext('2d');
    
    function draw() {
      if (!analyser) return;
      
      requestAnimationFrame(draw);
      analyser.getByteTimeDomainData(dataArray);
      
      ctx.fillStyle = 'rgb(255, 255, 255)';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.lineWidth = 2;
      ctx.strokeStyle = 'rgb(220, 38, 38)';
      ctx.beginPath();
      
      const sliceWidth = canvas.width / dataArray.length;
      let x = 0;
      
      for (let i = 0; i < dataArray.length; i++) {
        const v = dataArray[i] / 128.0;
        const y = v * canvas.height / 2;
        
        if (i === 0) {
          ctx.moveTo(x, y);
        } else {
          ctx.lineTo(x, y);
        }
        
        x += sliceWidth;
      }
      
      ctx.lineTo(canvas.width, canvas.height / 2);
      ctx.stroke();
    }
    
    draw();
  }
  
  async function sendVoiceMessage(audioBlob) {
    const duration = Math.floor((Date.now() - recordingStartTime) / 1000);
    {{#if selectedUser}}
    const receiverId = {{selectedUser.selectedUserId}};
    {{else}}
    const receiverId = null;
    {{/if}}
    
    if (!receiverId) {
      alert('Please select a conversation first.');
      return;
    }
    
    const formData = new FormData();
    formData.append('audio', audioBlob, 'voice-message.webm');
    formData.append('recipientId', receiverId);
    formData.append('duration', duration);
    
    try {
      const response = await fetch('/messages/send-voice', {
        method: 'POST',
        body: formData
      });
      
      if (response.ok) {
        // Reload page to show new message
        window.location.reload();
      } else {
        alert('Failed to send voice message. Please try again.');
      }
    } catch (error) {
      console.error('Error sending voice message:', error);
      alert('Failed to send voice message. Please check your connection.');
    }
  }
  
  // Thread options menu
  function toggleThreadMenu(event) {
    if (event) event.stopPropagation();
    document.getElementById('threadMenu').classList.toggle('hidden');
  }

  document.addEventListener('click', function (e) {
    const menu = document.getElementById('threadMenu');
    if (menu && !menu.classList.contains('hidden') && !menu.contains(e.target)) {
      menu.classList.add('hidden');
    }
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      const menu = document.getElementById('threadMenu');
      if (menu) menu.classList.add('hidden');
    }
  });

  // In-conversation search: filters message bubbles client-side
  function toggleThreadSearch() {
    const bar = document.getElementById('threadSearchBar');
    const input = document.getElementById('threadSearchInput');
    bar.classList.toggle('hidden');
    if (!bar.classList.contains('hidden')) {
      input.focus();
    } else {
      input.value = '';
      filterThreadMessages('');
    }
  }

  function filterThreadMessages(query) {
    const q = query.trim().toLowerCase();
    let visible = 0;
    let total = 0;
    document.querySelectorAll('.messages-list > div').forEach(function (bubble) {
      total++;
      const match = q === '' || bubble.textContent.toLowerCase().includes(q);
      bubble.classList.toggle('hidden', !match);
      if (match) visible++;
    });
    const count = document.getElementById('threadSearchCount');
    if (q === '') {
      count.classList.add('hidden');
    } else {
      count.textContent = visible === 0 ? 'No messages match' : visible + ' of ' + total + ' messages';
      count.classList.remove('hidden');
    }
  }

  // Jump straight to the latest message instead of the top of the thread
  function scrollToLatestMessage() {
    var list = document.querySelector('.messages-list');
    if (!list) return;
    list.scrollTop = list.scrollHeight;
    var parent = list.parentElement;
    while (parent && parent !== document.body) {
      var style = window.getComputedStyle(parent);
      if (/(auto|scroll)/.test(style.overflowY) && parent.scrollHeight > parent.clientHeight) {
        parent.scrollTop = parent.scrollHeight;
        break;
      }
      parent = parent.parentElement;
    }
  }

  document.addEventListener('DOMContentLoaded', function () {
    scrollToLatestMessage();
    const conversationSearch = document.getElementById('conversationSearch');
    const conversationList = document.querySelector('.conversation-list');
    if (conversationSearch && conversationList) {
      const conversations = Array.from(conversationList.querySelectorAll('.vm-conversation-link'));
      const noMatches = document.createElement('p');
      noMatches.className = 'vm-empty-state p-6 text-center';
      noMatches.textContent = 'No conversations match your search.';
      noMatches.hidden = true;
      conversationList.append(noMatches);
      conversationSearch.addEventListener('input', function () {
        const query = conversationSearch.value.trim().toLowerCase();
        let visible = 0;
        conversations.forEach(function (conversation) {
          const matches = (conversation.dataset.conversationSearch || conversation.textContent).toLowerCase().includes(query);
          conversation.hidden = !matches;
          if (matches) visible++;
        });
        noMatches.hidden = visible > 0 || conversations.length === 0;
      });
    }
    const threadInput = document.getElementById('threadSearchInput');
    if (threadInput) {
      threadInput.addEventListener('input', function () { filterThreadMessages(threadInput.value); });
    }
  });

  // Voice Message Playback
  let currentAudio = null;
  
  function playVoiceMessage(audioPath, button) {
    // Stop any currently playing audio
    if (currentAudio) {
      currentAudio.pause();
      currentAudio = null;
    }
    
    // Create new audio element
    currentAudio = new Audio(audioPath);
    
    // Change button to pause icon
    button.innerHTML = `
      <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
        <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/>
      </svg>
    `;
    
    currentAudio.play();
    
    currentAudio.onended = () => {
      // Change button back to play icon
      button.innerHTML = `
        <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
      `;
      currentAudio = null;
    };
    
    // Allow pausing
    button.onclick = () => {
      if (currentAudio && !currentAudio.paused) {
        currentAudio.pause();
        button.innerHTML = `
          <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
        `;
        currentAudio = null;
      } else {
        playVoiceMessage(audioPath, button);
      }
    };
  }
</script>

<!-- Call Container (for UI elements) -->
<div id="call-container"></div>

{{> footer}}
