{{> head}}

{{> user-sidebar}}

<!-- Navigation Bar -->
<nav class="bg-white shadow-md">
  <div class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <!-- Back Button & Logo/Brand -->
      <div class="flex items-center space-x-1 sm:space-x-3">
        <label for="sidebar-toggle" class="cursor-pointer p-1 sm:p-2 -ml-2 text-gray-600 hover:text-red-600 hover:bg-gray-100 rounded-lg transition-colors" title="Menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </label>
        <div class="flex items-center space-x-1 sm:space-x-2">
          <svg class="w-6 h-6 sm:w-8 sm:h-8 text-red-600" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.94-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" />
          </svg>
          <a href="/dashboard" class="text-xl sm:text-2xl font-bold text-gray-800">VitalMatch</a>
        </div>
      </div>

      <!-- User Menu -->
      <div class="flex items-center space-x-4">
        <a href="/dashboard" class="text-gray-700 hover:text-red-600 transition">Dashboard</a>
        <a href="/logout" class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition">Logout</a>
      </div>
    </div>
  </div>
</nav>

<!-- Donor Profile Content -->
<div class="min-h-screen bg-gray-50 py-12">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto">

      <!-- Header -->
      <div class="bg-gradient-to-r from-blue-600 to-red-600 rounded-xl shadow-lg p-8 mb-8 text-white">
        <h1 class="text-3xl font-bold mb-2">Donor Profile</h1>
        <p class="text-white/90">Manage your donor information and availability status</p>
      </div>

      <!-- Enhanced Profile Card with Interactions -->
      <div class="bg-white rounded-xl shadow-md p-8 relative">
        <!-- Loading Overlay -->
        <div id="loadingOverlay"
          class="hidden absolute inset-0 bg-white bg-opacity-90 flex items-center justify-center z-50 rounded-xl">
          <div class="text-center">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto mb-4"></div>
            <p class="text-gray-600 font-semibold">Saving your profile...</p>
            <p class="text-gray-500 text-sm">Please wait while we update your information</p>
          </div>
        </div>

        <form id="donorProfileForm" action="/donor-profile" method="POST" novalidate>
          <input type="hidden" name="_csrf" value="{{csrfToken}}">

          <!-- Step Indicator -->
          <div class="mb-6">
            <div class="flex items-center justify-between mb-4">
              <span class="text-sm font-semibold text-gray-600">Step <span id="donorStepNumber">1</span> of 4</span>
              <span id="progressText" class="text-sm text-gray-500">0% Complete</span>
            </div>
            <div class="flex items-center mb-4">
              <div class="donor-step-pill flex-1 text-center text-xs font-semibold py-2 rounded-l-lg" data-step-pill="1">1. Personal</div>
              <div class="donor-step-pill flex-1 text-center text-xs font-semibold py-2" data-step-pill="2">2. Contact</div>
              <div class="donor-step-pill flex-1 text-center text-xs font-semibold py-2" data-step-pill="3">3. Medical</div>
              <div class="donor-step-pill flex-1 text-center text-xs font-semibold py-2 rounded-r-lg" data-step-pill="4">4. Finish</div>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2">
              <div id="progressBar"
                class="bg-gradient-to-r from-blue-500 to-green-500 h-2 rounded-full transition-all duration-300"
                style="width: 0%"></div>
            </div>
          </div>

          <!-- Personal Information Section -->
          <div class="mb-8 donor-step" data-step="1">
            <h2 class="text-2xl font-bold text-gray-800 mb-4 flex items-center">
              <svg class="w-6 h-6 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              Personal Information
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              <div class="form-group">
                <label class="block text-gray-700 font-semibold mb-2">
                  Full Name *
                  <span class="tooltip-trigger ml-1 cursor-help"
                    data-tooltip="Enter your complete legal name as it appears on your ID">
                    <svg class="w-4 h-4 inline text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </span>
                </label>
                <input type="text" name="fullName" id="fullName" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                  placeholder="Enter your full name" data-validate="required,minLength:2">
                <div class="error-message hidden text-red-600 text-sm mt-1"></div>
                <div class="success-message hidden text-green-600 text-sm mt-1">
                  <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd" />
                  </svg>
                  Valid name entered
                </div>
              </div>

              <div class="form-group">
                <label class="block text-gray-700 font-semibold mb-2">
                  Date of Birth *
                  <span class="tooltip-trigger ml-1 cursor-help"
                    data-tooltip="You must be between 18-65 years old to donate blood">
                    <svg class="w-4 h-4 inline text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </span>
                </label>
                <input type="date" name="dateOfBirth" id="dateOfBirth" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                  data-validate="required,age">
                <div class="error-message hidden text-red-600 text-sm mt-1"></div>
                <div class="success-message hidden text-green-600 text-sm mt-1">
                  <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd" />
                  </svg>
                  <span id="ageDisplay">Valid age</span>
                </div>
              </div>

              <div class="form-group">
                <label class="block text-gray-700 font-semibold mb-2">Gender *</label>
                <select name="gender" id="gender" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                  data-validate="required">
                  <option value="">Select gender</option>
                  <option value="male">Male</option>
                  <option value="female">Female</option>
                  <option value="other">Other</option>
                </select>
                <div class="error-message hidden text-red-600 text-sm mt-1"></div>
                <div class="success-message hidden text-green-600 text-sm mt-1">
                  <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd" />
                  </svg>
                  Gender selected
                </div>
              </div>

              <div class="form-group">
                <label class="block text-gray-700 font-semibold mb-2">
                  Blood Type *
                  <span class="tooltip-trigger ml-1 cursor-help"
                    data-tooltip="Your blood type determines who you can donate to and receive from">
                    <svg class="w-4 h-4 inline text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </span>
                </label>
                <select name="bloodType" id="bloodType" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                  data-validate="required">
                  <option value="">Select blood type</option>
                  <option value="A+">A+ (A Positive)</option>
                  <option value="A-">A- (A Negative)</option>
                  <option value="B+">B+ (B Positive)</option>
                  <option value="B-">B- (B Negative)</option>
                  <option value="AB+">AB+ (AB Positive)</option>
                  <option value="AB-">AB- (AB Negative)</option>
                  <option value="O+">O+ (O Positive)</option>
                  <option value="O-">O- (O Negative - Universal Donor)</option>
                </select>
                <div class="error-message hidden text-red-600 text-sm mt-1"></div>
                <div class="success-message hidden text-green-600 text-sm mt-1">
                  <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd" />
                  </svg>
                  Blood type selected
                </div>
                <div id="bloodTypeInfo" class="hidden mt-2 p-3 bg-blue-50 rounded-lg text-sm text-blue-800"></div>
              </div>

              <div class="form-group">
                <label class="block text-gray-700 font-semibold mb-2">
                  Weight (kg) *
                  <span class="tooltip-trigger ml-1 cursor-help"
                    data-tooltip="Minimum weight requirement is 50kg for blood donation">
                    <svg class="w-4 h-4 inline text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </span>
                </label>
                <input type="number" name="weight" id="weight" required min="40" max="200"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                  placeholder="Enter weight" data-validate="required,min:50,max:200">
                <div class="error-message hidden text-red-600 text-sm mt-1"></div>
                <div class="success-message hidden text-green-600 text-sm mt-1">
                  <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd" />
                  </svg>
                  Weight meets requirements
                </div>
              </div>

              <div class="form-group">
                <label class="block text-gray-700 font-semibold mb-2">Height (cm) *</label>
                <input type="number" name="height" id="height" required min="100" max="250"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                  placeholder="Enter height" data-validate="required,min:100,max:250">
                <div class="error-message hidden text-red-600 text-sm mt-1"></div>
                <div class="success-message hidden text-green-600 text-sm mt-1">
                  <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd" />
                  </svg>
                  Valid height entered
                </div>
                <div id="bmiDisplay" class="hidden mt-2 text-sm text-gray-600"></div>
              </div>
            </div>
          </div>

          <!-- Contact Information Section -->
          <div class="mb-8 donor-step hidden" data-step="2">
            <h2 class="text-2xl font-bold text-gray-800 mb-4 flex items-center">
              <svg class="w-6 h-6 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              Contact Information
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-gray-700 font-semibold mb-2">Mobile Number *</label>
                <input type="tel" name="mobileNumber" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  placeholder="09XX-XXX-XXXX">
              </div>

              <div>
                <label class="block text-gray-700 font-semibold mb-2">Email Address *</label>
                <input type="email" name="email" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  placeholder="email@example.com">
              </div>
            </div>
          </div>

          <!-- Address Information Section -->
          <div class="mb-8 donor-step hidden" data-step="2">
            <h2 class="text-2xl font-bold text-gray-800 mb-4 flex items-center">
              <svg class="w-6 h-6 text-red-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              Address Information
            </h2>

            <div class="grid grid-cols-1 gap-6">
              <div>
                <label class="block text-gray-700 font-semibold mb-2">Complete Address *</label>
                <input type="text" name="address" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  placeholder="House No., Street, Barangay">
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div>
                  <label class="block text-gray-700 font-semibold mb-2">City *</label>
                  <div data-city-wrap>
                    <select name="city" data-city-select required
                      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white">
                      <option value="">Select municipality</option>
                      <option>Baco</option>
                      <option>Bansud</option>
                      <option>Bongabong</option>
                      <option>Bulalacao</option>
                      <option>Calapan City</option>
                      <option>Gloria</option>
                      <option>Mansalay</option>
                      <option>Naujan</option>
                      <option>Pinamalayan</option>
                      <option>Pola</option>
                      <option>Puerto Galera</option>
                      <option>Roxas</option>
                      <option>San Teodoro</option>
                      <option>Socorro</option>
                      <option>Victoria</option>
                      <option value="__other">Others (specify)</option>
                    </select>
                    <input type="text" data-city-other placeholder="Specify municipality"
                      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent mt-2 hidden">
                  </div>
                </div>

                <div>
                  <label class="block text-gray-700 font-semibold mb-2">Province *</label>
                  <input type="text" name="province" required
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                    placeholder="Enter province">
                </div>

                <div>
                  <label class="block text-gray-700 font-semibold mb-2">Zip Code *</label>
                  <input type="text" name="zipCode" required
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                    placeholder="Enter zip code">
                </div>
              </div>
            </div>
            <input type="hidden" name="latitude" id="donorLatitude">
            <input type="hidden" name="longitude" id="donorLongitude">
          </div>

          <!-- Medical Information Section -->
          <div class="mb-8 donor-step hidden" data-step="3">
            <h2 class="text-2xl font-bold text-gray-800 mb-4 flex items-center">
              <svg class="w-6 h-6 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              Medical Information
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-gray-700 font-semibold mb-2">Last Donation Date</label>
                <input type="date" name="lastDonationDate"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
              </div>

              <div>
                <label class="block text-gray-700 font-semibold mb-2">Medical Conditions</label>
                <textarea name="medicalConditions" rows="2"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  placeholder="List any medical conditions..."></textarea>
              </div>
            </div>
          </div>

          <!-- Availability Status Section -->
          <div class="mb-8 donor-step hidden" data-step="4">
            <h2 class="text-2xl font-bold text-gray-800 mb-4 flex items-center">
              <svg class="w-6 h-6 text-orange-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Availability Status
            </h2>

            <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
              <div class="flex items-start space-x-4">
                <input type="checkbox" name="isAvailable" id="isAvailable"
                  class="mt-1 w-5 h-5 text-blue-600 border-gray-300 rounded focus:ring-blue-500">
                <div class="flex-1">
                  <label for="isAvailable" class="text-gray-800 font-semibold cursor-pointer">I am currently available
                    to donate blood</label>
                  <p class="text-gray-600 text-sm mt-1">Check this box if you are willing and able to donate blood. You
                    will receive notifications when there are matching blood requests in your area.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Emergency Contact Section -->
          <div class="mb-8 donor-step hidden" data-step="4">
            <h2 class="text-2xl font-bold text-gray-800 mb-4 flex items-center">
              <svg class="w-6 h-6 text-red-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              Emergency Contact
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              <div>
                <label class="block text-gray-700 font-semibold mb-2">Emergency Contact Name *</label>
                <input type="text" name="emergencyContactName" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  placeholder="Enter contact name">
              </div>

              <div>
                <label class="block text-gray-700 font-semibold mb-2">Emergency Contact Number *</label>
                <input type="tel" name="emergencyContactNumber" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  placeholder="09XX-XXX-XXXX">
              </div>

              <div>
                <label class="block text-gray-700 font-semibold mb-2">Relationship *</label>
                <input type="text" name="emergencyContactRelationship" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  placeholder="e.g., Spouse, Parent, Sibling">
              </div>
            </div>
          </div>

          <!-- Wizard Navigation -->
          <div class="flex justify-between items-center">
            <button type="button" id="donorWizardBack"
              class="px-6 py-3 border border-gray-300 rounded-lg text-gray-700 font-semibold hover:bg-gray-50 transition invisible">
              &larr; Back
            </button>
            <button type="button" id="donorWizardNext"
              class="px-8 py-3 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition shadow-lg hover:shadow-xl">
              Next &rarr;
            </button>
            <button type="submit" id="donorSubmitBtn"
              class="hidden px-8 py-3 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition shadow-lg hover:shadow-xl transform hover:-translate-y-1">
              Save Donor Profile
            </button>
          </div>

        </form>
      </div>

      <!-- Help Text -->
      <div class="mt-6 bg-green-50 border border-green-200 rounded-lg p-4">
        <div class="flex items-start">
          <svg class="w-6 h-6 text-green-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor"
            viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div>
            <p class="text-green-800 font-semibold mb-1">Donor Eligibility Requirements</p>
            <ul class="text-green-700 text-sm space-y-1 list-disc list-inside">
              <li>Must be at least 18 years old and not more than 65 years old</li>
              <li>Must weigh at least 50 kg (110 lbs)</li>
              <li>Must be in good health and feeling well</li>
              <li>Must wait at least 3 months between blood donations</li>
            </ul>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

{{> footer}}

{{#if donor}}
<script type="application/json" id="donor-data">{{{donorJson}}}</script>
<script>
  // Pre-fill the form when editing an existing donor profile
  (function () {
    try {
      var data = JSON.parse(document.getElementById("donor-data").textContent);
      if (!data) return;
      var form = document.getElementById("donorProfileForm");
      Object.keys(data).forEach(function (key) {
        var field = form.querySelector("[name=\"" + key + "\"]");
        if (!field || data[key] === null || data[key] === undefined || data[key] === "") return;
        if (field.type === "checkbox") {
          field.checked = !!data[key];
        } else {
          field.value = data[key];
        }
        field.dispatchEvent(new Event("input", { bubbles: true }));
        field.dispatchEvent(new Event("change", { bubbles: true }));
      });
    } catch (e) {
      console.error("Could not pre-fill donor form:", e);
    }
  })();
</script>
{{/if}}

<script>
  if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(position => {
      document.getElementById('donorLatitude').value = position.coords.latitude;
      document.getElementById('donorLongitude').value = position.coords.longitude;
    }, () => {});
  }
</script>

<script>
  // Multi-step wizard for the donor form: validate each short step before advancing
  (function () {
    var currentStep = 1;
    var totalSteps = 4;
    var form = document.getElementById('donorProfileForm');
    if (!form) return;

    function validateStep(n) {
      var steps = form.querySelectorAll('.donor-step[data-step="' + n + '"]');
      for (var s = 0; s < steps.length; s++) {
        var fields = steps[s].querySelectorAll('input, select, textarea');
        for (var i = 0; i < fields.length; i++) {
          var f = fields[i];
          if (f.type === 'hidden' || f.type === 'checkbox' || f.disabled) continue;
          if (f.hasAttribute('required') && !String(f.value).trim()) {
            f.focus();
            if (f.scrollIntoView) f.scrollIntoView({ behavior: 'smooth', block: 'center' });
            f.classList.add('border-red-500');
            (function (el) { setTimeout(function () { el.classList.remove('border-red-500'); }, 2500); })(f);
            return false;
          }
        }
      }
      return true;
    }

    function showStep(n) {
      currentStep = Math.min(Math.max(n, 1), totalSteps);
      form.querySelectorAll('.donor-step').forEach(function (s) {
        s.classList.toggle('hidden', s.getAttribute('data-step') != currentStep);
      });
      document.querySelectorAll('[data-step-pill].donor-step-pill').forEach(function (p) {
        var pn = parseInt(p.getAttribute('data-step-pill'), 10);
        p.classList.remove('bg-blue-600', 'text-white', 'bg-green-100', 'text-green-700', 'bg-gray-100', 'text-gray-500');
        if (pn < currentStep) { p.classList.add('bg-green-100', 'text-green-700'); }
        else if (pn === currentStep) { p.classList.add('bg-blue-600', 'text-white'); }
        else { p.classList.add('bg-gray-100', 'text-gray-500'); }
      });
      document.getElementById('donorStepNumber').textContent = currentStep;
      document.getElementById('donorWizardBack').classList.toggle('invisible', currentStep === 1);
      document.getElementById('donorWizardNext').classList.toggle('hidden', currentStep === totalSteps);
      document.getElementById('donorSubmitBtn').classList.toggle('hidden', currentStep !== totalSteps);
      form.scrollIntoView({ behavior: 'smooth' });
    }

    document.getElementById('donorWizardNext').addEventListener('click', function () {
      if (validateStep(currentStep)) showStep(currentStep + 1);
    });
    document.getElementById('donorWizardBack').addEventListener('click', function () {
      showStep(currentStep - 1);
    });

    showStep(1);
  })();
</script>

<!-- Tooltip Container -->
<div id="tooltip"
  class="absolute z-50 px-3 py-2 text-sm text-white bg-gray-900 rounded-lg shadow-lg opacity-0 pointer-events-none transition-opacity duration-200">
  <div id="tooltipText"></div>
  <div class="tooltip-arrow absolute w-2 h-2 bg-gray-900 transform rotate-45"></div>
</div>

<script>
  // Enhanced Donor Profile Form
  class DonorProfileForm {
    constructor() {
      this.form = document.getElementById('donorProfileForm');
      this.submitBtn = document.getElementById('submitBtn');
      this.progressBar = document.getElementById('progressBar');
      this.progressText = document.getElementById('progressText');
      this.loadingOverlay = document.getElementById('loadingOverlay');

      this.totalFields = this.form.querySelectorAll('[data-validate]').length;
      this.validFields = 0;

      this.bloodTypeInfo = {
        'A+': 'Can donate to: A+, AB+ | Can receive from: A+, A-, O+, O-',
        'A-': 'Can donate to: A+, A-, AB+, AB- | Can receive from: A-, O-',
        'B+': 'Can donate to: B+, AB+ | Can receive from: B+, B-, O+, O-',
        'B-': 'Can donate to: B+, B-, AB+, AB- | Can receive from: B-, O-',
        'AB+': 'Universal Plasma Donor | Can receive from: All blood types',
        'AB-': 'Can donate to: AB+, AB- | Can receive from: AB-, A-, B-, O-',
        'O+': 'Can donate to: A+, B+, AB+, O+ | Can receive from: O+, O-',
        'O-': 'Universal Blood Donor | Can donate to: All blood types'
      };

      this.init();
    }

    init() {
      this.setupEventListeners();
      this.setupTooltips();
      this.updateProgress();
    }

    setupEventListeners() {
      // Real-time validation
      this.form.querySelectorAll('[data-validate]').forEach(field => {
        field.addEventListener('input', (e) => this.validateField(e.target));
        field.addEventListener('blur', (e) => this.validateField(e.target));
        field.addEventListener('focus', (e) => this.clearFieldErrors(e.target));
      });

      // Special handlers
      document.getElementById('bloodType').addEventListener('change', (e) => this.showBloodTypeInfo(e.target.value));
      document.getElementById('dateOfBirth').addEventListener('change', (e) => this.calculateAge(e.target.value));
      document.getElementById('weight').addEventListener('input', () => this.calculateBMI());
      document.getElementById('height').addEventListener('input', () => this.calculateBMI());

      // Form submission
      this.form.addEventListener('submit', (e) => this.handleSubmit(e));
    }

    setupTooltips() {
      const tooltip = document.getElementById('tooltip');
      const tooltipText = document.getElementById('tooltipText');

      document.querySelectorAll('.tooltip-trigger').forEach(trigger => {
        trigger.addEventListener('mouseenter', (e) => {
          const text = e.target.closest('.tooltip-trigger').dataset.tooltip;
          tooltipText.textContent = text;

          const rect = e.target.getBoundingClientRect();
          tooltip.style.left = rect.left + (rect.width / 2) - (tooltip.offsetWidth / 2) + 'px';
          tooltip.style.top = rect.top - tooltip.offsetHeight - 10 + 'px';

          tooltip.classList.remove('opacity-0');
          tooltip.classList.add('opacity-100');
        });

        trigger.addEventListener('mouseleave', () => {
          tooltip.classList.remove('opacity-100');
          tooltip.classList.add('opacity-0');
        });
      });
    }

    validateField(field) {
      const rules = field.dataset.validate.split(',');
      const value = field.value.trim();
      let isValid = true;
      let errorMessage = '';

      // Clear previous states
      this.clearFieldErrors(field);

      for (const rule of rules) {
        const [ruleName, ruleValue] = rule.split(':');

        switch (ruleName) {
          case 'required':
            if (!value) {
              isValid = false;
              errorMessage = 'This field is required';
            }
            break;

          case 'minLength':
            if (value && value.length < parseInt(ruleValue)) {
              isValid = false;
              errorMessage = `Minimum ${ruleValue} characters required`;
            }
            break;

          case 'min':
            if (value && parseInt(value) < parseInt(ruleValue)) {
              isValid = false;
              errorMessage = `Minimum value is ${ruleValue}`;
            }
            break;

          case 'max':
            if (value && parseInt(value) > parseInt(ruleValue)) {
              isValid = false;
              errorMessage = `Maximum value is ${ruleValue}`;
            }
            break;

          case 'age':
            if (value) {
              const age = this.calculateAge(value);
              if (age < 18) {
                isValid = false;
                errorMessage = 'You must be at least 18 years old to donate blood';
              } else if (age > 65) {
                isValid = false;
                errorMessage = 'Maximum age for blood donation is 65 years';
              }
            }
            break;

          case 'email':
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (value && !emailRegex.test(value)) {
              isValid = false;
              errorMessage = 'Please enter a valid email address';
            }
            break;

          case 'phone':
            const phoneRegex = /^09\d{9}$/;
            if (value && !phoneRegex.test(value.replace(/[-\s]/g, ''))) {
              isValid = false;
              errorMessage = 'Please enter a valid Philippine mobile number';
            }
            break;
        }

        if (!isValid) break;
      }

      // Update field appearance
      if (isValid && value) {
        this.showFieldSuccess(field);
      } else if (!isValid) {
        this.showFieldError(field, errorMessage);
      }

      this.updateProgress();
      return isValid;
    }

    showFieldError(field, message) {
      field.classList.add('border-red-500', 'bg-red-50');
      field.classList.remove('border-green-500', 'bg-green-50');

      const errorDiv = field.parentNode.querySelector('.error-message');
      const successDiv = field.parentNode.querySelector('.success-message');

      if (errorDiv) {
        errorDiv.textContent = message;
        errorDiv.classList.remove('hidden');
      }

      if (successDiv) {
        successDiv.classList.add('hidden');
      }
    }

    showFieldSuccess(field) {
      field.classList.add('border-green-500', 'bg-green-50');
      field.classList.remove('border-red-500', 'bg-red-50');

      const errorDiv = field.parentNode.querySelector('.error-message');
      const successDiv = field.parentNode.querySelector('.success-message');

      if (errorDiv) {
        errorDiv.classList.add('hidden');
      }

      if (successDiv) {
        successDiv.classList.remove('hidden');
      }
    }

    clearFieldErrors(field) {
      field.classList.remove('border-red-500', 'bg-red-50', 'border-green-500', 'bg-green-50');

      const errorDiv = field.parentNode.querySelector('.error-message');
      const successDiv = field.parentNode.querySelector('.success-message');

      if (errorDiv) errorDiv.classList.add('hidden');
      if (successDiv) successDiv.classList.add('hidden');
    }

    calculateAge(birthDate) {
      if (!birthDate) return 0;

      const today = new Date();
      const birth = new Date(birthDate);
      let age = today.getFullYear() - birth.getFullYear();
      const monthDiff = today.getMonth() - birth.getMonth();

      if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birth.getDate())) {
        age--;
      }

      // Update age display
      const ageDisplay = document.getElementById('ageDisplay');
      if (ageDisplay && age > 0) {
        ageDisplay.textContent = `Age: ${age} years old`;
      }

      return age;
    }

    showBloodTypeInfo(bloodType) {
      const infoDiv = document.getElementById('bloodTypeInfo');
      if (bloodType && this.bloodTypeInfo[bloodType]) {
        infoDiv.textContent = this.bloodTypeInfo[bloodType];
        infoDiv.classList.remove('hidden');
      } else {
        infoDiv.classList.add('hidden');
      }
    }

    calculateBMI() {
      const weight = parseFloat(document.getElementById('weight').value);
      const height = parseFloat(document.getElementById('height').value);
      const bmiDisplay = document.getElementById('bmiDisplay');

      if (weight && height) {
        const bmi = weight / ((height / 100) ** 2);
        const bmiCategory = this.getBMICategory(bmi);

        bmiDisplay.innerHTML = `BMI: ${bmi.toFixed(1)} - ${bmiCategory}`;
        bmiDisplay.classList.remove('hidden');
      } else {
        bmiDisplay.classList.add('hidden');
      }
    }

    getBMICategory(bmi) {
      if (bmi < 18.5) return 'Underweight';
      if (bmi < 25) return 'Normal weight';
      if (bmi < 30) return 'Overweight';
      return 'Obese';
    }

    updateProgress() {
      this.validFields = 0;

      this.form.querySelectorAll('[data-validate]').forEach(field => {
        if (this.validateField(field) && field.value.trim()) {
          this.validFields++;
        }
      });

      const progress = (this.validFields / this.totalFields) * 100;
      this.progressBar.style.width = progress + '%';
      this.progressText.textContent = Math.round(progress) + '% Complete';

      // Enable/disable submit button
      if (progress >= 80) { // Allow submission at 80% for optional fields
        this.submitBtn.disabled = false;
        this.submitBtn.classList.add('pulse-animation');
      } else {
        this.submitBtn.disabled = true;
        this.submitBtn.classList.remove('pulse-animation');
      }
    }

    handleSubmit(e) {
      // Show loading state while the form submits to the server
      this.showLoading(true);
    }

    showLoading(show) {
      if (show) {
        this.loadingOverlay.classList.remove('hidden');
        this.submitBtn.disabled = true;
      } else {
        this.loadingOverlay.classList.add('hidden');
        this.submitBtn.disabled = false;
      }
    }

    showNotification(message, type = 'info') {
      const notification = document.createElement('div');
      notification.className = `fixed top-4 right-4 z-50 p-4 rounded-lg shadow-lg transform translate-x-full transition-transform duration-300 ${type === 'error' ? 'bg-red-600 text-white' :
          type === 'success' ? 'bg-green-600 text-white' :
            'bg-blue-600 text-white'
        }`;
      notification.textContent = message;

      document.body.appendChild(notification);

      setTimeout(() => {
        notification.classList.remove('translate-x-full');
      }, 10);

      setTimeout(() => {
        notification.classList.add('translate-x-full');
        setTimeout(() => notification.remove(), 300);
      }, 5000);
    }
  }

  // Initialize form when DOM is loaded
  document.addEventListener('DOMContentLoaded', () => {
    new DonorProfileForm();
  });

  // Add pulse animation CSS
  const style = document.createElement('style');
  style.textContent = `
  .pulse-animation {
    animation: pulse 2s infinite;
  }
  
  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }
  
  .tooltip-arrow {
    bottom: -4px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
  }
`;
  document.head.appendChild(style);
</script>