{{> head}}

{{> user-sidebar}}

<!-- Navigation Bar -->
{{> internal-header}}

<!-- Donor Profile Content -->
<main id="main-content" tabindex="-1" class="vm-page min-h-screen bg-gray-50 py-12">
  <div class="vm-page-container container mx-auto px-4">
    <div class="max-w-4xl mx-auto">
      {{#if error}}<div class="vm-alert vm-alert--danger mb-4" role="alert">{{error}} <a class="vm-text-link" href="/donor-profile">Retry loading profile</a></div>{{/if}}
      {{#if error_msg}}<div class="vm-alert vm-alert--danger mb-4" role="alert">{{error_msg}}</div>{{/if}}

      <!-- Header -->
      <div class="vm-page-heading mb-8">
        <h1 class="text-3xl font-bold mb-2">Donor Profile</h1>
        <p class="text-white/90">Manage your donor information and availability status</p>
      </div>

      <!-- Enhanced Profile Card with Interactions -->
      <div class="vm-form-shell vm-panel bg-white rounded-md p-8 relative">
        <!-- Loading Overlay -->
        <div id="loadingOverlay"
          class="hidden absolute inset-0 bg-white bg-opacity-90 flex items-center justify-center z-50 rounded-md">
          <div class="text-center">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto mb-4"></div>
            <p class="text-gray-600 font-semibold">Saving your profile...</p>
            <p class="text-gray-500 text-sm">Please wait while we update your information</p>
          </div>
        </div>

        {{#unless error}}<form id="donorProfileForm" data-workspace-form action="/donor-profile" method="POST" novalidate>
          <input type="hidden" name="_csrf" value="{{csrfToken}}">

          <!-- Step Indicator -->
          <div class="mb-6">
            <div class="flex items-center justify-between mb-4">
              <span class="text-sm font-semibold text-gray-600">Step <span id="donorStepNumber">1</span> of 4</span>
              <span id="progressText" class="text-sm text-gray-500">Step 1 of 4</span>
            </div>
            <div class="flex items-center mb-4">
              <div class="donor-step-pill flex-1 text-center text-xs font-semibold py-2 rounded-l-lg" data-step-pill="1">1. Personal</div>
              <div class="donor-step-pill flex-1 text-center text-xs font-semibold py-2" data-step-pill="2">2. Contact</div>
              <div class="donor-step-pill flex-1 text-center text-xs font-semibold py-2" data-step-pill="3">3. Medical</div>
              <div class="donor-step-pill flex-1 text-center text-xs font-semibold py-2 rounded-r-lg" data-step-pill="4">4. Finish</div>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2">
              <div id="progressBar"
                class="vm-surface-muted h-2 rounded-full transition-all duration-300"
                style="width: 0%"></div>
            </div>
          </div>

          <!-- Personal Information Section -->
          <div class="mb-8 donor-step" data-step="1">
            <h2 class="text-2xl font-bold text-gray-800 mb-4 flex items-center">
              <svg class="w-6 h-6 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              Personal Information
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              <div class="form-group">
                <label class="block text-gray-700 font-semibold mb-2" for="fullName">
                  Full Name *
                  <span class="tooltip-trigger ml-1 cursor-help"
                    data-tooltip="Enter your complete legal name as it appears on your ID">
                    <svg class="w-4 h-4 inline text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </span>
                </label>
                <input type="text" name="fullName" id="fullName" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                  placeholder="Enter your full name" data-validate="required,minLength:2">
                <div class="error-message hidden text-red-600 text-sm mt-1"></div>
                <div class="success-message hidden text-green-600 text-sm mt-1">
                  <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd" />
                  </svg>
                  Valid name entered
                </div>
              </div>

              <div class="form-group">
                <label class="block text-gray-700 font-semibold mb-2" for="dateOfBirth">
                  Date of Birth *
                  <span class="tooltip-trigger ml-1 cursor-help"
                    data-tooltip="You must be between 18-65 years old to donate blood">
                    <svg class="w-4 h-4 inline text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </span>
                </label>
                <input type="date" name="dateOfBirth" id="dateOfBirth" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                  data-validate="required,age">
                <div class="error-message hidden text-red-600 text-sm mt-1"></div>
                <div class="success-message hidden text-green-600 text-sm mt-1">
                  <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd" />
                  </svg>
                  <span id="ageDisplay">Valid age</span>
                </div>
              </div>

              <div class="form-group">
                <label class="block text-gray-700 font-semibold mb-2" for="gender">Gender *</label>
                <select name="gender" id="gender" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                  data-validate="required">
                  <option value="">Select gender</option>
                  <option value="male">Male</option>
                  <option value="female">Female</option>
                  <option value="other">Other</option>
                </select>
                <div class="error-message hidden text-red-600 text-sm mt-1"></div>
                <div class="success-message hidden text-green-600 text-sm mt-1">
                  <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd" />
                  </svg>
                  Gender selected
                </div>
              </div>

              <div class="form-group">
                <label class="block text-gray-700 font-semibold mb-2" for="bloodType">
                  Blood Type *
                  <span class="tooltip-trigger ml-1 cursor-help"
                    data-tooltip="Your blood type determines who you can donate to and receive from">
                    <svg class="w-4 h-4 inline text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </span>
                </label>
                <select name="bloodType" id="bloodType" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                  data-validate="required">
                  <option value="">Select blood type</option>
                  <option value="A+">A+ (A Positive)</option>
                  <option value="A-">A- (A Negative)</option>
                  <option value="B+">B+ (B Positive)</option>
                  <option value="B-">B- (B Negative)</option>
                  <option value="AB+">AB+ (AB Positive)</option>
                  <option value="AB-">AB- (AB Negative)</option>
                  <option value="O+">O+ (O Positive)</option>
                  <option value="O-">O- (O Negative - Universal Donor)</option>
                </select>
                <div class="error-message hidden text-red-600 text-sm mt-1"></div>
                <div class="success-message hidden text-green-600 text-sm mt-1">
                  <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd" />
                  </svg>
                  Blood type selected
                </div>
                <div id="bloodTypeInfo" class="hidden mt-2 p-3 bg-blue-50 rounded-lg text-sm text-blue-800"></div>
              </div>

              <div class="form-group">
                <label class="block text-gray-700 font-semibold mb-2" for="weight">
                  Weight (kg) *
                  <span class="tooltip-trigger ml-1 cursor-help"
                    data-tooltip="Minimum weight requirement is 50kg for blood donation">
                    <svg class="w-4 h-4 inline text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </span>
                </label>
                <input type="number" name="weight" id="weight" required min="50" max="200"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                  placeholder="Enter weight" data-validate="required,min:50,max:200">
                <div class="error-message hidden text-red-600 text-sm mt-1"></div>
                <div class="success-message hidden text-green-600 text-sm mt-1">
                  <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd" />
                  </svg>
                  Weight meets requirements
                </div>
              </div>

              <div class="form-group">
                <label class="block text-gray-700 font-semibold mb-2" for="height">Height (cm) *</label>
                <input type="number" name="height" id="height" required min="100" max="250"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                  placeholder="Enter height" data-validate="required,min:100,max:250">
                <div class="error-message hidden text-red-600 text-sm mt-1"></div>
                <div class="success-message hidden text-green-600 text-sm mt-1">
                  <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd" />
                  </svg>
                  Valid height entered
                </div>
                <div id="bmiDisplay" class="hidden mt-2 text-sm text-gray-600"></div>
              </div>
            </div>
          </div>

          <!-- Contact Information Section -->
          <div class="mb-8 donor-step" data-step="2">
            <h2 class="text-2xl font-bold text-gray-800 mb-4 flex items-center">
              <svg class="w-6 h-6 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              Contact Information
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-gray-700 font-semibold mb-2" for="vm-donor-profile-39">Mobile Number *</label>
                <input type="tel" name="mobileNumber" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  placeholder="09XX-XXX-XXXX" id="vm-donor-profile-39">
              </div>

              <div>
                <label class="block text-gray-700 font-semibold mb-2" for="vm-donor-profile-40">Email Address *</label>
                <input type="email" name="email" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  placeholder="email@example.com" id="vm-donor-profile-40">
              </div>
            </div>
          </div>

          <!-- Address Information Section -->
          <div class="mb-8 donor-step" data-step="2">
            <h2 class="text-2xl font-bold text-gray-800 mb-4 flex items-center">
              <svg class="w-6 h-6 text-red-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              Address Information
            </h2>

            <div class="grid grid-cols-1 gap-6">
              <div>
                <label class="block text-gray-700 font-semibold mb-2" for="vm-donor-profile-41">Complete Address *</label>
                <input type="text" name="address" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  placeholder="House No., Street, Barangay" id="vm-donor-profile-41">
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div>
                  <label class="block text-gray-700 font-semibold mb-2">City *</label>
                  <div data-city-wrap>
                    <select name="city" data-city-select required
                      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white" aria-label="Municipality">
                      <option value="">Select municipality</option>
                      <option>Baco</option>
                      <option>Bansud</option>
                      <option>Bongabong</option>
                      <option>Bulalacao</option>
                      <option>Calapan City</option>
                      <option>Gloria</option>
                      <option>Mansalay</option>
                      <option>Naujan</option>
                      <option>Pinamalayan</option>
                      <option>Pola</option>
                      <option>Puerto Galera</option>
                      <option>Roxas</option>
                      <option>San Teodoro</option>
                      <option>Socorro</option>
                      <option>Victoria</option>
                      <option value="__other">Others (specify)</option>
                    </select>
                    <input type="text" data-city-other placeholder="Specify municipality"
                      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent mt-2 hidden" aria-label="Specify municipality">
                  </div>
                </div>

                <div>
                  <label class="block text-gray-700 font-semibold mb-2" for="vm-donor-profile-42">Province *</label>
                  <input type="text" name="province" required
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                    placeholder="Enter province" id="vm-donor-profile-42">
                </div>

                <div>
                  <label class="block text-gray-700 font-semibold mb-2" for="vm-donor-profile-43">Zip Code *</label>
                  <input type="text" name="zipCode" required
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                    placeholder="Enter zip code" id="vm-donor-profile-43">
                </div>
              </div>
            </div>
            <input type="hidden" name="latitude" id="donorLatitude">
            <input type="hidden" name="longitude" id="donorLongitude">
          </div>

          <!-- Medical Information Section -->
          <div class="mb-8 donor-step" data-step="3">
            <h2 class="text-2xl font-bold text-gray-800 mb-4 flex items-center">
              <svg class="w-6 h-6 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              Medical Information
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-gray-700 font-semibold mb-2" for="vm-donor-profile-44">Last Donation Date</label>
                <input type="date" name="lastDonationDate"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" id="vm-donor-profile-44">
              </div>

              <div>
                <label class="block text-gray-700 font-semibold mb-2" for="vm-donor-profile-45">Medical Conditions</label>
                <textarea name="medicalConditions" rows="2"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  placeholder="List any medical conditions..." id="vm-donor-profile-45"></textarea>
              </div>
            </div>
          </div>

          <!-- Availability Status Section -->
          <div class="mb-8 donor-step" data-step="4">
            <h2 class="text-2xl font-bold text-gray-800 mb-4 flex items-center">
              <svg class="w-6 h-6 text-orange-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Availability Status
            </h2>

            <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
              <div class="flex items-start space-x-4">
                <input type="checkbox" name="isAvailable" id="isAvailable"
                  class="mt-1 w-5 h-5 text-blue-600 border-gray-300 rounded focus:ring-blue-500">
                <div class="flex-1">
                  <label for="isAvailable" class="text-gray-800 font-semibold cursor-pointer">I am currently available
                    to donate blood</label>
                  <p class="text-gray-600 text-sm mt-1">Check this box if you are willing and able to donate blood. You
                    will receive notifications when there are matching blood requests in your area.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Emergency Contact Section -->
          <div class="mb-8 donor-step" data-step="4">
            <h2 class="text-2xl font-bold text-gray-800 mb-4 flex items-center">
              <svg class="w-6 h-6 text-red-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              Emergency Contact
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              <div>
                <label class="block text-gray-700 font-semibold mb-2" for="vm-donor-profile-46">Emergency Contact Name *</label>
                <input type="text" name="emergencyContactName" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  placeholder="Enter contact name" id="vm-donor-profile-46">
              </div>

              <div>
                <label class="block text-gray-700 font-semibold mb-2" for="vm-donor-profile-47">Emergency Contact Number *</label>
                <input type="tel" name="emergencyContactNumber" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  placeholder="09XX-XXX-XXXX" id="vm-donor-profile-47">
              </div>

              <div>
                <label class="block text-gray-700 font-semibold mb-2" for="vm-donor-profile-48">Relationship *</label>
                <input type="text" name="emergencyContactRelationship" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  placeholder="e.g., Spouse, Parent, Sibling" id="vm-donor-profile-48">
              </div>
            </div>
          </div>

          <!-- Wizard Navigation -->
          <div class="vm-form-actions flex justify-between items-center">
            <button type="button" id="donorWizardBack"
              class="vm-button px-6 py-3 border border-gray-300 rounded-lg text-gray-700 font-semibold hover:bg-gray-50 transition invisible">
              &larr; Back
            </button>
            <button type="button" id="donorWizardNext"
              class="vm-button vm-button--primary px-8 py-3 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition">
              Next &rarr;
            </button>
            <button type="submit" id="donorSubmitBtn"
              class="vm-button vm-button--primary px-8 py-3 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition transform">
              Save Donor Profile
            </button>
          </div>

        </form>{{/unless}}
      </div>

      <!-- Help Text -->
      <div class="mt-6 bg-green-50 border border-green-200 rounded-lg p-4">
        <div class="flex items-start">
          <svg class="w-6 h-6 text-green-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor"
            viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div>
            <p class="text-green-800 font-semibold mb-1">Donor Eligibility Requirements</p>
            <ul class="text-green-700 text-sm space-y-1 list-disc list-inside">
              <li>Must be at least 18 years old and not more than 65 years old</li>
              <li>Must weigh at least 50 kg (110 lbs)</li>
              <li>Must be in good health and feeling well</li>
              <li>Whole blood coordination uses a {{#if coordinationIntervalDays}}{{coordinationIntervalDays}}{{else}}56{{/if}}-day interval; medical staff assess eligibility and other components</li>
            </ul>
          </div>
        </div>
      </div>

    </div>
  </div>
</main>



{{#if donor}}
<script type="application/json" id="donor-data">{{{donorJson}}}</script>
{{/if}}


<script src="/js/workspace-form.js?v=1" defer></script>

{{> footer}}
