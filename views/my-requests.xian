{{> head}}

{{> user-sidebar}}

<!-- Navigation Bar -->
{{> internal-header}}

<!-- My Requests Content -->
<main id="main-content" tabindex="-1" class="vm-page min-h-screen bg-gray-50 py-12">
  <div class="vm-page-container container mx-auto px-4">
    {{#if error}}<div class="vm-alert vm-alert--danger mb-4" role="alert">{{error}} <a class="vm-text-link" href="/my-requests">Retry</a></div>{{/if}}
    <div class="max-w-6xl mx-auto">

      <!-- Header -->
      <div class="vm-page-heading mb-8">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-3xl font-bold mb-2">My Requests</h1>
            <p class="text-white/90">View and manage your blood requests and donation history</p>
          </div>
          <a href="/request-blood"
            class="vm-button vm-button--primary bg-white text-green-600 px-6 py-3 rounded-lg font-semibold hover:bg-gray-100 transition">
            + New Request
          </a>
        </div>
      </div>

      {{#if success_msg}}<div class="vm-alert vm-alert--success mb-6" role="status">{{success_msg}}</div>{{/if}}
      {{#if error_msg}}<div class="vm-alert vm-alert--danger mb-6" role="alert">{{error_msg}}</div>{{/if}}

      <!-- Request filters -->
      <div class="vm-panel bg-white rounded-md mb-6">
        <div class="p-4 border-b">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <!-- Search Bar -->
            <div class="relative flex-1 max-w-md">
              <input type="search" value="{{search}}" maxlength="100" id="searchInput" placeholder="Search requests..."
                class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all duration-200" aria-label="Search your requests">
              <svg class="absolute left-3 top-2.5 h-5 w-5 text-gray-400" fill="none" stroke="currentColor"
                viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>

            <!-- Sort Dropdown -->
            <div class="relative">
              <select id="sortSelect"
                class="appearance-none bg-white border border-gray-300 rounded-lg px-4 py-2 pr-8 focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all duration-200" aria-label="Sort requests">
                <option value="newest" {{#if (eq sort "newest")}}selected{{/if}}>Newest First</option>
                <option value="oldest" {{#if (eq sort "oldest")}}selected{{/if}}>Oldest First</option>
                <option value="urgency" {{#if (eq sort "urgency")}}selected{{/if}}>By Urgency</option>
                <option value="status" {{#if (eq sort "status")}}selected{{/if}}>By Status</option>
              </select>
              <svg class="absolute right-2 top-2.5 h-5 w-5 text-gray-400 pointer-events-none" fill="none"
                stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </div>
        </div>

        <div class="vm-tabs flex border-b overflow-x-auto">
          <button
            aria-pressed="true" class="filter-tab px-6 py-4 font-semibold whitespace-nowrap transition-colors duration-200 text-green-600 border-b-2 border-green-600"
            data-filter="all">
            All Requests

          </button>
          <button class="filter-tab px-6 py-4 font-semibold whitespace-nowrap" data-filter="pending">Awaiting review </button>
          <button class="filter-tab px-6 py-4 font-semibold whitespace-nowrap" data-filter="scheduled">Scheduled </button>
          <button
            class="filter-tab px-6 py-4 font-semibold whitespace-nowrap transition-colors duration-200 text-gray-500 hover:text-gray-700"
            data-filter="active">
            Active

          </button>
          <button
            class="filter-tab px-6 py-4 font-semibold whitespace-nowrap transition-colors duration-200 text-gray-500 hover:text-gray-700"
            data-filter="fulfilled">
            Fulfilled

          </button>
          <button
            class="filter-tab px-6 py-4 font-semibold whitespace-nowrap transition-colors duration-200 text-gray-500 hover:text-gray-700"
            data-filter="cancelled">
            Cancelled

          </button>
        </div>
      </div>

      <p class="vm-muted text-sm mb-4">Search, status counts, and sorting apply to the records on this page. Use the page controls to view more.</p>
      <!-- Request rows with expandable details -->
      <div data-server-records data-filter="{{filter}}" id="requestsContainer" class="vm-request-list space-y-6">
        {{#if requests.length}}
        {{#each requests}}
        <div
          class="request-card bg-white rounded-md p-6 border-l-4 {{#if (eq status 'active')}}border-red-500{{else if (eq status 'fulfilled')}}border-green-500{{else if (eq status 'cancelled')}}border-gray-500{{else}}border-yellow-500{{/if}} transform transition-all duration-300"
          data-status="{{status}}" data-urgency="{{urgency}}" data-date="{{createdAt}}">
          <div class="flex items-start justify-between mb-4">
            <div class="flex-1">
              <div class="flex items-center space-x-3 mb-2">
                <!-- Labeled request priority -->
                <span
                  class="vm-status {{#if (eq urgency 'critical')}}vm-status--danger{{else if (eq urgency 'urgent')}}vm-status--warning{{else if (eq urgency 'high')}}vm-status--warning{{else}}vm-status--info{{/if}} px-3 py-1 rounded-full text-sm font-semibold capitalize">{{urgency}}</span>
                <!-- Status Badge -->
                <span
                  class="vm-status {{#if (eq status 'active')}}vm-status--success bg-green-100{{else if (eq status 'fulfilled')}}vm-status--success{{else if (eq status 'cancelled')}}vm-status--danger{{else}}vm-status--warning{{/if}} px-3 py-1 rounded-full text-sm font-semibold flex items-center capitalize">
                  {{#if (eq status 'active')}}
                  <div class="w-2 h-2 bg-green-500 rounded-full mr-2 animate-pulse"></div>
                  {{else if (eq status 'fulfilled')}}
                  <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd" />
                  </svg>
                  {{/if}}
                  {{status}}
                </span>
              </div>
              <h3 class="text-xl font-bold text-gray-800 mb-1">Blood Request #{{id}}</h3>
              <p class="text-gray-600 text-sm">Submitted on {{formatDate createdAt}}</p>
            </div>
            <div class="text-right">
              <p class="text-xl font-semibold">
                {{bloodType}}</p>
              <p class="text-gray-600 text-sm">{{unitsRequired}} Units</p>
            </div>
          </div>

          <p class="text-sm text-gray-600 mb-3 truncate">{{#if patientReference}}Ref {{patientReference}} · {{/if}}{{patientName}} · {{hospitalName}} · {{city}}</p>

          <div id="more-{{id}}" class="hidden">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div>
              <p class="text-gray-600 text-sm mb-1">Patient</p>
              <p class="font-semibold text-gray-800">{{patientName}}{{#if patientReference}} <span class="text-xs font-normal text-gray-500">(Ref {{patientReference}})</span>{{/if}}</p>
            </div>
            <div>
              <p class="text-gray-600 text-sm mb-1">Hospital</p>
              <p class="font-semibold text-gray-800">{{hospitalName}}</p>
            </div>
            <div>
              <p class="text-gray-600 text-sm mb-1">Location</p>
              <p class="font-semibold text-gray-800">{{city}}, {{province}}</p>
            </div>
            <div>
              <p class="text-gray-600 text-sm mb-1">Required By</p>
              <p class="font-semibold text-gray-800">{{formatDate requiredByDate}}</p>
            </div>
          </div>

          {{#if indicationOfTransfusion}}
          <div class="mb-4 p-3 bg-blue-50 rounded-lg">
            <p class="text-gray-600 text-sm mb-1">Indication of Transfusion</p>
            <p class="font-semibold text-gray-800">{{indicationOfTransfusion}}</p>
          </div>
          {{/if}}

          {{#if bloodComponents}}
          <div class="mb-4 p-3 bg-purple-50 rounded-lg">
            <p class="text-gray-600 text-sm mb-2">Blood Components Required</p>
            <div class="space-y-1">
              {{#each bloodComponents}}
              <div class="flex justify-between items-center">
                <span class="text-sm font-medium text-gray-700 capitalize">{{type}}</span>
                <span class="text-sm text-gray-600">{{volume}}</span>
              </div>
              {{/each}}
            </div>
          </div>
          {{/if}}

          {{#if (eq status 'active')}}
          <p class="vm-muted text-sm mb-4">This request is active. View details to review available donor matches.</p>
          {{/if}}
          </div>

          <!-- Action Buttons -->
          <div class="vm-request-actions">
            <button onclick="toggleCard({{id}}, this)" aria-controls="more-{{id}}" aria-expanded="false"
              class="vm-button px-4 py-2 border border-gray-300 rounded-lg text-gray-600 font-semibold hover:bg-gray-50 transition-all duration-200">
              More
            </button>
            <a href="/view-blood-request/{{id}}"
              class="vm-button bg-green-600 text-white px-4 py-2 rounded-lg font-semibold hover:bg-green-700 transition-all duration-200 text-center">
              View Details
            </a>
            {{#unless (eq status 'fulfilled')}}{{#unless (eq status 'cancelled')}}
            <button
              class="vm-button px-4 py-2 border border-red-300 rounded-lg text-red-600 font-semibold hover:bg-red-50 transition-all duration-200 vm-button--danger"
              onclick="confirmCancel({{id}})">
              Cancel
            </button>
            {{/unless}}{{/unless}}
          </div>
        </div>
        {{/each}}
        {{else}}
        <!-- No Requests State -->
        <div class="vm-empty-state">
          <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          <h3 class="text-xl font-bold text-gray-800 mb-2">No Blood Requests Yet</h3>
          <p class="text-gray-600 mb-6">You haven't submitted any blood requests. Start by creating your first request.
          </p>
          <a href="/request-blood"
            class="vm-button inline-flex items-center bg-red-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-red-700 transition-all duration-200 transform vm-button--primary">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
            </svg>
            Create Blood Request
          </a>
        </div>
        {{/if}}

    <!-- No Results State -->
    <div id="noResults" class="vm-empty-state hidden">
      <svg class="w-20 h-20 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
      <h3 class="text-xl font-semibold text-gray-800 mb-2">No requests found</h3>
      <p class="text-gray-600 mb-6">Try adjusting your search or filter criteria</p>
      <button onclick="clearFilters()"
        class="vm-button bg-green-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-green-700 transition">
        Clear Filters
      </button>
    </div>
  </div>



</div>
</div>
  {{> pagination}}
</main>

<script src="/js/request-list.js?v=2" defer></script>

{{> footer}}
