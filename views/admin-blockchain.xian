<!-- Admin Blockchain Content -->
<main id="main-content" tabindex="-1" class="vm-page min-h-screen bg-gray-100 dark:bg-[#09090b] py-8">
  <div class="vm-page-container container mx-auto px-4">

    <!-- Header -->
    <div class="vm-page-heading mb-6 lg:mb-8">
      <h1 class="text-2xl lg:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-2">Local integrity log</h1>
      <p class="text-gray-600 dark:text-gray-400 text-sm lg:text-base">Check hashes in the local integrity log. This is not independent clinical verification or proof that records cannot be changed.</p>
    </div>

    <!-- Local log status Card -->
    <div class="blockchain-card mb-6 lg:mb-8">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h2 class="text-lg lg:text-xl font-semibold mb-2">Local log status</h2>
          <div class="status-indicator">
            <div class="status-dot" id="statusDot"></div>
            <span id="statusText" class="text-sm lg:text-base">Checking...</span>
          </div>
        </div>
        <div class="text-left sm:text-right">
          <div class="text-xl lg:text-2xl font-bold" id="totalBlocks">
            <div class="animate-pulse bg-white dark:bg-[#18181b] bg-opacity-30 h-8 w-12 rounded"></div>
          </div>
          <div class="text-xs lg:text-sm opacity-90">Total Blocks</div>
        </div>
      </div>
    </div>

    <!-- Statistics Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6 mb-8">
      <div class="stat-card">
        <div class="stat-number" id="donationCount">
          <div class="animate-pulse bg-gray-200 h-8 w-8 mx-auto rounded"></div>
        </div>
        <div class="text-gray-600 dark:text-gray-400 font-medium">Donations</div>
      </div>
      <div class="stat-card">
        <div class="stat-number" id="requestCount">
          <div class="animate-pulse bg-gray-200 h-8 w-8 mx-auto rounded"></div>
        </div>
        <div class="text-gray-600 dark:text-gray-400 font-medium">Requests</div>
      </div>
      <div class="stat-card">
        <div class="stat-number" id="fulfillmentCount">
          <div class="animate-pulse bg-gray-200 h-8 w-8 mx-auto rounded"></div>
        </div>
        <div class="text-gray-600 dark:text-gray-400 font-medium">Fulfillments</div>
      </div>
      <div class="stat-card">
        <div class="stat-number" id="pendingCount">
          <div class="animate-pulse bg-gray-200 h-8 w-8 mx-auto rounded"></div>
        </div>
        <div class="text-gray-600 dark:text-gray-400 font-medium">Pending</div>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="action-buttons mb-8 flex-wrap">
      <button class="vm-button vm-button--primary btn-blockchain mb-2" id="mineBtn" onclick="mineBlock(event)">
        Mine Pending Transactions
      </button>
      <button class="vm-button btn-blockchain mb-2" id="verifyBtn" onclick="verifyBlockchain(event)">
        Check local log hashes
      </button>
      <button class="vm-button btn-blockchain mb-2" id="refreshBtn" onclick="refreshData(event)">
        Refresh Data
      </button>
    </div>

    <!-- Recent Blocks -->
    <div class="vm-panel bg-white dark:bg-[#18181b] rounded-lg shadow-sm dark:shadow-none p-4 lg:p-6">
      <h3 class="text-base lg:text-lg font-semibold mb-4">Recent integrity log activity</h3>
      <div id="recentBlocks">
        <div class="text-center text-gray-500 dark:text-gray-400 py-8">
          Loading blockchain data...
        </div>
      </div>
    </div>

  </div>
</main>

<script>
    let blockchainData = null;

    async function loadBlockchainStats() {
        try {
            document.getElementById('statusText').textContent = 'Loading...';
            const response = await fetch('/api/blockchain/stats');
            if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
            const result = await response.json();
            if (result.success) {
                blockchainData = result.data;
                updateUI();
                await loadRecentActivity();
            } else {
                throw new Error(result.error || 'Failed to load blockchain stats');
            }
        } catch (error) {
            console.error('Error loading blockchain stats:', error);
            document.getElementById('statusText').textContent = 'Error loading data';
            document.getElementById('statusDot').className = 'status-dot status-invalid';
            document.getElementById('recentBlocks').innerHTML = `
                <div class="text-center text-red-500 py-8">
                    <p>Error loading blockchain data</p>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">${error.message}</p>
                    <button onclick="refreshData()" class="vm-button mt-4 bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600 transition">Try Again</button>
                </div>`;
        }
    }

    async function loadRecentActivity() {
        try {
            const response = await fetch('/api/blockchain/recent');
            if (response.ok) {
                const result = await response.json();
                if (result.success && result.blocks && result.blocks.length > 0) {
                    displayRecentBlocks(result.blocks);
                } else {
                    document.getElementById('recentBlocks').innerHTML = '<div class="text-center text-gray-500 dark:text-gray-400 py-8"><p>No recent blockchain activity</p></div>';
                }
            } else { throw new Error('Failed to load recent activity'); }
        } catch (error) {
            console.error('Error loading recent activity:', error);
            document.getElementById('recentBlocks').innerHTML = '<div class="text-center text-gray-500 dark:text-gray-400 py-8"><p>Unable to load recent activity</p></div>';
        }
    }

    function describeTransaction(tx) {
        const badge = `<span class="transaction-badge badge-${tx.type}">${tx.type.charAt(0).toUpperCase() + tx.type.slice(1)}</span>`;
        const d = tx.data || {};
        let detail = '';
        if (tx.type === 'request') {
            detail = `Request #${tx.requestId} · ${d.bloodType || '?'} · ${d.units ?? d.unitsRequired ?? '?'} unit(s) · ${d.hospital || ''} · ${d.urgency || ''} · ${d.status || ''}`;
        } else if (tx.type === 'donation') {
            detail = `Donor #${tx.donorId} · ${d.bloodType || '?'} · ${d.units ?? 0} unit(s) · ${d.location || ''}`;
        } else if (tx.type === 'fulfillment') {
            detail = `Request #${tx.requestId} · Donor #${tx.donorId} · ${d.unitsProvided ?? d.units ?? '?'} unit(s)`;
        } else if (tx.data && tx.data.message) {
            detail = tx.data.message;
        }
        return `<div class="text-sm text-gray-700 dark:text-gray-300">${badge}<span class="ml-2">${detail}</span></div>`;
    }

    function displayRecentBlocks(blocks) {
        const container = document.getElementById('recentBlocks');
        if (!blocks || blocks.length === 0) {
            container.innerHTML = '<div class="text-center text-gray-500 dark:text-gray-400 py-8"><p>No recent blocks found</p></div>';
            return;
        }
        container.innerHTML = blocks.slice(0, 5).map(block => {
            const txs = Array.isArray(block.data) ? block.data : [];
            return `
            <div class="block-item">
              <div class="flex justify-between items-start mb-2">
                <div>
                  <span class="font-semibold text-gray-900 dark:text-gray-100">Block #${block.index}</span>
                  <div class="hash-display">Hash: ${block.hash.substring(0, 20)}...</div>
                  <div class="hash-display">Prev: ${String(block.previousHash).substring(0, 20)}...</div>
                </div>
                <div class="text-right">
                  <div class="text-sm text-gray-500 dark:text-gray-400">${new Date(block.timestamp).toLocaleString()}</div>
                  <div class="text-xs text-gray-400 dark:text-gray-500">Nonce: ${block.nonce} · ${txs.length} transaction${txs.length === 1 ? '' : 's'}</div>
                </div>
              </div>
              ${txs.length > 0 ? `<div class="mt-2 space-y-2">${txs.map(describeTransaction).join('')}</div>` : '<div class="mt-2 text-sm text-gray-500 dark:text-gray-400">Genesis block</div>'}
            </div>`;
        }).join('');
    }

    function updateUI() {
        if (!blockchainData) return;
        const statusDot = document.getElementById('statusDot');
        const statusText = document.getElementById('statusText');
        if (blockchainData.isValid) {
            statusDot.className = 'status-dot status-valid';
            statusText.textContent = 'Local log hashes match';
        } else {
            statusDot.className = 'status-dot status-invalid';
            statusText.textContent = 'Local log hashes do not match';
        }
        animateCounter('totalBlocks', blockchainData.totalBlocks);
        animateCounter('donationCount', blockchainData.donations);
        animateCounter('requestCount', blockchainData.requests);
        animateCounter('fulfillmentCount', blockchainData.fulfillments);
        animateCounter('pendingCount', blockchainData.pendingTransactions);
        const mineBtn = document.getElementById('mineBtn');
        if (mineBtn) {
            if (blockchainData.pendingTransactions === 0) {
                mineBtn.disabled = true;
                mineBtn.title = "No pending transactions to mine";
                mineBtn.style.opacity = '0.5';
            } else {
                mineBtn.disabled = false;
                mineBtn.title = "";
                mineBtn.style.opacity = '1';
            }
        }
    }

    function animateCounter(elementId, targetValue) {
        const element = document.getElementById(elementId);
        const duration = 1000;
        const startTime = performance.now();
        function updateCounter(currentTime) {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            element.textContent = Math.floor(targetValue * progress);
            if (progress < 1) requestAnimationFrame(updateCounter);
        }
        requestAnimationFrame(updateCounter);
    }

    async function mineBlock(event) {
        const button = event ? event.currentTarget : document.getElementById('mineBtn');
        const originalText = button ? button.innerHTML : 'Mine Pending Transactions';
        if (blockchainData && blockchainData.pendingTransactions === 0) {
            alert('INFO: There are currently no pending transactions to mine.');
            return;
        }
        if (button) { button.innerHTML = 'Mining...'; button.disabled = true; }
        try {
            const response = await fetch('/api/blockchain/mine', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
            const result = await response.json();
            if (result.success) {
                button.innerHTML = 'Mined!';
                alert('Block mined successfully!');
                setTimeout(() => { button.innerHTML = originalText; button.disabled = false; }, 2000);
                refreshData();
            } else { throw new Error(result.message || 'Mining failed'); }
        } catch (error) {
            console.error('Error mining block:', error);
            if (button) { button.innerHTML = 'Error'; setTimeout(() => { button.innerHTML = originalText; button.disabled = false; }, 2000); }
            alert('Error mining block: ' + error.message);
        }
    }

    async function verifyBlockchain(event) {
        const button = event ? event.currentTarget : document.getElementById('verifyBtn');
        const originalText = button ? button.innerHTML : 'Check local log hashes';
        if (button) { button.innerHTML = 'Verifying...'; button.disabled = true; }
        try {
            const response = await fetch('/api/blockchain/verify');
            const result = await response.json();
            if (result.success) {
                if (result.isValid) { button.innerHTML = 'Valid!'; alert('Local log hashes match. This check does not independently certify a donation or facility review.'); }
                else { button.innerHTML = 'Invalid!'; alert('Local log hash mismatch detected. Review audit history and backups.'); }
                setTimeout(() => { button.innerHTML = originalText; button.disabled = false; }, 2000);
                refreshData();
            } else { throw new Error(result.error || 'Verification failed'); }
        } catch (error) {
            console.error('Error verifying blockchain:', error);
            if (button) { button.innerHTML = 'Error'; setTimeout(() => { button.innerHTML = originalText; button.disabled = false; }, 2000); }
            alert('Error verifying blockchain: ' + error.message);
        }
    }

    async function refreshData(event) {
        const button = event ? event.currentTarget : document.getElementById('refreshBtn');
        if (button) {
            const originalText = button.innerHTML;
            button.innerHTML = 'Refreshing...';
            button.disabled = true;
            setTimeout(() => { button.innerHTML = originalText; button.disabled = false; }, 1000);
        }
        await loadBlockchainStats();
    }

    document.addEventListener('DOMContentLoaded', function() {
        loadBlockchainStats();
        setInterval(refreshData, 30000);
    });
</script>
