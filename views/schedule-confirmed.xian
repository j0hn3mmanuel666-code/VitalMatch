{{> head-public}}
{{> public-nav}}
<main id="main-content" tabindex="-1" class="journey-status">
  <section class="journey-status__panel" aria-labelledby="schedule-heading">
    <p class="journey-eyebrow">Donation appointment</p>
    {{#if invalid}}
      <h1 id="schedule-heading">That confirmation link is unavailable.</h1>
      <p>The link may be invalid, already used, or expired. Please request a new one from the coordination team.</p>
      <div class="journey-status__actions"><a class="journey-button" href="/dashboard">Go to your account</a><a class="journey-button journey-button--secondary" href="/contact">Contact the team</a></div>
    {{else}}
      <h1 id="schedule-heading">{{#if confirmed}}Your availability is confirmed.{{else}}{{#if alreadyConfirmed}}You have already confirmed.{{else}}Review your appointment.{{/if}}{{/if}}</h1>
      <p>{{#if confirmed}}Thank you for confirming your availability for the scheduled blood donation.{{else}}{{#if alreadyConfirmed}}This appointment already has your availability confirmation.{{else}}Check the details below, then confirm whether you are available for the scheduled blood donation.{{/if}}{{/if}}</p>
      <dl class="journey-appointment-details"><div><dt>Your role</dt><dd>{{role}}</dd></div><div><dt>Request</dt><dd>#{{request.id}}</dd></div><div><dt>Hospital</dt><dd>{{request.hospitalName}}</dd></div><div><dt>Blood type</dt><dd>{{request.bloodType}}</dd></div>{{#if request.scheduledDate}}<div><dt>Scheduled for</dt><dd>{{formatDate request.scheduledDate}} at {{formatTime request.scheduledDate}}</dd></div>{{/if}}</dl>
      <div class="journey-status__actions">
        {{#if confirmed}}<a class="journey-button" href="/dashboard">Go to your account</a>{{else}}{{#if alreadyConfirmed}}<a class="journey-button" href="/dashboard">Go to your account</a>{{else}}<form method="POST" action="{{postUrl}}"><input type="hidden" name="_csrf" value="{{csrfToken}}"><input type="hidden" name="appointmentId" value="{{appointmentId}}"><input type="hidden" name="version" value="{{version}}"><button type="submit" class="journey-button journey-button--success">Confirm my availability</button></form>{{/if}}{{/if}}
      </div>
    {{/if}}
  </section>
</main>
{{> public-footer}}
