{{> head}}

<!-- Minimal Navigation Bar -->
<nav class="bg-white shadow-md sticky top-0 z-50">
  <div class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <!-- Back Button & Logo -->
      <div class="flex items-center space-x-3">
        <a href="javascript:history.length > 1 ? history.back() : window.location.href='/dashboard'" class="p-2 -ml-2 text-gray-600 hover:text-red-600 hover:bg-gray-100 rounded-lg transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </a>
        <div class="flex items-center space-x-2">
          <svg class="w-8 h-8 text-red-600" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.94-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
          </svg>
          <a href="/dashboard" class="text-2xl font-bold text-gray-800">VitalMatch</a>
        </div>
      </div>
      
      <!-- User Menu -->
      <div class="flex items-center space-x-4">
        <a href="/dashboard" class="text-gray-700 hover:text-red-600 transition font-semibold">Dashboard</a>
      </div>
    </div>
  </div>
</nav>

<div class="min-h-[calc(100vh-73px)] bg-gray-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <div class="text-center">
      <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-green-100 mb-4">
        <svg class="h-8 w-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h2 class="mt-2 text-3xl font-extrabold text-gray-900">
        Availability Confirmed!
      </h2>
      <p class="mt-2 text-sm text-gray-600">
        Thank you for confirming your availability for the scheduled blood donation.
      </p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
      <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10 text-center">
        <div class="mb-6">
          <h3 class="text-lg font-medium text-gray-900 border-b pb-2 mb-4">Appointment Details</h3>
          <div class="text-left space-y-3">
            <p class="text-sm text-gray-600">
              <span class="font-bold">Role:</span> 
              <span class="capitalize bg-blue-100 text-blue-800 px-2 py-0.5 rounded text-xs">{{role}}</span>
            </p>
            <p class="text-sm text-gray-600">
              <span class="font-bold">Request ID:</span> #{{request.id}}
            </p>
            <p class="text-sm text-gray-600">
              <span class="font-bold">Hospital:</span> {{request.hospitalName}}
            </p>
            <p class="text-sm text-gray-600">
              <span class="font-bold">Blood Type:</span> <span class="text-red-600 font-bold">{{request.bloodType}}</span>
            </p>
            {{#if request.scheduledDate}}
            <p class="text-sm text-gray-600">
              <span class="font-bold">Scheduled:</span> {{formatDate request.scheduledDate}} at {{formatTime request.scheduledDate}}
            </p>
            {{/if}}
          </div>
        </div>
        
        <div class="mt-6 text-center">
          <a href="/dashboard" class="w-full inline-flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
            Go to Dashboard
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

{{> footer}}
