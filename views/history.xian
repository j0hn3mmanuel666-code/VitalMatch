{{> head}}

{{> user-sidebar}}

<!-- Navigation Bar -->
{{> internal-header}}

<!-- History Content -->
<main id="main-content" tabindex="-1" class="vm-page min-h-screen bg-gray-50 py-12">
  <div class="vm-page-container container mx-auto px-4">
    {{#if error}}<div class="vm-alert vm-alert--danger mb-4" role="alert">{{error}} <a class="vm-text-link" href="/history">Retry</a></div>{{/if}}
    <div class="max-w-4xl mx-auto">

      <div class="vm-page-heading mb-8">
        <h1 class="text-3xl font-bold mb-2">My History</h1>
        <p class="text-white/90">Your blood requests and donations over time</p>
      </div>
      {{> record-search label="Search your history" placeholder="Patient, facility, blood type, location or request ID"}}

      <!-- Summary -->
      <div class="vm-metric-grid grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="vm-panel bg-white rounded-md p-5 text-center">
          <p class="text-3xl font-bold text-gray-800">{{summary.totalRequests}}</p>
          <p class="text-sm text-gray-500">Requests Made</p>
        </div>
        <div class="vm-panel bg-white rounded-md p-5 text-center">
          <p class="text-3xl font-bold text-green-600">{{summary.fulfilledRequests}}</p>
          <p class="text-sm text-gray-500">Requests Fulfilled</p>
        </div>
        <div class="vm-panel bg-white rounded-md p-5 text-center">
          <p class="text-3xl font-bold text-red-600">{{summary.totalDonations}}</p>
          <p class="text-sm text-gray-500">Donations Given</p>
        </div>
        <div class="vm-panel bg-white rounded-md p-5 text-center">
          <p class="text-3xl font-bold text-blue-600">{{summary.unitsCollected}}</p>
          <p class="text-sm text-gray-500">Units actually collected</p>
        </div>
      </div>

      <!-- Donations -->
      <h2 class="text-xl font-bold text-gray-800 mb-4">Donations Given</h2>
      <p class="vm-muted text-sm mb-4">Search covers your recorded donations and requests. Summary totals include your complete history.</p>
      {{#if donations.length}}
      <div class="vm-record-list mb-10">
        {{#each donations}}
        <div class="vm-panel bg-white rounded-md p-5 border-l-4 border-red-500">
          <div class="flex items-center justify-between">
            <div>
              <p class="font-semibold text-gray-800">{{bloodType}} &middot; {{unitsProvided}} unit(s) collected &middot; {{hospitalName}}</p>
              <p class="text-sm text-gray-500">Collected {{formatDate fulfilledAt}}</p>
            </div>
            <a href="/view-blood-request/{{id}}" class="vm-button vm-button--small">Details</a>
          </div>
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="vm-panel bg-white rounded-md p-6 text-center text-gray-500 mb-10">No donations recorded yet. Your fulfilled donations will appear here.</div>
      {{/if}}

      {{> pagination pagination=donationPagination label="Donation history pages"}}
      <!-- Requests -->
      <h2 class="text-xl font-bold text-gray-800 mb-4">Blood Requests</h2>
      {{#if requests.length}}
      <div class="vm-record-list">
        {{#each requests}}
        <div class="vm-panel bg-white rounded-md p-5 border-l-4 {{#if (eq status "fulfilled")}}border-green-500{{else}}{{#if (eq status "active")}}border-red-500{{else}}border-gray-400{{/if}}{{/if}}">
          <div class="flex items-center justify-between">
            <div>
              <p class="font-semibold text-gray-800">Request #{{id}} &middot; {{bloodType}} &middot; {{unitsRequired}} unit(s)</p>
              <p class="text-sm text-gray-500">{{hospitalName}} &middot; {{formatDate createdAt}} &middot; <span class="capitalize font-semibold">{{status}}</span></p>
            </div>
            <a href="/view-blood-request/{{id}}" class="vm-button vm-button--small">Details</a>
          </div>
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="vm-panel bg-white rounded-md p-6 text-center text-gray-500">No requests yet. <a href="/request-blood" class="vm-text-link">Create your first request</a>.</div>
      {{/if}}

    </div>
  </div>
  {{> pagination}}
</main>

{{> footer}}
