<!-- Admin Hospitals Content -->
<div class="min-h-screen bg-gray-100 dark:bg-[#09090b] py-8">
  <div class="container mx-auto px-4">

    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-800 dark:text-gray-200 mb-2">Hospital Statistics</h1>
      <p class="text-gray-600 dark:text-gray-400">View hospital blood request statistics and rankings</p>
    </div>

    <!-- Hospitals Table -->
    <div class="bg-white dark:bg-[#18181b] rounded-xl shadow-md dark:shadow-none overflow-hidden">
      {{#if hospitals.length}}
      <div class="overflow-x-auto custom-scrollbar">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-800">
          <thead class="bg-gray-50 dark:bg-[#27272a]">
            <tr>
              <th
                class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                Rank</th>
              <th
                class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                Hospital Name</th>
              <th
                class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                Location</th>
              <th
                class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                Total Requests</th>
              <th
                class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                Active Requests</th>
              <th
                class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                Fulfilled</th>
            </tr>
          </thead>
          <tbody class="bg-white dark:bg-[#18181b] divide-y divide-gray-200 dark:divide-gray-800">
            {{#each hospitals}}
            <tr class="hover:bg-gray-50 dark:bg-[#27272a]">
              <td class="px-4 py-3 whitespace-nowrap">
                <span
                  class="{{#if (eq @index 0)}}bg-yellow-500{{else if (eq @index 1)}}bg-gray-400{{else if (eq @index 2)}}bg-orange-600{{else}}bg-blue-600{{/if}} text-white w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm">
                  {{add @index 1}}
                </span>
              </td>
              <td class="px-4 py-3 text-sm font-semibold text-gray-900 dark:text-gray-100">{{hospitalName}}</td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900 dark:text-gray-100">{{city}}, {{province}}
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm font-bold text-gray-900 dark:text-gray-100">{{totalCount}}
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900 dark:text-gray-100">{{activeCount}}</td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-green-600 font-semibold">{{fulfilledCount}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      {{else}}
      <div class="text-center py-12">
        <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
        </svg>
        <p class="text-gray-500 dark:text-gray-400 text-lg mb-4">No hospital data available</p>
        <p class="text-gray-400">Hospital statistics will appear as blood requests are submitted</p>
      </div>
      {{/if}}
    </div>

    <!-- Hospital Accounts -->
    <div class="mt-8 mb-8">
      <h2 class="text-xl font-bold text-gray-800 dark:text-gray-200 mb-2">Hospital Accounts</h2>
      <p class="text-gray-600 dark:text-gray-400 mb-4">Verify new registrations or suspend accounts. Suspended hospitals cannot log in.</p>
    </div>
    <div class="bg-white dark:bg-[#18181b] rounded-xl shadow-md dark:shadow-none overflow-hidden">
      {{#if hospitalUsers.length}}
      <div class="overflow-x-auto custom-scrollbar">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-800">
          <thead class="bg-gray-50 dark:bg-[#27272a]">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Hospital</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Email</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Status</th>
              <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white dark:bg-[#18181b] divide-y divide-gray-200 dark:divide-gray-800">
            {{#each hospitalUsers}}
            <tr class="hover:bg-gray-50 dark:bg-[#27272a]" id="hospital-row-{{id}}">
              <td class="px-4 py-3 text-sm font-semibold text-gray-900 dark:text-gray-100">{{firstName}} {{lastName}}</td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600 dark:text-gray-400">{{email}}</td>
              <td class="px-4 py-3 whitespace-nowrap text-sm">
                {{#if isActive}}
                <span class="bg-green-100 text-green-700 px-2 py-1 rounded-full text-xs font-semibold">Verified</span>
                {{else}}
                <span class="bg-yellow-100 text-yellow-700 px-2 py-1 rounded-full text-xs font-semibold">Pending</span>
                {{/if}}
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-right">
                {{#if isActive}}
                <button onclick="setHospitalStatus({{id}}, 'suspend')" class="bg-red-100 text-red-700 px-3 py-1 rounded-lg text-xs font-semibold hover:bg-red-200 transition">Suspend</button>
                {{else}}
                <button onclick="setHospitalStatus({{id}}, 'verify')" class="bg-green-600 text-white px-3 py-1 rounded-lg text-xs font-semibold hover:bg-green-700 transition">Verify</button>
                {{/if}}
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      {{else}}
      <div class="text-center py-12">
        <p class="text-gray-500 dark:text-gray-400 text-lg">No hospital accounts registered yet</p>
      </div>
      {{/if}}
    </div>

  </div>
</div>

<script>
  async function setHospitalStatus(id, action) {
    const verb = action === 'verify' ? 'verify' : 'suspend';
    if (!confirm('Are you sure you want to ' + verb + ' this hospital account?')) return;
    try {
      const response = await fetch('/admin/hospitals/' + id + '/' + action, { method: 'POST' });
      const result = await response.json();
      if (result.success) {
        location.reload();
      } else {
        alert(result.message || 'Could not update hospital status');
      }
    } catch (err) {
      console.error(err);
      alert('Could not update hospital status');
    }
  }
</script>