{{> head}}

{{> user-sidebar}}

<!-- Navigation Bar -->
{{> internal-header}}

<!-- Appointments Content -->
<main id="main-content" tabindex="-1" class="vm-page min-h-screen bg-gray-50 py-12">
  <div class="vm-page-container container mx-auto px-4">
    {{#if error}}<p class="vm-alert vm-alert--danger" role="alert">{{error}} <a class="vm-button vm-button--small" href="/my-appointments">Retry</a></p>{{/if}}
    <div class="max-w-4xl mx-auto">

      <div class="vm-page-heading mb-8">
        <h1 class="text-3xl font-bold mb-2">My Appointments</h1>
        <p class="text-white/90">Upcoming blood donations scheduled for you</p>
      </div>
      {{> record-search label="Search appointments" placeholder="Facility, blood type, location or request ID"}}

      {{#if success_msg}}
      <div class="vm-alert vm-alert--success bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">{{success_msg}}</div>
      {{/if}}
      {{#if error_msg}}
      <div class="vm-alert vm-alert--danger bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">{{error_msg}}</div>
      {{/if}}

      {{#if appointments.length}}
      <div class="space-y-5">
        {{#each appointments}}
        <div class="vm-panel bg-white rounded-md p-6 border-l-4 border-blue-500">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div>
              <div class="flex items-center gap-3 mb-2">
                <span class="text-2xl font-bold text-red-600">{{bloodType}}</span>
                <span class="text-sm text-gray-500">{{unitsRemaining}} units remaining</span>
                {{#if donorConfirmed}}
                <span class="vm-status vm-status--success text-xs font-semibold bg-green-100 text-green-700 px-2 py-1 rounded-full">You confirmed</span>
                {{else}}
                <span class="vm-status vm-status--warning text-xs font-semibold bg-yellow-100 text-yellow-700 px-2 py-1 rounded-full">Awaiting your confirmation</span>
                {{/if}}
              </div>
              <p class="font-semibold text-gray-800">{{hospitalName}}</p>
              <p class="text-sm text-gray-500">{{city}}, {{province}}</p>
              {{#if scheduledDate}}
              <p class="text-sm text-gray-700 mt-1">Scheduled: {{formatDate scheduledDate}} at {{formatTime scheduledDate}}</p>
              {{/if}}
            </div>
            <div class="flex flex-col gap-2 md:items-end">
              {{#unless donorConfirmed}}
              <a href="/confirm-schedule/{{id}}/donor?appointment={{appointmentId}}&amp;version={{version}}" class="vm-button bg-green-600 text-white px-5 py-2 rounded-lg font-semibold hover:bg-green-700 transition text-center vm-button--success">Review and Confirm</a>
              {{/unless}}
              <form method="POST" action="/appointments/{{id}}/decline" id="declineApptForm-{{id}}">
                <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                <input type="hidden" name="version" value="{{version}}">
                <button type="submit" class="vm-button w-full border border-red-300 text-red-600 px-5 py-2 rounded-lg font-semibold hover:bg-red-50 transition vm-button--danger">Decline</button>
              </form>
            </div>
          </div>
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="vm-panel bg-white rounded-md p-12 text-center">
        <p class="text-xl font-semibold text-gray-800 mb-2">No upcoming appointments</p>
        <p class="text-gray-500 mb-6">When a hospital schedules you for a donation, it will appear here.</p>
        <a href="/dashboard" class="vm-button inline-block bg-red-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-red-700 transition">Back to Dashboard</a>
      </div>
      {{/if}}

    </div>
  </div>
  {{> pagination}}
</main>

<script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('[id^="declineApptForm-"]').forEach(function (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      openConfirmModal({
        title: 'Decline Appointment?',
        message: 'The request will go back to the matching pool for another donor.',
        button: 'Decline',
        buttonClass: 'bg-red-600 hover:bg-red-700',
        icon: 'warning',
        onSubmit: function () { form.submit(); }
      });
    });
  });
});
</script>

{{> footer}}
