{{> head}}

{{> user-sidebar}}

<!-- Navigation Bar -->
<nav class="bg-white shadow-md">
  <div class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-1 sm:space-x-3">
        <label for="sidebar-toggle" class="cursor-pointer p-1 sm:p-2 -ml-2 text-gray-600 hover:text-red-600 hover:bg-gray-100 rounded-lg transition-colors" title="Menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </label>
        <div class="flex items-center space-x-1 sm:space-x-2">
          <svg class="w-6 h-6 sm:w-8 sm:h-8 text-red-600" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.94-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" />
          </svg>
          <a href="/dashboard" class="text-xl sm:text-2xl font-bold text-gray-800">VitalMatch</a>
        </div>
      </div>
      <div class="flex items-center space-x-4">
        <a href="/dashboard" class="text-gray-700 hover:text-red-600 transition">Dashboard</a>
        <a href="/logout" class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition">Logout</a>
      </div>
    </div>
  </div>
</nav>

<!-- Appointments Content -->
<div class="min-h-screen bg-gray-50 py-12">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto">

      <div class="bg-gradient-to-r from-blue-600 to-indigo-600 rounded-xl shadow-lg p-8 mb-8 text-white">
        <h1 class="text-3xl font-bold mb-2">My Appointments</h1>
        <p class="text-white/90">Upcoming blood donations scheduled for you</p>
      </div>

      {{#if success_msg}}
      <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">{{success_msg}}</div>
      {{/if}}
      {{#if error_msg}}
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">{{error_msg}}</div>
      {{/if}}

      {{#if appointments.length}}
      <div class="space-y-5">
        {{#each appointments}}
        <div class="bg-white rounded-xl shadow-md p-6 border-l-4 border-blue-500">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div>
              <div class="flex items-center gap-3 mb-2">
                <span class="text-2xl font-bold text-red-600">{{bloodType}}</span>
                <span class="text-sm text-gray-500">{{unitsRequired}} unit(s)</span>
                {{#if donorConfirmed}}
                <span class="text-xs font-semibold bg-green-100 text-green-700 px-2 py-1 rounded-full">You confirmed</span>
                {{else}}
                <span class="text-xs font-semibold bg-yellow-100 text-yellow-700 px-2 py-1 rounded-full">Awaiting your confirmation</span>
                {{/if}}
              </div>
              <p class="font-semibold text-gray-800">{{hospitalName}}</p>
              <p class="text-sm text-gray-500">{{city}}, {{province}}</p>
              {{#if scheduledDate}}
              <p class="text-sm text-gray-700 mt-1">Scheduled: {{formatDate scheduledDate}} at {{formatTime scheduledDate}}</p>
              {{/if}}
            </div>
            <div class="flex flex-col gap-2 md:items-end">
              {{#unless donorConfirmed}}
              <a href="/confirm-schedule/{{id}}/donor" class="bg-green-600 text-white px-5 py-2 rounded-lg font-semibold hover:bg-green-700 transition text-center">Review and Confirm</a>
              {{/unless}}
              <form method="POST" action="/appointments/{{id}}/decline" onsubmit="return confirm('Are you sure you want to decline this appointment? The request will go back to matching.');">
                <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                <button type="submit" class="w-full border border-red-300 text-red-600 px-5 py-2 rounded-lg font-semibold hover:bg-red-50 transition">Decline</button>
              </form>
            </div>
          </div>
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="bg-white rounded-xl shadow-md p-12 text-center">
        <p class="text-xl font-semibold text-gray-800 mb-2">No upcoming appointments</p>
        <p class="text-gray-500 mb-6">When a hospital schedules you for a donation, it will appear here.</p>
        <a href="/dashboard" class="inline-block bg-red-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-red-700 transition">Back to Dashboard</a>
      </div>
      {{/if}}

    </div>
  </div>
</div>

{{> footer}}
