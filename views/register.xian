{{> head-public}}
{{> public-nav hideRegister=true}}
<main id="main-content" tabindex="-1" class="journey-auth journey-register">
  <div class="journey-container journey-auth__grid">
    <section class="journey-auth__form" aria-labelledby="register-heading">
      <p class="journey-eyebrow">Join the donor community</p>
      <h1 id="register-heading">Be ready to help.</h1>
      <p class="journey-lead">Create your account to begin. After verifying your email, you can complete your donor profile and share your availability.</p>
      {{#if error}}<div id="register-error" class="journey-alert" role="alert">{{error}}</div>{{/if}}
      <form method="POST" action="/register" class="journey-form"{{#if error}} aria-describedby="register-error"{{/if}}>
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <p class="journey-alert" role="alert" data-form-status hidden></p>
        <fieldset><legend>Personal information</legend><div class="journey-form__grid">
          <div><label for="firstName">First name *</label><input type="text" name="firstName" id="firstName" autocomplete="given-name" required></div>
          <div><label for="lastName">Last name *</label><input type="text" name="lastName" id="lastName" autocomplete="family-name" required></div>
          <div><label for="dateOfBirth">Date of birth *</label><input type="date" name="dateOfBirth" id="dateOfBirth" autocomplete="bday" required></div>
          <div><label for="gender">Gender *</label><select name="gender" id="gender" required><option value="">Select gender</option><option value="Male">Male</option><option value="Female">Female</option><option value="Other">Other</option></select></div>
        </div></fieldset>
        <fieldset><legend>Contact information</legend>
          <label for="email">Email address *</label><input type="email" name="email" id="email" autocomplete="email" placeholder="name@example.com" required>
          <label for="phone">Mobile number *</label><input type="tel" name="phone" id="phone" autocomplete="tel" placeholder="09171234567" pattern="[0-9]{11}" aria-describedby="phone-help" required><p class="field-help" id="phone-help">Use an 11-digit Philippine mobile number, for example 09171234567.</p>
          <label for="address">Complete address *</label><textarea name="address" id="address" autocomplete="street-address" rows="2" placeholder="Street, barangay, municipality, Oriental Mindoro" required></textarea>
        </fieldset>
        <fieldset><legend>Account security</legend>
          <label for="password">Password *</label><div class="password-field"><input type="password" name="password" id="password" autocomplete="new-password" minlength="{{#if passwordPolicy.minLength}}{{passwordPolicy.minLength}}{{else}}8{{/if}}" maxlength="72" data-password-policy data-require-special="{{#if passwordPolicy.requireSpecialChars}}true{{else}}false{{/if}}" aria-describedby="passwordRequirements" required><button type="button" data-toggle-password="password" aria-controls="password" aria-pressed="false" aria-label="Show or hide password">Show</button></div>
          <ul id="passwordRequirements" class="password-requirements"><li data-rule="length">At least {{#if passwordPolicy.minLength}}{{passwordPolicy.minLength}}{{else}}8{{/if}} characters</li><li data-rule="upper">One uppercase letter (A-Z)</li><li data-rule="lower">One lowercase letter (a-z)</li><li data-rule="digit">One number (0-9)</li>{{#if passwordPolicy.requireSpecialChars}}<li data-rule="special">One symbol from @$!%*?&amp;</li>{{/if}}<li data-rule="allowed">Use only A-Z, a-z, 0-9, or @$!%*?&amp;</li><li data-rule="max">No more than 72 UTF-8 bytes (72 characters with the allowed characters)</li></ul>
          <label for="confirmPassword">Confirm password *</label><div class="password-field"><input type="password" name="confirmPassword" id="confirmPassword" autocomplete="new-password" minlength="{{#if passwordPolicy.minLength}}{{passwordPolicy.minLength}}{{else}}8{{/if}}" maxlength="72" required><button type="button" data-toggle-password="confirmPassword" aria-controls="confirmPassword" aria-pressed="false" aria-label="Show or hide confirm password">Show</button></div>
        </fieldset>
        <p class="field-help">Fields marked * are required. Read our <a class="journey-text-link" href="/privacy">privacy policy</a> and <a class="journey-text-link" href="/terms">terms of service</a>.</p>
        <button type="submit" class="journey-button journey-button--block">Create donor account</button>
        <p class="journey-form__footer">Already registered? <a href="/login">Sign in to your account</a></p>
      </form>
    </section>
    <aside class="journey-auth__rail" aria-labelledby="register-guide" data-reveal>
      <p class="journey-eyebrow">What happens next</p><h2 id="register-guide">One clear step at a time.</h2>
      <ol class="journey-rail__steps"><li><div><strong>Create your account</strong><span>Share your personal and contact details.</span></div></li><li><div><strong>Verify your email</strong><span>Open the verification link sent to your inbox.</span></div></li><li><div><strong>Complete your profile</strong><span>Add donor information and availability after signing in.</span></div></li></ol>
      <p>Registration does not determine donation eligibility. Screening is carried out by qualified medical professionals.</p>
      <p>Representing a hospital or clinic? Accounts are issued by an administrator. <a href="/contact" class="journey-text-link">Contact the team</a>.</p>
    </aside>
  </div>
</main>
<script src="/js/public-register.js?v=2" defer></script>
{{> public-footer}}
