{{> head}}
{{> user-sidebar}}
{{> internal-header}}

<main id="main-content" tabindex="-1" class="vm-page min-h-screen bg-gray-50 py-8">
  <div class="vm-page-container max-w-3xl">
    <div class="vm-page-heading mb-8">
      <p class="vm-eyebrow">Help us improve</p>
      <h1>Review VitalMatch</h1>
      <p>Share what is working well and what would make the system easier to use. Your feedback is visible to the VitalMatch administrators.</p>
    </div>

    {{#if success_msg}}<div class="vm-alert vm-alert--success mb-5" role="status">{{success_msg}}</div>{{/if}}
    {{#if error_msg}}<div class="vm-alert vm-alert--danger mb-5" role="alert">{{error_msg}}</div>{{/if}}

    <section class="vm-panel bg-white dark:bg-[#18181b] rounded-md p-6 mb-8" aria-labelledby="feedback-form-title">
      <h2 id="feedback-form-title" class="text-xl font-bold mb-2">How was your experience?</h2>
      <p class="text-sm text-gray-600 dark:text-gray-400 mb-5">Your account role is included so administrators can understand feedback across requesters, donors, hospitals, and administrators.</p>
      <form action="/feedback" method="POST" class="space-y-5">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <fieldset>
          <legend class="block text-sm font-semibold mb-2">Overall rating <span aria-hidden="true">*</span></legend>
          <div class="flex flex-wrap gap-3" role="radiogroup" aria-label="Overall rating">
            <label class="inline-flex items-center gap-2 border border-gray-300 dark:border-gray-700 rounded-lg px-3 py-2 cursor-pointer hover:border-red-500">
              <input type="radio" name="rating" value="1" required class="accent-red-600"><span>1 ★</span>
            </label>
            <label class="inline-flex items-center gap-2 border border-gray-300 dark:border-gray-700 rounded-lg px-3 py-2 cursor-pointer hover:border-red-500">
              <input type="radio" name="rating" value="2" class="accent-red-600"><span>2 ★</span>
            </label>
            <label class="inline-flex items-center gap-2 border border-gray-300 dark:border-gray-700 rounded-lg px-3 py-2 cursor-pointer hover:border-red-500">
              <input type="radio" name="rating" value="3" class="accent-red-600"><span>3 ★</span>
            </label>
            <label class="inline-flex items-center gap-2 border border-gray-300 dark:border-gray-700 rounded-lg px-3 py-2 cursor-pointer hover:border-red-500">
              <input type="radio" name="rating" value="4" class="accent-red-600"><span>4 ★</span>
            </label>
            <label class="inline-flex items-center gap-2 border border-gray-300 dark:border-gray-700 rounded-lg px-3 py-2 cursor-pointer hover:border-red-500">
              <input type="radio" name="rating" value="5" class="accent-red-600"><span>5 ★</span>
            </label>
          </div>
        </fieldset>

        <div>
          <label for="feedback-category" class="block text-sm font-semibold mb-2">What is this about?</label>
          <select id="feedback-category" name="category" class="w-full rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-[#09090b] px-3 py-2">
            <option value="general">General experience</option>
            <option value="ease_of_use">Ease of use</option>
            <option value="accessibility">Accessibility</option>
            <option value="bug">Something is not working</option>
            <option value="feature">Feature idea</option>
          </select>
        </div>

        <div>
          <label for="feedback-comment" class="block text-sm font-semibold mb-2">Tell us more <span class="font-normal text-gray-500">(optional)</span></label>
          <textarea id="feedback-comment" name="comment" rows="5" maxlength="2000" class="w-full rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-[#09090b] px-3 py-2" placeholder="What should we keep, change, or fix?"></textarea>
          <p class="text-xs text-gray-500 mt-1">Do not include patient names or other private medical details.</p>
        </div>
        <button type="submit" class="vm-button vm-button--primary px-5 py-2">Send feedback</button>
      </form>
    </section>

    <section aria-labelledby="my-feedback-title">
      <h2 id="my-feedback-title" class="text-lg font-bold mb-3">Your recent feedback</h2>
      {{#if submissions.length}}
        <div class="space-y-3">
          {{#each submissions}}
          <article class="vm-panel bg-white dark:bg-[#18181b] rounded-md p-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <strong>{{rating}} / 5 stars · {{category}}</strong>
              <span class="text-xs text-gray-500">{{status}} · {{formatDate createdAt}}</span>
            </div>
            {{#if comment}}<p class="mt-2 text-sm whitespace-pre-wrap">{{comment}}</p>{{/if}}
          </article>
          {{/each}}
        </div>
      {{else}}
        <p class="text-sm text-gray-600 dark:text-gray-400">You have not sent any feedback yet.</p>
      {{/if}}
    </section>
  </div>
</main>
{{> footer}}
