{{> head}}
<link rel="stylesheet" href="/css/vendor/leaflet/leaflet.css?v=1.9.4" />
<script src="/js/vendor/leaflet/leaflet.js?v=1.9.4" defer></script>

{{> user-sidebar}}
<!-- Navigation Bar -->
{{> internal-header}}

<!-- Map Content -->
<main id="main-content" tabindex="-1" class="vm-page min-h-screen bg-gray-50 py-8">
  <div class="vm-page-container container mx-auto px-4">
    <div class="max-w-6xl mx-auto">

      <div class="vm-page-heading mb-6">
        <h1 class="text-3xl font-bold text-gray-800 mb-2">Blood Map of Mindoro</h1>
        <p class="text-gray-600">Hospitals with open requests, urgent needs, donation centers, and donor coverage. Toggle layers on the map.</p>
      </div>

      <p id="mapFeedback" class="vm-muted mb-3" aria-live="polite">Loading map records...</p>
      <div class="flex gap-3 mb-4"><button id="mapRetry" type="button" class="vm-button vm-button--small">Refresh map records</button><a class="vm-button vm-button--small" href="{{#if isAdmin}}/admin/requests{{else}}/my-requests{{/if}}">Open request register</a></div>
      <div class="vm-panel bg-white rounded-md overflow-hidden">
        <div id="bloodMap" class="w-full" style="height: 70vh; min-height: 480px;"></div>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 px-6 py-4 border-t border-gray-100 text-sm text-gray-600">
          <span class="flex items-center"><span class="inline-block w-4 h-4 rounded-full bg-blue-600 text-white text-[10px] font-bold text-center leading-4 mr-2">H</span>Hospital</span>
          <span class="flex items-center"><span class="inline-block w-4 h-4 rounded-full bg-red-600 text-white text-[10px] font-bold text-center leading-4 mr-2">!</span>Urgent request</span>
          <span class="flex items-center"><span class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-white border-2 border-red-600 text-red-600 text-[10px] font-bold mr-2">+</span>Donation center</span>
          <span class="flex items-center"><span class="inline-block w-4 h-4 rounded-full bg-green-600 mr-2"></span>Available donor (approx.)</span>
          <span class="flex items-center"><span class="inline-block w-4 h-4 rounded-full bg-orange-500 text-white text-[10px] font-bold text-center leading-4 mr-2">#</span>Donor coverage</span>
        </div>
      </div>

      <p class="text-xs text-gray-500 mt-4">Donor pins are approximate city-level locations to protect privacy. Only hospitals see available-donor coverage; your exact location is visible only to you.</p>

    </div>
  </div>
</main>



<script src="/js/workspace-map.js?v=2" defer></script>

{{> footer}}
