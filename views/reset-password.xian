{{> head-public}}
{{> public-nav hideLogin=true }}

<main id="main-content" tabindex="-1" class="journey-page journey-simple">
  <div class="journey-simple__panel">
    <p class="journey-eyebrow">Account access</p>
    <h1 class="journey-title">Choose a new password.</h1>
    <p class="journey-lead" id="passwordRequirements">Use at least {{#if passwordPolicy.minLength}}{{passwordPolicy.minLength}}{{else}}8{{/if}} characters with an uppercase letter, a lowercase letter, and a number.{{#if passwordPolicy.requireSpecialChars}} Include a symbol from @$!%*?&amp;.{{/if}} Use only A-Z, a-z, 0-9, or @$!%*?&amp;. The maximum is 72 UTF-8 bytes (72 characters with the allowed characters).</p>
    <div class="journey-form">
      {{#if tokenValid}}
      {{#if error_msg}}<div class="journey-alert" role="alert">{{error_msg}}</div>{{/if}}
      <form method="POST" action="/reset-password/{{token}}" autocomplete="on">
        <p class="journey-alert" role="alert" data-form-status hidden></p>
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <label for="newPassword">New password<input type="password" name="newPassword" id="newPassword" placeholder="Create a new password" minlength="{{#if passwordPolicy.minLength}}{{passwordPolicy.minLength}}{{else}}8{{/if}}" maxlength="72" autocomplete="new-password" data-password-policy data-require-special="{{#if passwordPolicy.requireSpecialChars}}true{{else}}false{{/if}}" aria-describedby="passwordRequirements" required></label>
        <label for="confirmPassword">Confirm new password<input type="password" name="confirmPassword" id="confirmPassword" placeholder="Re-enter your new password" minlength="{{#if passwordPolicy.minLength}}{{passwordPolicy.minLength}}{{else}}8{{/if}}" maxlength="72" autocomplete="new-password" required></label>
        <button type="submit" class="journey-button journey-button--block">Reset password</button>
      </form>
      {{else}}
      <div class="journey-alert" role="alert">This reset link is invalid or has expired. Request a new link to continue.</div>
      <a class="journey-button journey-button--block" href="/forgot-password">Request a new link</a>
      {{/if}}
    </div>
  </div>
</main>

<script src="/js/public-register.js?v=2" defer></script>
{{> public-footer}}
