{{> head}}

{{> user-sidebar}}

<main id="main-content" tabindex="-1" class="vm-page min-h-screen bg-gray-50 py-8">
  <div class="vm-page-container container mx-auto px-4">
    {{#if error}}<div class="vm-alert vm-alert--danger mb-4" role="alert">{{error}} <a class="vm-text-link" href="/hospital/appointments">Retry</a></div>{{/if}}
    <div class="max-w-6xl mx-auto">

      <div class="vm-page-heading vm-heading-actions flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <div>
          <h1 class="text-3xl font-bold text-gray-800">Facility Appointments</h1>
          <p class="text-gray-600">Scheduled donations for your facility — confirmations update here</p>
        </div>
      </div>
      {{> record-search label="Search appointments" placeholder="Donor, blood type, facility, location or ID"}}

      <div class="vm-panel bg-white rounded-md overflow-hidden">
        {{#if appointments.length}}
        <div class="vm-table-scroll overflow-x-auto" tabindex="0" role="region" aria-label="Scrollable data table">
          <table data-search-mode="server" class="vm-table min-w-full divide-y divide-gray-200">
            <thead>
              <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Request</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Donor</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Blood</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Scheduled</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Confirmations</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {{#each appointments}}
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3 text-sm font-semibold text-gray-800">#{{id}} · {{hospitalName}}</td>
                <td class="px-4 py-3 text-sm text-gray-700">{{donorName}}{{#if donorBloodType}} ({{donorBloodType}}){{/if}}</td>
                <td class="px-4 py-3 text-sm font-bold text-red-600">{{bloodType}}</td>
                <td class="px-4 py-3 text-sm text-gray-700">{{formatDateTime scheduledDate}}</td>
                <td class="px-4 py-3 text-xs text-gray-600">Donor: {{#if donorConfirmed}}confirmed{{else}}pending{{/if}} · Requester: {{#if requesterConfirmed}}confirmed{{else}}pending{{/if}}</td>
                <td class="px-4 py-3 text-right whitespace-nowrap">
                  <a href="/view-blood-request/{{id}}" class="text-blue-600 hover:text-blue-800 text-sm font-semibold">View</a>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        {{else}}
        <div class="p-12 text-center">
          <p class="text-lg font-semibold text-gray-800 mb-2">No scheduled appointments</p>
          <p class="text-gray-500 mb-6">Appointments you coordinate will appear here with confirmation status.</p>
          <a href="/hospital/patients" class="inline-block bg-red-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-red-700 transition">Patient Records</a>
        </div>
        {{/if}}
      </div>

    </div>
  </div>
</main>

{{> footer}}
