{{> head}}

{{> user-sidebar}}

<!-- Navigation Bar -->
{{> internal-header}}

<!-- Facility blood requests Content -->
<main id="main-content" tabindex="-1" class="vm-page min-h-screen bg-gray-50 py-8">
  <div class="vm-page-container container mx-auto px-4">
    {{#if error}}<div class="vm-alert vm-alert--danger mb-4" role="alert">{{error}} <a class="vm-text-link" href="/hospital/patients">Retry</a></div>{{/if}}
    <div class="max-w-6xl mx-auto">

      <div class="vm-page-heading vm-heading-actions flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <div>
          <h1 class="text-3xl font-bold text-gray-800">Facility blood requests</h1>
          <p class="text-gray-600">Every patient request submitted by your facility</p>
          {{#if facilityName}}
          <p class="text-sm text-blue-700 font-semibold mt-1">Showing patients of {{facilityName}} only</p>
          {{/if}}
        </div>
        <div class="flex gap-2">
          <a href="/messages/admin" class="vm-button inline-flex items-center bg-blue-600 text-white px-5 py-2 rounded-lg font-semibold hover:bg-blue-700 transition">Message Admin</a>
          <a href="/request-blood" class="vm-button vm-button--primary inline-flex items-center bg-red-600 text-white px-5 py-2 rounded-lg font-semibold hover:bg-red-700 transition">+ New Request</a>
        </div>
      </div>
      {{> record-search label="Search patient records" placeholder="Patient, blood type, facility, location or ID"}}

      {{#if success_msg}}
      <div class="vm-alert vm-alert--success bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">{{success_msg}}</div>
      {{/if}}
      {{#if error_msg}}
      <div class="vm-alert vm-alert--danger bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">{{error_msg}}</div>
      {{/if}}

      {{#if pendingReview.length}}
      <div class="bg-yellow-50 border border-yellow-300 rounded-md p-6 mb-6">
        <h2 class="text-xl font-bold text-yellow-800 mb-2">Needs Your Review ({{pendingReview.length}})</h2>
        <p class="text-sm text-yellow-700 mb-4">These requests name your facility. Confirm whether each patient is really yours.</p>
        <div class="space-y-3">
          {{#each pendingReview}}
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 bg-white border border-yellow-200 rounded-lg px-4 py-3">
            <div>
              <p class="font-semibold text-gray-800">Request #{{id}} · {{patientName}}, {{patientAge}} yrs · <span class="text-red-600 font-bold">{{bloodType}}</span></p>
              <p class="text-xs text-gray-500">{{hospitalName}} · {{city}} · {{formatDate createdAt}}</p>
            </div>
            <div class="flex gap-2">
              <a href="/view-blood-request/{{id}}" class="vm-button vm-button--small px-4 py-2 text-sm border border-gray-300 text-gray-700 rounded-lg font-semibold hover:bg-gray-50 transition">Review</a>
              <form method="POST" action="/hospital/requests/{{id}}/approve" class="inline" id="approveHospForm-{{id}}">
                <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
                <button type="submit" class="vm-button vm-button--small px-4 py-2 text-sm bg-green-600 text-white rounded-lg font-semibold hover:bg-green-700 transition vm-button--success">Approve</button>
              </form>
              <form method="POST" action="/hospital/requests/{{id}}/decline" class="inline" id="declineHospForm-{{id}}">
                <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
                <input type="text" name="declineReason" required placeholder="Reason for declining" maxlength="200"
                  class="px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-red-500 focus:border-red-500" aria-label="Reason for declining">
                <button type="submit" class="vm-button vm-button--small px-4 py-2 text-sm border border-red-300 text-red-600 rounded-lg font-semibold hover:bg-red-50 transition vm-button--danger">Decline</button>
              </form>
            </div>
          </div>
          {{/each}}
        </div>
      </div>
      {{/if}}

      <div class="vm-metric-grid grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="vm-panel bg-white rounded-md p-4 text-center">
          <p class="text-2xl font-bold text-gray-800">{{summary.total}}</p>
          <p class="text-xs text-gray-500">Total requests</p>
        </div>
        <div class="vm-panel bg-white rounded-md p-4 text-center">
          <p class="text-2xl font-bold text-green-600">{{summary.active}}</p>
          <p class="text-xs text-gray-500">Active</p>
        </div>
        <div class="vm-panel bg-white rounded-md p-4 text-center">
          <p class="text-2xl font-bold text-blue-600">{{summary.scheduled}}</p>
          <p class="text-xs text-gray-500">Scheduled</p>
        </div>
        <div class="vm-panel bg-white rounded-md p-4 text-center">
          <p class="text-2xl font-bold text-purple-600">{{summary.fulfilled}}</p>
          <p class="text-xs text-gray-500">Fulfilled</p>
        </div>
      </div>

      <div class="vm-panel bg-white rounded-md overflow-hidden">
        {{#if records.length}}
        <div class="vm-table-scroll overflow-x-auto" tabindex="0" role="region" aria-label="Scrollable data table">
          <table data-search-mode="server" class="vm-table min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Patient</th>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Blood</th>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Urgency</th>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Pledges</th>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Donor / Schedule</th>
                <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              {{#each records}}
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3">
                  <p class="text-sm font-semibold text-gray-800">{{patientName}}</p>
                  <p class="text-xs text-gray-500">{{patientAge}} yrs ? {{unitsRequired}} unit(s) ? {{formatDate createdAt}}</p>
                </td>
                <td class="px-4 py-3"><span class="text-sm font-bold text-red-600">{{bloodType}}</span></td>
                <td class="px-4 py-3">{{> status-badge value=urgency}}</td>
                <td class="px-4 py-3">{{> status-badge value=status}}</td>
                <td class="px-4 py-3 text-sm text-gray-700">{{#if pledgeCount}}{{pledgeCount}} offered{{else}}None{{/if}}</td>
                <td class="px-4 py-3 text-sm text-gray-700">{{#if donorName}}{{donorName}}{{else}}Not assigned{{/if}}{{#if scheduledDate}}<p class="vm-muted text-xs">{{formatDate scheduledDate}} at {{formatTime scheduledDate}}</p>{{/if}}</td>
                <td class="px-4 py-3 text-right whitespace-nowrap">
                  <a href="/view-blood-request/{{id}}" class="vm-button vm-button--small">View</a>
                  {{#if (eq status 'active')}}
                  {{#if isOwn}}
                  <form method="POST" action="/cancel-request/{{id}}" class="inline" id="cancelReqForm-{{id}}">
                    <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
                    <button type="submit" class="vm-button vm-button--small text-red-600 hover:text-red-800 text-sm font-semibold vm-button--danger">Cancel</button>
                  </form>
                  {{/if}}
                  {{/if}}
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        {{else}}
        <div class="p-12 text-center">
          <p class="text-lg font-semibold text-gray-800 mb-2">No patient records yet</p>
          <p class="text-gray-500 mb-6">Submit your first blood request to create a patient record.</p>
          <a href="/request-blood" class="vm-button inline-block bg-red-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-red-700 transition vm-button--primary">New Request</a>
        </div>
        {{/if}}
      </div>

    </div>
  </div>
  {{> pagination}}
</main>

<script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('[id^="approveHospForm-"]').forEach(function (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      openConfirmModal({
        title: 'Approve Request?',
        message: 'This patient will be linked to your facility.',
        button: 'Approve',
        buttonClass: 'bg-green-600 hover:bg-green-700',
        icon: 'success',
        onSubmit: function () { form.submit(); }
      });
    });
  });
  document.querySelectorAll('[id^="declineHospForm-"]').forEach(function (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      openConfirmModal({
        title: 'Decline Request?',
        message: 'This patient will not be linked to your facility.',
        button: 'Decline',
        buttonClass: 'bg-red-600 hover:bg-red-700',
        icon: 'warning',
        onSubmit: function () { form.submit(); }
      });
    });
  });
  document.querySelectorAll('[id^="cancelReqForm-"]').forEach(function (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      openConfirmModal({
        title: 'Cancel Request?',
        message: 'This patient request will be permanently cancelled.',
        button: 'Cancel Request',
        buttonClass: 'bg-red-600 hover:bg-red-700',
        icon: 'danger',
        onSubmit: function () { form.submit(); }
      });
    });
  });
});
</script>

{{> footer}}
