{{> head}}

{{> user-sidebar}}

<!-- Navigation Bar -->
<nav class="bg-white shadow-md">
  <div class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-1 sm:space-x-3">
        <label for="sidebar-toggle" class="cursor-pointer p-1 sm:p-2 -ml-2 text-gray-600 hover:text-red-600 hover:bg-gray-100 rounded-lg transition-colors" title="Menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </label>
        <div class="flex items-center space-x-1 sm:space-x-2">
          <svg class="w-6 h-6 sm:w-8 sm:h-8 text-red-600" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.94-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" />
          </svg>
          <a href="/dashboard" class="text-xl sm:text-2xl font-bold text-gray-800">VitalMatch</a>
        </div>
      </div>
      <div class="flex items-center space-x-4">
        <a href="/dashboard" class="text-gray-700 hover:text-red-600 transition">Dashboard</a>
        <a href="/logout" class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition">Logout</a>
      </div>
    </div>
  </div>
</nav>

<!-- Patient Records Content -->
<div class="min-h-screen bg-gray-50 py-8">
  <div class="container mx-auto px-4">
    <div class="max-w-6xl mx-auto">

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <div>
          <h1 class="text-3xl font-bold text-gray-800">Patient Records</h1>
          <p class="text-gray-600">Every patient request submitted by your facility</p>
          {{#if facilityName}}
          <p class="text-sm text-blue-700 font-semibold mt-1">Showing patients of {{facilityName}} only</p>
          {{/if}}
        </div>
        <a href="/request-blood" class="inline-flex items-center bg-red-600 text-white px-5 py-2 rounded-lg font-semibold hover:bg-red-700 transition">+ New Request</a>
      </div>

      {{#if success_msg}}
      <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">{{success_msg}}</div>
      {{/if}}
      {{#if error_msg}}
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">{{error_msg}}</div>
      {{/if}}

      {{#if pendingReview.length}}
      <div class="bg-yellow-50 border border-yellow-300 rounded-xl p-6 mb-6">
        <h2 class="text-xl font-bold text-yellow-800 mb-2">Needs Your Review ({{pendingReview.length}})</h2>
        <p class="text-sm text-yellow-700 mb-4">These requests name your facility. Confirm whether each patient is really yours.</p>
        <div class="space-y-3">
          {{#each pendingReview}}
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 bg-white border border-yellow-200 rounded-lg px-4 py-3">
            <div>
              <p class="font-semibold text-gray-800">Request #{{id}} · {{patientName}}, {{patientAge}} yrs · <span class="text-red-600 font-bold">{{bloodType}}</span></p>
              <p class="text-xs text-gray-500">{{hospitalName}} · {{city}} · {{formatDate createdAt}}</p>
            </div>
            <div class="flex gap-2">
              <a href="/view-blood-request/{{id}}" class="px-4 py-2 text-sm border border-gray-300 text-gray-700 rounded-lg font-semibold hover:bg-gray-50 transition">Review</a>
              <form method="POST" action="/hospital/requests/{{id}}/approve" class="inline">
                <input type="hidden" name="_csrf" value="{{csrfToken}}">
                <button type="submit" class="px-4 py-2 text-sm bg-green-600 text-white rounded-lg font-semibold hover:bg-green-700 transition">Approve</button>
              </form>
              <form method="POST" action="/hospital/requests/{{id}}/decline" class="inline" onsubmit="return confirm('Decline this request (patient is not yours)?');">
                <input type="hidden" name="_csrf" value="{{csrfToken}}">
                <button type="submit" class="px-4 py-2 text-sm border border-red-300 text-red-600 rounded-lg font-semibold hover:bg-red-50 transition">Decline</button>
              </form>
            </div>
          </div>
          {{/each}}
        </div>
      </div>
      {{/if}}

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-white rounded-xl shadow-md p-4 text-center">
          <p class="text-2xl font-bold text-gray-800">{{summary.total}}</p>
          <p class="text-xs text-gray-500">Total Patients</p>
        </div>
        <div class="bg-white rounded-xl shadow-md p-4 text-center">
          <p class="text-2xl font-bold text-green-600">{{summary.active}}</p>
          <p class="text-xs text-gray-500">Active</p>
        </div>
        <div class="bg-white rounded-xl shadow-md p-4 text-center">
          <p class="text-2xl font-bold text-blue-600">{{summary.scheduled}}</p>
          <p class="text-xs text-gray-500">Scheduled</p>
        </div>
        <div class="bg-white rounded-xl shadow-md p-4 text-center">
          <p class="text-2xl font-bold text-purple-600">{{summary.fulfilled}}</p>
          <p class="text-xs text-gray-500">Fulfilled</p>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-md overflow-hidden">
        {{#if records.length}}
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Patient</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Blood</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Urgency</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Pledges</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Donor / Schedule</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              {{#each records}}
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3">
                  <p class="text-sm font-semibold text-gray-800">{{patientName}}</p>
                  <p class="text-xs text-gray-500">{{patientAge}} yrs � {{unitsRequired}} unit(s) � {{formatDate createdAt}}</p>
                </td>
                <td class="px-4 py-3"><span class="text-sm font-bold text-red-600">{{bloodType}}</span></td>
                <td class="px-4 py-3"><span class="text-xs font-semibold capitalize">{{urgency}}</span></td>
                <td class="px-4 py-3"><span class="text-xs font-semibold capitalize px-2 py-1 rounded-full {{#if (eq status "fulfilled")}}bg-blue-100 text-blue-700{{else}}{{#if (eq status "active")}}bg-green-100 text-green-700{{else}}bg-gray-100 text-gray-600{{/if}}{{/if}}">{{status}}</span></td>
                <td class="px-4 py-3 text-sm text-gray-700">{{#if pledgeCount}}{{pledgeCount}} offered{{else}}�{{/if}}</td>
                <td class="px-4 py-3 text-sm text-gray-700">{{#if donorName}}{{donorName}}{{else}}�{{/if}}</td>
                <td class="px-4 py-3 text-right whitespace-nowrap">
                  <a href="/view-blood-request/{{id}}" class="text-blue-600 hover:text-blue-800 text-sm font-semibold mr-3">View</a>
                  {{#if (eq status 'active')}}
                  <form method="POST" action="/cancel-request/{{id}}" class="inline" onsubmit="return confirm('Cancel this patient request?');">
                    <input type="hidden" name="_csrf" value="{{csrfToken}}">
                    <button type="submit" class="text-red-600 hover:text-red-800 text-sm font-semibold">Cancel</button>
                  </form>
                  {{/if}}
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        {{else}}
        <div class="p-12 text-center">
          <p class="text-lg font-semibold text-gray-800 mb-2">No patient records yet</p>
          <p class="text-gray-500 mb-6">Submit your first blood request to create a patient record.</p>
          <a href="/request-blood" class="inline-block bg-red-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-red-700 transition">New Request</a>
        </div>
        {{/if}}
      </div>

    </div>
  </div>
</div>

{{> footer}}
