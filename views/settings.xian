{{> head}}

{{> user-sidebar}}

<!-- Navigation Bar -->
{{> internal-header}}

<!-- Settings Content -->
<main id="main-content" tabindex="-1" class="vm-page min-h-screen bg-gray-50 py-12">
  <div class="vm-page-container container mx-auto px-4">
    <div class="max-w-4xl mx-auto">

      <!-- Header -->
      <div class="vm-page-heading mb-8">
        <h1 class="text-3xl font-bold mb-2">Settings</h1>
        <p class="text-red-100">Manage your profile, donor preferences, notifications, and security</p>
      </div>

      <!-- Flash Messages -->
      {{#if success_msg}}
      <div class="vm-alert vm-alert--success bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">
        {{success_msg}}
      </div>
      {{/if}}
      {{#if error_msg}}
      <div class="vm-alert vm-alert--danger bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
        {{error_msg}}
      </div>
      {{/if}}

      <!-- Tabs -->
      <div class="vm-panel bg-white rounded-md mb-6 overflow-hidden">
        <div class="vm-tabs flex border-b overflow-x-auto">
          <button type="button" data-tab="profile" class="settings-tab px-6 py-4 text-sm font-semibold whitespace-nowrap">Profile</button>
          <button type="button" data-tab="donor" class="settings-tab px-6 py-4 text-sm font-semibold whitespace-nowrap">Donor</button>
          <button type="button" data-tab="notifications" class="settings-tab px-6 py-4 text-sm font-semibold whitespace-nowrap">Notifications</button>
          <button type="button" data-tab="security" class="settings-tab px-6 py-4 text-sm font-semibold whitespace-nowrap">Security</button>
        </div>
      </div>

      <!-- Profile Panel -->
      <div id="panel-profile" class="vm-form-shell vm-panel settings-panel bg-white rounded-md p-8 hidden">
        <h2 class="text-xl font-bold text-gray-800 mb-6">Profile Information</h2>
        <form action="/settings/profile" method="POST" class="space-y-5">
          <input type="hidden" name="_csrf" value="{{csrfToken}}">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2" for="vm-settings-58">First Name</label>
              <input type="text" name="firstName" value="{{user.firstName}}" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500" id="vm-settings-58">
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2" for="vm-settings-59">Last Name</label>
              <input type="text" name="lastName" value="{{user.lastName}}" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500" id="vm-settings-59">
            </div>
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2" for="vm-settings-60">Email (cannot be changed)</label>
            <input type="email" value="{{user.email}}" disabled class="w-full px-4 py-3 border border-gray-200 bg-gray-100 text-gray-500 rounded-lg" id="vm-settings-60">
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2" for="vm-settings-61">Phone</label>
            <input type="text" name="phone" value="{{user.phone}}" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500" id="vm-settings-61">
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2" for="vm-settings-62">Address</label>
            <textarea name="address" rows="3" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500" id="vm-settings-62">{{user.address}}</textarea>
          </div>
          {{#if (eq user.role 'hospital')}}
          <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
            <label class="block text-sm font-semibold text-gray-700 mb-2" for="vm-settings-63">Official Hospital Name</label>
            <input type="text" name="hospitalName" value="{{user.hospitalName}}" readonly placeholder="e.g. Calapan City Hospital" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500" id="vm-settings-63">
            <p class="text-xs text-gray-500 mt-1">Facility identity is managed by a chapter administrator. Contact the coordination team to request a correction.</p>
          </div>
          {{/if}}
          <button type="submit" class="vm-button vm-button--primary bg-red-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-red-700 transition">Save Profile</button>
        </form>
      </div>

      <!-- Donor Panel -->
      <div id="panel-donor" class="vm-form-shell vm-panel settings-panel bg-white rounded-md p-8 hidden">
        <h2 class="text-xl font-bold text-gray-800 mb-6">Donor Preferences</h2>
        {{#if isDonor}}
        <form action="/settings/donor" method="POST" class="space-y-5">
          <input type="hidden" name="_csrf" value="{{csrfToken}}">
          <div class="flex items-center justify-between bg-gray-50 border border-gray-200 rounded-lg p-4">
            <div>
              <p class="font-semibold text-gray-800">Available for matching</p>
              <p class="text-sm text-gray-500">When on, hospitals can match you to blood requests</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" name="isAvailable" class="sr-only peer" {{#if donor.isAvailable}}checked{{/if}}>
              <div class="w-11 h-6 bg-gray-200 rounded-full peer-checked:bg-red-600 transition-colors"></div>
            </label>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2" for="vm-settings-64">Blood Type</label>
              <input type="text" value="{{donor.bloodType}}" disabled class="w-full px-4 py-3 border border-gray-200 bg-gray-100 text-gray-500 rounded-lg" id="vm-settings-64">
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2" for="vm-settings-65">Contact Number</label>
              <input type="text" name="mobileNumber" value="{{donor.mobileNumber}}" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500" id="vm-settings-65">
            </div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2" for="vm-settings-66">Emergency Contact Name</label>
              <input type="text" name="emergencyContactName" value="{{donor.emergencyContactName}}" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500" id="vm-settings-66">
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2" for="vm-settings-67">Emergency Contact Number</label>
              <input type="text" name="emergencyContactNumber" value="{{donor.emergencyContactNumber}}" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500" id="vm-settings-67">
            </div>
          </div>
          <button type="submit" class="vm-button vm-button--primary bg-red-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-red-700 transition">Save Donor Settings</button>
        </form>
        {{else}}
        <div class="text-center py-8">
          <p class="text-gray-600 mb-4">You do not have a donor profile yet. Register as a donor to manage availability and emergency contacts here.</p>
          <a href="/donor-profile" class="vm-button inline-block bg-red-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-red-700 transition vm-button--primary">Become a Donor</a>
        </div>
        {{/if}}
      </div>

      <!-- Notifications Panel -->
      <div id="panel-notifications" class="vm-panel settings-panel bg-white rounded-md p-8 hidden">
        <h2 class="text-xl font-bold text-gray-800 mb-2">Notification Preferences</h2>
        <p class="text-sm text-gray-500 mb-6">Choose what VitalMatch is allowed to send you</p>
        <form action="/settings/notifications" method="POST" class="space-y-4">
          <input type="hidden" name="_csrf" value="{{csrfToken}}">
          <label class="flex items-start space-x-3 bg-gray-50 border border-gray-200 rounded-lg p-4 cursor-pointer">
            <input type="checkbox" name="notifyMatches" {{#if prefs.notifyMatches}}checked{{/if}} class="mt-1 w-5 h-5 text-red-600 rounded focus:ring-red-500">
            <span><span class="block font-semibold text-gray-800">Match alerts</span><span class="block text-sm text-gray-500">Nearby blood requests and donors found for you</span></span>
          </label>
          <label class="flex items-start space-x-3 bg-gray-50 border border-gray-200 rounded-lg p-4 cursor-pointer">
            <input type="checkbox" name="notifyAppointments" {{#if prefs.notifyAppointments}}checked{{/if}} class="mt-1 w-5 h-5 text-red-600 rounded focus:ring-red-500">
            <span><span class="block font-semibold text-gray-800">Appointment updates</span><span class="block text-sm text-gray-500">Scheduled, fulfilled, or cancelled donations</span></span>
          </label>
          <label class="flex items-start space-x-3 bg-gray-50 border border-gray-200 rounded-lg p-4 cursor-pointer">
            <input type="checkbox" name="emailUpdates" {{#if prefs.emailUpdates}}checked{{/if}} class="mt-1 w-5 h-5 text-red-600 rounded focus:ring-red-500">
            <span><span class="block font-semibold text-gray-800">Email updates</span><span class="block text-sm text-gray-500">Nearby request alerts sent to your email inbox</span></span>
          </label>
          <button type="submit" class="vm-button vm-button--primary bg-red-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-red-700 transition">Save Preferences</button>
        </form>
      </div>

      <!-- Security Panel -->
      <div id="panel-security" class="vm-panel settings-panel bg-white rounded-md p-8 hidden">
        <h2 class="text-xl font-bold text-gray-800 mb-6">Security</h2>
        <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 mb-8">
          <p class="font-semibold text-gray-800">{{user.email}}</p>
          {{#if user.emailVerified}}
          <p class="text-sm text-green-600 font-semibold mt-1">Email verified</p>
          {{else}}
          <p class="text-sm text-yellow-600 font-semibold mt-1">Email not verified</p>
          <button type="button" onclick="resendVerification()" class="vm-button vm-button--small mt-2 text-sm text-red-600 hover:text-red-700 font-semibold">Resend verification email</button>
          <p id="resendStatus" class="text-sm text-gray-500 mt-1"></p>
          {{/if}}
        </div>
        <h3 class="text-lg font-bold text-gray-800 mb-4">Change Password</h3>
        <form action="/settings/password" method="POST" class="space-y-5">
          <input type="hidden" name="_csrf" value="{{csrfToken}}">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2" for="vm-settings-68">Current Password</label>
            <input type="password" name="currentPassword" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500" id="vm-settings-68">
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2" for="vm-settings-69">New Password</label>
            <input type="password" name="newPassword" required minlength="{{#if passwordPolicy.minLength}}{{passwordPolicy.minLength}}{{else}}8{{/if}}" maxlength="72" autocomplete="new-password" data-password-policy data-require-special="{{#if passwordPolicy.requireSpecialChars}}true{{else}}false{{/if}}" aria-describedby="passwordRequirements" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500" id="vm-settings-69">
            <p id="passwordRequirements" class="text-xs text-gray-500 mt-1">At least {{#if passwordPolicy.minLength}}{{passwordPolicy.minLength}}{{else}}8{{/if}} characters with an uppercase letter, a lowercase letter, and a number.{{#if passwordPolicy.requireSpecialChars}} Include a symbol from @$!%*?&amp;.{{/if}} Use only A-Z, a-z, 0-9, or @$!%*?&amp;. The maximum is 72 UTF-8 bytes (72 characters with the allowed characters).</p>
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2" for="vm-settings-70">Confirm New Password</label>
            <input type="password" name="confirmPassword" required minlength="{{#if passwordPolicy.minLength}}{{passwordPolicy.minLength}}{{else}}8{{/if}}" maxlength="72" autocomplete="new-password" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500" id="vm-settings-70">
          </div>
          <button type="submit" class="vm-button vm-button--primary bg-red-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-red-700 transition">Change Password</button>
        </form>
      </div>

    </div>
  </div>
</main>



<script>
  var activeTab = "{{activeTab}}";
  function showTab(name) {
    document.querySelectorAll(".settings-panel").forEach(function(p) { p.classList.add("hidden"); });
    document.querySelectorAll(".settings-tab").forEach(function(b) {
      b.classList.remove("text-red-600", "border-b-2", "border-red-600");
      b.classList.add("text-gray-500");
    });
    var panel = document.getElementById("panel-" + name);
    if (panel) panel.classList.remove("hidden");
    var btn = document.querySelector("[data-tab=\"" + name + "\"]");
    if (btn) { btn.classList.add("text-red-600", "border-b-2", "border-red-600"); btn.classList.remove("text-gray-500"); }
  }
  document.querySelectorAll(".settings-tab").forEach(function(b) {
    b.addEventListener("click", function() { showTab(b.getAttribute("data-tab")); });
  });
  showTab(activeTab);

  function resendVerification() {
    var status = document.getElementById("resendStatus");
    status.textContent = "Sending...";
    fetch("/resend-verification", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email: "{{user.email}}" })
    }).then(function(r) { return r.json(); }).then(function(data) {
      status.textContent = data.message || "Done";
    }).catch(function() { status.textContent = "Failed to send. Please try again."; });
  }
</script>

<script src="/js/public-register.js?v=2" defer></script>
{{> footer}}
