{{> head}}

<style>
  /* Sidebar Animation */
  .sidebar {
    transform: translateX(-100%);
    transition: transform 0.3s ease-in-out;
  }

  .sidebar-toggle:checked~.sidebar-container .sidebar {
    transform: translateX(0);
  }

  .sidebar-toggle:checked~.sidebar-overlay {
    opacity: 1;
    pointer-events: auto;
  }

  .sidebar-overlay {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease-in-out;
  }
</style>

<!-- Sidebar Toggle Checkbox (Hidden) -->
<input type="checkbox" id="sidebar-toggle" class="hidden sidebar-toggle" />

<!-- Single Top Navigation Bar -->
<nav class="bg-white shadow-md sticky top-0 z-50">
  <div class="container mx-auto px-2 sm:px-4 py-2 sm:py-4">
    <div class="flex items-center justify-between">
      <!-- Left: Hamburger + Logo -->
      <div class="flex items-center space-x-1 sm:space-x-4">
        <!-- Hamburger Button -->
        <label for="sidebar-toggle" class="cursor-pointer hover:bg-gray-100 p-1 sm:p-2 rounded-lg transition-colors">
          <svg class="w-5 h-5 sm:w-6 sm:h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </label>

        <!-- Logo -->
        <div class="flex items-center space-x-1 sm:space-x-2">
          <svg class="w-6 h-6 sm:w-8 sm:h-8 text-red-600" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.94-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" />
          </svg>
          <span class="text-xl sm:text-2xl font-bold text-gray-800">VitalMatch</span>
        </div>
      </div>

      <!-- Center: Search Bar (Desktop) -->
      <div class="hidden lg:flex flex-1 max-w-md mx-8">
        <div class="relative w-full">
          <input type="text" id="dashboardSearch" placeholder="Search requests, donors, messages..."
            class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-colors"
            onkeyup="handleDashboardSearch(event)">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <!-- Search Results Dropdown -->
          <div id="dashboardSearchResults"
            class="hidden absolute top-full left-0 right-0 bg-white border border-gray-200 rounded-lg shadow-lg mt-1 max-h-64 overflow-y-auto z-50">
            <!-- Search results will be populated here -->
          </div>
        </div>
      </div>

      <!-- Right: User Menu with Notifications -->
      <div class="flex items-center space-x-1 sm:space-x-4">
        <!-- Mobile Search Button -->
        <button
          class="lg:hidden text-gray-600 hover:text-gray-800 hover:bg-gray-100 p-1 sm:p-2 rounded-lg transition-colors"
          onclick="toggleDashboardMobileSearch()">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>

        <!-- Notifications Bell -->
        <div class="relative">
          <button id="notificationBtn"
            class="relative p-1 sm:p-2 text-gray-600 hover:text-gray-800 hover:bg-gray-100 rounded-lg transition-colors"
            onclick="toggleNotifications()">
            <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
            <!-- Notification Badge -->
            <span id="notificationBadge"
              class="absolute -top-1 -right-1 bg-red-500 text-white text-[10px] sm:text-xs rounded-full w-4 h-4 sm:w-5 sm:h-5 flex items-center justify-center font-semibold animate-pulse">3</span>
          </button>

          <!-- Notifications Dropdown -->
          <div id="notificationDropdown"
            class="hidden absolute right-0 mt-2 w-80 bg-white rounded-lg shadow-xl border z-50">
            <div class="p-4 border-b">
              <div class="flex items-center justify-between">
                <h3 class="font-semibold text-gray-800">Notifications</h3>
                <button onclick="markAllNotificationsRead()" class="text-sm text-blue-600 hover:text-blue-700">Mark all
                  read</button>
              </div>
            </div>

            <div id="notificationList" class="max-h-96 overflow-y-auto">
              <!-- Notifications will be populated here dynamically -->
              <div class="p-8 text-center text-gray-500">
                <div
                  class="w-8 h-8 border-4 border-red-500 border-t-transparent rounded-full animate-spin mx-auto mb-2">
                </div>
                Loading...
              </div>
            </div>

            <div class="p-4 border-t">
              <button class="w-full text-center text-sm text-blue-600 hover:text-blue-700 font-semibold">
                View All Notifications
              </button>
            </div>
          </div>
        </div>

        <span class="text-gray-700 hidden md:inline">Welcome, <span class="font-semibold">{{#if
            user}}{{user.firstName}}{{else}}Administrator{{/if}}</span></span>
        <a href="/logout"
          class="bg-red-600 text-white px-2 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-base rounded-lg hover:bg-red-700 transition-colors transform hover:scale-105">Logout</a>
      </div>
    </div>

    <!-- Mobile Search Bar -->
    <div id="dashboardMobileSearch" class="hidden mt-4 lg:hidden">
      <div class="relative">
        <input type="text" id="dashboardMobileSearchInput" placeholder="Search requests, donors, messages..."
          class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-colors text-base"
          onkeyup="handleDashboardSearch(event, true)">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>
    </div>
  </div>
</nav>

<!-- Breadcrumb Navigation for Dashboard -->
<div class="bg-gray-50 border-b border-gray-200">
  <div class="container mx-auto px-4 py-3">
    <nav class="flex items-center space-x-2 text-sm" aria-label="Breadcrumb">
      <ol class="flex items-center space-x-2">
        <li class="flex items-center">
          <a href="/" class="text-gray-600 hover:text-red-600 transition-colors">Home</a>
        </li>
        <li class="flex items-center">
          <svg class="w-4 h-4 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          <span class="text-gray-800 font-semibold">{{title}}</span>
        </li>
      </ol>
    </nav>
  </div>
</div>

<!-- Sidebar Overlay (Dark Background) -->
<label for="sidebar-toggle" class="sidebar-overlay fixed inset-0 bg-black bg-opacity-50 z-40"></label>

<!-- Sidebar Container -->
<div class="sidebar-container">
  <!-- Sidebar -->
  <aside class="sidebar fixed top-0 left-0 h-full w-72 bg-white shadow-2xl z-50 overflow-y-auto">
    <div class="p-6">

      <!-- Close Button -->
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-gray-800">Menu</h2>
        <label for="sidebar-toggle" class="cursor-pointer hover:bg-gray-100 p-2 rounded-lg transition">
          <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </label>
      </div>

      <!-- User Profile Section -->
      <div class="mb-6 pb-6 border-b">
        <div class="flex items-center space-x-3">
          <div
            class="w-14 h-14 bg-gradient-to-br from-red-500 to-blue-500 rounded-full flex items-center justify-center text-white font-bold text-xl shadow-lg">
            {{#if user}}{{user.firstName.charAt 0}}{{else}}A{{/if}}
          </div>
          <div>
            <p class="font-semibold text-gray-800 text-lg">{{#if user}}{{user.firstName}}
              {{user.lastName}}{{else}}Admin{{/if}}</p>
            <p class="text-sm text-green-600 font-medium">● 
              {{#if (eq user.role 'hospital')}}Hospital Account
              {{else if donorProfile}}Active Donor
              {{else}}Registered User{{/if}}
            </p>
          </div>
        </div>
      </div>

      <!-- Navigation Links -->
      <nav class="space-y-1">

        <!-- Dashboard -->
        <a href="{{#if (eq user.role 'hospital')}}/hospital/dashboard{{else}}/dashboard{{/if}}"
          class="flex items-center space-x-3 px-4 py-3 rounded-lg bg-red-50 text-red-600 font-semibold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <span>Dashboard</span>
        </a>

        <!-- My Profile -->
        {{#unless (eq user.role 'hospital')}}
        <a href="/view-donor-profile"
          class="flex items-center space-x-3 px-4 py-3 rounded-lg text-gray-700 hover:bg-gray-100 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          <span>My Profile</span>
        </a>
        {{/unless}}

        <!-- My Requests -->
        <a href="/my-requests"
          class="flex items-center space-x-3 px-4 py-3 rounded-lg text-gray-700 hover:bg-gray-100 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
          <span>My Requests</span>
        </a>

        <!-- Notifications -->
        <a href="/notifications"
          class="flex items-center justify-between px-4 py-3 rounded-lg text-gray-700 hover:bg-gray-100 transition">
          <div class="flex items-center space-x-3">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
            <span>Notifications</span>
          </div>
          <span id="sidebarNotificationBadge"
            class="bg-red-500 text-white text-xs rounded-full w-6 h-6 flex items-center justify-center font-semibold"
            style="display: none;"></span>
        </a>

        <!-- Messages/Chats -->
        <a href="/messages"
          class="flex items-center justify-between px-4 py-3 rounded-lg text-gray-700 hover:bg-gray-100 transition">
          <div class="flex items-center space-x-3">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
            <span>Messages</span>
          </div>
          <span
            class="bg-blue-500 text-white text-xs rounded-full w-6 h-6 flex items-center justify-center font-semibold">2</span>
        </a>

        <!-- Divider -->
        <div class="border-t my-4"></div>

        <!-- Request Blood -->
        <a href="/new-blood-request"
          class="flex items-center space-x-3 px-4 py-3 rounded-lg text-gray-700 hover:bg-gray-100 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Request Blood</span>
        </a>

        <!-- Donation History -->
        {{#unless (eq user.role 'hospital')}}
        <a href="#" class="flex items-center space-x-3 px-4 py-3 rounded-lg text-gray-700 hover:bg-gray-100 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>History</span>
        </a>
        {{/unless}}

        <!-- Settings -->
        <a href="#" class="flex items-center space-x-3 px-4 py-3 rounded-lg text-gray-700 hover:bg-gray-100 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>Settings</span>
        </a>

        <!-- Help & Support -->
        <a href="#" class="flex items-center space-x-3 px-4 py-3 rounded-lg text-gray-700 hover:bg-gray-100 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Help & Support</span>
        </a>

      </nav>
    </div>
  </aside>
</div>

<!-- Dashboard Content -->
<div class="min-h-screen bg-gray-50 py-8">
  <div class="container mx-auto px-4">

    <!-- Welcome Banner with Real-time Status -->
    <div
      class="bg-gradient-to-r from-red-600 to-blue-600 rounded-xl shadow-lg p-8 mb-8 text-white relative overflow-hidden">
      <!-- Background Pattern -->
      <div class="absolute inset-0 opacity-10">
        <svg class="w-full h-full" viewBox="0 0 100 100" fill="none">
          <defs>
            <pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse">
              <path d="M 10 0 L 0 0 0 10" fill="none" stroke="currentColor" stroke-width="0.5" />
            </pattern>
          </defs>
          <rect width="100" height="100" fill="url(#grid)" />
        </svg>
      </div>

      <div class="relative z-10 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
          <h1 class="text-3xl font-bold mb-2">Hello, {{#if user}}{{user.firstName}}{{else}}there{{/if}}!</h1>
          <p class="text-white/90 text-lg mb-4 md:mb-0">Welcome to your VitalMatch {{title}}. Ready to make a difference
            today?</p>
        </div>

        <!-- Real-time Status Indicators -->
        <div class="flex flex-col md:flex-row gap-4">
          <div class="bg-white/20 backdrop-blur-sm rounded-lg px-4 py-3 text-center">
            <div class="flex items-center justify-center mb-1">
              <div class="w-3 h-3 bg-green-400 rounded-full animate-pulse mr-2"></div>
              <span class="text-sm font-semibold">System Status</span>
            </div>
            <p class="text-xs text-white/80">All systems operational</p>
          </div>

          {{#if (eq user.role 'hospital')}}
          <div class="bg-white/20 backdrop-blur-sm rounded-lg px-4 py-3 text-center">
            <div class="flex items-center justify-center mb-1">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
              <span class="text-sm font-semibold">Hospital Mode</span>
            </div>
            <p class="text-xs text-white/80">Request Coordinator</p>
          </div>
          {{else}}
          <div class="bg-white/20 backdrop-blur-sm rounded-lg px-4 py-3 text-center">
            <div class="flex items-center justify-center mb-1">
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="text-sm font-semibold">Donor Status</span>
            </div>
            <p class="text-xs text-white/80">Available to donate</p>
          </div>
          {{/if}}
        </div>
      </div>
    </div>

    <!-- Enhanced Quick Actions with Notifications -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">

      <!-- Request Blood Card -->
      <a href="/new-blood-request"
        class="group bg-white rounded-xl shadow-md p-6 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border-2 border-transparent hover:border-red-500 relative overflow-hidden">
        <!-- Background Gradient on Hover -->
        <div
          class="absolute inset-0 bg-gradient-to-br from-red-50 to-red-100 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        </div>

        <div class="relative z-10">
          <div class="flex items-center justify-between mb-4">
            <div class="bg-red-100 p-3 rounded-lg group-hover:bg-red-200 transition-colors">
              <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <span class="bg-red-500 text-white text-xs px-2 py-1 rounded-full font-semibold">URGENT</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-800 mb-2">Request Blood</h3>
          <p class="text-gray-600 text-sm mb-3">Submit an urgent blood request for your hospital or patient</p>
          <div class="flex items-center text-red-600 text-sm font-semibold">
            <span>Start Request</span>
            <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor"
              viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </div>
      </a>

      <!-- Donor Profile / Messages Card -->
      {{#if (eq user.role 'hospital')}}
      <a href="/messages"
        class="group bg-white rounded-xl shadow-md p-6 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border-2 border-transparent hover:border-blue-500 relative overflow-hidden">
        <div
          class="absolute inset-0 bg-gradient-to-br from-blue-50 to-blue-100 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        </div>
        <div class="relative z-10">
          <div class="flex items-center justify-between mb-4">
            <div class="bg-blue-100 p-3 rounded-lg group-hover:bg-blue-200 transition-colors">
              <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
            </div>
            <span class="bg-blue-500 text-white text-xs px-2 py-1 rounded-full font-semibold">CHAT</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-800 mb-2">Messages</h3>
          <p class="text-gray-600 text-sm mb-3">Communicate with blood donors and Red Cross administrators</p>
          <div class="flex items-center text-blue-600 text-sm font-semibold">
            <span>Open Chat</span>
            <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor"
              viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </div>
      </a>
      {{else}}
      <a href="/view-donor-profile"
        class="group bg-white rounded-xl shadow-md p-6 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border-2 border-transparent hover:border-blue-500 relative overflow-hidden">
        <div
          class="absolute inset-0 bg-gradient-to-br from-blue-50 to-blue-100 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        </div>
        <div class="relative z-10">
          <div class="flex items-center justify-between mb-4">
            <div class="bg-blue-100 p-3 rounded-lg group-hover:bg-blue-200 transition-colors">
              <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <div class="flex items-center">
              <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse mr-1"></div>
              <span class="text-green-600 text-xs font-semibold">ACTIVE</span>
            </div>
          </div>
          <h3 class="text-xl font-semibold text-gray-800 mb-2">Donor Profile</h3>
          <p class="text-gray-600 text-sm mb-3">View or update your donor information and availability status</p>
          <div class="flex items-center text-blue-600 text-sm font-semibold">
            <span>Manage Profile</span>
            <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor"
              viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </div>
      </a>
      {{/if}}
 
      <!-- My Requests Card -->
      <a href="/my-requests"
        class="group bg-white rounded-xl shadow-md p-6 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border-2 border-transparent hover:border-green-500 relative overflow-hidden">
        <div
          class="absolute inset-0 bg-gradient-to-br from-green-50 to-green-100 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        </div>
 
        <div class="relative z-10">
          <div class="flex items-center justify-between mb-4">
            <div class="bg-green-100 p-3 rounded-lg group-hover:bg-green-200 transition-colors">
              <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
            </div>
            <span class="bg-gray-100 text-gray-600 text-xs px-2 py-1 rounded-full font-semibold">{{#if hospitalStats}}{{hospitalStats.activeRequests}}{{else}}0{{/if}} ACTIVE</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-800 mb-2">My Requests</h3>
          <p class="text-gray-600 text-sm mb-3">View and manage your blood requests and donations</p>
          <div class="flex items-center text-green-600 text-sm font-semibold">
            <span>View History</span>
            <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor"
              viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </div>
      </a>
 
      <!-- Emergency Alerts / Guidelines Card -->
      {{#if (eq user.role 'hospital')}}
      <a href="/#how-it-works"
        class="group bg-white rounded-xl shadow-md p-6 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border-2 border-transparent hover:border-orange-500 relative overflow-hidden">
        <div
          class="absolute inset-0 bg-gradient-to-br from-orange-50 to-orange-100 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        </div>
        <div class="relative z-10">
          <div class="flex items-center justify-between mb-4">
            <div class="bg-orange-100 p-3 rounded-lg group-hover:bg-orange-200 transition-colors">
              <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.168.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.168.477-4.5 1.253" />
              </svg>
            </div>
            <span class="bg-orange-500 text-white text-xs px-2 py-1 rounded-full font-semibold">INFO</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-800 mb-2">Guidelines</h3>
          <p class="text-gray-600 text-sm mb-3">Learn about blood request requirements and matching procedures</p>
          <div class="flex items-center text-orange-600 text-sm font-semibold">
            <span>View Info</span>
            <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor"
              viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </div>
      </a>
      {{else}}
      <div
        class="group bg-white rounded-xl shadow-md p-6 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border-2 border-transparent hover:border-orange-500 relative overflow-hidden cursor-pointer"
        onclick="showEmergencyAlerts()">
        <div
          class="absolute inset-0 bg-gradient-to-br from-orange-50 to-orange-100 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        </div>
 
        <div class="relative z-10">
          <div class="flex items-center justify-between mb-4">
            <div class="bg-orange-100 p-3 rounded-lg group-hover:bg-orange-200 transition-colors">
              <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
              </svg>
            </div>
            <span class="bg-orange-500 text-white text-xs px-2 py-1 rounded-full font-semibold animate-pulse">2
              NEW</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-800 mb-2">Emergency Alerts</h3>
          <p class="text-gray-600 text-sm mb-3">Urgent blood requests in your area that need immediate attention</p>
          <div class="flex items-center text-orange-600 text-sm font-semibold">
            <span>View Alerts</span>
            <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor"
              viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </div>
      </div>
      {{/if}}

    </div>

    <!-- Enhanced Statistics Section with Charts -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">

      <!-- Your Impact Stats / Hospital Request Metrics -->
      {{#if (eq user.role 'hospital')}}
      <div class="lg:col-span-2 bg-white rounded-xl shadow-md p-6">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-2xl font-bold text-gray-800">Hospital Request Metrics</h2>
          <div class="flex items-center space-x-2">
            <div class="w-3 h-3 bg-red-500 rounded-full animate-pulse"></div>
            <span class="text-sm text-gray-600">Hospital Account</span>
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-6">

          <div class="text-center group">
            <div
              class="bg-gradient-to-br from-red-100 to-red-200 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform">
              <svg class="w-10 h-10 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
            </div>
            <p class="text-3xl font-bold text-gray-800 mb-1">{{#if hospitalStats}}{{hospitalStats.totalRequests}}{{else}}0{{/if}}</p>
            <p class="text-gray-600 text-sm">Total Requests</p>
          </div>

          <div class="text-center group">
            <div
              class="bg-gradient-to-br from-blue-100 to-blue-200 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform">
              <svg class="w-10 h-10 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <p class="text-3xl font-bold text-gray-800 mb-1">{{#if hospitalStats}}{{hospitalStats.activeRequests}}{{else}}0{{/if}}</p>
            <p class="text-gray-600 text-sm">Active Requests</p>
          </div>

          <div class="text-center group">
            <div
              class="bg-gradient-to-br from-green-100 to-green-200 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform">
              <svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <p class="text-3xl font-bold text-gray-800 mb-1">{{#if hospitalStats}}{{hospitalStats.fulfilledRequests}}{{else}}0{{/if}}</p>
            <p class="text-gray-600 text-sm">Fulfilled Requests</p>
          </div>

          <div class="text-center group">
            <div
              class="bg-gradient-to-br from-purple-100 to-purple-200 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform">
              <svg class="w-10 h-10 text-purple-600" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
              </svg>
            </div>
            <p class="text-3xl font-bold text-gray-800 mb-1">{{#if hospitalStats}}{{hospitalStats.totalUnitsRequested}}{{else}}0{{/if}}</p>
            <p class="text-gray-600 text-sm">Units Requested</p>
          </div>

        </div>

        <!-- Mini Chart Placeholder -->
        <div class="bg-gray-50 rounded-lg p-4">
          <h3 class="text-sm font-semibold text-gray-700 mb-3">Blood Requests Volume (Last 6 Months)</h3>
          <div class="flex items-end justify-between h-24 space-x-2">
            <div class="bg-blue-200 rounded-t w-full" style="height: 15%"></div>
            <div class="bg-blue-300 rounded-t w-full" style="height: 35%"></div>
            <div class="bg-blue-400 rounded-t w-full" style="height: 50%"></div>
            <div class="bg-blue-500 rounded-t w-full" style="height: 25%"></div>
            <div class="bg-blue-600 rounded-t w-full" style="height: 70%"></div>
            <div class="bg-blue-700 rounded-t w-full" style="height: {{#if hospitalStats}}{{#if hospitalStats.totalRequests}}{{add hospitalStats.totalRequests 20}}{{else}}40{{/if}}{{else}}40{{/if}}%"></div>
          </div>
          <div class="flex justify-between text-xs text-gray-500 mt-2">
            <span>Jan</span>
            <span>Feb</span>
            <span>Mar</span>
            <span>Apr</span>
            <span>May</span>
            <span>Jun</span>
          </div>
        </div>
      </div>
      {{else}}
      <div class="lg:col-span-2 bg-white rounded-xl shadow-md p-6">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-2xl font-bold text-gray-800">Your Impact Dashboard</h2>
          <div class="flex items-center space-x-2">
            <div class="w-3 h-3 bg-green-400 rounded-full animate-pulse"></div>
            <span class="text-sm text-gray-600">Live Data</span>
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-6">

          <div class="text-center group">
            <div
              class="bg-gradient-to-br from-red-100 to-red-200 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform">
              <svg class="w-10 h-10 text-red-600" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
              </svg>
            </div>
            <p class="text-3xl font-bold text-gray-800 mb-1">0</p>
            <p class="text-gray-600 text-sm">Total Donations</p>
            <div class="w-full bg-gray-200 rounded-full h-2 mt-2">
              <div class="bg-red-500 h-2 rounded-full" style="width: 0%"></div>
            </div>
          </div>

          <div class="text-center group">
            <div
              class="bg-gradient-to-br from-blue-100 to-blue-200 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform">
              <svg class="w-10 h-10 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <p class="text-3xl font-bold text-gray-800 mb-1">0</p>
            <p class="text-gray-600 text-sm">Lives Saved</p>
            <div class="w-full bg-gray-200 rounded-full h-2 mt-2">
              <div class="bg-blue-500 h-2 rounded-full" style="width: 0%"></div>
            </div>
          </div>

          <div class="text-center group">
            <div
              class="bg-gradient-to-br from-green-100 to-green-200 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform">
              <svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <p class="text-2xl font-bold text-green-600 mb-1">Active</p>
            <p class="text-gray-600 text-sm">Donor Status</p>
            <div class="w-full bg-gray-200 rounded-full h-2 mt-2">
              <div class="bg-green-500 h-2 rounded-full animate-pulse" style="width: 100%"></div>
            </div>
          </div>

          <div class="text-center group">
            <div
              class="bg-gradient-to-br from-purple-100 to-purple-200 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform">
              <svg class="w-10 h-10 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <p class="text-2xl font-bold text-gray-800 mb-1">Ready</p>
            <p class="text-gray-600 text-sm">Next Eligible</p>
            <div class="w-full bg-gray-200 rounded-full h-2 mt-2">
              <div class="bg-purple-500 h-2 rounded-full" style="width: 100%"></div>
            </div>
          </div>

        </div>

        <!-- Mini Chart Placeholder -->
        <div class="bg-gray-50 rounded-lg p-4">
          <h3 class="text-sm font-semibold text-gray-700 mb-3">Donation Activity (Last 6 Months)</h3>
          <div class="flex items-end justify-between h-24 space-x-2">
            <div class="bg-red-200 rounded-t w-full" style="height: 20%"></div>
            <div class="bg-red-300 rounded-t w-full" style="height: 40%"></div>
            <div class="bg-red-400 rounded-t w-full" style="height: 60%"></div>
            <div class="bg-red-500 rounded-t w-full" style="height: 30%"></div>
            <div class="bg-red-600 rounded-t w-full" style="height: 80%"></div>
            <div class="bg-red-700 rounded-t w-full" style="height: 50%"></div>
          </div>
          <div class="flex justify-between text-xs text-gray-500 mt-2">
            <span>Jan</span>
            <span>Feb</span>
            <span>Mar</span>
            <span>Apr</span>
            <span>May</span>
            <span>Jun</span>
          </div>
        </div>
      </div>
      {{/if}}

      <!-- Quick Actions Sidebar -->
      <div class="space-y-6">

        <!-- Blood Type Compatibility / Hospital Details -->
        {{#if (eq user.role 'hospital')}}
        <div class="bg-white rounded-xl shadow-md p-6">
          <h3 class="text-lg font-semibold text-gray-800 mb-4">Hospital Details</h3>
          <div class="space-y-3">
            <div>
              <p class="text-xs text-gray-500 font-semibold uppercase">Representative Name</p>
              <p class="text-sm text-gray-800 font-medium">{{user.firstName}} {{user.lastName}}</p>
            </div>
            <div>
              <p class="text-xs text-gray-500 font-semibold uppercase">Email Address</p>
              <p class="text-sm text-gray-800 truncate font-medium">{{user.email}}</p>
            </div>
            <div>
              <p class="text-xs text-gray-500 font-semibold uppercase">Contact Number</p>
              <p class="text-sm text-gray-800 font-medium">{{user.phone}}</p>
            </div>
            <div>
              <p class="text-xs text-gray-500 font-semibold uppercase">Registered Address</p>
              <p class="text-sm text-gray-800 font-medium">{{user.address}}</p>
            </div>
            <div class="pt-2 border-t">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                Authorized Requester
              </span>
            </div>
          </div>
        </div>

        <!-- Hospital Assistance Center -->
        <div class="bg-white rounded-xl shadow-md p-6">
          <h3 class="text-lg font-semibold text-gray-800 mb-4">Assistance Center</h3>
          <div class="space-y-4">
            <div class="p-3 bg-red-50 rounded-lg border border-red-100">
              <p class="text-xs text-red-600 font-semibold uppercase mb-1">Red Cross Emergency Line</p>
              <p class="text-sm font-bold text-red-700">PRC Mindoro: (043) 288-1234</p>
              <p class="text-xs text-gray-500 mt-1">24/7 Blood Coordination Desk</p>
            </div>
            <div class="text-center py-2">
              <p class="text-xs text-gray-500">Need to update account verification details? Please contact support@vitalmatch.ph.</p>
            </div>
          </div>
        </div>
        {{else}}
        <!-- Blood Type Compatibility -->
        <div class="bg-white rounded-xl shadow-md p-6">
          <h3 class="text-lg font-semibold text-gray-800 mb-4">Blood Type Info</h3>
          {{#if donorProfile.bloodType}}
          <div class="text-center">
            <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-3">
              <span class="text-2xl font-bold text-red-600">{{donorProfile.bloodType}}</span>
            </div>
            <p class="text-sm text-gray-600 mb-3">Your Blood Type</p>
            <div class="text-xs text-gray-500">
              <p class="mb-1">Based on your registered donor profile.</p>
            </div>
          </div>
          {{else}}
          <div class="text-center">
            <div
              class="w-16 h-16 bg-gray-100 border border-dashed border-gray-300 rounded-full flex items-center justify-center mx-auto mb-3">
              <span class="text-xl font-bold text-gray-400">?</span>
            </div>
            <p class="text-sm text-gray-600 mb-3">Blood Type Not Set</p>
            <div class="text-xs text-gray-500 mb-4">
              <p>You haven't added a blood type to your profile yet.</p>
            </div>
            <a href="/view-donor-profile"
              class="inline-block text-xs font-semibold bg-gray-100 text-gray-700 px-3 py-1.5 rounded hover:bg-gray-200 transition">Update
              Profile</a>
          </div>
          {{/if}}
        </div>

        <!-- Upcoming Appointments -->
        <div class="bg-white rounded-xl shadow-md p-6">
          <h3 class="text-lg font-semibold text-gray-800 mb-4">Upcoming</h3>
          <div class="space-y-3">
            <div class="flex items-center p-3 bg-blue-50 rounded-lg">
              <div class="w-3 h-3 bg-blue-500 rounded-full mr-3"></div>
              <div class="flex-1">
                <p class="text-sm font-semibold text-gray-800">Health Check</p>
                <p class="text-xs text-gray-600">Tomorrow, 2:00 PM</p>
              </div>
            </div>

            <div class="text-center py-4">
              <svg class="w-12 h-12 text-gray-300 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <p class="text-sm text-gray-500">No other appointments</p>
            </div>
          </div>
        </div>

        <!-- Quick Donate Button -->
        <div class="bg-gradient-to-br from-red-500 to-red-600 rounded-xl shadow-md p-6 text-white text-center">
          <svg class="w-12 h-12 mx-auto mb-3 opacity-90" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
          </svg>
          <h3 class="text-lg font-semibold mb-2">Ready to Donate?</h3>
          <p class="text-sm text-white/90 mb-4">Your next donation can save up to 3 lives</p>
          <button class="bg-white text-red-600 px-4 py-2 rounded-lg font-semibold text-sm hover:bg-gray-100 transition">
            Schedule Donation
          </button>
        </div>
        {{/if}}

        <!-- Blockchain Status Widget --
        <div class="bg-gradient-to-br from-purple-500 to-indigo-600 rounded-xl shadow-md p-6 text-white">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold">Blockchain Status</h3>
            <div class="w-3 h-3 bg-green-400 rounded-full animate-pulse" id="blockchainStatusDot"></div>
          </div>
          
          <div class="space-y-3">
            <div class="flex justify-between items-center">
              <span class="text-sm text-white/80">Total Blocks:</span>
              <span class="font-semibold" id="dashboardTotalBlocks">-</span>
            </div>
            
            <div class="flex justify-between items-center">
              <span class="text-sm text-white/80">Your Records:</span>
              <span class="font-semibold" id="dashboardUserRecords">-</span>
            </div>
            
            <div class="flex justify-between items-center">
              <span class="text-sm text-white/80">Pending:</span>
              <span class="font-semibold" id="dashboardPendingTx">-</span>
            </div>
          </div>
          
          <div class="mt-4 pt-4 border-t border-white/20">
            <div class="flex items-center justify-between">
              <span class="text-xs text-white/70">Integrity:</span>
              <span class="text-xs font-semibold" id="blockchainIntegrity">Verified ✓</span>
            </div>
          </div>
          
          <button onclick="window.open('/admin/blockchain', '_blank')" class="mt-4 w-full bg-white/20 hover:bg-white/30 text-white px-4 py-2 rounded-lg text-sm font-semibold transition">
            View Blockchain
          </button>
        </div>
      -->
      </div>

    </div>

    <!-- Enhanced Recent Activity -->
    <div class="bg-white rounded-xl shadow-md p-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-gray-800">Recent Activity</h2>
        <div class="flex items-center space-x-3">
          <button class="text-sm text-gray-600 hover:text-gray-800 transition">
            <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.707A1 1 0 013 7V4z" />
            </svg>
            Filter
          </button>
          <button class="text-sm text-blue-600 hover:text-blue-700 transition font-semibold">
            View All
          </button>
        </div>
      </div>

      {{#if activities.length}}
      <div class="space-y-4">
        {{#each activities}}
        <div
          class="group flex items-start space-x-4 p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-all duration-200 cursor-pointer border border-transparent hover:border-gray-200">
          <!-- Icon with Animation -->
          <div class="flex-shrink-0">
            {{#if (eq type 'request')}}
            <div class="bg-red-100 p-3 rounded-lg group-hover:bg-red-200 transition-colors">
              <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
            </div>
            {{else}}
            <div class="bg-blue-100 p-3 rounded-lg group-hover:bg-blue-200 transition-colors">
              <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            {{/if}}
          </div>

          <!-- Content -->
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-lg font-semibold text-gray-800 group-hover:text-gray-900 transition-colors">{{title}}</h3>
              {{#if (eq type 'request')}}
              {{#if (eq status 'active')}}
              <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-xs font-semibold flex items-center">
                <div class="w-2 h-2 bg-green-500 rounded-full mr-2 animate-pulse"></div>
                Active
              </span>
              {{else if (eq status 'fulfilled')}}
              <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-xs font-semibold flex items-center">
                <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd" />
                </svg>
                Fulfilled
              </span>
              {{else if (eq status 'cancelled')}}
              <span class="bg-gray-100 text-gray-700 px-3 py-1 rounded-full text-xs font-semibold">Cancelled</span>
              {{else}}
              <span
                class="bg-yellow-100 text-yellow-700 px-3 py-1 rounded-full text-xs font-semibold flex items-center">
                <div class="w-2 h-2 bg-yellow-500 rounded-full mr-2 animate-pulse"></div>
                Pending
              </span>
              {{/if}}
              {{else}}
              {{#if (eq status 'active')}}
              <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-xs font-semibold flex items-center">
                <div class="w-2 h-2 bg-green-500 rounded-full mr-2 animate-pulse"></div>
                Available
              </span>
              {{else}}
              <span class="bg-gray-100 text-gray-700 px-3 py-1 rounded-full text-xs font-semibold">Unavailable</span>
              {{/if}}
              {{/if}}
            </div>
            <p class="text-gray-600 text-sm mb-3 leading-relaxed">{{description}}</p>
            <div class="flex items-center justify-between">
              <div class="flex items-center text-gray-400 text-xs">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>{{date}}</span>
              </div>
              <a href="{{link}}"
                class="text-blue-600 hover:text-blue-700 text-sm font-semibold flex items-center group-hover:translate-x-1 transition-transform">
                View Details
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        </div>
        {{/each}}
      </div>

      <!-- Load More Button -->
      <div class="text-center mt-6">
        <button
          class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-6 py-3 rounded-lg font-semibold transition-colors">
          Load More Activities
        </button>
      </div>

      {{else}}
      <!-- Enhanced Empty State -->
      <div class="text-center py-16">
        <div class="relative">
          <!-- Animated Background -->
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-32 h-32 bg-gradient-to-br from-gray-100 to-gray-200 rounded-full opacity-50"></div>
          </div>

          <!-- Icon -->
          <div class="relative z-10 mb-6">
            <svg class="w-20 h-20 text-gray-300 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>

          <h3 class="text-xl font-semibold text-gray-700 mb-3">No Recent Activity</h3>
          <p class="text-gray-500 mb-6 max-w-md mx-auto">Your donation history and requests will appear here once you
            start using VitalMatch</p>

          <!-- Quick Action Buttons -->
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href="/new-blood-request"
              class="bg-red-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-red-700 transition">
              Make Your First Request
            </a>
            <a href="/view-donor-profile"
              class="bg-blue-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-blue-700 transition">
              Complete Donor Profile
            </a>
          </div>
        </div>
      </div>
      {{/if}}
    </div>

  </div>
</div>

<!-- Emergency Alerts Modal -->
<div id="emergencyModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center p-4">
  <div class="bg-white rounded-xl shadow-2xl max-w-2xl w-full max-h-[80vh] overflow-y-auto">
    <div class="p-6 border-b">
      <div class="flex items-center justify-between">
        <div class="flex items-center">
          <div class="bg-orange-100 p-2 rounded-lg mr-3">
            <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16c-.77.833.192 2.5 1.732 2.5z" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-gray-800">Emergency Blood Requests</h2>
        </div>
        <button onclick="closeEmergencyModal()" class="text-gray-400 hover:text-gray-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <div class="p-6 space-y-4">
      <!-- Emergency Alert 1 -->
      <div class="border border-red-200 rounded-lg p-4 bg-red-50">
        <div class="flex items-start justify-between mb-3">
          <div class="flex items-center">
            <span class="bg-red-500 text-white text-xs px-2 py-1 rounded-full font-semibold mr-3">CRITICAL</span>
            <h3 class="font-semibold text-gray-800">O- Blood Needed Urgently</h3>
          </div>
          <span class="text-xs text-gray-500">2 min ago</span>
        </div>
        <p class="text-sm text-gray-700 mb-3">
          <strong>Hospital:</strong> Calapan City Hospital<br>
          <strong>Patient:</strong> 45-year-old male, car accident victim<br>
          <strong>Required:</strong> 4 units of O- blood<br>
          <strong>Location:</strong> Calapan City, Oriental Mindoro
        </p>
        <div class="flex items-center justify-between">
          <div class="flex items-center text-sm text-gray-600">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>5.2 km away</span>
          </div>
          <button class="bg-red-600 text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-red-700 transition">
            Respond Now
          </button>
        </div>
      </div>

      <!-- Emergency Alert 2 -->
      <div class="border border-orange-200 rounded-lg p-4 bg-orange-50">
        <div class="flex items-start justify-between mb-3">
          <div class="flex items-center">
            <span class="bg-orange-500 text-white text-xs px-2 py-1 rounded-full font-semibold mr-3">URGENT</span>
            <h3 class="font-semibold text-gray-800">A+ Blood Request</h3>
          </div>
          <span class="text-xs text-gray-500">15 min ago</span>
        </div>
        <p class="text-sm text-gray-700 mb-3">
          <strong>Hospital:</strong> Bongabong District Hospital<br>
          <strong>Patient:</strong> 28-year-old female, surgery preparation<br>
          <strong>Required:</strong> 2 units of A+ blood<br>
          <strong>Location:</strong> Bongabong, Oriental Mindoro
        </p>
        <div class="flex items-center justify-between">
          <div class="flex items-center text-sm text-gray-600">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>12.8 km away</span>
          </div>
          <button
            class="bg-orange-600 text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-orange-700 transition">
            Respond Now
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Nearby Blood Request Notification Modal -->
<div id="requestNotificationModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center p-4">
  <div class="bg-white rounded-xl shadow-2xl max-w-md w-full">
    <div class="p-5 border-b flex items-center justify-between">
      <h2 id="requestNotificationTitle" class="text-lg font-bold text-gray-800">Nearby Blood Request</h2>
      <button onclick="closeRequestNotificationModal()" class="text-gray-400 hover:text-gray-600" aria-label="Close notification">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div class="p-5">
      <p id="requestNotificationMessage" class="text-sm leading-6 text-gray-600"></p>
      <div class="mt-5 flex justify-end gap-3">
        <button onclick="closeRequestNotificationModal()" class="px-4 py-2 text-sm font-semibold text-gray-600 hover:text-gray-800">Close</button>
        <a id="requestNotificationLink" href="#" class="px-4 py-2 rounded-lg bg-red-600 text-sm font-semibold text-white hover:bg-red-700">View Request</a>
      </div>
    </div>
  </div>
</div>

<script>
  // Dashboard Search Functionality
  let dashboardSearchTimeout;
  function handleDashboardSearch(event, isMobile = false) {
    const query = event.target.value.trim();
    const resultsContainer = document.getElementById('dashboardSearchResults');

    // Clear previous timeout
    clearTimeout(dashboardSearchTimeout);

    if (query.length < 2) {
      resultsContainer.classList.add('hidden');
      return;
    }

    // Debounce search
    dashboardSearchTimeout = setTimeout(() => {
      performDashboardSearch(query, resultsContainer, isMobile);
    }, 300);
  }

  function performDashboardSearch(query, resultsContainer, isMobile) {
    // Show loading state
    resultsContainer.innerHTML = `
    <div class="p-4 text-center">
      <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-red-600 mx-auto"></div>
      <p class="text-sm text-gray-600 mt-2">Searching...</p>
    </div>
  `;
    resultsContainer.classList.remove('hidden');

    // Simulate search results (replace with actual API call)
    setTimeout(() => {
      const mockResults = generateDashboardSearchResults(query);
      displayDashboardSearchResults(mockResults, resultsContainer);
    }, 500);
  }

  function generateDashboardSearchResults(query) {
    const allResults = [
      { type: 'request', title: 'Blood Request #BR001', subtitle: 'O+ needed at Calapan Hospital', url: '/my-requests/BR001', status: 'active' },
      { type: 'request', title: 'Blood Request #BR002', subtitle: 'A- needed at Bongabong Hospital', url: '/my-requests/BR002', status: 'fulfilled' },
      { type: 'donor', title: 'John Doe (O+)', subtitle: 'Available donor in Calapan', url: '/donors/john-doe', status: 'available' },
      { type: 'donor', title: 'Maria Santos (A-)', subtitle: 'Available donor in Bongabong', url: '/donors/maria-santos', status: 'available' },
      { type: 'message', title: 'Message from Dr. Cruz', subtitle: 'Regarding your blood request', url: '/messages/dr-cruz', status: 'unread' },
      { type: 'message', title: 'System Notification', subtitle: 'Your donation eligibility updated', url: '/messages/system', status: 'read' },
      { type: 'page', title: 'Request Blood', subtitle: 'Submit a new blood request', url: '/new-blood-request' },
      { type: 'page', title: 'My Profile', subtitle: 'Update your donor information', url: '/view-donor-profile' }
    ];

    return allResults.filter(result =>
      result.title.toLowerCase().includes(query.toLowerCase()) ||
      result.subtitle.toLowerCase().includes(query.toLowerCase())
    ).slice(0, 6);
  }

  function displayDashboardSearchResults(results, container) {
    if (results.length === 0) {
      container.innerHTML = `
      <div class="p-4 text-center">
        <svg class="w-8 h-8 text-gray-300 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        <p class="text-sm text-gray-600">No results found</p>
      </div>
    `;
      return;
    }

    const resultsHTML = results.map(result => {
      const icon = getDashboardSearchResultIcon(result.type);
      const statusBadge = getDashboardSearchStatusBadge(result.status, result.type);

      return `
      <a href="${result.url}" class="flex items-center p-3 hover:bg-gray-50 transition-colors border-b border-gray-100 last:border-b-0">
        <div class="flex-shrink-0 mr-3">
          ${icon}
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between mb-1">
            <p class="text-sm font-semibold text-gray-800 truncate">${result.title}</p>
            ${statusBadge}
          </div>
          <p class="text-xs text-gray-600 truncate">${result.subtitle}</p>
        </div>
        <svg class="w-4 h-4 text-gray-400 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    `;
    }).join('');

    container.innerHTML = resultsHTML;
  }

  function getDashboardSearchResultIcon(type) {
    const icons = {
      request: '<div class="w-8 h-8 bg-red-100 rounded-lg flex items-center justify-center"><svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg></div>',
      donor: '<div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center"><svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg></div>',
      message: '<div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center"><svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg></div>',
      page: '<div class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center"><svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg></div>'
    };
    return icons[type] || icons.page;
  }

  function getDashboardSearchStatusBadge(status, type) {
    if (!status) return '';

    const badges = {
      active: '<span class="bg-green-100 text-green-700 px-2 py-1 rounded-full text-xs font-semibold">Active</span>',
      fulfilled: '<span class="bg-blue-100 text-blue-700 px-2 py-1 rounded-full text-xs font-semibold">Fulfilled</span>',
      available: '<span class="bg-green-100 text-green-700 px-2 py-1 rounded-full text-xs font-semibold">Available</span>',
      unread: '<span class="bg-red-100 text-red-700 px-2 py-1 rounded-full text-xs font-semibold">New</span>',
      read: ''
    };

    return badges[status] || '';
  }

  function toggleDashboardMobileSearch() {
    const searchBar = document.getElementById('dashboardMobileSearch');
    searchBar.classList.toggle('hidden');

    if (!searchBar.classList.contains('hidden')) {
      document.getElementById('dashboardMobileSearchInput').focus();
    }
  }

  // Close search results when clicking outside
  document.addEventListener('click', function (e) {
    const searchContainer = document.querySelector('#dashboardSearch')?.parentElement;
    const resultsContainer = document.getElementById('dashboardSearchResults');

    if (searchContainer && !searchContainer.contains(e.target)) {
      resultsContainer?.classList.add('hidden');
    }
  });

  // Enhanced sidebar navigation with active states
  function updateSidebarActiveState() {
    const currentPath = window.location.pathname;
    const sidebarLinks = document.querySelectorAll('aside a');

    sidebarLinks.forEach(link => {
      try {
        const linkPath = new URL(link.href).pathname;
        link.classList.remove('bg-red-50', 'text-red-600', 'font-semibold');
        link.classList.add('text-gray-700');

        if (linkPath === currentPath) {
          link.classList.remove('text-gray-700');
          link.classList.add('bg-red-50', 'text-red-600', 'font-semibold');
        }
      } catch (e) { }
    });
  }

  // Emergency Alerts Modal Functions
  function showEmergencyAlerts() {
    document.getElementById('emergencyModal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeEmergencyModal() {
    document.getElementById('emergencyModal').classList.add('hidden');
    document.body.style.overflow = 'auto';
  }

  function showRequestNotificationModal(notificationId, fallbackTitle, fallbackMessage) {
    fetch(`/api/notifications?_=${Date.now()}`)
      .then(response => response.json())
      .then(data => {
        const notification = data.notifications?.find(item => item.id === notificationId);
        const title = notification?.title || fallbackTitle;
        const message = notification?.message || fallbackMessage;
        const link = notification?.link;

        document.getElementById('requestNotificationTitle').textContent = title;
        document.getElementById('requestNotificationMessage').textContent = message;
        const requestLink = document.getElementById('requestNotificationLink');
        requestLink.href = link?.startsWith('/view-blood-request/') ? link : '#';
        requestLink.classList.toggle('hidden', !link?.startsWith('/view-blood-request/'));
        document.getElementById('requestNotificationModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      })
      .catch(() => {
        window.location.href = link;
      });
  }

  function closeRequestNotificationModal() {
    document.getElementById('requestNotificationModal').classList.add('hidden');
    document.body.style.overflow = 'auto';
  }

  // Close modal when clicking outside
  document.getElementById('emergencyModal').addEventListener('click', function (e) {
    if (e.target === this) {
      closeEmergencyModal();
    }
  });

  // Notification Dropdown Functions
  function toggleNotifications() {
    const dropdown = document.getElementById('notificationDropdown');
    dropdown.classList.toggle('hidden');
  }

  // Close notification dropdown when clicking outside
  document.addEventListener('click', function (e) {
    const notificationBtn = document.getElementById('notificationBtn');
    const notificationDropdown = document.getElementById('notificationDropdown');

    if (!notificationBtn.contains(e.target) && !notificationDropdown.contains(e.target)) {
      notificationDropdown.classList.add('hidden');
    }
  });

  // Simulate real-time updates
  function updateDashboardStats() {
    // This would normally fetch real data from the server
    console.log('Updating dashboard stats...');

    // Update blockchain status
    loadDashboardBlockchainData();
  }

  // Load blockchain data for dashboard widget
  async function loadDashboardBlockchainData() {
    try {
      const response = await fetch('/api/blockchain/stats');
      const result = await response.json();

      if (result.success) {
        const data = result.data;

        // Update blockchain status dot
        const statusDot = document.getElementById('blockchainStatusDot');
        if (data.isValid) {
          statusDot.className = 'w-3 h-3 bg-green-400 rounded-full animate-pulse';
        } else {
          statusDot.className = 'w-3 h-3 bg-red-400 rounded-full animate-pulse';
        }

        // Update statistics
        document.getElementById('dashboardTotalBlocks').textContent = data.totalBlocks || '-';
        document.getElementById('dashboardUserRecords').textContent =
          (data.donations + data.requests + data.fulfillments) || '-';
        document.getElementById('dashboardPendingTx').textContent = data.pendingTransactions || '-';

        // Update integrity status
        const integrityElement = document.getElementById('blockchainIntegrity');
        if (data.isValid) {
          integrityElement.textContent = 'Verified ✓';
          integrityElement.className = 'text-xs font-semibold text-green-200';
        } else {
          integrityElement.textContent = 'Compromised ❌';
          integrityElement.className = 'text-xs font-semibold text-red-200';
        }
      }
    } catch (error) {
      console.error('Error loading blockchain data:', error);
      // Show error state
      document.getElementById('dashboardTotalBlocks').textContent = 'Error';
      document.getElementById('dashboardUserRecords').textContent = 'Error';
      document.getElementById('dashboardPendingTx').textContent = 'Error';
    }
  }

  // Update stats every 30 seconds
  setInterval(updateDashboardStats, 30000);

  // Add notification sound for emergency alerts (optional)
  function playNotificationSound() {
    // Create a simple beep sound
    try {
      const audioContext = new (window.AudioContext || window.webkitAudioContext)();
      const oscillator = audioContext.createOscillator();
      const gainNode = audioContext.createGain();

      oscillator.connect(gainNode);
      gainNode.connect(audioContext.destination);

      oscillator.frequency.value = 800;
      oscillator.type = 'sine';

      gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
      gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.5);

      oscillator.start(audioContext.currentTime);
      oscillator.stop(audioContext.currentTime + 0.5);
    } catch (error) {
      console.log('Audio not supported');
    }
  }

  // Simulate new emergency alert (for demo purposes)
  setTimeout(() => {
    // Update notification badge
    const badge = document.querySelector('.animate-pulse');
    if (badge) {
      badge.textContent = '3 NEW';
      playNotificationSound();
    }
  }, 10000); // Show new alert after 10 seconds

  // Simulate real-time notification updates
  function addNewNotification(type, title, message) {
    const badge = document.getElementById('notificationBadge');
    const currentCount = parseInt(badge.textContent) || 0;
    badge.textContent = currentCount + 1;
    badge.classList.add('animate-pulse');

    // Play notification sound
    playNotificationSound();

    // You could also add the notification to the dropdown here
    console.log(`New ${type} notification: ${title} - ${message}`);
  }

  // Example: Simulate receiving a new notification after 15 seconds
  setTimeout(() => {
    addNewNotification('emergency', 'New Blood Request', 'AB+ blood needed urgently');
  }, 15000);

  // Keyboard shortcuts for dashboard
  function initializeDashboardKeyboardShortcuts() {
    document.addEventListener('keydown', function (e) {
      // Ctrl/Cmd + K for search
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        const searchInput = document.getElementById('dashboardSearch') || document.getElementById('dashboardMobileSearchInput');
        if (searchInput) {
          searchInput.focus();
        }
      }

      // Alt + N for notifications
      if (e.altKey && e.key === 'n') {
        e.preventDefault();
        toggleNotifications();
      }

      // Alt + M for mobile menu (sidebar)
      if (e.altKey && e.key === 'm') {
        e.preventDefault();
        const sidebarToggle = document.getElementById('sidebar-toggle');
        if (sidebarToggle) {
          sidebarToggle.click();
        }
      }

      // Escape to close modals and dropdowns
      if (e.key === 'Escape') {
        const emergencyModal = document.getElementById('emergencyModal');
        const notificationDropdown = document.getElementById('notificationDropdown');
        const searchResults = document.getElementById('dashboardSearchResults');
        const mobileSearch = document.getElementById('dashboardMobileSearch');

        if (!emergencyModal.classList.contains('hidden')) {
          closeEmergencyModal();
        }

        const requestNotificationModal = document.getElementById('requestNotificationModal');
        if (!requestNotificationModal.classList.contains('hidden')) {
          closeRequestNotificationModal();
        }

        if (!notificationDropdown.classList.contains('hidden')) {
          notificationDropdown.classList.add('hidden');
        }

        if (!searchResults.classList.contains('hidden')) {
          searchResults.classList.add('hidden');
        }

        if (!mobileSearch.classList.contains('hidden')) {
          toggleDashboardMobileSearch();
        }
      }
    });
  }

  // Dashboard Animation on Load
  document.addEventListener('DOMContentLoaded', function () {
    // Initialize keyboard shortcuts
    initializeDashboardKeyboardShortcuts();

    // Update sidebar active state
    updateSidebarActiveState();

    // Load initial blockchain data
    loadDashboardBlockchainData();

    // Animate statistics cards
    const statCards = document.querySelectorAll('.group');
    statCards.forEach((card, index) => {
      setTimeout(() => {
        card.style.opacity = '0';
        card.style.transform = 'translateY(20px)';
        card.style.transition = 'all 0.5s ease-out';

        setTimeout(() => {
          card.style.opacity = '1';
          card.style.transform = 'translateY(0)';
        }, 100);
      }, index * 100);
    });

    // Add keyboard shortcut hints
    const searchInput = document.getElementById('dashboardSearch');
    if (searchInput) {
      searchInput.setAttribute('title', 'Press Ctrl+K to focus search');
    }

    // Add focus trap for modals
    const emergencyModal = document.getElementById('emergencyModal');
    emergencyModal.addEventListener('keydown', function (e) {
      if (e.key === 'Tab') {
        const focusableElements = emergencyModal.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
        const firstElement = focusableElements[0];
        const lastElement = focusableElements[focusableElements.length - 1];

        if (e.shiftKey) {
          if (document.activeElement === firstElement) {
            e.preventDefault();
            lastElement.focus();
          }
        } else {
          if (document.activeElement === lastElement) {
            e.preventDefault();
            firstElement.focus();
          }
        }
      }
    });
  });
</script>

{{> footer}}