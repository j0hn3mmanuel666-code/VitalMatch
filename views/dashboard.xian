{{> head}}

{{> user-sidebar}}

<!-- Single Top Navigation Bar -->
{{> internal-header dashboard=true}}

<!-- Dashboard Content -->
<main id="main-content" tabindex="-1" class="vm-page">
  <div class="vm-page-container">
    {{#if error}}<div class="vm-alert vm-alert--danger mb-4" role="alert">{{error}} <a class="vm-text-link" href="/dashboard">Retry loading dashboard</a></div>{{/if}}
    <div class="vm-page-heading vm-heading-actions">
      <div><p class="vm-eyebrow">{{#if (eq user.role 'hospital')}}Hospital coordination{{else}}Your workspace{{/if}}</p><h1>{{#if (eq user.role 'hospital')}}Hospital dashboard{{else}}Dashboard{{/if}}</h1><p>{{#if (eq user.role 'hospital')}}Follow your requests and coordinate the next step with donors and the chapter.{{else}}Review current requests, manage your availability, and keep track of your activity.{{/if}}</p></div>
      <a href="/new-blood-request" class="vm-button vm-button--primary">New blood request</a>
    </div>
    {{#unless error}}<dl class="vm-dashboard-summary">
      {{#if (eq user.role 'hospital')}}
      <div><dt>Active requests</dt><dd>{{#if hospitalStats}}{{hospitalStats.activeRequests}}{{else}}0{{/if}}</dd><p><a href="/my-requests" class="vm-text-link">Review your requests</a></p></div>
      <div><dt>Fulfilled requests</dt><dd>{{#if hospitalStats}}{{hospitalStats.fulfilledRequests}}{{else}}0{{/if}}</dd><p>Completed coordination</p></div>
      <div><dt>Facility reviews needed</dt><dd>{{pendingReviewCount}}</dd><p><a href="/hospital/patients" class="vm-text-link">Open review inbox</a></p></div>
      {{else}}
      {{#if donorProfile}}
      <div><dt>Your availability</dt><dd style="font-size:1.15rem">{{donorStatus}}</dd><p><a href="/donor-profile" class="vm-text-link">Manage availability</a></p></div>
      <div><dt>Completed donations</dt><dd>{{donationStats.totalDonations}}</dd><p>Your recorded donation activity</p></div>
      <div><dt>Next coordination date</dt><dd style="font-size:1.15rem">{{nextEligible}}</dd><p>Final eligibility is assessed by medical staff</p></div>
      {{else}}
      <div><dt>Requests awaiting review</dt><dd>{{requesterStats.pendingRequests}}</dd><p><a href="/my-requests" class="vm-text-link">Follow facility review</a></p></div>
      <div><dt>Open requests</dt><dd>{{requesterStats.activeRequests}}</dd><p><a href="/my-requests" class="vm-text-link">Review coordination</a></p></div>
      <div><dt>Your requests</dt><dd>{{requesterStats.totalRequests}}</dd><p>Submitted requests and outcomes</p></div>
      {{/if}}
      {{/if}}
    </dl>
    <div class="vm-dashboard-grid">
      <div>
        <section aria-labelledby="current-requests-title">
          <div class="vm-section-heading"><div><h2 id="current-requests-title">Requests needing donor support</h2><p class="vm-muted text-sm mt-1">Recent active urgent requests in the coordination network.</p></div><button type="button" onclick="showEmergencyAlerts()" class="vm-button vm-button--small">View alerts</button></div>
          {{#if urgentRequests.length}}
          <div class="vm-table-scroll" tabindex="0" role="region" aria-label="Current urgent blood requests"><table class="vm-table"><caption>Current urgent blood requests</caption><thead><tr><th scope="col" class="text-left">Request</th><th scope="col" class="text-left">Blood needed</th><th scope="col" class="text-left">Priority</th><th scope="col" class="text-right">Action</th></tr></thead><tbody>
            {{#each urgentRequests}}<tr><td><strong class="text-sm font-semibold">Request #{{id}}</strong><p class="vm-muted text-xs">{{hospitalName}}</p></td><td class="whitespace-nowrap">{{bloodType}} <span class="vm-muted">· {{unitsRequired}} units</span></td><td><span class="vm-status {{#if emergencyActive}}vm-status--danger{{else}}{{#if (eq urgency 'critical')}}vm-status--danger{{else}}vm-status--warning{{/if}}{{/if}}">{{urgencyLabel}}</span></td><td class="text-right"><a href="/view-blood-request/{{id}}" class="vm-button vm-button--small">View request</a></td></tr>{{/each}}
          </tbody></table></div>
          {{else}}<div class="vm-empty-state vm-panel"><h3>No urgent requests at the moment</h3><p>New urgent requests will appear here when coordination is needed.</p><a class="vm-text-link inline-block mt-3" href="/map">View the blood map</a></div>{{/if}}
        </section>
        <section class="vm-section" aria-labelledby="activity-title">
          <div class="vm-section-heading"><h2 id="activity-title">Recent activity</h2><a href="/history" class="vm-text-link text-sm">View history</a></div>
          {{#if activities.length}}{{#each activities}}<article class="vm-activity-row"><div><h3>{{title}}</h3><p>{{description}}</p><p class="mt-1"><time>{{formatDate date}}</time></p></div><a class="vm-button vm-button--small" href="{{link}}">View details</a></article>{{/each}}{{else}}<div class="vm-empty-state"><h3>No activity yet</h3><p>Your requests and profile updates will appear here.</p></div>{{/if}}
        </section>
      </div>
      <aside aria-label="Frequent tasks">
        <h2 class="mb-4">Quick access</h2>
        <div class="vm-action-list">
          {{#if (eq user.role 'hospital')}}
          <a href="/hospital/patients"><span><strong>Review patient requests</strong><small>Approve or decline requests directed to your hospital.</small></span><span aria-hidden="true">→</span></a>
          <a href="/messages/admin"><span><strong>Contact the coordination team</strong><small>Continue the conversation with a chapter administrator.</small></span><span aria-hidden="true">→</span></a>
          {{else}}
          <a href="/view-donor-profile"><span><strong>{{#if donorProfile}}Your donor profile{{else}}Complete your donor profile{{/if}}</strong><small>Keep your contact details and availability current.</small></span><span aria-hidden="true">→</span></a>
          <a href="/my-appointments"><span><strong>Appointments</strong><small>Review schedules and confirm your availability.</small></span><span aria-hidden="true">→</span></a>
          {{/if}}
          <a href="/my-requests"><span><strong>Your blood requests</strong><small>Follow request status and donor responses.</small></span><span aria-hidden="true">→</span></a>
          <a href="/messages"><span><strong>Messages</strong><small>Stay in touch with donors and coordinators.</small></span><span aria-hidden="true">→</span></a>
          <a href="/map"><span><strong>Blood map</strong><small>See current requests and donor locations.</small></span><span aria-hidden="true">→</span></a>
          <a href="/help"><span><strong>Help & guidelines</strong><small>Understand requests, matching, and the donation process.</small></span><span aria-hidden="true">→</span></a>
        </div>
        <details class="vm-analytics"><summary>{{#if (eq user.role 'hospital')}}Request activity{{else}}Donation activity{{/if}} · last 6 months</summary>
          {{#if (eq user.role 'hospital')}}
          {{#if hasHospitalActivity}}<div class="flex items-end justify-between h-24 gap-2" role="img" aria-label="Request activity for the last six months">{{#each hospitalChart}}<div class="bg-gray-600 w-full" style="height:{{height}}%" title="{{label}}"></div>{{/each}}</div><div class="flex justify-between text-xs vm-muted mt-2">{{#each hospitalChart}}<span>{{label}}</span>{{/each}}</div>{{else}}<p class="vm-muted text-sm">No requests recorded in the last six months.</p>{{/if}}
          {{else}}
          {{#if hasDonationActivity}}<div class="flex items-end justify-between h-24 gap-2" role="img" aria-label="Donation activity for the last six months">{{#each donationChart}}<div class="bg-gray-600 w-full" style="height:{{height}}%" title="{{label}}"></div>{{/each}}</div><div class="flex justify-between text-xs vm-muted mt-2">{{#each donationChart}}<span>{{label}}</span>{{/each}}</div>{{else}}<p class="vm-muted text-sm">No donations recorded in the last six months.</p>{{/if}}
          {{/if}}
        </details>
      </aside>
    </div>
    {{/unless}}
  </div>
</main>

<!-- Emergency Alerts Modal -->
<div id="emergencyModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center p-4">
  <div class="bg-white rounded-md max-w-2xl w-full max-h-[80vh] overflow-y-auto">
    <div class="p-6 border-b">
      <div class="flex items-center justify-between">
        <div class="flex items-center">
          <div class="bg-orange-100 p-2 rounded-lg mr-3">
            <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16c-.77.833.192 2.5 1.732 2.5z" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-gray-800">Emergency Blood Requests</h2>
        </div>
        <button onclick="closeEmergencyModal()" class="vm-button text-gray-400 hover:text-gray-600" aria-label="Close dialog">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <div class="p-6 space-y-4">
      {{#each urgentRequests}}
      <div class="border {{#if (eq urgency 'critical')}}border-red-200 bg-red-50{{else}}border-orange-200 bg-orange-50{{/if}} rounded-lg p-4">
        <div class="flex items-start justify-between mb-3">
          <div class="flex items-center">
            <span class="vm-status {{#if (eq urgency 'critical')}}vm-status--danger{{else}}vm-status--warning{{/if}} text-white text-xs px-2 py-1 rounded-full font-semibold mr-3">{{urgencyLabel}}</span>
            <h3 class="font-semibold text-gray-800">{{bloodType}} Blood Needed Urgently</h3>
          </div>
          <span class="text-xs text-gray-500">{{timeAgo}}</span>
        </div>
        <p class="text-sm text-gray-700 mb-3">
          <strong>Hospital:</strong> {{hospitalName}}<br>

          <strong>Required:</strong> {{unitsRequired}} units of {{bloodType}} blood<br>
          <strong>Location:</strong> {{city}}, {{province}}
        </p>
        <div class="flex items-center justify-between">
          <span class="text-sm text-gray-600">Request #{{id}}</span>
          <a href="/view-blood-request/{{id}}"
            class="vm-button vm-button--small {{#if (eq urgency 'critical')}}bg-red-600 hover:bg-red-700{{else}}bg-orange-600 hover:bg-orange-700{{/if}} text-white px-4 py-2 rounded-lg text-sm font-semibold transition vm-button--primary">
            Respond Now
          </a>
        </div>
      </div>
      {{else}}
      <div class="text-center py-8">
        <p class="text-gray-600 font-semibold mb-1">No urgent requests right now</p>
        <p class="text-sm text-gray-500">Critical and urgent blood requests will appear here.</p>
      </div>
      {{/each}}
    </div>
  </div>
</div>

<!-- Nearby Blood Request Notification Modal -->
<div id="requestNotificationModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center p-4">
  <div class="vm-panel bg-white rounded-md max-w-md w-full">
    <div class="p-5 border-b flex items-center justify-between">
      <h2 id="requestNotificationTitle" class="text-lg font-bold text-gray-800">Nearby Blood Request</h2>
      <button onclick="closeRequestNotificationModal()" class="vm-button text-gray-400 hover:text-gray-600" aria-label="Close notification">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div class="p-5">
      <p id="requestNotificationMessage" class="text-sm leading-6 text-gray-600"></p>
      <div class="mt-5 flex justify-end gap-3">
        <button onclick="closeRequestNotificationModal()" class="vm-button vm-button--small px-4 py-2 text-sm font-semibold text-gray-600 hover:text-gray-800">Close</button>
        <a id="requestNotificationLink" href="#" class="vm-button vm-button--small px-4 py-2 rounded-lg bg-red-600 text-sm font-semibold text-white hover:bg-red-700">View Request</a>
      </div>
    </div>
  </div>
</div>

<script>
  // Sidebar active state is handled by the shared user-sidebar partial

  // Emergency Alerts Modal Functions
  function showEmergencyAlerts() {
    document.getElementById('emergencyModal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeEmergencyModal() {
    document.getElementById('emergencyModal').classList.add('hidden');
    document.body.style.overflow = 'auto';
  }

  function showRequestNotificationModal(notificationId, fallbackTitle, fallbackMessage) {
    fetch(`/api/notifications?_=${Date.now()}`)
      .then(response => response.json())
      .then(data => {
        const notification = data.notifications?.find(item => item.id === notificationId);
        const title = notification?.title || fallbackTitle;
        const message = notification?.message || fallbackMessage;
        const link = notification?.link;

        document.getElementById('requestNotificationTitle').textContent = title;
        document.getElementById('requestNotificationMessage').textContent = message;
        const requestLink = document.getElementById('requestNotificationLink');
        requestLink.href = link?.startsWith('/view-blood-request/') ? link : '#';
        requestLink.classList.toggle('hidden', !link?.startsWith('/view-blood-request/'));
        document.getElementById('requestNotificationModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      })
      .catch(() => {
        window.location.href = '/notifications';
      });
  }

  function closeRequestNotificationModal() {
    document.getElementById('requestNotificationModal').classList.add('hidden');
    document.body.style.overflow = 'auto';
  }

  // Close modal when clicking outside
  document.getElementById('emergencyModal').addEventListener('click', function (e) {
    if (e.target === this) {
      closeEmergencyModal();
    }
  });

  // Notification Dropdown Functions
  function toggleNotifications() {
    const dropdown = document.getElementById('notificationDropdown');
    const hidden = dropdown.classList.toggle('hidden');
    document.getElementById('notificationBtn').setAttribute('aria-expanded', String(!hidden));
  }

  // Close notification dropdown when clicking outside
  document.addEventListener('click', function (e) {
    const notificationBtn = document.getElementById('notificationBtn');
    const notificationDropdown = document.getElementById('notificationDropdown');

    if (!notificationBtn.contains(e.target) && !notificationDropdown.contains(e.target)) {
      notificationDropdown.classList.add('hidden');
      notificationBtn.setAttribute('aria-expanded', 'false');
    }
  });

  // Keyboard shortcuts for dashboard
  function initializeDashboardKeyboardShortcuts() {
    document.addEventListener('keydown', function (e) {
      // Ctrl/Cmd + K for search
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        window.focusWorkspaceSearch();
      }

      // Alt + N for notifications
      if (e.altKey && e.key === 'n') {
        e.preventDefault();
        toggleNotifications();
      }

      // Alt + M for mobile menu (sidebar)
      if (e.altKey && e.key === 'm') {
        e.preventDefault();
        document.querySelector('.vm-header [data-sidebar-toggle]')?.click();
      }

      // Escape to close modals and dropdowns
      if (e.key === 'Escape') {
        const emergencyModal = document.getElementById('emergencyModal');
        const notificationDropdown = document.getElementById('notificationDropdown');

        if (!emergencyModal.classList.contains('hidden')) {
          closeEmergencyModal();
        }

        const requestNotificationModal = document.getElementById('requestNotificationModal');
        if (!requestNotificationModal.classList.contains('hidden')) {
          closeRequestNotificationModal();
        }

        if (!notificationDropdown.classList.contains('hidden')) {
          notificationDropdown.classList.add('hidden');
          document.getElementById('notificationBtn').setAttribute('aria-expanded', 'false');
        }

        window.closeWorkspaceSearch();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initializeDashboardKeyboardShortcuts);
</script>

{{> footer}}
