{{> head-public}}
{{> public-nav hideLogin=true }}

<main id="main-content" tabindex="-1" class="journey-page journey-simple">
  <div class="journey-simple__panel">
    <p class="journey-eyebrow">Account access</p>
    <h1 class="journey-title">Reset your password.</h1>
    <p class="journey-lead">Enter the email address connected to your VitalMatch account. If it is recognized, we will send a password-reset link.</p>
    <div class="journey-form">
      {{#if resetSent}}
      <div class="journey-alert journey-alert--success" role="status">If an account exists for that email, a reset link has been sent. Check your inbox; the link expires in one hour.</div>
      <a class="journey-button journey-button--block" href="/login">Back to login</a>
      {{else}}
      {{#if error_msg}}<div class="journey-alert" role="alert">{{error_msg}}</div>{{/if}}
      <form method="POST" action="/forgot-password" autocomplete="on">
        <p class="journey-alert" role="alert" data-form-status hidden></p>
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <label for="email">Email address<input type="email" name="email" id="email" placeholder="name@example.com" autocomplete="email" required></label>
        <button type="submit" class="journey-button journey-button--block">Send reset link</button>
      </form>
      <p class="journey-form__footer">Remembered your password? <a href="/login">Back to login</a></p>
      {{/if}}
    </div>
  </div>
</main>

{{> public-footer}}
