<!-- Admin Appointments Content -->
<main id="main-content" tabindex="-1" class="vm-page min-h-screen bg-gray-100 dark:bg-[#09090b] py-8">
  <div class="vm-page-container container mx-auto px-4">

    <!-- Header -->
    <div class="vm-page-heading mb-8">
      <h1 class="text-3xl font-bold text-gray-800 dark:text-gray-200 mb-2">Upcoming Appointments</h1>
      <p class="text-gray-600 dark:text-gray-400">View and manage scheduled blood donations</p>
    </div>
      {{> record-search label="Search appointments" placeholder="Patient, donor, facility, blood type or request ID"}}

    <p id="appointmentFeedback" class="vm-alert hidden" aria-live="polite"></p>
    {{#if error}}<div class="vm-alert vm-alert--danger mb-4" role="alert">{{error}} <a class="vm-text-link" href="/admin/appointments">Retry</a></div>{{/if}}
    <!-- Appointments Table -->
    <div class="vm-panel bg-white dark:bg-[#18181b] rounded-md dark:shadow-none overflow-hidden">
      {{#if appointments.length}}
      <div class="vm-table-scroll overflow-x-auto" tabindex="0" role="region" aria-label="Scrollable data table">
        <table data-search-mode="server" class="vm-table min-w-full divide-y divide-gray-100 dark:divide-gray-800">
          <thead class="bg-gray-50 dark:bg-[#27272a]/80 backdrop-blur">
            <tr>
              <th scope="col" class="px-4 py-3 text-left text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-widest">ID</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-widest">Patient / Request</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-widest">Assigned Donor</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-widest">Scheduled Date</th>
              <th scope="col" class="px-4 py-3 text-center text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-widest">Confirmations</th>
              <th scope="col" class="px-4 py-3 text-right text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-widest pr-6">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white dark:bg-[#18181b] divide-y divide-gray-100 dark:divide-gray-800">
            {{#each appointments}}
            <tr class="hover:bg-indigo-50/30 transition-colors duration-200 group">
              <td class="px-4 py-4 whitespace-nowrap text-sm font-semibold text-gray-600 dark:text-gray-400">#{{id}}</td>
              <td class="px-4 py-4 whitespace-nowrap">
                <div class="flex flex-col">
                  <span class="text-sm font-bold text-gray-900 dark:text-gray-100">{{patientName}}</span>
                  <span class="text-xs text-gray-500">{{hospitalName}}</span>
                  <span class="vm-status inline-flex mt-1 items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800 w-max">
                    {{bloodType}} • {{unitsRequired}} Unit(s)
                  </span>
                </div>
              </td>
              <td class="px-4 py-4 whitespace-nowrap">
                {{#if donor}}
                  <div class="flex flex-col">
                    <span class="text-sm font-bold text-gray-900 dark:text-gray-100">{{donor.fullName}}</span>
                    <span class="text-xs text-gray-500 flex items-center">📱 {{donor.mobileNumber}}</span>
                  </div>
                {{else}}
                  <span class="vm-status text-xs text-gray-500 italic bg-gray-50 px-2 py-1 rounded">Walk-in / TBD</span>
                {{/if}}
              </td>
              <td class="px-4 py-4 whitespace-nowrap">
                {{#if scheduledDate}}
                  <div class="flex flex-col">
                    <span class="text-sm font-bold text-gray-900 dark:text-gray-100">{{formatDate scheduledDate}}</span>
                    <span class="text-xs text-gray-500">{{formatTime scheduledDate}}</span>
                  </div>
                {{else}}
                  <span class="text-xs text-gray-500">ASAP</span>
                {{/if}}
              </td>
              <td class="px-4 py-4 whitespace-nowrap text-center">
                <div class="flex flex-col items-center space-y-2">
                  <!-- Requester Confirmation -->
                  <div class="flex items-center space-x-1" title="Requester Confirmation">
                    <span class="text-xs font-medium text-gray-500 w-16 text-right">Requester:</span>
                    {{#if requesterConfirmed}}
                      <span class="vm-status vm-status--success">Confirmed</span><svg aria-hidden="true" class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    {{else}}
                      <span class="vm-status vm-status--warning">Waiting</span><svg aria-hidden="true" class="w-4 h-4 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    {{/if}}
                  </div>
                  <!-- Donor Confirmation -->
                  {{#if donor}}
                  <div class="flex items-center space-x-1" title="Donor Confirmation">
                    <span class="text-xs font-medium text-gray-500 w-16 text-right">Donor:</span>
                    {{#if donorConfirmed}}
                      <span class="vm-status vm-status--success">Confirmed</span><svg aria-hidden="true" class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    {{else}}
                      <span class="vm-status vm-status--warning">Waiting</span><svg aria-hidden="true" class="w-4 h-4 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    {{/if}}
                  </div>
                  {{/if}}
                </div>
              </td>
              <td class="px-4 py-4 whitespace-nowrap text-right pr-6">
                <div class="flex items-center justify-end space-x-2">
                  <a href="/view-blood-request/{{id}}" class="vm-button vm-button--small p-1.5 text-blue-600 bg-blue-50 rounded-md hover:bg-blue-100 hover:text-blue-800 transition tooltip-trigger" title="View details">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                  <span>View</span></a>
                  <button type="button" class="vm-button vm-button--small vm-button--success" data-appointment-action="complete" data-request-id="{{id}}" data-appointment-id="{{appointmentId}}" data-version="{{version}}" data-remaining="{{unitsRemaining}}">Record donation</button>
                  <button type="button" class="vm-button vm-button--small vm-button--warning" data-appointment-action="reschedule" data-request-id="{{id}}" data-appointment-id="{{appointmentId}}" data-version="{{version}}" data-remaining="{{unitsRemaining}}">Reschedule</button>
                  <button type="button" class="vm-button vm-button--small vm-button--danger" data-appointment-action="cancel" data-request-id="{{id}}" data-appointment-id="{{appointmentId}}" data-version="{{version}}" data-remaining="{{unitsRemaining}}">Cancel</button>
                </div>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      {{else}}
      <div class="vm-empty-state text-center py-16">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gray-50 dark:bg-gray-800 mb-4">
          <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
        </div>
        <h3 class="text-lg font-medium text-gray-900 dark:text-gray-100 mb-1">No upcoming appointments</h3>
        <p class="text-gray-500 dark:text-gray-400 text-sm max-w-sm mx-auto">When requests are scheduled with donors, they will appear here for tracking.</p>
      </div>
      {{/if}}
    </div>
  </div>
  {{> pagination}}
</main>


<div id="appointmentActionModal" class="vm-dialog-backdrop fixed hidden flex" role="dialog" aria-modal="true" aria-labelledby="appointmentActionTitle">
  <div class="vm-dialog">
    <h2 id="appointmentActionTitle">Update appointment</h2>
    <p id="appointmentContext"></p>
    <p class="vm-muted text-sm">Scheduling changes require a reason and fresh confirmations. Record only units actually collected after medical clearance. Partial donations leave the remaining request open.</p>
    <form id="appointmentActionForm">
      <div class="form-group mt-4"><label for="appointmentUnits">Units actually collected</label><input id="appointmentUnits" type="number" name="unitsProvided" min="1" max="10" step="1"></div>
      <div class="form-group mt-4"><label for="appointmentDate">New date and time (your local time)</label><input id="appointmentDate" type="datetime-local" name="scheduledDate"></div>
      <div class="form-group mt-4"><label for="appointmentReason">Reason / completion notes</label><textarea id="appointmentReason" name="reason" maxlength="1000" rows="3"></textarea></div>
      <p id="appointmentActionError" class="vm-field-error" role="alert"></p>
      <div class="vm-dialog__actions mt-4"><button type="button" data-dialog-close="true" onclick="closeAppointmentAction()" class="vm-button">Go back</button><button type="submit" class="vm-button vm-button--primary">Save</button></div>
    </form>
  </div>
</div>
<script src="/js/appointment-actions.js?v=2" defer></script>
