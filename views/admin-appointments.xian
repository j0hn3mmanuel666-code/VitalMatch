<!-- Admin Appointments Content -->
<div class="min-h-screen bg-gray-100 dark:bg-[#09090b] py-8">
  <div class="container mx-auto px-4">

    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-800 dark:text-gray-200 mb-2">Upcoming Appointments</h1>
      <p class="text-gray-600 dark:text-gray-400">View and manage scheduled blood donations</p>
    </div>

    <!-- Appointments Table -->
    <div class="bg-white dark:bg-[#18181b] rounded-xl shadow-md dark:shadow-none overflow-hidden">
      {{#if appointments.length}}
      <div class="overflow-x-auto custom-scrollbar">
        <table class="min-w-full divide-y divide-gray-100 dark:divide-gray-800">
          <thead class="bg-gray-50 dark:bg-[#27272a]/80 backdrop-blur">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-widest">ID</th>
              <th class="px-4 py-3 text-left text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-widest">Patient / Request</th>
              <th class="px-4 py-3 text-left text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-widest">Assigned Donor</th>
              <th class="px-4 py-3 text-left text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-widest">Scheduled Date</th>
              <th class="px-4 py-3 text-center text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-widest">Confirmations</th>
              <th class="px-4 py-3 text-right text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-widest pr-6">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white dark:bg-[#18181b] divide-y divide-gray-100 dark:divide-gray-800">
            {{#each appointments}}
            <tr class="hover:bg-indigo-50/30 transition-colors duration-200 group">
              <td class="px-4 py-4 whitespace-nowrap text-sm font-semibold text-gray-600 dark:text-gray-400">#{{id}}</td>
              <td class="px-4 py-4 whitespace-nowrap">
                <div class="flex flex-col">
                  <span class="text-sm font-bold text-gray-900 dark:text-gray-100">{{patientName}}</span>
                  <span class="text-xs text-gray-500">{{hospitalName}}</span>
                  <span class="inline-flex mt-1 items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800 w-max">
                    {{bloodType}} • {{unitsRequired}} Unit(s)
                  </span>
                </div>
              </td>
              <td class="px-4 py-4 whitespace-nowrap">
                {{#if assignedDonor}}
                  <div class="flex flex-col">
                    <span class="text-sm font-bold text-gray-900 dark:text-gray-100">{{assignedDonor.fullName}}</span>
                    <span class="text-xs text-gray-500 flex items-center">📱 {{assignedDonor.mobileNumber}}</span>
                  </div>
                {{else}}
                  <span class="text-xs text-gray-500 italic bg-gray-50 px-2 py-1 rounded">Walk-in / TBD</span>
                {{/if}}
              </td>
              <td class="px-4 py-4 whitespace-nowrap">
                {{#if scheduledDate}}
                  <div class="flex flex-col">
                    <span class="text-sm font-bold text-gray-900 dark:text-gray-100">{{formatDate scheduledDate}}</span>
                    <span class="text-xs text-gray-500">{{formatTime scheduledDate}}</span>
                  </div>
                {{else}}
                  <span class="text-xs text-gray-500">ASAP</span>
                {{/if}}
              </td>
              <td class="px-4 py-4 whitespace-nowrap text-center">
                <div class="flex flex-col items-center space-y-2">
                  <!-- Requester Confirmation -->
                  <div class="flex items-center space-x-1" title="Requester Confirmation">
                    <span class="text-xs font-medium text-gray-500 w-16 text-right">Requester:</span>
                    {{#if requesterConfirmed}}
                      <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    {{else}}
                      <svg class="w-4 h-4 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    {{/if}}
                  </div>
                  <!-- Donor Confirmation -->
                  {{#if assignedDonor}}
                  <div class="flex items-center space-x-1" title="Donor Confirmation">
                    <span class="text-xs font-medium text-gray-500 w-16 text-right">Donor:</span>
                    {{#if donorConfirmed}}
                      <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    {{else}}
                      <svg class="w-4 h-4 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    {{/if}}
                  </div>
                  {{/if}}
                </div>
              </td>
              <td class="px-4 py-4 whitespace-nowrap text-right pr-6">
                <div class="flex items-center justify-end space-x-2">
                  <a href="/view-blood-request/{{id}}" class="p-1.5 text-blue-600 bg-blue-50 rounded-md hover:bg-blue-100 hover:text-blue-800 transition tooltip-trigger" title="View details">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                  </a>
                  <!-- Mark as Complete Button -->
                  <button type="button" class="complete-btn p-1.5 text-green-600 bg-green-50 rounded-md hover:bg-green-100 hover:text-green-800 transition tooltip-trigger" data-request-id="{{id}}" title="Mark as Completed">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                  </button>
                  <button type="button" onclick="cancelAppointment('{{id}}')" class="p-1.5 text-red-600 bg-red-50 rounded-md hover:bg-red-100 hover:text-red-800 transition delete-btn tooltip-trigger" title="Cancel Appointment">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                  </button>
                </div>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      {{else}}
      <div class="text-center py-16">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gray-50 dark:bg-gray-800 mb-4">
          <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
        </div>
        <h3 class="text-lg font-medium text-gray-900 dark:text-gray-100 mb-1">No upcoming appointments</h3>
        <p class="text-gray-500 dark:text-gray-400 text-sm max-w-sm mx-auto">When requests are scheduled with donors, they will appear here for tracking.</p>
      </div>
      {{/if}}
    </div>
  </div>
</div>

<!-- Modals -->
<!-- Complete Appointment Modal -->
<div id="completeModal" class="fixed inset-0 z-50 hidden items-center justify-center overflow-y-auto overflow-x-hidden bg-black/50 backdrop-blur-sm transition-opacity">
  <div class="relative w-full max-w-md p-4">
    <div class="relative bg-white rounded-2xl shadow-xl dark:bg-[#18181b] border border-gray-100 dark:border-gray-800">
      <div class="p-6 text-center">
        <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-green-100 dark:bg-green-900/30 mb-4">
          <svg class="h-6 w-6 text-green-600 dark:text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
        </div>
        <h3 class="mb-5 text-lg font-normal text-gray-600 dark:text-gray-300">Are you sure you want to mark this scheduled appointment as fully completed?</h3>
        <button id="confirmCompleteBtn" type="button" class="text-white bg-green-600 hover:bg-green-700 focus:ring-4 focus:outline-none focus:ring-green-300 dark:focus:ring-green-800 font-medium rounded-lg text-sm inline-flex items-center px-5 py-2.5 text-center mr-2 transition-colors">
          Yes, I'm sure
        </button>
        <button onclick="closeModal('completeModal')" type="button" class="text-gray-500 bg-white hover:bg-gray-100 focus:ring-4 focus:outline-none focus:ring-gray-200 rounded-lg border border-gray-200 text-sm font-medium px-5 py-2.5 hover:text-gray-900 focus:z-10 dark:bg-[#27272a] dark:text-gray-300 dark:border-gray-700 dark:hover:text-white dark:hover:bg-gray-700 transition-colors">No, cancel</button>
      </div>
    </div>
  </div>
</div>

<!-- Cancel Appointment Modal -->
<div id="cancelModal" class="fixed inset-0 z-50 hidden items-center justify-center overflow-y-auto overflow-x-hidden bg-black/50 backdrop-blur-sm transition-opacity">
  <div class="relative w-full max-w-md p-4">
    <div class="relative bg-white rounded-2xl shadow-xl dark:bg-[#18181b] border border-gray-100 dark:border-gray-800">
      <div class="p-6 text-center">
        <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-red-100 dark:bg-red-900/30 mb-4">
          <svg class="h-6 w-6 text-red-600 dark:text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <h3 class="mb-5 text-lg font-normal text-gray-600 dark:text-gray-300">Are you sure you want to cancel this appointment? The request will revert to pending status.</h3>
        <button id="confirmCancelBtn" type="button" class="text-white bg-red-600 hover:bg-red-700 focus:ring-4 focus:outline-none focus:ring-red-300 dark:focus:ring-red-800 font-medium rounded-lg text-sm inline-flex items-center px-5 py-2.5 text-center mr-2 transition-colors">
          Yes, cancel it
        </button>
        <button onclick="closeModal('cancelModal')" type="button" class="text-gray-500 bg-white hover:bg-gray-100 focus:ring-4 focus:outline-none focus:ring-gray-200 rounded-lg border border-gray-200 text-sm font-medium px-5 py-2.5 hover:text-gray-900 focus:z-10 dark:bg-[#27272a] dark:text-gray-300 dark:border-gray-700 dark:hover:text-white dark:hover:bg-gray-700 transition-colors">No, keep it</button>
      </div>
    </div>
  </div>
</div>

<!-- Message Modal -->
<div id="messageModal" class="fixed inset-0 z-50 hidden items-center justify-center overflow-y-auto overflow-x-hidden bg-black/50 backdrop-blur-sm transition-opacity">
  <div class="relative w-full max-w-sm p-4">
    <div class="relative bg-white rounded-2xl shadow-xl dark:bg-[#18181b] border border-gray-100 dark:border-gray-800">
      <div class="p-6 text-center">
        <h3 id="messageModalText" class="mb-5 text-lg font-normal text-gray-600 dark:text-gray-300"></h3>
        <button id="messageModalOkBtn" type="button" class="text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:outline-none focus:ring-blue-300 dark:focus:ring-blue-800 font-medium rounded-lg text-sm inline-flex items-center px-8 py-2.5 text-center transition-colors">
          OK
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  let currentRequestId = null;

  function showModal(modalId) {
    const modal = document.getElementById(modalId);
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeModal(modalId) {
    const modal = document.getElementById(modalId);
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  function showMessage(msg, reloadOnClose = false) {
    document.getElementById('messageModalText').innerText = msg;
    showModal('messageModal');
    
    document.getElementById('messageModalOkBtn').onclick = function() {
      closeModal('messageModal');
      if (reloadOnClose) location.reload();
    };
  }

  document.addEventListener('DOMContentLoaded', () => {
    // Bind complete buttons
    const completeButtons = document.querySelectorAll('.complete-btn');
    completeButtons.forEach(btn => {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        currentRequestId = e.currentTarget.getAttribute('data-request-id');
        showModal('completeModal');
      });
    });

    document.getElementById('confirmCompleteBtn').addEventListener('click', function() {
      closeModal('completeModal');
      if (currentRequestId) {
        processComplete(currentRequestId);
      }
    });

    document.getElementById('confirmCancelBtn').addEventListener('click', function() {
      closeModal('cancelModal');
      showMessage('Functionality to cancel and revert is pending. Please use the view details page.');
    });
  });

  function processComplete(requestId) {
    fetch(`/admin/fulfill-request/${requestId}`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ notes: 'Completed as scheduled.' })
    })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          showMessage('Appointment marked as completed successfully!', true);
        } else {
          showMessage('Error: ' + data.message);
        }
      })
      .catch(error => {
        showMessage('Error processing request.');
        console.error(error);
      });
  }

  function cancelAppointment(requestId) {
    currentRequestId = requestId;
    showModal('cancelModal');
  }
</script>
