{{> head}}

{{> user-sidebar}}

<!-- Navigation Bar -->
<nav class="bg-white shadow-md">
  <div class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <!-- Back Button & Logo/Brand -->
      <div class="flex items-center space-x-1 sm:space-x-3">
        <label for="sidebar-toggle" class="cursor-pointer p-1 sm:p-2 -ml-2 text-gray-600 hover:text-red-600 hover:bg-gray-100 rounded-lg transition-colors" title="Menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </label>
        <div class="flex items-center space-x-1 sm:space-x-2">
          <svg class="w-6 h-6 sm:w-8 sm:h-8 text-red-600" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.94-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
          </svg>
          <a href="/dashboard" class="text-xl sm:text-2xl font-bold text-gray-800">VitalMatch</a>
        </div>
      </div>
      
      <!-- User Menu -->
      <div class="flex items-center space-x-4">
        <a href="/dashboard" class="text-gray-700 hover:text-red-600 transition">Dashboard</a>
        <a href="/donor-profile" class="text-gray-700 hover:text-red-600 transition">Edit Profile</a>
        <a href="/logout" class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition">Logout</a>
      </div>
    </div>
  </div>
</nav>

<!-- Donor Profile View Content -->
<div class="min-h-screen bg-gray-50 py-12">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto">
      
      <!-- Header -->
      <div class="bg-gradient-to-r from-blue-600 to-red-600 rounded-xl shadow-lg p-8 mb-8 text-white">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-3xl font-bold mb-2">My Donor Profile</h1>
            <p class="text-white/90">View your registered donor information</p>
          </div>
          <a href="/donor-profile" class="bg-white text-blue-600 px-6 py-3 rounded-lg font-semibold hover:bg-gray-100 transition shadow-lg">
            Edit Profile
          </a>
        </div>
      </div>

      {{#if donor}}
      
      <!-- Profile Status Card -->
      <div class="bg-white rounded-xl shadow-md p-6 mb-6 border-l-4 border-green-500">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-4">
            <div class="bg-green-100 p-4 rounded-full">
              <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <p class="text-2xl font-bold text-gray-800">Donor Profile</p>
              <p class="text-gray-600">Your registered information</p>
            </div>
          </div>
          <div class="text-center">
            <p class="text-4xl font-bold text-red-600">{{donor.bloodType}}</p>
            <p class="text-sm text-gray-600">Blood Type</p>
          </div>
        </div>
      </div>
      
      <!-- Personal Information -->
      <div class="bg-white rounded-xl shadow-md p-6 mb-6">
        <h2 class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
          <svg class="w-6 h-6 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
          Personal Information
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <p class="text-sm text-gray-600 mb-1">Full Name</p>
            <p class="text-lg font-semibold text-gray-800">{{donor.fullName}}</p>
          </div>
          
          <div>
            <p class="text-sm text-gray-600 mb-1">Date of Birth</p>
            <p class="text-lg font-semibold text-gray-800">{{donor.dateOfBirth}}</p>
          </div>
          
          <div>
            <p class="text-sm text-gray-600 mb-1">Gender</p>
            <p class="text-lg font-semibold text-gray-800 capitalize">{{donor.gender}}</p>
          </div>
          
          <div>
            <p class="text-sm text-gray-600 mb-1">Blood Type</p>
            <p class="text-lg font-semibold text-red-600">{{donor.bloodType}}</p>
          </div>
          
          <div>
            <p class="text-sm text-gray-600 mb-1">Weight</p>
            <p class="text-lg font-semibold text-gray-800">{{donor.weight}} kg</p>
          </div>
          
          <div>
            <p class="text-sm text-gray-600 mb-1">Height</p>
            <p class="text-lg font-semibold text-gray-800">{{donor.height}} cm</p>
          </div>
        </div>
      </div>
      
      <!-- Contact Information -->
      <div class="bg-white rounded-xl shadow-md p-6 mb-6">
        <h2 class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
          <svg class="w-6 h-6 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Contact Information
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <p class="text-sm text-gray-600 mb-1">Mobile Number</p>
            <p class="text-lg font-semibold text-gray-800">{{donor.mobileNumber}}</p>
          </div>
          
          <div>
            <p class="text-sm text-gray-600 mb-1">Email Address</p>
            <p class="text-lg font-semibold text-gray-800">{{donor.email}}</p>
          </div>
        </div>
      </div>
      
      <!-- Address Information -->
      <div class="bg-white rounded-xl shadow-md p-6 mb-6">
        <h2 class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
          <svg class="w-6 h-6 text-red-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          Address Information
        </h2>
        
        <div class="grid grid-cols-1 gap-4">
          <div>
            <p class="text-sm text-gray-600 mb-1">Complete Address</p>
            <p class="text-lg font-semibold text-gray-800">{{donor.address}}</p>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
              <p class="text-sm text-gray-600 mb-1">City</p>
              <p class="text-lg font-semibold text-gray-800">{{donor.city}}</p>
            </div>
            
            <div>
              <p class="text-sm text-gray-600 mb-1">Province</p>
              <p class="text-lg font-semibold text-gray-800">{{donor.province}}</p>
            </div>
            
            <div>
              <p class="text-sm text-gray-600 mb-1">Zip Code</p>
              <p class="text-lg font-semibold text-gray-800">{{donor.zipCode}}</p>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Medical Information -->
      <div class="bg-white rounded-xl shadow-md p-6 mb-6">
        <h2 class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
          <svg class="w-6 h-6 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          Medical Information
        </h2>
        
        <div class="grid grid-cols-1 gap-4">
          <div>
            <p class="text-sm text-gray-600 mb-1">Last Donation Date</p>
            <p class="text-lg font-semibold text-gray-800">{{#if donor.lastDonationDate}}{{donor.lastDonationDate}}{{else}}No previous donations{{/if}}</p>
          </div>
          
          <div>
            <p class="text-sm text-gray-600 mb-1">Medical Conditions</p>
            <p class="text-lg font-semibold text-gray-800">{{#if donor.medicalConditions}}{{donor.medicalConditions}}{{else}}None reported{{/if}}</p>
          </div>
        </div>
      </div>
      
      <!-- Emergency Contact -->
      <div class="bg-white rounded-xl shadow-md p-6 mb-6">
        <h2 class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
          <svg class="w-6 h-6 text-orange-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
          Emergency Contact
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div>
            <p class="text-sm text-gray-600 mb-1">Contact Name</p>
            <p class="text-lg font-semibold text-gray-800">{{donor.emergencyContactName}}</p>
          </div>
          
          <div>
            <p class="text-sm text-gray-600 mb-1">Contact Number</p>
            <p class="text-lg font-semibold text-gray-800">{{donor.emergencyContactNumber}}</p>
          </div>
          
          <div>
            <p class="text-sm text-gray-600 mb-1">Relationship</p>
            <p class="text-lg font-semibold text-gray-800 capitalize">{{donor.emergencyContactRelationship}}</p>
          </div>
        </div>
      </div>

      {{else}}
      
      <!-- No Profile Found -->
      <div class="bg-white rounded-xl shadow-md p-12 text-center">
        <svg class="w-20 h-20 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
        <h3 class="text-xl font-semibold text-gray-800 mb-2">No Donor Profile Found</h3>
        <p class="text-gray-600 mb-6">You haven't created a donor profile yet.</p>
        <a href="/donor-profile" class="inline-block bg-blue-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-blue-700 transition">
          Create Donor Profile
        </a>
      </div>
      
      {{/if}}
      
    </div>
  </div>
</div>

{{> footer}}
