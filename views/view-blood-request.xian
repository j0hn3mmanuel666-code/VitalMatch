{{#if isAdmin}}{{> admin-head}}{{> admin-sidebar}}{{else}}{{> head}}{{> user-sidebar}}{{/if}}

<!-- Navigation Bar -->
{{> internal-header}}

<!-- Blood Request View Content -->
<main id="main-content" tabindex="-1" class="vm-page min-h-screen bg-gray-50 py-12">
  <div class="vm-page-container container mx-auto px-4">
    <div class="max-w-4xl mx-auto">

      <!-- Header -->
      <div class="vm-page-heading mb-8">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-3xl font-bold mb-2">Blood Request Details</h1>
            <p class="text-white/90">View your submitted blood request information</p>
          </div>
          <a href="{{#if isAdmin}}/admin/requests{{else}}/my-requests{{/if}}"
            class="vm-button bg-white text-red-600 px-6 py-3 rounded-lg font-semibold hover:bg-gray-100 transition">
            View All Requests
          </a>
        </div>
      </div>

      {{#if request}}
<section class="vm-panel p-6 mb-6" aria-labelledby="request-progress-heading">
  <h2 id="request-progress-heading">Coordination progress</h2>
  <dl class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-3"><div><dt>Facility review</dt><dd>{{> status-badge value=request.hospitalStatus}}</dd></div><div><dt>Units collected</dt><dd>{{request.unitsFulfilled}} of {{request.unitsRequired}}</dd></div><div><dt>Units remaining</dt><dd>{{request.unitsRemaining}}</dd></div></dl>
  <p class="vm-muted mt-3">{{nextAction}}</p>
  {{#if isOwner}}{{#if (eq request.status 'pending')}}{{#if (eq request.hospitalStatus 'declined')}}<a class="vm-button mt-3" href="/requests/{{request.id}}/edit">Correct returned request</a>{{/if}}{{/if}}{{/if}}
  {{#if hospitalDeclineReason}}<p class="vm-alert vm-alert--danger mt-3">Facility response: {{hospitalDeclineReason}}</p>{{/if}}
  {{#if request.scheduledDate}}<p class="mt-3">Scheduled: {{formatDate request.scheduledDate}} at {{formatTime request.scheduledDate}}. {{#if request.requesterConfirmed}}Requester confirmed.{{else}}Requester confirmation needed.{{/if}} {{#if request.donorConfirmed}}Donor confirmed.{{else}}Donor confirmation needed.{{/if}}</p>{{/if}}
  {{#if history.length}}<details class="mt-4"><summary>Request activity history (latest 100 events)</summary>{{#each history}}<article class="vm-activity-row"><div><strong>{{label}}</strong><p>{{description}}</p><time>{{formatDate createdAt}}</time></div></article>{{/each}}</details>{{/if}}
</section>
{{#if isAdmin}}{{#if (eq request.status 'pending')}}
<section class="vm-panel p-6 mb-6" aria-labelledby="coordinator-review-heading"><h2 id="coordinator-review-heading">Coordinator review</h2><p class="vm-muted mt-2">Verify the facility and request details with staff before approving outreach. Enter a reason for the decision.</p><label for="coordinatorReviewReason" class="block mt-3">Review notes / return reason</label><textarea id="coordinatorReviewReason" rows="3" maxlength="1000" required></textarea><div class="flex gap-3 mt-3"><button class="vm-button vm-button--success" type="button" onclick="reviewRequest('approve')">Approve outreach</button><button class="vm-button vm-button--warning" type="button" onclick="reviewRequest('decline')">Return for correction</button></div><p id="coordinatorReviewError" role="alert" class="vm-field-error"></p></section>
{{/if}}{{/if}}
{{#if isOwner}}{{#if (eq request.status 'scheduled')}}<a class="vm-button mb-4 vm-button--success" href="/confirm-schedule/{{request.id}}/requester?appointment={{request.appointmentId}}&amp;version={{request.appointmentVersion}}">Review and confirm current appointment</a>{{/if}}{{/if}}
<!-- Request Status Card -->
      <div class="vm-panel bg-white rounded-md p-6 mb-6 border-l-4 border-red-500">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-4">
            <div class="bg-red-100 p-4 rounded-full">
              <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <p class="text-2xl font-bold text-gray-800 capitalize">{{request.status}} Request</p>
              <p class="text-gray-600">Current request status</p>
            </div>
          </div>
          <div class="text-center">
            <p class="text-4xl font-bold text-red-600">{{request.bloodType}}</p>
            <p class="text-sm text-gray-600">{{request.unitsRequired}} Units</p>
          </div>
        </div>
      </div>

      <!-- Urgency Badge -->
      <div class="bg-orange-50 border border-orange-200 rounded-lg p-4 mb-6">
        <div class="flex items-center space-x-3">
          <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <div>
            <p class="font-semibold text-orange-800 capitalize">Urgency: {{request.urgency}}</p>
            <p class="text-sm text-orange-700">Required by: {{formatDate request.requiredByDate}}</p>
          </div>
        </div>
      </div>

      {{#if request.patientName}}
      <!-- Patient Information -->
      <details class="collapsible bg-white rounded-md p-6 mb-6" open>
        <summary class="flex items-center justify-between">
          <span class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
          <svg class="w-6 h-6 text-red-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          Patient Information
          </span>
          <svg class="chev w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </summary>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <p class="text-sm text-gray-600 mb-1">Patient Name</p>
            <p class="text-lg font-semibold text-gray-800">{{request.patientName}}</p>
          </div>

          <div>
            <p class="text-sm text-gray-600 mb-1">Patient Age</p>
            <p class="text-lg font-semibold text-gray-800">{{request.patientAge}} years old</p>
          </div>

          <div>
            <p class="text-sm text-gray-600 mb-1">Blood Type Needed</p>
            <p class="text-lg font-semibold text-red-600">{{request.bloodType}}</p>
          </div>

          <div>
            <p class="text-sm text-gray-600 mb-1">Units Required</p>
            <p class="text-lg font-semibold text-gray-800">{{request.unitsRequired}} units</p>
          </div>
        </div>
      </details>

      {{else}}<p class="vm-muted mb-4">Patient details are shared with the requester, assigned facility, and coordination staff.</p>{{/if}}
      <!-- Hospital Information -->
      <details class="collapsible bg-white rounded-md p-6 mb-6">
        <summary class="flex items-center justify-between">
          <span class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
          <svg class="w-6 h-6 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
          Hospital Information
          </span>
          <svg class="chev w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </summary>

        <div class="grid grid-cols-1 gap-4">
          <div>
            <p class="text-sm text-gray-600 mb-1">Hospital Name</p>
            <p class="text-lg font-semibold text-gray-800">{{request.hospitalName}}</p>
          </div>

          <div>
            <p class="text-sm text-gray-600 mb-1">Hospital Address</p>
            <p class="text-lg font-semibold text-gray-800">{{request.hospitalAddress}}</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <p class="text-sm text-gray-600 mb-1">City</p>
              <p class="text-lg font-semibold text-gray-800">{{request.city}}</p>
            </div>

            <div>
              <p class="text-sm text-gray-600 mb-1">Province</p>
              <p class="text-lg font-semibold text-gray-800">{{request.province}}</p>
            </div>
          </div>
        </div>
      </details>

      <!-- Contact Information -->
      <details class="collapsible bg-white rounded-md p-6 mb-6">
        <summary class="flex items-center justify-between">
          <span class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
          <svg class="w-6 h-6 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Contact Information
          </span>
          <svg class="chev w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </summary>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div>
            <p class="text-sm text-gray-600 mb-1">Contact Person</p>
            <p class="text-lg font-semibold text-gray-800">{{request.contactPerson}}</p>
          </div>

          <div>
            <p class="text-sm text-gray-600 mb-1">Contact Number</p>
            <p class="text-lg font-semibold text-gray-800">{{request.contactNumber}}</p>
          </div>

          <div>
            <p class="text-sm text-gray-600 mb-1">Email Address</p>
            <p class="text-lg font-semibold text-gray-800">{{request.email}}</p>
          </div>
        </div>
      </details>

      <!-- Request Details -->
      <details class="collapsible bg-white rounded-md p-6 mb-6">
        <summary class="flex items-center justify-between">
          <span class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
          <svg class="w-6 h-6 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Additional Details
          </span>
          <svg class="chev w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </summary>

        <div class="grid grid-cols-1 gap-4">
          <div>
            <p class="text-sm text-gray-600 mb-1">Urgency Level</p>
            <p class="text-lg font-semibold text-gray-800 capitalize">{{request.urgency}}</p>
          </div>

          <div>
            <p class="text-sm text-gray-600 mb-1">Required By Date</p>
            <p class="text-lg font-semibold text-gray-800">{{formatDate request.requiredByDate}}</p>
          </div>

          <div>
            <p class="text-sm text-gray-600 mb-1">Additional Notes</p>
            <p class="text-lg font-semibold text-gray-800">{{#if request.notes}}{{request.notes}}{{else}}No additional
              notes{{/if}}</p>
          </div>

          <div>
            <p class="text-sm text-gray-600 mb-1">Request Submitted</p>
            <p class="text-lg font-semibold text-gray-800">{{formatDate request.createdAt}}</p>
          </div>
        </div>
      </details>

      {{#if emergencyActive}}
      <div class="bg-red-600 text-white rounded-md p-5 mb-6 animate-pulse">
        <div class="flex items-center justify-between flex-wrap gap-3">
          <div class="flex items-center">
            <svg class="w-8 h-8 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
              <p class="font-bold text-lg">EMERGENCY — all matching donors notified</p>
              <p class="text-sm text-red-100">This request jumped the queue and expires automatically.</p>
            </div>
          </div>
          {{#if canManageEmergency}}
          <form method="POST" action="/requests/{{request.id}}/clear-emergency" id="clearEmergencyForm">
            <input type="hidden" name="_csrf" value="{{csrfToken}}">
            <button type="submit" class="vm-button vm-button--small px-5 py-2 bg-white text-red-700 rounded-lg font-bold hover:bg-red-50 transition text-sm vm-button--warning">Stand Down</button>
          </form>
          {{/if}}
        </div>
      </div>
      {{else}}
      {{#if canManageEmergency}}
      {{#if request}}
      {{#unless (eq request.status 'fulfilled')}}
      {{#unless (eq request.status 'cancelled')}}
      <div class="bg-orange-50 border border-orange-300 rounded-md p-5 mb-6">
        <div class="flex items-center justify-between flex-wrap gap-3">
          <div>
            <p class="font-bold text-gray-800">Declare an emergency?</p>
            <p class="text-sm text-gray-600">Notifies every matching donor immediately. Expires in 6 hours. Audited.</p>
          </div>
          <form method="POST" action="/requests/{{request.id}}/escalate" id="escalateEmergencyForm">
            <input type="hidden" name="_csrf" value="{{csrfToken}}">
            <button type="submit" class="vm-button vm-button--small px-5 py-2 bg-orange-600 text-white rounded-lg font-bold hover:bg-orange-700 transition text-sm vm-button--warning">Declare Emergency</button>
          </form>
        </div>
      </div>
      {{/unless}}
      {{/unless}}
      {{/if}}
      {{/if}}
      {{/if}}

      <!-- Donor Response -->
      {{#unless isAdmin}}
      {{#if request}}
      <div class="vm-surface-muted border border-red-200 rounded-md p-6 mb-6 text-center">
        {{#if (eq pledgeState 'offer')}}
        <h3 class="text-lg font-bold text-gray-800 mb-2">Can you donate {{request.bloodType}} blood?</h3>
        <p class="text-sm text-gray-600 mb-4">Your blood type is compatible with this request. Offer to donate and the requester will be notified immediately.</p>
        <form method="POST" action="/requests/{{request.id}}/pledge">
          <input type="hidden" name="_csrf" value="{{csrfToken}}">
          <button type="submit" class="vm-button vm-button--primary px-8 py-3 bg-red-600 text-white rounded-lg font-bold hover:bg-red-700 transition">
            Offer to Donate
          </button>
        </form>
        {{else if (eq pledgeState 'pledged')}}
        <h3 class="text-lg font-bold text-green-700 mb-2">You have offered to donate</h3>
        <p class="text-sm text-gray-600 mb-4">The requester has been notified. They will schedule you if you are selected.</p>
        <form method="POST" action="/requests/{{request.id}}/pledge/withdraw" id="withdrawPledgeForm">
          <input type="hidden" name="_csrf" value="{{csrfToken}}">
          <button type="submit" class="vm-button vm-button--small px-6 py-2 border border-gray-300 text-gray-600 rounded-lg font-semibold hover:bg-gray-100 transition text-sm vm-button--danger">
            Withdraw Pledge
          </button>
        </form>
        {{else if (eq pledgeState 'nodonor')}}
        <h3 class="text-lg font-bold text-gray-800 mb-2">Want to respond to this request?</h3>
        <p class="text-sm text-gray-600 mb-4">Register as a donor first, then you can offer to donate.</p>
        <a href="/donor-profile" class="vm-button inline-block px-8 py-3 bg-red-600 text-white rounded-lg font-bold hover:bg-red-700 transition vm-button--primary">Become a Donor</a>
        {{else if (eq pledgeState 'unavailable')}}
        <h3 class="text-lg font-bold text-gray-800 mb-2">You are currently hidden from matching</h3>
        <p class="text-sm text-gray-600 mb-4">Turn on availability in Settings to offer donations.</p>
        <a href="/settings?tab=donor" class="vm-button inline-block px-8 py-3 bg-blue-600 text-white rounded-lg font-bold hover:bg-blue-700 transition">Go to Donor Settings</a>
        {{else if (eq pledgeState 'incompatible')}}
        <div class="text-sm text-gray-600">Your blood type is not compatible with this request, so you cannot pledge for it.</div>
        {{/if}}
        {{#if pledgeCount}}
        <p class="text-sm text-gray-500 mt-4">{{pledgeCount}} donor(s) have offered so far</p>
        {{/if}}
      </div>
      {{/if}}
      {{#if isOwner}}
      {{#if pledges.length}}
      <div class="vm-panel bg-white rounded-md p-6 mb-6">
        <h3 class="text-lg font-bold text-gray-800 mb-4">Donors Who Offered ({{pledges.length}})</h3>
        <div class="space-y-3">
          {{#each pledges}}
          <div class="flex items-center justify-between border border-gray-200 rounded-lg px-4 py-3">
            <div>
              <p class="font-semibold text-gray-800">{{name}}</p>
              <p class="text-xs text-gray-500">{{formatDate when}}</p>
            </div>
            <span class="vm-status bg-red-100 text-red-700 px-3 py-1 rounded-full text-sm font-bold">{{bloodType}}</span>
          </div>
          {{/each}}
        </div>
      </div>
      {{/if}}
      {{/if}}
      {{/unless}}
      {{#if isAdmin}}
      {{#if pledges.length}}
      <div class="bg-blue-50 border border-blue-200 rounded-md p-6 mb-6">
        <h3 class="text-lg font-bold text-gray-800 mb-4">Pledged Donors ({{pledgeCount}})</h3>
        <div class="space-y-3">
          {{#each pledges}}
          <div class="vm-panel flex items-center justify-between bg-white border border-gray-200 rounded-lg px-4 py-3">
            <div>
              <p class="font-semibold text-gray-800">{{name}}</p>
              <p class="text-xs text-gray-500">{{formatDate when}}</p>
            </div>
            <div class="flex items-center gap-2">
              <span class="vm-status bg-red-100 text-red-700 px-3 py-1 rounded-full text-sm font-bold">{{bloodType}}</span>
              {{#if ../isAdmin}}
              {{#if donorId}}
              <a href="/admin/requests?schedule={{@root.request.id}}&donor={{donorId}}"
                class="vm-button vm-button--small px-3 py-1 bg-blue-600 text-white rounded-lg text-xs font-bold hover:bg-blue-700 transition">Schedule</a>
              {{/if}}
              {{/if}}
            </div>
          </div>
          {{/each}}
        </div>
        <p class="text-sm text-gray-500 mt-4">Schedule one of these donors from the admin Requests page.</p>
      </div>
      {{/if}}
      {{/if}}
      <!-- Action Buttons -->
      <div class="flex justify-center space-x-4">
        {{#if isAdmin}}
        <a href="/admin/requests"
          class="vm-button px-6 py-3 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition">
          Back to Admin Requests
        </a>
        {{#if request}}
        {{#unless (eq request.status 'fulfilled')}}
        <a class="vm-button vm-button--primary" href="/admin/requests?schedule={{request.id}}">Coordinate / record donation</a>
        {{/unless}}
        {{/if}}
        {{else}}
        {{#if canReviewHospital}}
        <form action="/hospital/requests/{{request.id}}/approve" method="POST" class="inline">
          <input type="hidden" name="_csrf" value="{{csrfToken}}">
          <button type="submit"
            class="vm-button px-6 py-3 bg-green-600 text-white rounded-lg font-semibold hover:bg-green-700 transition vm-button--success">
            Approve (Our Patient)
          </button>
        </form>
        <form action="/hospital/requests/{{request.id}}/decline" method="POST" class="inline">
          <input type="hidden" name="_csrf" value="{{csrfToken}}">
          <input type="text" name="declineReason" required placeholder="Reason for declining" maxlength="200"
            class="px-4 py-3 border border-gray-300 rounded-lg focus:ring-red-500 focus:border-red-500" aria-label="Reason for declining">
          <button type="submit"
            class="vm-button px-6 py-3 border border-red-600 text-red-600 rounded-lg font-semibold hover:bg-red-50 transition vm-button--danger">
            Decline
          </button>
        </form>
        {{/if}}
        <a href="/my-requests"
          class="vm-button px-6 py-3 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition">
          View All My Requests
        </a>
        <a href="/request-blood"
          class="vm-button vm-button--primary px-6 py-3 border border-red-600 text-red-600 rounded-lg font-semibold hover:bg-red-50 transition">
          Submit New Request
        </a>
        {{/if}}
      </div>

      {{else}}

      <!-- No Request Found -->
      <div class="vm-panel bg-white rounded-md p-12 text-center">
        <svg class="w-20 h-20 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <h3 class="text-xl font-semibold text-gray-800 mb-2">No Request Found</h3>
        <p class="text-gray-600 mb-6">The blood request you're looking for doesn't exist.</p>
        <a href="/request-blood"
          class="vm-button vm-button--primary inline-block bg-red-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-red-700 transition">
          Submit Blood Request
        </a>
      </div>

      {{/if}}

    </div>
  </div>
</main>



<script>
  document.addEventListener('DOMContentLoaded', function () {
    {{#if request}}
    {{/if}}

    var escalateForm = document.getElementById('escalateEmergencyForm');
    if (escalateForm) {
      escalateForm.addEventListener('submit', function (e) {
        e.preventDefault();
        openConfirmModal({
          title: 'Declare EMERGENCY?',
          message: 'Every matching donor will be notified immediately. Expires in 6 hours. This action is audited.',
          button: 'Declare Emergency',
          buttonClass: 'bg-orange-600 hover:bg-orange-700',
          icon: 'warning',
          onSubmit: function () { escalateForm.submit(); }
        });
      });
    }

    var clearForm = document.getElementById('clearEmergencyForm');
    if (clearForm) {
      clearForm.addEventListener('submit', function (e) {
        e.preventDefault();
        openConfirmModal({
          title: 'Stand Down Emergency?',
          message: 'The emergency will be cleared and normal matching resumes.',
          button: 'Stand Down',
          buttonClass: 'bg-red-600 hover:bg-red-700',
          icon: 'danger',
          onSubmit: function () { clearForm.submit(); }
        });
      });
    }

    var withdrawForm = document.getElementById('withdrawPledgeForm');
    if (withdrawForm) {
      withdrawForm.addEventListener('submit', function (e) {
        e.preventDefault();
        openConfirmModal({
          title: 'Withdraw Pledge?',
          message: 'You will be removed from this request. The requester will be notified.',
          button: 'Withdraw',
          buttonClass: 'bg-red-600 hover:bg-red-700',
          icon: 'danger',
          onSubmit: function () { withdrawForm.submit(); }
        });
      });
    }
  });
</script>

<script>
async function reviewRequest(action) {
  const reason = document.getElementById('coordinatorReviewReason'), error = document.getElementById('coordinatorReviewError');
  if (!reason.value.trim()) { error.textContent = 'Enter review notes before saving a decision.'; reason.focus(); return; }
  const panel = reason.closest('section'), buttons = panel.querySelectorAll('button'); buttons.forEach(button => button.disabled = true); error.textContent = 'Saving review...';
  try { const response = await fetch('/admin/requests/{{request.id}}/review', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': window.getCsrfToken() }, body: JSON.stringify({ action, reason: reason.value }) }); const data = await response.json(); if (!response.ok || !data.success) throw new Error(data.message || 'Review could not be saved.'); location.reload(); }
  catch (failure) { error.textContent = failure.message + ' Your notes are retained; retry.'; buttons.forEach(button => button.disabled = false); }
}
</script>

