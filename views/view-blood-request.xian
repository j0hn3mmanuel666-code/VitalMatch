{{> head}}

<!-- Navigation Bar -->
<nav class="bg-white shadow-md">
  <div class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <!-- Back Button & Logo/Brand -->
      <div class="flex items-center space-x-1 sm:space-x-3">
        <a href="javascript:history.length > 1 ? history.back() : window.location.href='/dashboard'"
          class="p-1 sm:p-2 -ml-2 text-gray-600 hover:text-red-600 hover:bg-gray-100 rounded-lg transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </a>
        <div class="flex items-center space-x-1 sm:space-x-2">
          <svg class="w-6 h-6 sm:w-8 sm:h-8 text-red-600" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.94-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" />
          </svg>
          <a href="{{#if isAdmin}}/admin/dashboard{{else}}/dashboard{{/if}}"
            class="text-xl sm:text-2xl font-bold text-gray-800">VitalMatch</a>
        </div>
      </div>

      <!-- User Menu -->
      <div class="flex items-center space-x-4">
        {{#if isAdmin}}
        <a href="/admin/dashboard" class="text-gray-700 hover:text-red-600 transition">Dashboard</a>
        <a href="/admin/requests" class="text-gray-700 hover:text-red-600 transition">Requests</a>
        {{else}}
        <a href="/dashboard" class="text-gray-700 hover:text-red-600 transition">Dashboard</a>
        <a href="/my-requests" class="text-gray-700 hover:text-red-600 transition">My Requests</a>
        {{/if}}
        <a href="/logout" class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition">Logout</a>
      </div>
    </div>
  </div>
</nav>

<!-- Blood Request View Content -->
<div class="min-h-screen bg-gray-50 py-12">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto">

      <!-- Header -->
      <div class="bg-gradient-to-r from-red-600 to-blue-600 rounded-xl shadow-lg p-8 mb-8 text-white">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-3xl font-bold mb-2">Blood Request Details</h1>
            <p class="text-white/90">View your submitted blood request information</p>
          </div>
          <a href="{{#if isAdmin}}/admin/requests{{else}}/my-requests{{/if}}"
            class="bg-white text-red-600 px-6 py-3 rounded-lg font-semibold hover:bg-gray-100 transition shadow-lg">
            View All Requests
          </a>
        </div>
      </div>

      {{#if request}}

      <style>
        details.collapsible summary { list-style: none; cursor: pointer; }
        details.collapsible summary::-webkit-details-marker { display: none; }
        details.collapsible .chev { transition: transform 0.2s ease-in-out; flex-shrink: 0; }
        details.collapsible[open] .chev { transform: rotate(180deg); }
      </style>

      <!-- Request Status Card -->
      <div class="bg-white rounded-xl shadow-md p-6 mb-6 border-l-4 border-red-500">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-4">
            <div class="bg-red-100 p-4 rounded-full">
              <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <p class="text-2xl font-bold text-gray-800 capitalize">{{request.status}} Request</p>
              <p class="text-gray-600">Current request status</p>
            </div>
          </div>
          <div class="text-center">
            <p class="text-4xl font-bold text-red-600">{{request.bloodType}}</p>
            <p class="text-sm text-gray-600">{{request.unitsRequired}} Units</p>
          </div>
        </div>
      </div>

      <!-- Urgency Badge -->
      <div class="bg-orange-50 border border-orange-200 rounded-lg p-4 mb-6">
        <div class="flex items-center space-x-3">
          <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <div>
            <p class="font-semibold text-orange-800 capitalize">Urgency: {{request.urgency}}</p>
            <p class="text-sm text-orange-700">Required by: {{formatDate request.requiredByDate}}</p>
          </div>
        </div>
      </div>

      <!-- Patient Information -->
      <details class="collapsible bg-white rounded-xl shadow-md p-6 mb-6" open>
        <summary class="flex items-center justify-between">
          <span class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
          <svg class="w-6 h-6 text-red-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          Patient Information
          </span>
          <svg class="chev w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </summary>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <p class="text-sm text-gray-600 mb-1">Patient Name</p>
            <p class="text-lg font-semibold text-gray-800">{{request.patientName}}</p>
          </div>

          <div>
            <p class="text-sm text-gray-600 mb-1">Patient Age</p>
            <p class="text-lg font-semibold text-gray-800">{{request.patientAge}} years old</p>
          </div>

          <div>
            <p class="text-sm text-gray-600 mb-1">Blood Type Needed</p>
            <p class="text-lg font-semibold text-red-600">{{request.bloodType}}</p>
          </div>

          <div>
            <p class="text-sm text-gray-600 mb-1">Units Required</p>
            <p class="text-lg font-semibold text-gray-800">{{request.unitsRequired}} units</p>
          </div>
        </div>
      </details>

      <!-- Hospital Information -->
      <details class="collapsible bg-white rounded-xl shadow-md p-6 mb-6">
        <summary class="flex items-center justify-between">
          <span class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
          <svg class="w-6 h-6 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
          Hospital Information
          </span>
          <svg class="chev w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </summary>

        <div class="grid grid-cols-1 gap-4">
          <div>
            <p class="text-sm text-gray-600 mb-1">Hospital Name</p>
            <p class="text-lg font-semibold text-gray-800">{{request.hospitalName}}</p>
          </div>

          <div>
            <p class="text-sm text-gray-600 mb-1">Hospital Address</p>
            <p class="text-lg font-semibold text-gray-800">{{request.hospitalAddress}}</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <p class="text-sm text-gray-600 mb-1">City</p>
              <p class="text-lg font-semibold text-gray-800">{{request.city}}</p>
            </div>

            <div>
              <p class="text-sm text-gray-600 mb-1">Province</p>
              <p class="text-lg font-semibold text-gray-800">{{request.province}}</p>
            </div>
          </div>
        </div>
      </details>

      <!-- Contact Information -->
      <details class="collapsible bg-white rounded-xl shadow-md p-6 mb-6">
        <summary class="flex items-center justify-between">
          <span class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
          <svg class="w-6 h-6 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Contact Information
          </span>
          <svg class="chev w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </summary>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div>
            <p class="text-sm text-gray-600 mb-1">Contact Person</p>
            <p class="text-lg font-semibold text-gray-800">{{request.contactPerson}}</p>
          </div>

          <div>
            <p class="text-sm text-gray-600 mb-1">Contact Number</p>
            <p class="text-lg font-semibold text-gray-800">{{request.contactNumber}}</p>
          </div>

          <div>
            <p class="text-sm text-gray-600 mb-1">Email Address</p>
            <p class="text-lg font-semibold text-gray-800">{{request.email}}</p>
          </div>
        </div>
      </details>

      <!-- Request Details -->
      <details class="collapsible bg-white rounded-xl shadow-md p-6 mb-6">
        <summary class="flex items-center justify-between">
          <span class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
          <svg class="w-6 h-6 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Additional Details
          </span>
          <svg class="chev w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </summary>

        <div class="grid grid-cols-1 gap-4">
          <div>
            <p class="text-sm text-gray-600 mb-1">Urgency Level</p>
            <p class="text-lg font-semibold text-gray-800 capitalize">{{request.urgency}}</p>
          </div>

          <div>
            <p class="text-sm text-gray-600 mb-1">Required By Date</p>
            <p class="text-lg font-semibold text-gray-800">{{formatDate request.requiredByDate}}</p>
          </div>

          <div>
            <p class="text-sm text-gray-600 mb-1">Additional Notes</p>
            <p class="text-lg font-semibold text-gray-800">{{#if request.notes}}{{request.notes}}{{else}}No additional
              notes{{/if}}</p>
          </div>

          <div>
            <p class="text-sm text-gray-600 mb-1">Request Submitted</p>
            <p class="text-lg font-semibold text-gray-800">{{formatDate request.createdAt}}</p>
          </div>
        </div>
      </details>

      <!-- Blockchain Verification --
      <div class="bg-gradient-to-r from-purple-600 to-indigo-600 rounded-xl shadow-md p-6 mb-6 text-white">
        <h2 class="text-2xl font-bold mb-4 flex items-center">
          <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
          </svg>
          Blockchain Verification
        </h2>
        
        <div class="bg-white/10 rounded-lg p-4 mb-4">
          <div class="flex items-center justify-between mb-2">
            <span class="text-white/90">Request Status on Blockchain:</span>
            <span id="blockchainStatus" class="px-3 py-1 bg-green-500 text-white rounded-full text-sm font-semibold">
              ✓ Verified
            </span>
          </div>
          <div class="text-sm text-white/80" id="blockchainInfo">
            This request has been permanently recorded on the VitalMatch blockchain for transparency and immutability.
          </div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
          <div>
            <span class="text-white/70">Block Hash:</span>
            <div class="font-mono text-xs bg-white/10 p-2 rounded mt-1" id="blockHash">
              Loading...
            </div>
          </div>
          <div>
            <span class="text-white/70">Transaction ID:</span>
            <div class="font-mono text-xs bg-white/10 p-2 rounded mt-1" id="transactionId">
              Loading...
            </div>
          </div>
        </div>
        
        <button onclick="viewBlockchainDetails()" class="mt-4 bg-white/20 hover:bg-white/30 text-white px-4 py-2 rounded-lg transition text-sm">
          View Full Blockchain Record
        </button>
      </div>
    -->
      {{#if emergencyActive}}
      <div class="bg-red-600 text-white rounded-xl p-5 mb-6 shadow-lg animate-pulse">
        <div class="flex items-center justify-between flex-wrap gap-3">
          <div class="flex items-center">
            <svg class="w-8 h-8 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
              <p class="font-bold text-lg">EMERGENCY — all matching donors notified</p>
              <p class="text-sm text-red-100">This request jumped the queue and expires automatically.</p>
            </div>
          </div>
          {{#if canManageEmergency}}
          <form method="POST" action="/requests/{{request.id}}/clear-emergency" onsubmit="return confirm('Stand down this emergency?');">
            <input type="hidden" name="_csrf" value="{{csrfToken}}">
            <button type="submit" class="px-5 py-2 bg-white text-red-700 rounded-lg font-bold hover:bg-red-50 transition text-sm">Stand Down</button>
          </form>
          {{/if}}
        </div>
      </div>
      {{else}}
      {{#if canManageEmergency}}
      {{#if request}}
      {{#unless (eq request.status 'fulfilled')}}
      {{#unless (eq request.status 'cancelled')}}
      <div class="bg-orange-50 border border-orange-300 rounded-xl p-5 mb-6">
        <div class="flex items-center justify-between flex-wrap gap-3">
          <div>
            <p class="font-bold text-gray-800">Declare an emergency?</p>
            <p class="text-sm text-gray-600">Notifies every matching donor immediately. Expires in 6 hours. Audited.</p>
          </div>
          <form method="POST" action="/requests/{{request.id}}/escalate" onsubmit="return confirm('Declare EMERGENCY for this request? Every matching donor will be notified at once.');">
            <input type="hidden" name="_csrf" value="{{csrfToken}}">
            <button type="submit" class="px-5 py-2 bg-orange-600 text-white rounded-lg font-bold hover:bg-orange-700 transition text-sm">Declare Emergency</button>
          </form>
        </div>
      </div>
      {{/unless}}
      {{/unless}}
      {{/if}}
      {{/if}}
      {{/if}}

      <!-- Donor Response -->
      {{#unless isAdmin}}
      {{#if request}}
      <div class="bg-gradient-to-r from-red-50 to-orange-50 border border-red-200 rounded-xl p-6 mb-6 text-center">
        {{#if (eq pledgeState 'offer')}}
        <h3 class="text-lg font-bold text-gray-800 mb-2">Can you donate {{request.bloodType}} blood?</h3>
        <p class="text-sm text-gray-600 mb-4">Your blood type is compatible with this request. Offer to donate and the requester will be notified immediately.</p>
        <form method="POST" action="/requests/{{request.id}}/pledge">
          <input type="hidden" name="_csrf" value="{{csrfToken}}">
          <button type="submit" class="px-8 py-3 bg-red-600 text-white rounded-lg font-bold hover:bg-red-700 transition shadow-lg">
            Offer to Donate
          </button>
        </form>
        {{else if (eq pledgeState 'pledged')}}
        <h3 class="text-lg font-bold text-green-700 mb-2">You have offered to donate</h3>
        <p class="text-sm text-gray-600 mb-4">The requester has been notified. They will schedule you if you are selected.</p>
        <form method="POST" action="/requests/{{request.id}}/pledge/withdraw" onsubmit="return confirm('Withdraw your pledge for this request?');">
          <input type="hidden" name="_csrf" value="{{csrfToken}}">
          <button type="submit" class="px-6 py-2 border border-gray-300 text-gray-600 rounded-lg font-semibold hover:bg-gray-100 transition text-sm">
            Withdraw Pledge
          </button>
        </form>
        {{else if (eq pledgeState 'nodonor')}}
        <h3 class="text-lg font-bold text-gray-800 mb-2">Want to respond to this request?</h3>
        <p class="text-sm text-gray-600 mb-4">Register as a donor first, then you can offer to donate.</p>
        <a href="/donor-profile" class="inline-block px-8 py-3 bg-red-600 text-white rounded-lg font-bold hover:bg-red-700 transition shadow-lg">Become a Donor</a>
        {{else if (eq pledgeState 'unavailable')}}
        <h3 class="text-lg font-bold text-gray-800 mb-2">You are currently hidden from matching</h3>
        <p class="text-sm text-gray-600 mb-4">Turn on availability in Settings to offer donations.</p>
        <a href="/settings?tab=donor" class="inline-block px-8 py-3 bg-blue-600 text-white rounded-lg font-bold hover:bg-blue-700 transition shadow-lg">Go to Donor Settings</a>
        {{else if (eq pledgeState 'incompatible')}}
        <div class="text-sm text-gray-600">Your blood type is not compatible with this request, so you cannot pledge for it.</div>
        {{/if}}
        {{#if pledgeCount}}
        <p class="text-sm text-gray-500 mt-4">{{pledgeCount}} donor(s) have offered so far</p>
        {{/if}}
      </div>
      {{/if}}
      {{#if isOwner}}
      {{#if pledges.length}}
      <div class="bg-white rounded-xl shadow-md p-6 mb-6">
        <h3 class="text-lg font-bold text-gray-800 mb-4">Donors Who Offered ({{pledges.length}})</h3>
        <div class="space-y-3">
          {{#each pledges}}
          <div class="flex items-center justify-between border border-gray-200 rounded-lg px-4 py-3">
            <div>
              <p class="font-semibold text-gray-800">{{name}}</p>
              <p class="text-xs text-gray-500">{{formatDate when}}</p>
            </div>
            <span class="bg-red-100 text-red-700 px-3 py-1 rounded-full text-sm font-bold">{{bloodType}}</span>
          </div>
          {{/each}}
        </div>
      </div>
      {{/if}}
      {{/if}}
      {{/unless}}
      {{#if isAdmin}}
      {{#if pledges.length}}
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-6 mb-6">
        <h3 class="text-lg font-bold text-gray-800 mb-4">Pledged Donors ({{pledgeCount}})</h3>
        <div class="space-y-3">
          {{#each pledges}}
          <div class="flex items-center justify-between bg-white border border-gray-200 rounded-lg px-4 py-3">
            <div>
              <p class="font-semibold text-gray-800">{{name}}</p>
              <p class="text-xs text-gray-500">{{formatDate when}}</p>
            </div>
            <div class="flex items-center gap-2">
              <span class="bg-red-100 text-red-700 px-3 py-1 rounded-full text-sm font-bold">{{bloodType}}</span>
              {{#if ../isAdmin}}
              {{#if donorId}}
              <a href="/admin/requests?schedule={{@root.request.id}}&donor={{donorId}}"
                class="px-3 py-1 bg-blue-600 text-white rounded-lg text-xs font-bold hover:bg-blue-700 transition">Schedule</a>
              {{/if}}
              {{/if}}
            </div>
          </div>
          {{/each}}
        </div>
        <p class="text-sm text-gray-500 mt-4">Schedule one of these donors from the admin Requests page.</p>
      </div>
      {{/if}}
      {{/if}}
      <!-- Action Buttons -->
      <div class="flex justify-center space-x-4">
        {{#if isAdmin}}
        <a href="/admin/requests"
          class="px-6 py-3 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition shadow-lg">
          Back to Admin Requests
        </a>
        {{#if request}}
        {{#unless (eq request.status 'fulfilled')}}
        <form action="/admin/fulfill-request/{{request.id}}" method="POST" class="inline">
          <button type="submit"
            class="px-6 py-3 bg-green-600 text-white rounded-lg font-semibold hover:bg-green-700 transition shadow-lg">
            Mark as Fulfilled
          </button>
        </form>
        {{/unless}}
        {{/if}}
        {{else}}
        <a href="/my-requests"
          class="px-6 py-3 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition shadow-lg">
          View All My Requests
        </a>
        <a href="/request-blood"
          class="px-6 py-3 border border-red-600 text-red-600 rounded-lg font-semibold hover:bg-red-50 transition">
          Submit New Request
        </a>
        {{/if}}
      </div>

      {{else}}

      <!-- No Request Found -->
      <div class="bg-white rounded-xl shadow-md p-12 text-center">
        <svg class="w-20 h-20 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <h3 class="text-xl font-semibold text-gray-800 mb-2">No Request Found</h3>
        <p class="text-gray-600 mb-6">The blood request you're looking for doesn't exist.</p>
        <a href="/request-blood"
          class="inline-block bg-red-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-red-700 transition">
          Submit Blood Request
        </a>
      </div>

      {{/if}}

    </div>
  </div>
</div>

{{> footer}}

<script>
  // Load blockchain verification data
  async function loadBlockchainData() {
    try {
      const requestId = window.location.pathname.split('/').pop();
      const response = await fetch(`/api/blockchain/request/${requestId}`);
      const result = await response.json();

      if (result.success && result.data.length > 0) {
        const latestRecord = result.data[result.data.length - 1];

        // Update blockchain status
        document.getElementById('blockchainStatus').innerHTML = '✓ Verified';
        document.getElementById('blockchainStatus').className = 'px-3 py-1 bg-green-500 text-white rounded-full text-sm font-semibold';

        // Update blockchain info
        document.getElementById('blockchainInfo').textContent =
          `Recorded in block #${latestRecord.blockIndex} at ${new Date(latestRecord.timestamp).toLocaleString()}`;

        // Update hashes (truncated for display)
        document.getElementById('blockHash').textContent =
          latestRecord.blockHash ? latestRecord.blockHash.substring(0, 32) + '...' : 'N/A';
        document.getElementById('transactionId').textContent =
          `${latestRecord.type}-${requestId}-${latestRecord.blockIndex}`;

      } else {
        // Not yet on blockchain
        document.getElementById('blockchainStatus').innerHTML = '⏳ Pending';
        document.getElementById('blockchainStatus').className = 'px-3 py-1 bg-yellow-500 text-white rounded-full text-sm font-semibold';
        document.getElementById('blockchainInfo').textContent =
          'This request is pending blockchain confirmation. It will be recorded in the next block.';
        document.getElementById('blockHash').textContent = 'Pending...';
        document.getElementById('transactionId').textContent = 'Pending...';
      }
    } catch (error) {
      console.error('Error loading blockchain data:', error);
      document.getElementById('blockchainStatus').innerHTML = '❌ Error';
      document.getElementById('blockchainStatus').className = 'px-3 py-1 bg-red-500 text-white rounded-full text-sm font-semibold';
      document.getElementById('blockchainInfo').textContent =
        'Unable to verify blockchain status at this time.';
    }
  }

  // View full blockchain details
  function viewBlockchainDetails() {
    const requestId = window.location.pathname.split('/').pop();
    window.open(`/api/blockchain/request/${requestId}`, '_blank');
  }

  // Load blockchain data when page loads
  document.addEventListener('DOMContentLoaded', function () {
    { { #if request } }
    loadBlockchainData();
    { {/if } }
  });
</script>