{{> head-public}}

<div class="min-h-screen bg-gradient-to-br from-green-50 to-green-100 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <div class="text-center">
      <!-- Success Icon -->
      <div class="mx-auto flex items-center justify-center h-20 w-20 rounded-full bg-green-100 mb-6">
        <svg class="h-10 w-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
      </div>
      
      <h2 class="text-3xl font-bold text-gray-900 mb-2">Email Verified!</h2>
      <p class="text-gray-600 mb-6">Welcome to VitalMatch, {{firstName}}!</p>
    </div>

    <div class="bg-white rounded-lg shadow-md p-8">
      <div class="text-center mb-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">🎉 Your Account is Now Active!</h3>
        <p class="text-gray-600 mb-6">
          Your email has been successfully verified. You can now access all VitalMatch features and start making a difference in your community.
        </p>
      </div>

      <div class="space-y-4 text-sm text-gray-700">
        <div class="bg-red-50 rounded-lg p-4">
          <h4 class="font-semibold text-red-800 mb-2">🩸 What you can do now:</h4>
          <ul class="space-y-2">
            <li class="flex items-center">
              <svg class="h-4 w-4 text-red-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              Request blood for yourself or others
            </li>
            <li class="flex items-center">
              <svg class="h-4 w-4 text-red-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              Register as a blood donor
            </li>
            <li class="flex items-center">
              <svg class="h-4 w-4 text-red-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              Connect with your community
            </li>
            <li class="flex items-center">
              <svg class="h-4 w-4 text-red-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              Track your donation impact
            </li>
          </ul>
        </div>

        <div class="bg-blue-50 rounded-lg p-4">
          <h4 class="font-semibold text-blue-800 mb-2">📧 Stay Updated</h4>
          <p class="text-blue-700 text-sm">
            You'll receive email notifications about donation opportunities, urgent requests, and important updates from VitalMatch.
          </p>
        </div>
      </div>
    </div>

    <div class="text-center space-y-4">
      <a href="/login" class="inline-flex items-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors">
        <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
        </svg>
        Login to Your Account
      </a>
      
      <p class="text-sm text-gray-500">
        Ready to start saving lives? Log in and explore VitalMatch!
      </p>
    </div>
  </div>
</div>

{{> footer}}