{{> head-public}}
{{> public-nav hideRegister=true}}

<main id="main-content" tabindex="-1" class="journey-status">
  <section class="journey-status__panel" aria-labelledby="verified-heading">
    <div class="journey-status__signal journey-status__signal--success" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg></div>
    <p class="journey-eyebrow">Account ready</p>
    <h1 id="verified-heading">Your email is verified.</h1>
    <p>Welcome to VitalMatch, {{firstName}}. You can now sign in and complete the next appropriate step in the coordination process.</p>
    <div class="journey-status__details"><strong>What happens next</strong><br>Sign in to access the account features available to your role. Donation eligibility and any clinical decisions remain with the appropriate medical professionals.</div>
    <div class="journey-status__actions"><a class="journey-button" href="/login">Sign in to VitalMatch</a><a class="journey-button journey-button--secondary" href="/">Return home</a></div>
  </section>
</main>

{{> public-footer}}
