<!-- Settings Content -->
<main id="main-content" tabindex="-1" class="vm-page min-h-screen bg-gray-100 dark:bg-[#09090b] py-8">
  <div class="vm-page-container max-w-4xl">
    
    <!-- Header -->
    <div class="vm-page-heading mb-8">
      <h1 class="text-3xl font-bold text-gray-800 dark:text-gray-200 mb-2">Settings</h1>
      <p class="text-gray-600 dark:text-gray-400">Manage system configuration and preferences</p>
    </div>

    <!-- Settings Tabs -->
    <div class="vm-panel bg-white dark:bg-[#18181b] rounded-md dark:shadow-none overflow-hidden">
      <div class="border-b border-gray-200 dark:border-gray-800">
        <div class="vm-tabs flex flex-wrap">
          <button class="settings-tab px-6 py-4 text-sm font-medium text-gray-700 dark:text-gray-300 border-b-2 border-transparent hover:text-gray-900 dark:hover:text-gray-100 hover:border-gray-300 dark:hover:border-gray-700 active" data-tab="general">
            <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            General
          </button>
          <button class="settings-tab px-6 py-4 text-sm font-medium text-gray-700 dark:text-gray-300 border-b-2 border-transparent hover:text-gray-900 dark:hover:text-gray-100 hover:border-gray-300 dark:hover:border-gray-700" data-tab="email">
            <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Email
          </button>
          <button class="settings-tab px-6 py-4 text-sm font-medium text-gray-700 dark:text-gray-300 border-b-2 border-transparent hover:text-gray-900 dark:hover:text-gray-100 hover:border-gray-300 dark:hover:border-gray-700" data-tab="notifications">
            <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
            Notifications
          </button>
          <button class="settings-tab px-6 py-4 text-sm font-medium text-gray-700 dark:text-gray-300 border-b-2 border-transparent hover:text-gray-900 dark:hover:text-gray-100 hover:border-gray-300 dark:hover:border-gray-700" data-tab="security">
            <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            Security
          </button>
        </div>
      </div>

      <div class="p-6">
        
        <!-- General Settings Tab -->
        <div id="general-tab" class="settings-content">
          <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-200 mb-6">General Settings</h2>
          
          <form id="generalSettingsForm" class="space-y-6">
            <!-- Application Name -->
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" for="appName">Application Name</label>
              <input type="text" id="appName" name="appName" value="VitalMatch" 
                     class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100">
              <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Name shown in workspace navigation</p>
            </div>

            <!-- System Status -->
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" for="systemStatus">System Status</label>
              <select id="systemStatus" name="systemStatus" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100">
                <option value="online">Online</option>
                <option value="maintenance">Maintenance Mode</option>
                <option value="offline">Offline</option>
              </select>
              <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Controls access for non-admin users; administrators retain access to restore service.</p>
            </div>

            <!-- Time Zone -->
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" for="timeZone">Time Zone</label>
              <select id="timeZone" name="timeZone" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100">
                <option value="UTC">UTC</option>
                <option value="Asia/Manila" selected>Asia/Manila (Philippines)</option>
                <option value="Asia/Tokyo">Asia/Tokyo</option>
                <option value="America/New_York">America/New_York</option>
                <option value="Europe/London">Europe/London</option>
              </select>
              <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Controls dates and times shown in the workspace.</p>
            </div>

            <button type="submit" class="vm-button vm-button--primary px-6 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors">
              Save Changes
            </button>
          </form>
        </div>

        <!-- Email Settings Tab -->
        <div id="email-tab" class="settings-content hidden">
          <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-200 mb-6">Email Configuration</h2>
          <div class="vm-panel mb-4 p-4"><p id="emailStatus" aria-live="polite">Checking SMTP status...</p><p id="emailOutbox" class="vm-muted text-sm mt-2"></p><p class="vm-muted text-sm mt-2">Accepted by SMTP means the mail server accepted the message; recipient delivery is not guaranteed.</p><button type="button" id="retryEmailBtn" class="vm-button vm-button--small mt-3 vm-button--warning">Retry failed email jobs</button></div>
          <div class="vm-panel mb-4 p-4"><h3>Donor outreach dispatch</h3><p id="coordinationJobs" class="vm-muted text-sm mt-2" aria-live="polite">Checking coordination jobs...</p><p class="vm-muted text-sm mt-2">Completed dispatch means invitations were queued. Donor responses and actual donations are recorded separately.</p><button type="button" id="retryCoordinationBtn" class="vm-button vm-button--small mt-3 vm-button--warning">Retry failed outreach jobs</button></div>
          
          <form id="emailSettingsForm" class="space-y-6">
            <!-- SMTP Server -->
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" for="smtpServer">SMTP Server</label>
              <input type="text" id="smtpServer" name="smtpServer" placeholder="smtp.gmail.com" 
                     class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100">
              <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">SMTP server address for sending emails</p>
            </div>

            <!-- SMTP Port -->
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" for="smtpPort">SMTP Port</label>
                <input type="number" id="smtpPort" name="smtpPort" placeholder="587" 
                       class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100">
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" for="emailEncryption">Encryption</label>
                <select id="emailEncryption" name="emailEncryption" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100">
                  <option value="tls">TLS</option>
                  <option value="ssl">SSL</option>

                </select>
              </div>
            </div>

            <!-- Email Address -->
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" for="fromEmail">From Email Address</label>
              <input type="email" id="fromEmail" name="fromEmail" placeholder="noreply@vitalmatch.com" 
                     class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100">
              <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Email address used for sending notifications</p>
            </div>

            <!-- Email Username -->
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" for="emailUsername">Email Username</label>
              <input type="text" id="emailUsername" name="emailUsername" placeholder="your-email@gmail.com" 
                     class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100">
            </div>

            <!-- Email Password -->
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" for="emailPassword">Email Password</label>
              <input type="password" id="emailPassword" name="emailPassword" placeholder="••••••••" 
                     class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100">
              <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Use an app password when required. Leave this blank to keep the saved credential; it is never shown here.</p>
            </div>

            <!-- Test Email -->
            <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-4">
              <p class="text-sm text-blue-700 dark:text-blue-300 mb-3">Verify SMTP connection and authentication without sending a message</p>
              <button type="button" id="testEmailBtn" class="vm-button vm-button--primary px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                Verify SMTP connection
              </button>
            </div>

            <button type="submit" class="vm-button vm-button--primary px-6 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors">
              Save Email Settings
            </button>
          </form>
        </div>

        <!-- Notifications Settings Tab -->
        <div id="notifications-tab" class="settings-content hidden">
          <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-200 mb-6">Notification Settings</h2>
          
          <form id="notificationsSettingsForm" class="space-y-6">
            <!-- Email Notifications -->
            <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4">
              <div class="flex items-center justify-between mb-3">
                <div>
                  <h3 class="font-medium text-gray-900 dark:text-gray-100">Email Notifications</h3>
                  <p class="text-sm text-gray-500 dark:text-gray-400">Enable all outgoing email, including verification and password reset messages. Requires a configured SMTP provider.</p>
                </div>
                <input type="checkbox" id="emailNotificationsEnabled" name="emailNotificationsEnabled" checked 
                       class="w-5 h-5 text-red-600 rounded focus:ring-red-500" aria-label="Email notifications">
              </div>
            </div>

            <!-- Blood Request Notifications -->
            <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4">
              <div class="flex items-center justify-between mb-3">
                <div>
                  <h3 class="font-medium text-gray-900 dark:text-gray-100">Blood Request Alerts</h3>
                  <p class="text-sm text-gray-500 dark:text-gray-400">Email matching invitations, appointment notices and request updates to participants who opted in.</p>
                </div>
                <input type="checkbox" id="bloodRequestNotifications" name="bloodRequestNotifications" checked 
                       class="w-5 h-5 text-red-600 rounded focus:ring-red-500" aria-label="Blood request notifications">
              </div>
            </div>

            <!-- User Registration Notifications -->
            <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4">
              <div class="flex items-center justify-between mb-3">
                <div>
                  <h3 class="font-medium text-gray-900 dark:text-gray-100">Account Welcome Emails</h3>
                  <p class="text-sm text-gray-500 dark:text-gray-400">Send a welcome email when an account is activated. Verification and password reset emails are required for account access.</p>
                </div>
                <input type="checkbox" id="registrationNotifications" name="registrationNotifications" checked 
                       class="w-5 h-5 text-red-600 rounded focus:ring-red-500" aria-label="Account welcome emails">
              </div>
            </div>

            <!-- System Alert Notifications -->
            <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4">
              <div class="flex items-center justify-between mb-3">
                <div>
                  <h3 class="font-medium text-gray-900 dark:text-gray-100">System Alerts</h3>
                  <p class="text-sm text-gray-500 dark:text-gray-400">Allow system email alerts. Audit records remain mandatory regardless of this setting.</p>
                </div>
                <input type="checkbox" id="systemAlertNotifications" name="systemAlertNotifications" checked 
                       class="w-5 h-5 text-red-600 rounded focus:ring-red-500" aria-label="System alert notifications">
              </div>
            </div>

            <button type="submit" class="vm-button vm-button--primary px-6 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors">
              Save Notification Settings
            </button>
          </form>
        </div>

        <!-- Security Settings Tab -->
        <div id="security-tab" class="settings-content hidden">
          <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-200 mb-6">Security Settings</h2>
          
          <form id="securitySettingsForm" class="space-y-6">
            <!-- Session Timeout -->
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" for="sessionTimeout">Session Timeout (minutes)</label>
              <input type="number" id="sessionTimeout" name="sessionTimeout" value="30" min="5" max="480"
                     class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100">
              <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Auto-logout duration for inactive users</p>
            </div>

            <!-- Password Policy -->
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" for="minPasswordLength">Minimum Password Length</label>
              <input type="number" id="minPasswordLength" name="minPasswordLength" value="8" min="8" max="64"
                     class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent dark:bg-gray-700 dark:text-gray-100">
            </div>

            <!-- Require Special Characters -->
            <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4">
              <div class="flex items-center justify-between">
                <div>
                  <h3 class="font-medium text-gray-900 dark:text-gray-100">Require Special Characters in Password</h3>
                  <p class="text-sm text-gray-500 dark:text-gray-400">Enforce stronger password requirements</p>
                </div>
                <input type="checkbox" id="requireSpecialChars" name="requireSpecialChars" checked 
                       class="w-5 h-5 text-red-600 rounded focus:ring-red-500" aria-label="Require special characters in passwords">
              </div>
            </div>

            <div class="vm-alert"><p>Administrative audit records are always enabled. Multi-factor authentication and IP allowlists are not implemented; this screen does not claim or enable those protections.</p></div>

            <button type="submit" class="vm-button vm-button--primary px-6 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors">
              Save Security Settings
            </button>
          </form>
        </div>

      </div>
    </div>

  </div>
</main>

<!-- Toast Notification -->
<div id="toast" class="fixed bottom-4 right-4 hidden">
  <div class="bg-green-500 text-white px-6 py-3 rounded-lg">
    <p id="toastMessage">Settings saved successfully!</p>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', async function() {
  let settingsLoaded = false, savingSettings = false;
  const saveButtons = [...document.querySelectorAll('form button[type="submit"]')];
  const setSaveState = () => saveButtons.forEach(button => { button.disabled = !settingsLoaded || savingSettings; });
  setSaveState();
  // Load current settings
  await loadSettings();

  // Tab switching
  const tabs = document.querySelectorAll('.settings-tab');
  const contents = document.querySelectorAll('.settings-content');

  tabs.forEach(tab => {
    tab.addEventListener('click', function() {
      const tabName = this.dataset.tab;
      
      // Remove active state from all tabs
      tabs.forEach(t => t.classList.remove('border-red-500', 'text-red-600', 'dark:text-red-400', 'active'));
      contents.forEach(c => c.classList.add('hidden'));
      
      // Add active state to clicked tab
      this.classList.add('border-red-500', 'text-red-600', 'dark:text-red-400', 'active');
      this.style.borderBottomWidth = '2px';
      
      // Show corresponding content
      document.getElementById(tabName + '-tab').classList.remove('hidden');
    });
  });

  // Load settings from API
  async function loadSettings() {
    settingsLoaded = false; setSaveState();
    try {
      const response = await fetch('/api/admin/settings');
      if (!response.ok) throw new Error('Settings status is unavailable');
      const data = await response.json();
      if (!data.success) throw new Error(data.error || 'Settings status is unavailable');
      
      if (data.success) {
        const settings = data.settings;
        const status = data.emailStatus || {};
        document.getElementById('emailStatus').textContent = status.configured ? 'SMTP configuration present. Connection ' + (status.verified ? 'verified' : 'not yet verified') + '. Mode: ' + (status.mode || 'unknown') : 'SMTP is not configured. In-app notifications remain available.';
        const counts = data.outboxStats || {};
        document.getElementById('emailOutbox').textContent = 'Outbox: ' + (counts.pending || 0) + ' pending, ' + (counts.processing || 0) + ' processing, ' + (counts.sent || 0) + ' accepted by SMTP, ' + (counts.failed || 0) + ' failed, ' + (counts.suppressed || 0) + ' suppressed, ' + (counts.superseded || 0) + ' superseded.';
        document.getElementById('retryEmailBtn').disabled = !counts.failed;
        const jobs = data.coordinationStats || {};
        document.getElementById('coordinationJobs').textContent = 'Outreach dispatch: ' + (jobs.pending || 0) + ' pending, ' + (jobs.processing || 0) + ' processing, ' + (jobs.completed || 0) + ' completed, ' + (jobs.failed || 0) + ' failed.';
        document.getElementById('retryCoordinationBtn').disabled = !jobs.failed;
        
        // Populate General Settings
        if (settings.general) {
          document.getElementById('appName').value = settings.general.appName || 'VitalMatch';
          document.getElementById('systemStatus').value = settings.general.systemStatus || 'online';
          document.getElementById('timeZone').value = settings.general.timeZone || 'Asia/Manila';
        }
        
        // Populate Email Settings
        if (settings.email) {
          document.getElementById('smtpServer').value = settings.email.smtpServer || '';
          document.getElementById('smtpPort').value = settings.email.smtpPort || '587';
          document.getElementById('emailEncryption').value = settings.email.emailEncryption || 'tls';
          document.getElementById('fromEmail').value = settings.email.fromEmail || '';
          document.getElementById('emailUsername').value = settings.email.emailUsername || '';
          document.getElementById('emailPassword').value = ''; // Never pre-fill password
        }
        
        // Populate Notification Settings
        if (settings.notifications) {
          document.getElementById('emailNotificationsEnabled').checked = settings.notifications.emailNotificationsEnabled;
          document.getElementById('bloodRequestNotifications').checked = settings.notifications.bloodRequestNotifications;
          document.getElementById('registrationNotifications').checked = settings.notifications.registrationNotifications;
          document.getElementById('systemAlertNotifications').checked = settings.notifications.systemAlertNotifications;
        }
        
        // Populate Security Settings
        if (settings.security) {
          document.getElementById('sessionTimeout').value = settings.security.sessionTimeout || '30';
          document.getElementById('minPasswordLength').value = settings.security.minPasswordLength || '8';
          document.getElementById('requireSpecialChars').checked = settings.security.requireSpecialChars;
        }
        settingsLoaded = true; setSaveState();
      }
    } catch (error) {
      console.error('Error loading settings:', error);
      document.getElementById('emailStatus').textContent = 'Settings could not be loaded. Reload this page to retry before saving.';
      document.getElementById('emailOutbox').textContent = 'Email job counts are unavailable.';
      document.getElementById('coordinationJobs').textContent = 'Outreach job counts are unavailable. Reload this page to retry.';
      document.getElementById('retryEmailBtn').disabled = true;
      document.getElementById('retryCoordinationBtn').disabled = true;
      showToast('Error loading settings', 'error');
    }
  }

  // Form submissions
  document.getElementById('generalSettingsForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    await submitForm('/admin/settings/general', {
      appName: document.getElementById('appName').value,
      systemStatus: document.getElementById('systemStatus').value,
      timeZone: document.getElementById('timeZone').value
    }, 'General settings saved successfully!');
  });

  document.getElementById('emailSettingsForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    await submitForm('/admin/settings/email', {
      smtpServer: document.getElementById('smtpServer').value,
      smtpPort: document.getElementById('smtpPort').value,
      emailEncryption: document.getElementById('emailEncryption').value,
      fromEmail: document.getElementById('fromEmail').value,
      emailUsername: document.getElementById('emailUsername').value,
      emailPassword: document.getElementById('emailPassword').value
    }, 'Email settings saved successfully!');
  });

  document.getElementById('notificationsSettingsForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    await submitForm('/admin/settings/notifications', {
      emailNotificationsEnabled: document.getElementById('emailNotificationsEnabled').checked,
      bloodRequestNotifications: document.getElementById('bloodRequestNotifications').checked,
      registrationNotifications: document.getElementById('registrationNotifications').checked,
      systemAlertNotifications: document.getElementById('systemAlertNotifications').checked
    }, 'Notification settings saved successfully!');
  });

  document.getElementById('securitySettingsForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    await submitForm('/admin/settings/security', {
      sessionTimeout: document.getElementById('sessionTimeout').value,
      minPasswordLength: document.getElementById('minPasswordLength').value,
      requireSpecialChars: document.getElementById('requireSpecialChars').checked
    }, 'Security settings saved successfully!');
  });

  // Test Email Button
  document.getElementById('retryCoordinationBtn').addEventListener('click', async function () {
    this.disabled = true;
    try {
      const response = await fetch('/admin/settings/retry-coordination', { method: 'POST', headers: { 'X-CSRF-Token': window.getCsrfToken() } });
      const data = await response.json(); if (!response.ok || !data.success) throw new Error(data.message || data.error || 'Retry could not be queued');
      showToast(data.message || 'Failed outreach jobs queued for retry', 'success'); await loadSettings();
    } catch (error) { showToast(error.message, 'error'); this.disabled = false; }
  });
  document.getElementById('retryEmailBtn').addEventListener('click', async function () {
    this.disabled = true;
    try {
      const response = await fetch('/admin/settings/retry-email', { method: 'POST', headers: { 'X-CSRF-Token': window.getCsrfToken() } });
      const data = await response.json(); if (!response.ok || !data.success) throw new Error(data.message || 'Retry could not be queued');
      showToast(data.message || 'Failed jobs queued for retry', 'success'); await loadSettings();
    } catch (error) { showToast(error.message, 'error'); this.disabled = false; }
  });
  document.getElementById('testEmailBtn').addEventListener('click', async function() {
    const btn = this;
    btn.disabled = true;
    btn.textContent = 'Verifying SMTP...';
    
    try {
      const response = await fetch('/admin/settings/test-email', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json', 'X-CSRF-Token': window.getCsrfToken()
        },
        body: JSON.stringify({})
      });
      
      const data = await response.json();
      
      if (response.ok && data.success) {
        showToast(data.message, 'success');
      } else {
        showToast(data.message || data.error || 'SMTP verification failed', 'error');
      }
    } catch (error) {
      console.error('Error sending test email:', error);
      showToast('SMTP verification could not be completed', 'error');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Verify SMTP connection';
      loadSettings();
    }
  });

  // Submit form data
  async function submitForm(url, data, successMessage) {
    if (!settingsLoaded || savingSettings) { showToast('Wait for the current settings to load before saving.', 'error'); return; }
    savingSettings = true; setSaveState();
    try {
      const response = await fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json', 'X-CSRF-Token': window.getCsrfToken()
        },
        body: JSON.stringify(data)
      });
      
      const result = await response.json();
      
      if (response.ok && result.success) {
        showToast(successMessage || result.message, 'success');
        await loadSettings();
      } else {
        showToast(result.message || result.error || 'Error saving settings', 'error');
      }
    } catch (error) {
      console.error('Error submitting form:', error);
      showToast('Error saving settings', 'error');
    } finally { savingSettings = false; setSaveState(); }
  }

  // Toast notification
  function showToast(message, type = 'success') {
    const toast = document.getElementById('toast');
    const toastMessage = document.getElementById('toastMessage');
    const toastDiv = toast.querySelector('div');
    
    toastMessage.textContent = message;
    
    // Set color based on type
    if (type === 'error') {
      toastDiv.className = 'vm-alert bg-red-500 text-white px-6 py-3 rounded-lg ';
    } else {
      toastDiv.className = 'vm-alert bg-green-500 text-white px-6 py-3 rounded-lg ';
    }
    
    toast.classList.remove('hidden');
    
    setTimeout(() => {
      toast.classList.add('hidden');
    }, 3000);
  }
});
</script>
